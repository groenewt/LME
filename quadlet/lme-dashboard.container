# lme-dashboard.container
[Unit]
Description=LME Security Dashboard - FastAPI + Alpine.js UI
Requires=lme-elasticsearch.service lme-litellm.service lme-pgvector.service lme-embeddings.service #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
After=lme-elasticsearch.service lme-litellm.service lme-pgvector.service lme-embeddings.service #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
PartOf=lme.service #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
StartLimitIntervalSec=120 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
StartLimitBurst=10 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=5400
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED

[Container]
ContainerName=lme-dashboard #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Image=localhost/lme-dashboard:LME_LATEST #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Network=lme #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
PodmanArgs=--network-alias lme-dashboard #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
PublishPort=8502:8502 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=ELASTICSEARCH_URL=https://lme-elasticsearch:9200 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=ELASTICSEARCH_USER=elastic #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LITELLM_URL=https://lme-litellm:4000 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LITELLM_API_KEY=sk-lme-llama-proxy #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LITELLM_MODEL=lfm2.5-1.2b-instruct #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=PGVECTOR_HOST=lme-pgvector #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=PGVECTOR_PORT=5432 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=PGVECTOR_DB=lme_vectors #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=PGVECTOR_USER=lme #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=EMBED_URL=https://lme-embeddings:8081 #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/opt/lme/lme-dashboard/app.py:/app/app.py:ro #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/opt/lme/lme-dashboard/static:/app/static:ro #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/opt/lme/config:/opt/lme/config:rw #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/opt/lme/llama-models:/opt/lme/llama-models:rw #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/opt/lme/scripts/sigma:/opt/lme/scripts/sigma:rw #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=/etc/lme/pass.sh:/etc/lme/pass.sh:ro #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Volume=lme_certs:/certs:ro,idmap #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLAMA_MODELS_DIR=/opt/lme/llama-models #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLAMA_MODEL_CONFIG=/opt/lme/config/llama-cpp-model.json #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLAMA_MODEL_TRIGGER=/opt/lme/config/.llama-model-updated#@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLAMA_MODEL_STATUS=/opt/lme/config/llama-cpp-status.json #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=SSL_KEYFILE=/certs/dashboard/dashboard.key#@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=SSL_CERTFILE=/certs/dashboard/dashboard.crt #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LITELLM_CONFIG_PATH=/opt/lme/config/litellm_config.yaml #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLM_KEYS_PATH=/opt/lme/config/llm_keys.enc #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=LLM_KEYS_TRIGGER=/opt/lme/config/.llm-keys-updated #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Environment=VAULT_PASS_FILE=/etc/lme/pass.sh #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Exec=uvicorn app:app --host 0.0.0.0 --port 8502 --ssl-keyfile /certs/dashboard/dashboard.key --ssl-certfile /certs/dashboard/dashboard.crt #@@TODO:OPERATOR: HARDCODED@TODO:OPERATOR: HARDCODED
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD 
Secret=pgvector,type=env,target=PGVECTOR_PASS
