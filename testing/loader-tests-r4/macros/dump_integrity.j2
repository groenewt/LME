{#- macros/dump_integrity.j2 -- judge that every dump a comparison is about to read is EXACTLY the dump
    its originating run recorded (C1 loader-tests instrument, r2; codex-1931 C1-DUMP-INTEGRITY).
    STATUS: UNEXECUTED.
    Input (template var): members -- list of {side, case, declared, recorded, observed, present}:
      declared -- list of dumped variable names the cases file declares for the case (dump_vars)
      recorded -- the run's results.yml dump_sha256 mapping for the case (var -> sha256 | null)
      observed -- var -> sha256 recomputed from the bytes the comparator READ for this comparison
                  (null when the dump could not be read)
      present  -- list of entry names actually found in the case's resolved/ directory
    Every one of these is refused (one problem record each):
      recorded-map-missing   recorded is not a mapping (reported with var '*')
      recorded-hash-missing  a declared var has no 64-hex recorded hash (includes a null = no dump written)
      extra-recorded-member  recorded names a var the case does not declare
      dump-missing           a declared var's dump could not be read (observed null / absent)
      dump-file-absent       a declared "<var>.json" is not in the resolved/ listing
      extra-dump-file        the resolved/ listing holds an entry that is not a declared "<var>.json"
      hash-mismatch          observed != recorded (tampered / edited after the run recorded it)
    Output JSON: {checked, problems: [{side, case, var, why}]}. The caller refuses unless problems is
    empty and checked equals the number of members it built. Used by compare_neutrality.yml
    (production) and comparator_selftest.yml (declared negative controls) via the SAME template lookup. -#}
{%- set problems = [] -%}
{%- set n = [] -%}
{%- for m in members -%}
{%- set _ = n.append(1) -%}
{%- set declared = m.declared | map('string') | list -%}
{%- set present = (m.present | default([], true)) | map('string') | list -%}
{%- set observed = m.observed if (m.observed is mapping) else {} -%}
{%- if not (m.recorded is mapping) -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': '*', 'why': 'recorded-map-missing'}) -%}
{%- set recorded = {} -%}
{%- else -%}
{%- set recorded = m.recorded -%}
{%- endif -%}
{%- for k in recorded.keys() | map('string') | sort -%}
{%- if k not in declared -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': k, 'why': 'extra-recorded-member'}) -%}
{%- endif -%}
{%- endfor -%}
{%- set declared_files = [] -%}
{%- for v in declared -%}
{%- set _ = declared_files.append(v ~ '.json') -%}
{%- endfor -%}
{%- for f in present | sort -%}
{%- if f not in declared_files -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': f, 'why': 'extra-dump-file'}) -%}
{%- endif -%}
{%- endfor -%}
{%- for v in declared | sort -%}
{%- set rec = recorded[v] if v in recorded else none -%}
{%- set obs = observed[v] if v in observed else none -%}
{%- if (v ~ '.json') not in present -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': v, 'why': 'dump-file-absent'}) -%}
{%- endif -%}
{%- if not (rec is string) or not (rec is match('^[0-9a-f]{64}$')) -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': v, 'why': 'recorded-hash-missing'}) -%}
{%- elif obs is none -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': v, 'why': 'dump-missing'}) -%}
{%- elif obs != rec -%}
{%- set _ = problems.append({'side': m.side, 'case': m.case, 'var': v, 'why': 'hash-mismatch'}) -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{{ {'checked': n | length, 'problems': problems} | to_json }}
