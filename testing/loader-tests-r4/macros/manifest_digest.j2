{#- macros/manifest_digest.j2 -- CANONICAL member serialization for an aggregate manifest digest (C1
    loader-tests instrument, r2; codex-1931 C1-AGGREGATE-MANIFEST-DIGEST; aligned with the G-1933
    recipe "LC_ALL=C sorted member lines <path>\t<sha256>\n"). STATUS: UNEXECUTED.
    Input (template var): members -- mapping <relpath> -> <lowercase hex sha256 of that file>.
    Serialization scheme "path-tab-sha256-v1": one line per member, "<relpath><TAB><sha256>\n", every
    line newline-terminated, members ordered by relpath in CASE-SENSITIVE code-point order (= LC_ALL=C
    byte order of the UTF-8 paths; Jinja's default sort is case-insensitive and therefore NOT
    canonical). The aggregate digest is sha256 of the UTF-8 serialization, taken by the CALLER with
    hash('sha256'). The ACTUAL path and checksum of each member are serialized -- never the field
    names of a dict2items record (the v6.2 defect: joining an item dict joined its keys 'key'/'value',
    so every same-size manifest set digested identically).
    A member whose path is empty / contains TAB, LF or CR, or whose checksum is not 64 lowercase hex, is
    reported in `invalid` (and left out of the serialization); the caller must refuse.
    Output JSON: {scheme, count, serialization, invalid: [{path, checksum, why}]}.
    Used by run_loader_tests.yml (production) and comparator_selftest.yml (declared self-test) through
    the SAME ansible.builtin.template lookup. -#}
{%- set lines = [] -%}
{%- set bad = [] -%}
{%- for m in members | dict2items | sort(attribute='key', case_sensitive=true) -%}
{%- if not (m.key is string) or (m.key | length) == 0 or '\t' in m.key or '\n' in m.key or '\r' in m.key -%}
{%- set _ = bad.append({'path': m.key | string, 'checksum': m.value | string, 'why': 'bad path'}) -%}
{%- elif not (m.value is string) or not (m.value is match('^[0-9a-f]{64}$')) -%}
{%- set _ = bad.append({'path': m.key, 'checksum': m.value | string, 'why': 'bad checksum'}) -%}
{%- else -%}
{%- set _ = lines.append(m.key ~ '\t' ~ m.value ~ '\n') -%}
{%- endif -%}
{%- endfor -%}
{{ {'scheme': 'path-tab-sha256-v1', 'count': lines | length, 'serialization': lines | join(''), 'invalid': bad} | to_json }}
