{#- macros/c1_iso6_port.j2 -- MULTINODE-217-TEMPLATED-PORT-TYPE case expressions (C1-owned macro library; DATA =
    cases-c1-iso6-port.yml). Hand-authored with the editor (no generator). check(name, arg) returns TEXT only: a bare
    Ansible assert expression the probe evaluates. STRICT typing: `is integer` (int, never bool) / `is string`. -#}

{%- macro ES() -%}lme_services['elasticsearch'].publish_ports[0]{%- endmacro -%}
{%- macro FS() -%}lme_services['fleet-server'].publish_ports[0]{%- endmacro -%}
{%- macro INT(x, v) -%}({{ x }} is integer and {{ x }} is not boolean and {{ x }} == {{ v }}){%- endmacro -%}
{%- macro STR(x, v) -%}({{ x }} is string and {{ x }} == '{{ v }}'){%- endmacro -%}
{%- macro lazy(expr) -%}{{ '{{ ' ~ expr ~ ' }}' }}{%- endmacro -%}

{%- macro pin(name) -%}
{#- a typed lme_resolved pin: a bool field carried as its canonical STRING; the port normalization never applies -#}
{%- if name == 'bool_as_string' -%}{{ lazy("_lme_resolution.resolved | combine({'install_llm': (_lme_resolution.resolved.install_llm | string | lower)})") }}
{%- else -%}UNKNOWN-PIN-{{ name }}
{%- endif -%}
{%- endmacro -%}

{%- macro check(name, arg='') -%}
{#- every declared integer port leaf of every composed service is a strict int (no string survives on any core) -#}
{%- if name == 'all_ports_int' -%}(lme_services | dict2items | map(attribute='value') | selectattr('publish_ports', 'defined') | map(attribute='publish_ports') | flatten | map('dict2items') | flatten | selectattr('key', 'in', ['host', 'container', 'tailnet_port']) | map(attribute='value') | reject('integer') | list | length) == 0 and (lme_services | dict2items | map(attribute='value') | selectattr('publish_ports', 'defined') | map(attribute='publish_ports') | flatten | map('dict2items') | flatten | selectattr('key', 'in', ['host', 'container', 'tailnet_port']) | map(attribute='value') | select('boolean') | list | length) == 0
{%- elif name == 'mn_default' -%}{{ INT(ES() ~ '.host', 9200) }} and {{ INT(ES() ~ '.container', 9200) }} and {{ INT(ES() ~ '.tailnet_port', 9200) }} and {{ STR(ES() ~ '.bind', '0.0.0.0') }} and {{ INT(FS() ~ '.host', 8220) }} and {{ STR(FS() ~ '.bind', '0.0.0.0') }}
{%- elif name == 'mn_tailscale' -%}{{ INT(ES() ~ '.host', 19200) }} and {{ INT(ES() ~ '.container', 9200) }} and {{ INT(ES() ~ '.tailnet_port', 9200) }} and {{ STR(ES() ~ '.bind', '127.0.0.1') }}
{%- elif name == 'mn_bind' -%}{{ INT(ES() ~ '.host', 9200) }} and {{ STR(ES() ~ '.bind', arg) }}
{#- an operator override: declared int leaves as canonical strings -> ints; the item's undeclared `bind` stays the string -#}
{%- elif name == 'override_string' -%}{{ INT(ES() ~ '.host', 9300) }} and {{ INT(ES() ~ '.container', 9200) }} and {{ STR(ES() ~ '.bind', '9200') }} and {{ INT(ES() ~ '.tailnet_port', 9200) }} and (lme_services['elasticsearch'].publish_ports | length) == 1
{%- elif name == 'override_int_tailscale' -%}{{ INT(ES() ~ '.host', 9301) }} and {{ STR(ES() ~ '.bind', '127.0.0.1') }} and ('tailnet_port' not in lme_services['elasticsearch'].publish_ports[0])
{#- unrelated service fields are never converted (declared-field-only normalization) -#}
{%- elif name == 'unrelated_untouched' -%}(lme_services['elasticsearch'].ulimits.memlock is string) and (lme_services['elasticsearch'].ulimits.memlock == '-1:-1')
{#- REASON controls: the composed elasticsearch entry with ONE declared port leaf replaced by `arg`, through the SAME
    engine filter and the SAME loaded registry the build uses (a non-loop evaluation, so the refusal text is visible) -#}
{%- elif name == 'reason_host' -%}({'elasticsearch': (lme_services['elasticsearch'] | combine({'publish_ports': [{'host': {{ arg }}, 'container': 9200}]}))} | lme_service_typed_inputs(_lme_global_file.lme_config_registry)) is mapping
{%- elif name == 'reason_container' -%}({'elasticsearch': (lme_services['elasticsearch'] | combine({'publish_ports': [{'host': 9200, 'container': {{ arg }}}]}))} | lme_service_typed_inputs(_lme_global_file.lme_config_registry)) is mapping
{%- elif name == 'reason_decl_max_string' -%}(lme_services | lme_service_typed_inputs(_lme_global_file.lme_config_registry | combine({'service_input_types': {'publish_ports': {'max': '65535'}}}, recursive=True))) is mapping
{%- elif name == 'revision_hex' -%}lme_resolved_revision is string and lme_resolved_revision is match('^[0-9a-f]{64}$')
{%- else -%}UNKNOWN-CHECK-{{ name }}
{%- endif -%}
{%- endmacro -%}
