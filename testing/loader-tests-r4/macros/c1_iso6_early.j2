{#- macros/c1_iso6_early.j2 -- C1 iso6 early/verifier case expressions for the head AFTER C1-EFFECTIVE-ENDPOINT-BINDING
    (commit B 62e81d24). C1-owned macro library; DATA = cases-c1-iso6-early.yml / cases-c1-iso6-verifier.yml.
    Hand-authored with the editor (no generator). Every macro returns TEXT only (a bare Ansible expression).
    A NEW file (not an edit of c1_iso5.j2 / c1_iso5_verify.j2) so the historical macro bytes behind retained iso5 receipts
    stay unchanged. -#}

{%- macro H() -%}lme_resolved.remote_harness{%- endmacro -%}
{%- macro R() -%}lme_resolved{%- endmacro -%}
{%- macro REG() -%}_lme_global_file.lme_config_registry{%- endmacro -%}

{%- macro check(name) -%}
{#- ATTRIBUTED CHECK CHANGE (replaces c1_iso5.j2 check('binding_deployment') in the iso6 early file). B binds each bound
    target's effective declared endpoint [address, port_key, proxy_jump, owner] into binding.deployment.endpoints; the
    pre-B check asserted exact equality WITHOUT that key and fails on the final head (retained runs
    c5dd512bb9cf-reproduction-fin-early-219-*T051731Z and -217-*T052129Z: ph-heterogeneous-admitted and
    ph-same-target-reapply-stable UNEXPECTED-FAIL "Assertion failed"). Expected endpoints follow from the case inventory
    and the declared rule, not from the run: t1/t2 carry no ansible_host/port/ssh args/owner, so address = the inventory
    name (declared address fallback), port_key = '<ssh_config>' (declared port absent = delegate_ssh_config), proxy_jump
    = '' (inventory form absent), owner = '' (owner var undefined). -#}
{%- if name == 'binding_deployment_ep' -%}{{ H() }}.binding.deployment == {'profile': 'remote-harness', 'controller': 'localhost', 'target_group': 'lme_toolchain_targets', 'targets': ['t1', 't2'], 'endpoints': {'t1': ['t1', '<ssh_config>', '', ''], 't2': ['t2', '<ssh_config>', '', '']}} and {{ H() }}.binding.operation == 'deploy_transfer'
{%- else -%}UNKNOWN-CHECK-{{ name }}
{%- endif -%}
{%- endmacro -%}

{%- macro tampered(name) -%}
{#- ATTRIBUTED TAMPER CHANGE (verifier). The pre-B tamper 'binding_targets_only' set targets = ['t1'] while endpoints kept
    t1 AND t2, so on the final head the verifier refuses at the B endpoint-shape check before the scope binding it was
    written to reach (retained run c5dd512bb9cf-reproduction-fin-verifier-219-*T052505Z: NOT-REJECTED, cause "...endpoints
    must map every bound target..."). Two named claims now:
    binding_targets_coherent: targets AND endpoints narrowed together to t1 (a well-formed binding) -> must still be
      refused because scope_sha256 no longer binds it (the ORIGINAL claim, original needle);
    binding_targets_endpoints_skew: targets narrowed alone (endpoints unchanged) -> refused by the endpoint-shape rule. -#}
{%- if name == 'binding_targets_coherent' -%}({{ R() }} | combine({'remote_harness': ({{ H() }} | combine({'binding': ({{ H() }}.binding | combine({'deployment': ({{ H() }}.binding.deployment | combine({'targets': ['t1'], 'endpoints': {'t1': {{ H() }}.binding.deployment.endpoints['t1']}}))}))}))})) | lme_verify_resolved({{ REG() }})
{%- elif name == 'binding_targets_endpoints_skew' -%}({{ R() }} | combine({'remote_harness': ({{ H() }} | combine({'binding': ({{ H() }}.binding | combine({'deployment': ({{ H() }}.binding.deployment | combine({'targets': ['t1']}))}))}))})) | lme_verify_resolved({{ REG() }})
{%- else -%}UNKNOWN-TAMPER-{{ name }}
{%- endif -%}
{%- endmacro -%}
