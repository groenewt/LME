{#- macros/c1_iso6_endpoint.j2 -- C1-EFFECTIVE-ENDPOINT-BINDING case expressions (C1-owned macro library; DATA =
    cases-c1-iso6-endpoint.yml). Hand-authored with the editor (no generator). check(name, arg) returns TEXT only: a
    bare Ansible assert expression the probe evaluates. -#}

{%- macro C() -%}(_lme_global_file.lme_global | combine(_lme_profile_file.profile_overlay.lme_global | default({}), recursive=True)){%- endmacro -%}
{%- macro SCH() -%}_lme_global_file.lme_config_registry.remote_harness_schema{%- endmacro -%}
{%- macro OV() -%}(lme_global_override | default({})){%- endmacro -%}
{%- macro COMP() -%}({{ C() }} | combine({{ OV() }}, recursive=True)){%- endmacro -%}
{%- macro H() -%}lme_resolved.remote_harness{%- endmacro -%}
{%- macro EP() -%}{{ H() }}.binding.deployment.endpoints{%- endmacro -%}
{#- the section re-projected with t1's collected inventory value for ROLE replaced (same inventory id, same policy) -#}
{%- macro ALT(role, value) -%}({{ COMP() }} | lme_project_remote_harness({{ C() }}, {{ OV() }}, {{ SCH() }}, (_lme_rh_scope | combine({'connections': {'values': {'t1': {'{{ role }}': {{ value }}}}}}, recursive=True)), documents=_lme_rh_documents, admission=_lme_rh_admission)){%- endmacro -%}
{#- C1-ENDPOINT-EXPLICIT-NULL (codex 063540): ABSENCE is the role's key MISSING from t1's collected values (a
    supplied null is a value). DROP(role) re-projects with t1's collected values minus ROLE (non-recursive replace of
    t1's entry, so the key is really gone). -#}
{#- ATTRIBUTED MACRO FIX (retained runs a4f16f92aea8-reproduction-iso7-endpoint-219-*T135144Z / -217-*T135919Z:
    ep-baseline-bound UNEXPECTED-FAIL "object of type 'method' has no attribute 't1'" -- `.values` resolved to the dict
    METHOD). Subscript form only. -#}
{%- macro CV() -%}_lme_rh_scope.connections['values']{%- endmacro -%}
{%- macro DROP(role) -%}({{ COMP() }} | lme_project_remote_harness({{ C() }}, {{ OV() }}, {{ SCH() }}, (_lme_rh_scope | combine({'connections': (_lme_rh_scope.connections | combine({'values': ({{ CV() }} | combine({'t1': ({{ CV() }}.t1 | dict2items | rejectattr('key', 'eq', '{{ role }}') | items2dict)}))}))})), documents=_lme_rh_documents, admission=_lme_rh_admission)){%- endmacro -%}
{%- macro DROPPED(role, expect_t1) -%}({{ DROP(role) }}.binding.deployment.endpoints.t1 == {{ expect_t1 }} and {{ DROP(role) }}.binding.deployment.endpoints.t2 == {{ EP() }}.t2 and {{ DROP(role) }}.scope_sha256 != {{ H() }}.scope_sha256 and {{ DROP(role) }}.policy_sha256 == {{ H() }}.policy_sha256){%- endmacro -%}
{%- macro SAME() -%}({{ COMP() }} | lme_project_remote_harness({{ C() }}, {{ OV() }}, {{ SCH() }}, _lme_rh_scope, documents=_lme_rh_documents, admission=_lme_rh_admission)){%- endmacro -%}
{#- the changed binding moves THIS host's scope identity, every scope identity and the scopes digest; policy unchanged -#}
{%- macro MOVED(role, value, expect_t1) -%}({{ ALT(role, value) }}.binding.deployment.endpoints.t1 == {{ expect_t1 }} and {{ ALT(role, value) }}.binding.deployment.endpoints.t2 == {{ EP() }}.t2 and {{ ALT(role, value) }}.scope_sha256 != {{ H() }}.scope_sha256 and {{ ALT(role, value) }}.scopes.controller.scope_sha256 != {{ H() }}.scopes.controller.scope_sha256 and {{ ALT(role, value) }}.scopes_sha256 != {{ H() }}.scopes_sha256 and {{ ALT(role, value) }}.policy_sha256 == {{ H() }}.policy_sha256){%- endmacro -%}
{%- macro with_h(patch) -%}(lme_resolved | combine({'remote_harness': ({{ H() }} | combine({{ patch }}, recursive=True))})) | lme_verify_resolved(_lme_global_file.lme_config_registry, documents=_lme_rh_documents, admission=_lme_rh_admission){%- endmacro -%}

{%- macro check(name, arg='') -%}
{%- if name == 'verified' -%}lme_resolved | lme_verify_resolved(_lme_global_file.lme_config_registry, documents=_lme_rh_documents, admission=_lme_rh_admission)
{%- elif name == 'endpoints' -%}{{ EP() }} == {{ arg }}
{%- elif name == 'same_all_hosts' -%}(groups['all'] | map('extract', hostvars) | map(attribute='lme_resolved') | map(attribute='remote_harness') | map(attribute='binding') | map(attribute='deployment') | map(attribute='endpoints') | unique | list | length) == 1
{#- an unchanged endpoint re-projects byte-identically (stable) -#}
{%- elif name == 'unchanged_stable' -%}{{ SAME() }} == {{ H() }}
{%- elif name == 'moved_address' -%}{{ MOVED('address', "'10.9.9.9'", "['10.9.9.9', '2222', '', 'u1']") }}
{%- elif name == 'moved_port' -%}{{ MOVED('port', '2200', "['10.0.0.1', '2200', '', 'u1']") }}
{#- ATTRIBUTED CHECK CHANGE (C1-ENDPOINT-EXPLICIT-NULL): moved_port_absent previously drove "absent" as a supplied
    null (ALT('port', 'none')); after the fix a supplied null REFUSES, so absence is now a real key drop. -#}
{%- elif name == 'moved_port_absent' -%}{{ DROPPED('port', "['10.0.0.1', '<ssh_config>', '', 'u1']") }}
{#- paired ABSENT (key dropped) positives on the same projection -#}
{%- elif name == 'absent_address' -%}{{ DROPPED('address', "['t1', '2222', '', 'u1']") }}
{%- elif name == 'absent_owner' -%}{{ DROPPED('owner', "['10.0.0.1', '2222', '', '']") }}
{#- paired SUPPLIED-NULL refusals on the same projection (the filter raises inside the case's assert) -#}
{%- elif name == 'null_address' -%}{{ ALT('address', 'none') }}.binding is defined
{%- elif name == 'null_port' -%}{{ ALT('port', 'none') }}.binding is defined
{%- elif name == 'null_common_args' -%}{{ ALT('proxy_jump', 'none') }}.binding is defined
{%- elif name == 'null_owner' -%}{{ ALT('owner', 'none') }}.binding is defined
{%- elif name == 'moved_route' -%}{{ MOVED('proxy_jump', "'-o ProxyJump=bastion'", "['10.0.0.1', '2222', 'bastion', 'u1']") }}
{%- elif name == 'moved_owner' -%}{{ MOVED('owner', "'u9'", "['10.0.0.1', '2222', '', 'u9']") }}
{#- a float port through the SAME projection (t1's collected value replaced; core-independent: no host connection var) -#}
{%- elif name == 'alt_port_float' -%}{{ ALT('port', '22.5') }}.binding is defined
{#- verifier negatives -#}
{%- elif name == 'vf_endpoint_port_only' -%}{{ with_h("{'binding': {'deployment': {'endpoints': {'t1': ['10.0.0.1', '2200', '', 'u1']}}}}") }}
{%- elif name == 'vf_endpoint_missing_target' -%}(lme_resolved | combine({'remote_harness': ({{ H() }} | combine({'binding': ({{ H() }}.binding | combine({'deployment': ({{ H() }}.binding.deployment | combine({'endpoints': ({{ EP() }} | dict2items | rejectattr('key', 'eq', 't2') | items2dict)}))}))}))})) | lme_verify_resolved(_lme_global_file.lme_config_registry, documents=_lme_rh_documents, admission=_lme_rh_admission)
{%- else -%}UNKNOWN-CHECK-{{ name }}
{%- endif -%}
{%- endmacro -%}
