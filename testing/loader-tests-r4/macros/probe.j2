{#- macros/probe.j2 -- renders an Ansible PROBE playbook (YAML) for one loader test case.
    This is a C1 macro-library exemplar: DATA (cases.yml) + MACRO (this file) -> GENERATED artifact
    (the probe playbook). No hand-authored Python. Runtime Jinja that Ansible must evaluate at PROBE
    run time is wrapped in {% raw %} so it survives THIS (render-time) pass.
    r2 (codex-1931 C1-PRIVATE-PROBE-DEFAULTS): this macro holds NO private sentinel/default values.
    The undefined-dump sentinel, the control task label, the msg_source protocol constants and the
    default probe host pattern arrive as the DECLARED `fixture` argument (fixture_config.yml ->
    probe_fixture). With the declared values equal to the retired literals, a legacy case (no
    inventory_hosts / probe_hosts) renders byte-identical to the v6.2 probe.
    r2 (REV-SIGNER-ADMISSION harness extension): optional case.probe_hosts sets the play's host
    pattern; optional case.inventory_hosts switches the probe to PER-HOST outputs
    (outcomes/<inventory_hostname>.yml, resolved/<inventory_hostname>/<var>.json) so several hosts in
    one play can never clobber a shared outcome/dump file. STATUS: UNEXECUTED. -#}
{%- macro probe(case, casedir, loader_entry, site_flag_playvars, fixture) -%}
{%- set per_host = case.inventory_hosts is defined -%}
{%- set probe_hosts = (case.probe_hosts | to_json) if case.probe_hosts is defined else fixture.probe_hosts_default -%}
{%- set dump_dir = casedir ~ ('/resolved/{{ inventory_hostname }}' if per_host else '/resolved') -%}
{%- set outcome_dest = casedir ~ ('/outcomes/{{ inventory_hostname }}.yml' if per_host else '/outcome.yml') -%}
---
# GENERATED by loader-tests/macros/probe.j2 from loader-tests/cases.yml
# provenance: source=cases.yml  case={{ case.name }}  kind={{ case.kind }}  generator=macros/probe.j2
# DO NOT EDIT -- re-render via run_loader_tests.yml. (no render timestamp: stable output)
- name: "loader-probe {{ case.name }}"
  hosts: {{ probe_hosts }}
  connection: local
  gather_facts: false
  become: false
  vars:
    clone_directory: "{{ casedir }}"
    lme_profile: "{{ case.initial_profile | default(case.profile) }}"
    # Flag play vars MIRRORED from site.yml's first play (derived mechanically by the
    # runner). Present ONLY while site.yml still declares a flag as a play var; empty
    # after the Option-B fix. A play var here shadows inventory/host_var and (before the
    # fix) is captured as an operator override -- exactly what absent-key-profile-wins
    # detects.
{% for k, v in site_flag_playvars.items() %}
    {{ k }}: {{ v | to_json }}
{% endfor %}
  tasks:
{% if per_host and (case.dump_vars | default([]) | length > 0) %}
    - name: "per-host resolved-dump dir"
      ansible.builtin.file:
        path: "{{ dump_dir }}"
        state: directory
{% endif %}
    - block:
        - name: "load (initial)"
          ansible.builtin.include_role:
            name: {{ loader_entry.role }}
            tasks_from: {{ loader_entry.tasks_from }}
{% if case.kind == 'service_removal' %}
        - name: "precondition: {{ case.service_key }} present after first load"
          ansible.builtin.assert:
            that: ["'{{ case.service_key }}' in lme_services"]
        - name: "remove manifest {{ case.remove_manifest }}"
          ansible.builtin.file:
            path: "{{ casedir }}/{{ case.remove_manifest }}"
            state: absent
        - name: "reload after removal"
          ansible.builtin.include_role:
            name: {{ loader_entry.role }}
            tasks_from: {{ loader_entry.tasks_from }}
{% endif %}
{% if case.kind == 'profile_switch' %}
        - name: "switch profile -> {{ case.switch_to }}"
          ansible.builtin.set_fact:
            lme_profile: "{{ case.switch_to }}"
        - name: "reload after switch"
          ansible.builtin.include_role:
            name: {{ loader_entry.role }}
            tasks_from: {{ loader_entry.tasks_from }}
{% endif %}
{% for v in case.dump_vars | default([]) %}
        - name: "dump resolved {{ v }} (canonical sorted JSON)"
          ansible.builtin.copy:
            content: {% raw %}"{{ {% endraw %}lookup('vars', '{{ v }}', default='{{ fixture.undefined_sentinel }}') | to_json(sort_keys=True) {% raw %}}}\n"{% endraw +%}
            dest: "{{ dump_dir }}/{{ v }}.json"
{% endfor %}
{% if case.assert_that is defined %}
        - name: "{{ case.invariant_task }}"
          ansible.builtin.assert:
            that:
{% for a in case.assert_that %}
              - "{{ a }}"
{% endfor %}
{% if case.fail_msg is defined %}
            fail_msg: "{{ case.fail_msg }}"
{% endif %}
{% endif %}
        - name: "record success outcome"
          ansible.builtin.set_fact:
            _outcome:
              passed: true
              task: "{{ case.invariant_task | default(fixture.control_task_label) }}"
              failed_task: ""
              msg: ""
      rescue:
        # v6.2: two steps. Step 1 can never fail (no failed-result templating), so a rescued failure is
        # ALWAYS recorded as not-passed with its failed task. Step 2 captures the cause; ansible-core 2.17
        # re-templates ansible_failed_result (whose traceback carries Jinja source) and can raise, in which
        # case msg stays '' and msg_source stays 'uncaptured' -- the judge then takes the cause from the
        # retained stdout and says so. It never infers a cause.
        - name: "record failure outcome"
          ansible.builtin.set_fact:
            _outcome:
              passed: false
              task: "{{ case.invariant_task | default(fixture.control_task_label) }}"
              failed_task: {% raw %}"{{ ansible_failed_task.name | default('') }}"{% endraw +%}
              msg: ""
              msg_source: {{ fixture.msg_source_uncaptured }}
        - name: "capture failure cause"
          ansible.builtin.set_fact:
            _outcome: {% raw %}"{{ _outcome | combine({'msg': ((ansible_failed_result.msg | default('')) | string), 'msg_source': '{% endraw %}{{ fixture.msg_source_captured }}{% raw %}'}) }}"{% endraw +%}
          ignore_errors: true
      always:
        # r3 RH-ACTUAL-EXECUTABLE-SELECTION: the NESTED run self-reports the core and interpreter it
        # ACTUALLY executed under (magic vars, not the runner's belief); one_case.yml refuses a mismatch.
        - name: "write outcome.yml"
          ansible.builtin.copy:
            content: {% raw %}"{{ (_outcome | default({})) | combine({'actual': {'ansible_core': ansible_version.full, 'playbook_python': ansible_playbook_python}}) | to_nice_yaml }}"{% endraw +%}
            dest: "{{ outcome_dest }}"
    # v6.2: a rescued failure must NOT exit 0 -- the return code is part of the verdict evidence.
    - name: "probe exit status reflects the outcome"
      ansible.builtin.fail:
        msg: "probe outcome: not passed (see outcome.yml)"
      when: {% raw %}not (_outcome.passed | default(false)){% endraw +%}
{%- endmacro -%}
{{ probe(case, casedir, loader_entry, site_flag_playvars, probe_fixture) }}
