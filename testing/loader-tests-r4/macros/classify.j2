{#- macros/classify.j2 -- parse framed diff renders and classify every differing path against DECLARED
    intended-diff prefixes (C1 loader-tests instrument, v6.2). Input template vars:
      renders  -- list of {case, var, text}; text is one macros/diff.j2 render, which MUST be framed by
                  "#DIFF-BEGIN <var>" (first line) and "#DIFF-END <var>" (last line), every other line
                  "<path>\t<ADDED|REMOVED|CHANGED|TYPE-CHANGED>" with <path> equal to <var> or under "<var>." / "<var>["
      intended -- list of {path, reason}
    A path is intended iff it EQUALS a declared prefix or lies strictly UNDER it ("<prefix>." for a
    mapping key, "<prefix>[" for a list index -- r2, the element-wise list diff emits "<path>[<i>]").
    r2 (codex-1931 C1-TYPED-NEUTRALITY): accepted statuses are ADDED, REMOVED, CHANGED, TYPE-CHANGED.
    STATUS: UNEXECUTED.
    Output JSON: {renders_parsed, malformed: [{case, var, why}], records: [{case, path, status,
    intended_by, reason}]}; intended_by is null for an unintended path. Line/tab parsing lives here (not
    in YAML-embedded Jinja) so escape handling is the template engine's, not the YAML scalar style's. -#}
{%- set out = [] -%}
{%- set bad = [] -%}
{%- set n = [] -%}
{%- for r in renders -%}
{%- set lines = (r.text | string).splitlines() -%}
{%- set _ = n.append(1) -%}
{%- if lines | length < 2 or lines[0] != '#DIFF-BEGIN ' ~ r.var or lines[-1] != '#DIFF-END ' ~ r.var -%}
{%- set _ = bad.append({'case': r.case, 'var': r.var, 'why': 'unframed', 'head': (r.text | string)[:200]}) -%}
{%- else -%}
{%- for line in lines[1:-1] -%}
{%- set f = line.split('\t') -%}
{%- if f | length != 2 or f[1] not in ['ADDED', 'REMOVED', 'CHANGED', 'TYPE-CHANGED']
      or not (f[0] == r.var or f[0].startswith(r.var ~ '.') or f[0].startswith(r.var ~ '[')) -%}
{%- set _ = bad.append({'case': r.case, 'var': r.var, 'why': 'malformed line', 'line': line}) -%}
{%- else -%}
{%- set hit = [] -%}
{%- for i in intended -%}
{%- if f[0] == i.path or f[0].startswith(i.path ~ '.') or f[0].startswith(i.path ~ '[') -%}{%- set _ = hit.append(i) -%}{%- endif -%}
{%- endfor -%}
{%- set _ = out.append({'case': r.case, 'path': f[0], 'status': f[1],
                        'intended_by': (hit[0].path if hit else none),
                        'reason': (hit[0].reason if hit else none)}) -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{{ {'renders_parsed': n | length, 'malformed': bad, 'records': out} | to_json }}
