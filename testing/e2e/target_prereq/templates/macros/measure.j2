{#- testing/e2e/target_prereq/templates/macros/measure.j2 -- GENUINE, PARAMETERIZED Jinja macros of the R5
    MEASUREMENT-ONLY operation (tasks/measure_target_tools.yml; codex-tick394 R5-NEW-RECORD-VALUE-SOURCING, r5d
    codex-tick396 item 2). AUTHORED, NEVER RENDERED; inert until C1 registers rh.controller.bootstrap.target_prereq.
    observe.measure (B r5d C1 hunks). Rendered ONLY through the dispatcher at ms.call_rel, which imports this file by
    the declared ms.import_rel; the caller selects a macro by a declared ms.macros value and reads ONE JSON value back.
      ms   = the resolved tp.observe.measure declaration -- the ONLY source of every emitted key (record.fields), every
             emitted unset / initial / completion value (record.unset, record.initial, record.completion), every type
             word (record.types), contact state (record.contact_states), finding class (record.findings), cleared role
             (record.cleared_on_failure) and every text (texts).
      sep  = the resolved tp.reuse.path_separator (R1's declaration, the SINGLE owner of the separator; codex-tick405 Q2)
      tp   = the resolved rh.controller.bootstrap.target_prereq
      rh   = this host's resolved policy (os_tools, inventory.role_groups, guest, target_bootstrap.initial_contact)
      ctl  = tp_ctl (operation, hypervisor)
    READ-ONLY API names (not emitted values): the ansible.builtin.stat return keys (exists, islnk, isdir, isreg,
    lnk_source, lnk_target, checksum, uid, gid, mode, size, pw_name, gr_name), the loop / register keys (item, key,
    value, stat, results) and ansible_failed_result.msg. Language construction (not data): namespace accumulators,
    slices / indices, tests and filters.
    CUSTODY LIMIT (ms.texts.custody, recorded in every record): the evidence is the declared leaf, the final resolved
    file and the ancestors of those two endpoints -- NOT each intermediate symlink hop. Every candidate stays untrusted. -#}

{#- ---- one stat result's declared type word ---- -#}
{%- macro type_word(ms, s) -%}
{%- set T = ms.record.types -%}
{{ T.link if s.islnk else (T.dir if s.isdir else (T.file if s.isreg else T.other)) }}
{%- endmacro -%}

{#- ---- start(ms, ctl, target, label, rs): the contact-free record -- every declared initial role at its declared
     initial value, the contact not admitted, not complete, then the identity of this run (rs = lme_resolved.remote_harness) ---- -#}
{%- macro start(ms, ctl, target, label, rs) -%}
{%- set F = ms.record.fields -%}
{%- set ns = namespace(r={}) -%}
{%- for k in ms.record.top if k in ms.record.initial -%}{%- set ns.r = ns.r | combine({F[k]: ms.record.initial[k]}) -%}{%- endfor -%}
{{ ns.r | combine({F.schema: ms.record_schema, F.operation: ctl.operation, F.target: target, F.label: label,
                   F.scope: {F.scope_id: rs.scope.id, F.scope_sha256: rs.scope_sha256},
                   F.hypervisor: ctl.hypervisor | bool, F.contact: ms.record.contact_states.not_admitted,
                   F.complete: ms.record.completion.stopped,
                   F.custody: ms.texts.custody, F.claim: ms.texts.claim, F.adoption: ms.texts.adoption}) | to_json }}
{%- endmacro -%}

{#- ---- selection(ms, tp, rh, ctl): the SAME label closure as the selected operation (target_prereq.yml's tool hash):
     observation.required_by, plus observation.hypervisor_required_by ONLY when the selected QEMU work is declared on
     this host (hypervisors role-group member AND a resolved rh.guest.allocation mapping). A multi-label tool records
     only the labels that selected it; a non-hypervisor never selects a guest-only tool. The os_tools entry keys are
     read through the same record.fields roles C1 pins to them (path, required_by, identity). ---- -#}
{%- macro selection(ms, tp, rh, ctl) -%}
{%- set F = ms.record.fields -%}
{%- set ot = rh.controller.bootstrap.os_tools -%}
{%- set ga = rh.guest is defined and rh.guest.allocation is defined and rh.guest.allocation is mapping -%}
{%- set gs = (ctl.hypervisor | bool) and ga -%}
{%- set lb = (tp.observation.required_by + tp.observation.hypervisor_required_by) if gs else tp.observation.required_by -%}
{%- set ns = namespace(m={}) -%}
{%- for t in ot | list | sort -%}
{%- set by = ot[t][F.required_by] | intersect(lb) | list -%}
{%- if by | length > 0 -%}
{%- set ns.m = ns.m | combine({t: {F.path: ot[t][F.path], F.required_by: by, F.identity: ot[t][F.identity]}}) -%}
{%- endif -%}
{%- endfor -%}
{{ {F.labels: lb, F.tools: ns.m,
    F.closure: {F.member_labels: tp.observation.required_by, F.guest_labels: tp.observation.hypervisor_required_by,
                F.guest_selected: gs,
                F.basis: {F.hypervisor_member: ctl.hypervisor | bool,
                          F.role_group: rh.controller.bootstrap.inventory.role_groups.hypervisors,
                          F.guest_allocation_declared: ga}}} | to_json }}
{%- endmacro -%}

{#- ---- expectation(ms, tp, sel): the declared selection and the acceptance expectation (before activation) ---- -#}
{%- macro expectation(ms, tp, sel) -%}
{%- set F = ms.record.fields -%}
{{ {F.declared: {F.labels: sel[F.labels], F.closure: sel[F.closure], F.tools: sel[F.tools],
                 F.identity_kind: tp.observation.identity_kind, F.override_path: tp.observation.override_path,
                 F.checksum_algorithm: ms.checksum_algorithm},
    F.expectation: {F.contact: ms.record.contact_states.admitted, F.measured: sel[F.tools] | list | sort,
                    F.required: [tp.preservation.probe.tool, tp.linger.tool] | unique | list,
                    F.text: ms.texts.expectation}} | to_json }}
{%- endmacro -%}

{#- ---- admitted(ms, uid, user, py, module_tmp, tools): the admitted privileged initial contact (route outputs) ---- -#}
{%- macro admitted(ms, uid, user, py, module_tmp, tools) -%}
{%- set F = ms.record.fields -%}
{{ {F.contact: ms.record.contact_states.admitted,
    F.principal: {F.uid: uid, F.user: user, F.python: py, F.module_tmp: module_tmp},
    F.contact_tools: tools} | to_json }}
{%- endmacro -%}

{#- ---- ancestors(ms, sep, lst): every ancestor of every declared path and of every final link source, joined with the
     declared separator sep = tp.reuse.path_separator (the CUSTODY LIMIT: endpoint ancestors only, not intermediate
     hops); each path once ---- -#}
{%- macro ancestors(ms, sep, lst) -%}
{%- set ns = namespace(p=[]) -%}
{%- for r in lst -%}
{%- for full in [r.item.value[ms.record.fields.path]] + ([r.stat.lnk_source] if (r.stat.exists and r.stat.islnk and r.stat.lnk_source is defined) else []) -%}
{%- set parts = full.split(sep) -%}
{%- for i in range(parts | length) if i > 0 -%}
{%- set a = sep ~ (parts[1:i] | join(sep)) -%}
{%- if a not in ns.p -%}{%- set ns.p = ns.p + [a] -%}{%- endif -%}
{%- endfor -%}{%- endfor -%}{%- endfor -%}
{{ ns.p | to_json }}
{%- endmacro -%}

{#- ---- compose(ms, tp, rh, sel, lst, res, chain): the measurement, the comparison, the findings, the
     required-evidence completeness and the CANDIDATE override (never applied). A stat that succeeded WITHOUT a checksum
     is the finding checksum_missing (sha256 = record.unset, digest_present false, never a match, never a candidate) --
     not a module exception. complete = record.completion.done (ms.texts.complete); evidence = whether the required
     tools carry a usable digest (ms.texts.evidence). Neither proves trust, complete custody, readiness or adoption. ---- -#}
{%- macro compose(ms, tp, rh, sel, lst, res, chain) -%}
{%- set F = ms.record.fields -%}
{%- set C = ms.record.findings -%}
{%- set U = ms.record.unset -%}
{%- set ik = tp.observation.identity_kind -%}
{%- set ict = rh.controller.bootstrap.target_bootstrap.initial_contact.privileged.tools -%}
{%- set ch = namespace(m={}) -%}
{%- for r in chain -%}{%- set s = r.stat -%}
{%- set ch.m = ch.m | combine({r.item: {F.exists: s.exists,
      F.type: (type_word(ms, s) | string) if s.exists else U,
      F.uid: s.uid if s.exists else U, F.gid: s.gid if s.exists else U, F.mode: s.mode if s.exists else U}}) -%}
{%- endfor -%}
{%- set out = namespace(m={}, cand={}, src={}, dig=[], cls=[], f={}) -%}
{%- for r in lst -%}
{%- set t = r.item.key -%}{%- set d = r.item.value -%}{%- set s = r.stat -%}
{%- set rr = res | selectattr('item.item.key', 'equalto', t) | list -%}
{%- set rs = (rr | first).stat if rr | length > 0 else U -%}
{%- set resolved = ((s.lnk_source if s.islnk else d[F.path]) if s.exists else U) -%}
{%- set regular = (rs != U and rs.exists and rs.isreg) -%}
{%- set dig = rs.checksum if (regular and rs.checksum is defined) else U -%}
{%- set dmeas = (d[F.identity][F.kind] == ik) -%}
{%- set match = (dmeas and dig != U and dig == d[F.identity][F.sha256]) -%}
{%- set out.m = out.m | combine({t: {
      F.declared_path: d[F.path], F.required_by: d[F.required_by],
      F.executed_by_contact: t in ict,
      F.declared_identity: d[F.identity], F.declared_measured: dmeas,
      F.exists: s.exists,
      F.lstat: U if not s.exists else {
          F.type: type_word(ms, s) | string, F.uid: s.uid, F.gid: s.gid,
          F.owner: s.pw_name if s.pw_name is defined else U, F.group: s.gr_name if s.gr_name is defined else U,
          F.mode: s.mode, F.link_target: s.lnk_target if s.islnk and s.lnk_target is defined else U},
      F.resolved: resolved,
      F.resolved_stat: U if rs == U else {
          F.exists: rs.exists, F.regular: regular, F.uid: rs.uid if rs.exists else U, F.gid: rs.gid if rs.exists else U,
          F.mode: rs.mode if rs.exists else U, F.size: rs.size if rs.exists else U},
      F.sha256: dig, F.digest_present: dig != U,
      F.matches_declared: match}}) -%}
{%- set cls = C.absent if not s.exists else (C.not_regular if not regular else (C.checksum_missing if dig == U
              else (C.declared_unmeasured if not dmeas else (C.differs if not match else U)))) -%}
{%- set out.cls = out.cls + [{F.tools: t, F.findings: cls}] -%}
{%- if dig != U -%}{%- set out.dig = out.dig + [t] -%}{%- endif -%}
{%- if dig != U and not match -%}
{%- set out.cand = out.cand | combine({t: {F.identity: {F.kind: ik, F.sha256: dig}}}) -%}
{%- set out.src = out.src | combine({t: d[F.required_by]}) -%}
{%- endif -%}
{%- endfor -%}
{%- set c = namespace(v=out.cand) -%}
{%- for k in tp.observation.override_path | reverse -%}{%- set c.v = {k: c.v} -%}{%- endfor -%}
{%- set selected = sel[F.tools] | list | sort -%}
{%- set required = [tp.preservation.probe.tool, tp.linger.tool] | unique | list -%}
{%- set missing = selected | difference(out.dig) | list -%}
{#- every declared finding class -> the tools classified into it (a filter result; no literal empty value) -#}
{%- for k in C -%}
{%- set out.f = out.f | combine({C[k]: out.cls | selectattr(F.findings, 'equalto', C[k]) | map(attribute=F.tools) | list}) -%}
{%- endfor -%}
{{ {F.measured: out.m, F.chain: ch.m, F.absent: out.f[C.absent],
    F.candidate_override: (c.v if out.cand | length > 0 else U),
    F.candidate_sources: (out.src if out.cand | length > 0 else U),
    F.findings: out.f,
    F.evidence: {F.required: required, F.selected: selected, F.digested: out.dig | sort,
                 F.missing_required: required | intersect(missing) | list, F.missing_selected: missing,
                 F.required_complete: (required | intersect(missing) | list | length) == 0,
                 F.text: ms.texts.evidence},
    F.complete: ms.record.completion.done} | to_json }}
{%- endmacro -%}

{#- ---- failed(ms, rec, task, result): the rescue patch -- every ms.record.cleared_on_failure role back to its
     declared initial value, not complete; a contact that was not admitted is a REFUSAL (refusals; measurement does not
     establish its own initial trust), otherwise the stop is an ERROR. No candidate survives either. The stop is a
     STRUCTURED entry {refusal, task, detail} (detail = ansible_failed_result.msg when the module gave one, else the
     whole result as JSON), truncated to ms.error_max. ---- -#}
{%- macro failed(ms, rec, task, result) -%}
{%- set F = ms.record.fields -%}
{%- set ns = namespace(r={F.complete: ms.record.completion.stopped}) -%}
{%- for k in ms.record.cleared_on_failure -%}{%- set ns.r = ns.r | combine({F[k]: ms.record.initial[k]}) -%}{%- endfor -%}
{%- set detail = (result.msg if (result is mapping and result.msg is defined) else (result | to_json)) | string -%}
{%- set why = {F.refusal: ms.refusal, F.task: task, F.detail: detail[:(ms.error_max | int)]} -%}
{{ ns.r | combine({F.refusals: rec[F.refusals] + [why]} if rec[F.contact] != ms.record.contact_states.admitted
                  else {F.error: why}) | to_json }}
{%- endmacro -%}
