{#-
  testing/e2e/target_prereq/templates/owner_key_location.j2 -- the ONE J-KEY location rule (codex-tick350
  GRAPH-BINDING-TEMPLATE-TOPOLOGY: the producer contract, not re-encoded by any consumer). Rendered by
  ansible.builtin.template LOOKUP (value-pure; reads no file, no key, no inventory) from:
    - the producer: testing/e2e/target_prereq/tasks/bind_controller.yml (jk_ctl), and
    - the run binding: ansible/inventory/macros/run_binding.j2 (owner_key / owner_pubkey role values),
  so the binding's declared owner key paths and the producer's JKEY-LOCATION check use the same rule.
  Template vars (all required; no default):
    ok_bs          the resolved controller.bootstrap map (rh.controller.bootstrap: work_roots + owner_key)
    ok_repo_root   the controller checkout (rh_repo_root; work_roots.anchor repository_checkout)
    ok_deployment  the deployment identity (lme_resolved | lme_validated_deployment_identity)
    ok_target      the target inventory alias (a path component only, never a decision)
    ok_owner       the target's bound owner account
  Output: one JSON object {work_root, chain, keydir, key, pub, next, next_pub, record}.
-#}
{%- set s = ok_bs.owner_key.storage -%}
{%- set w = (ok_repo_root | mandatory) ~ '/' ~ ok_bs.work_roots.root_rel -%}
{%- set base = w ~ '/' ~ ok_bs.work_roots.sub_roots[s.sub_root] -%}
{%- set l1 = base ~ '/' ~ s.keys_rel -%}
{%- set l2 = l1 ~ '/' ~ (ok_deployment | mandatory) -%}
{%- set l3 = l2 ~ '/' ~ (ok_target | mandatory) -%}
{%- set kd = l3 ~ '/' ~ (ok_owner | mandatory) -%}
{%- set ps = s.pub_suffix | mandatory -%}
{{ {'work_root': w, 'chain': [base, l1, l2, l3, kd], 'keydir': kd,
    'key': kd ~ '/' ~ s.key_name, 'pub': kd ~ '/' ~ s.key_name ~ ps,
    'next': kd ~ '/' ~ s.key_name ~ s.next_suffix, 'next_pub': kd ~ '/' ~ s.key_name ~ s.next_suffix ~ ps,
    'record': kd ~ '/' ~ s.record_name} | to_json }}
