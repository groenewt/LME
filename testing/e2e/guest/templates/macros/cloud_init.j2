{#- testing/e2e/guest/templates/macros/cloud_init.j2 -- reusable NoCloud cloud-config macros (GUEST-CLOUDINIT-DECLARATION).
    Every value comes from the RESOLVED guest declaration rh.guest.cloud_init (C1-owned leaves, PROPOSED) or from this
    run's observations; no policy literal lives here. Each macro emits one top-level cloud-config key as YAML whose
    scalars are JSON-escaped (to_json), so no declared or observed value can inject YAML structure.
    Import: {% import 'macros/cloud_init.j2' as ci %} (resolved relative to the including template's directory). -#}

{#- users: the privileged account's login policy + its PUBLIC authorized keys (keys admitted by admit.yml) -#}
{%- macro users(account, keys) -%}
disable_root: {{ account.disable_root | bool | to_json }}
users:
  - name: {{ account.name | to_json }}
    lock_passwd: {{ account.lock_passwd | bool | to_json }}
    ssh_authorized_keys: {{ keys | to_json }}
{% endmacro -%}

{#- ssh: password authentication and host key regeneration policy -#}
{%- macro ssh(policy) -%}
ssh_pwauth: {{ policy.pwauth | bool | to_json }}
ssh_deletekeys: {{ policy.deletekeys | bool | to_json }}
ssh_genkeytypes: {{ policy.genkeytypes | to_json }}
{% endmacro -%}

{#- the data filesystem on the virtio disk addressed by its serial (never by enumeration order) -#}
{%- macro data_filesystem(fs, device) -%}
fs_setup:
  - label: {{ fs.label | to_json }}
    filesystem: {{ fs.filesystem | to_json }}
    device: {{ device | to_json }}
    partition: {{ fs.partition | to_json }}
    overwrite: {{ fs.overwrite | bool | to_json }}
mounts:
  - {{ [('LABEL=' ~ fs.label), fs.mount, fs.filesystem, fs.mount_options, fs.dump | string, fs.pass | string] | to_json }}
{% endmacro -%}

{#- first-boot identity readback: the declared identity source must equal this generation's uuid; otherwise the
    declared marker goes to the declared console and the declared action runs (fail closed). Every operand is quoted. -#}
{%- macro identity_check(check, expected) -%}
runcmd:
  - {{ [check.shell, '-c',
        'test "$(cat ' ~ (check.source | quote) ~ ')" = ' ~ (expected | quote)
        ~ ' || { echo ' ~ (check.marker | quote) ~ ' >' ~ (check.console | quote) ~ '; ' ~ (check.on_mismatch | map('quote') | join(' ')) ~ '; }'] | to_json }}
{% endmacro -%}
