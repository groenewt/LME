{#- testing/e2e/guest/templates/qemu-argv.json.j2 -- the COMPLETE argv of the guest process (a JSON list; tasks/provision.yml
    passes it to systemd-run --user after `--`, never through a shell). Inputs: gd, gg, gp, gt, g_uuid.
    user-mode networking only: one hostfwd bound to the declared loopback address; no bridge, tap, libvirt or root. -#}
{%- set q = gd.qemu -%}
{{ [gt.qemu_system,
    '-name', 'lme-guest-' ~ gg.run_id ~ ',process=lme-guest-' ~ gg.run_id,
    '-uuid', g_uuid,
    '-accel', q.accel,
    '-machine', q.machine,
    '-cpu', q.cpu,
    '-smp', gg.vcpus | string,
    '-m', (gg.memory_mib | string) ~ 'M',
    '-display', q.display,
    '-nodefaults',
    '-serial', 'file:' ~ gp.files.console,
    '-qmp', 'unix:' ~ gp.files.qmp ~ ',server=on,wait=off',
    '-drive', 'if=none,id=os,format=qcow2,file=' ~ gp.files.os_disk,
    '-device', q.disk_device ~ ',drive=os,serial=' ~ q.os_serial_prefix ~ g_uuid[:8] ~ ',bootindex=0',
    '-drive', 'if=none,id=data,format=qcow2,file=' ~ gp.files.data_disk,
    '-device', q.disk_device ~ ',drive=data,serial=' ~ q.data_serial_prefix ~ g_uuid[:8],
    '-drive', 'if=none,id=seed,format=raw,readonly=on,file=' ~ gp.files.seed,
    '-device', q.disk_device ~ ',drive=seed',
    '-netdev', q.net.mode ~ ',id=net0,hostfwd=tcp:' ~ q.net.bind ~ ':' ~ (gg.forward_port | string) ~ '-:' ~ (q.net.guest_port | string),
    '-device', q.net.device ~ ',netdev=net0'] | to_json }}
