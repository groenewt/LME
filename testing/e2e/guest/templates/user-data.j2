#cloud-config
{# testing/e2e/guest/templates/user-data.j2 -- NoCloud user-data of ONE guest generation (tasks/provision.yml).
    Inputs: gd (= rh.guest; cloud_init policy = gd.cloud_init, C1-owned leaves, PROPOSED), gg (= rh.guest.allocation),
    g_uuid. Rendered ONLY through the reusable macros (macros/cloud_init.j2); this file holds no policy literal.
    PUBLIC keys only (g_authorized_keys: the lines of the controller-side file gg.privileged_authorized_keys_file,
    admitted by admit.yml as PUBLIC ed25519 / ecdsa lines; C1 contract guest_allocation keeps key material out of
    policy); no password, no secret material. The privileged account's key/privilege model is a C (security) review
    item. #}
{% import 'macros/cloud_init.j2' as ci %}
hostname: {{ gg.name | to_json }}
fqdn: {{ gg.name | to_json }}
preserve_hostname: false
{{ ci.users(gd.cloud_init.privileged_account, g_authorized_keys) }}
{{ ci.ssh(gd.cloud_init.ssh) }}
{{ ci.data_filesystem(gd.cloud_init.data_fs, gd.cloud_init.data_fs.device_prefix ~ gd.qemu.data_serial_prefix ~ g_uuid[:8]) }}
{{ ci.identity_check(gd.cloud_init.identity_check, g_uuid) }}
