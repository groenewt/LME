#!/bin/sh
# TEST DOUBLE (gate cases only). It is rendered by controls/run_one_case.yml from controls/fake_ssh.j2, and it is
# argv[0] of the ssh argv that the fake seed records, so /usr/bin/ssh is never reached. It logs every call.
# `cat /etc/machine-id` answers the case's declared endpoint identity. Anything else succeeds silently.
printf '%s\n' "$*" >> {{ cd }}/ssh.calls
case "$*" in
  *' cat /etc/machine-id') printf '%s\n' {{ case.gate.endpoint_identity | quote }};;
esac
exit 0
