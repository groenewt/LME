#!/bin/bash
# TEST DOUBLE of the route's executor entrypoint (<bundle>/lme-controller-seed.sh run), for the GATE cases only.
# It tests deploy_gate's consumption of the executor: exact argv, the rc, and the declared outputs. It is NOT a
# receipt check; the real seed and receipt verification are the integration cases, applied by MAIN.
# It logs its argv (one line, %q-quoted words) and then acts per the case's declared mode for the named playbook:
#   contract: ok | refuse     transfer: ok | rc0_no_receipt | refuse
printf '%q ' "$@" >> {{ cd }}/seed.calls; printf '\n' >> {{ cd }}/seed.calls
label=""; pb=""
for a in "$@"; do
  case "$a" in
    lme_transfer_label=*) label="${a#lme_transfer_label=}";;
    */resolve_target.yml|*/transfer.yml) pb="${a##*/}";;
  esac
done
out="$LME_TRANSFER_STATE_DIR/{{ T.outputs.prefix }}$label"
case "$pb:{{ case.gate.contract | default('ok') }}:{{ case.gate.transfer | default('ok') }}" in
  resolve_target.yml:ok:*)
    printf '%s\n' {{ cd }}/fake_ssh root@{{ case.gate.host }} > "$out{{ T.outputs.ssh_argv }}"
    printf '%s\n' {{ case.gate.contract_identity | quote }} > "$out{{ T.outputs.machine_id }}"
    exit 0;;
  resolve_target.yml:refuse:*) echo "TRANSFER-CONTRACT-CONFLICT (fake)"; exit 2;;
  transfer.yml:*:ok) printf '{"schema":"fake"}\n' > "$out{{ T.outputs.transfer_receipt }}"; exit 0;;
  transfer.yml:*:rc0_no_receipt) exit 0;;
  transfer.yml:*:refuse) echo "TRANSFER-TARGET-DEPENDENCY (fake)"; exit 2;;
esac
echo "fake seed: unexpected playbook $pb"; exit 99
