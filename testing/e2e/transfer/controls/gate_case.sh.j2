#!/bin/bash
# GATE case scenario, rendered by controls/run_one_case.yml from controls/gate_case.sh.j2. It sources the real
# deploy_gate.sh and runs the declared calls, in order, against route's launcher (rendered into <cd>/bundle from the
# resolved declaration), the fake seed beside it and the fake ssh. Each call's rc is printed as `CALL <fn> rc=<n>`,
# and after each call the loaded SSH argv is printed as `SSHARGV <words>`. case.gate.launcher (optional) replaces the
# launcher input value verbatim (e.g. a relative or bare name, which the gate must refuse).
set -u
cd {{ cd | quote }}
source {{ repo_root | quote }}/testing/e2e/deploy_gate.sh
export LME_CONTROLLER_LAUNCHER={{ case.gate.launcher | default(cd ~ '/bundle/' ~ _wrp.bootstrap.bundle.launcher_file) | quote }}
export LME_CONTROLLER_ROOT={{ cd | quote }}/ctlroot
export LME_TRANSFER_INVENTORY={{ cd | quote }}/inventory.json LME_TRANSFER_STATE_DIR={{ cd | quote }}/state
export LME_SSH_AUTH_MODE={{ case.gate.auth_mode | default('explicit_key') | quote }}
{% for k in case.gate.unset | default([]) %}
unset {{ k }}
{% endfor %}
HOST={{ case.gate.host | quote }}; LABEL={{ case.gate.label | quote }}; REMOTE_DIR={{ case.gate.remote_dir | quote }}
SSH_KEY={{ case.gate.ssh_key | default('') | quote }}; SRC={{ repo_root | quote }}
LOG={{ cd | quote }}/gate.log; RESULTS={{ cd | quote }}/gate.results.jsonl
{% if case.gate.hostile is defined %}
# C27 HOSTILE AMBIENT ENVIRONMENT (argv/environment-construction proof only): shadow copies of the named tools lead
# PATH (each records SHADOWED-<tool> and exits 97 -- the launcher must use only its absolute declared tools), and the
# declared ambient names are set to foreign values (the launcher must pass none of them, except the carried socket in
# a carried-agent mode). The real seed apply on the final bundle proves compatibility separately.
mkdir -p {{ (cd ~ '/shadow') | quote }}
{% for t in case.gate.hostile.shadow_tools | default([]) %}
printf '#!/bin/sh\necho SHADOWED-%s >> %s\nexit 97\n' {{ t | quote }} {{ (cd ~ '/shadow.calls') | quote }} > {{ (cd ~ '/shadow/' ~ t) | quote }}
chmod 0755 {{ (cd ~ '/shadow/' ~ t) | quote }}
{% endfor %}
export PATH={{ (cd ~ '/shadow') | quote }}:"$PATH"
{% for k, v in case.gate.hostile.env | default({}) | dictsort %}
export {{ k }}={{ v | quote }}
{% endfor %}
{% endif %}
{% for c in case.gate.calls %}
{{ c }}; echo "CALL {{ c }} rc=$?"; echo "SSHARGV ${SSH[*]:-}"
{% endfor %}
