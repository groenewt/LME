{#- testing/e2e/transfer/templates/macros/entry_construct.j2 -- the PURE entry constructor (B-r1 s8, s9; codex-tick430-434
    R1S6-CONSTRUCTOR-CLOSURE; codex-tick435-436 grammar_decision / separator_decision; codex-tick446 RV-5 shared grammar).
    A non-entry template of the entry-generation closure [templates/entry.yml.j2, templates/macros/entry_construct.j2,
    + the shared refusal macro module (C1 r4c testing/remote_harness/templates/macros/refusal.j2) by C1-S9-SHARED-MACRO-REACH];
    it is also imported by the verifier library templates/macros/transfer.j2 (check.yml), which keeps every filesystem read
    and calls only the macros here that frame nothing (form_law, dir_forms, target_vars, remote_hosts, bare_that).
    CLOSURE LAW (the existing loader proof, lme_manifests.py _rh_prove_artifact_templates): no free name (every value is a
    macro parameter; the only globals are Jinja's namespace and dict), no import or include, no lookup, Jinja builtin
    filters only (dictsort, first, format, int, join, last, length, list, map, reject, select, sort, tojson, trim,
    unique; s9: no `default`), Jinja builtin tests plus `match` -- an ANSIBLE test plugin, not a Jinja builtin, which the
    loader already admits as its one declared known test capability (_RH_KNOWN_TESTS) in direct and named dispatch --
    and literal test names in reject / select. Results are returned through a caller-owned namespace (first parameter
    `out`); no JSON round trip, no mutation method. Every name is assigned in the enclosing frame before any branch that
    assigns it (no branch-local binding).
    INPUTS (parameters only): tr = the parsed declaration (top key transfer); G = the ONE admitted refusal grammar
    (controller.bootstrap.refusal_grammar), delivered by the construction context (lme_entry_context.refusal_grammar) --
    never copied into tr; rf = the shared refusal macro MODULE, imported by the caller WITHOUT context from the grammar's
    own macros_rel; a refusal is rf[G.macro](G, code, [detail]) -- the ONE composition (marker, code separator, code,
    delimiter, detail separator, detail list joined) lives there and is NOT restated here (codex-tick446 RV-5); sep = the
    core path separator (controller.bootstrap.path_admission.separator; lme_entry_context.path_separator). A cause is a
    pair [code, detail] (code = entry_forms.codes.<k>, detail = the detail-only texts.<k> format); a cause list travels as
    data (JSON pairs) inside a framed refusal's detail. Emitted keys come from entry_forms.emit.keys / emit.tasks_key /
    entry_guard.task_keys / construct.* (declared). -#}

{#- runtime expression wrap: the declared delimiters around an expression kept as runtime text -#}
{%- macro rt(F, e) -%}
{{ F.expr.open ~ e ~ F.expr.close }}
{%- endmacro -%}

{#- the declared bare-name refusal `that` text (F.bare.that_format over F.bare.pinned_expr) -#}
{%- macro bare_that(F) -%}
{{ F.bare.that_format | format(pinned=F.bare.pinned_expr) }}
{%- endmacro -%}

{#- entry_include(out, F, sep, dir_rel, up, target): the magic-rooted include form of `target` from `dir_rel` at `up`
    levels (expr.open, magic, up x path.up_filter, expr.close, sep, the target part below the reached directory).
    out.ok false when dropping `up` segments of dir_rel leaves no proper prefix of target; out.include none then. -#}
{%- macro entry_include(out, F, sep, dir_rel, up, target) -%}
{%- set ds = dir_rel.split(sep) -%}
{%- set tg = target.split(sep) -%}
{%- set u = up | int -%}
{%- set base = ds[:(ds | length) - u] if (u >= 0 and u <= (ds | length)) else none -%}
{%- set out.ok = not (base is none or tg[:base | length] != base or (tg | length) <= (base | length)) -%}
{%- set out.include = (F.expr.open ~ F.magic ~ (F.path.up_filter * u) ~ F.expr.close ~ sep ~ (tg[base | length:] | join(sep))) if out.ok else none -%}
{%- endmacro -%}

{#- remote_hosts(out, tr): out.v = {label: rendered hosts expression} of the declared remote placements; an absent or
    malformed declaration yields {} (form_law records its cause; nothing here formats an absent value) -#}
{%- macro remote_hosts(out, tr) -%}
{%- set F = tr.entry_forms -%}
{%- set ns = namespace(p=[]) -%}
{%- if F.placement is mapping and F.placement.remote is defined and F.placement.remote is mapping -%}
{%- for label, e in F.placement.remote | dictsort if e is string -%}{%- set ns.p = ns.p + [[label, rt(F, e | format(host=tr.controller_scope.delegate_to))]] -%}{%- endfor -%}
{%- endif -%}
{%- set out.v = dict(ns.p) -%}
{%- endmacro -%}

{#- form_law(out, tr, sep): out.v = the declaration-level cause pairs, checked once before any construction; non-empty
    WITHHOLDS every dependent construction (R1-S5-INVALID-ROLE-RESULT). R1S6-MISSING-REMOTE-DIAGNOSTIC: the presence of
    entry_forms.placement.remote is staged BEFORE any read or format of it; an absent node reports the declared
    diagnostic argument entry_forms.diagnostic.absent. -#}
{%- macro form_law(out, tr, sep) -%}
{%- set F = tr.entry_forms -%}
{%- set R = F.roles -%}
{%- set T = F.texts -%}
{%- set C = F.codes -%}
{%- set ns = namespace(w=[]) -%}
{%- if (R.values() | list | sort) != (tr.entry_guard.task_keys.keys() | list | sort) -%}
{%- set ns.w = ns.w + [[C.roles_vocabulary, T.roles_vocabulary | format(roles=(R.values() | list | sort | tojson), task_keys=(tr.entry_guard.task_keys.keys() | list | sort | tojson))]] -%}
{%- endif -%}
{%- set reserved = [F.placement.controller, F.placement.target, F.placement.undeclared, tr.controller_scope.delegate_to] | tojson -%}
{%- set has_remote = F.placement.remote is defined -%}
{%- if not has_remote -%}
{%- set ns.w = ns.w + [[C.placement_remote, T.placement_remote | format(label=F.diagnostic.absent, reserved=reserved)]] -%}
{%- elif F.placement.remote is not mapping -%}
{%- set ns.w = ns.w + [[C.placement_remote, T.placement_remote | format(label=(F.placement.remote | tojson), reserved=reserved)]] -%}
{%- else -%}
{%- for label, e in F.placement.remote | dictsort if label in [F.placement.controller, F.placement.target, F.placement.undeclared, tr.controller_scope.delegate_to] or e is not string -%}
{%- set ns.w = ns.w + [[C.placement_remote, T.placement_remote | format(label=label, reserved=reserved)]] -%}
{%- endfor -%}
{%- endif -%}
{%- set cls = [F.placement.controller, F.placement.target] | sort -%}
{%- for role in F.construct.roles -%}
{%- set H = F.construct.head_tasks[role] if (F.construct.head_tasks is mapping and role in F.construct.head_tasks) else none -%}
{%- if role not in tr.entry_guard.task_keys or H is not mapping or H.name is not mapping
       or (H.name.keys() | list | sort) != cls
       or (role == R.bare and (H.fail_msg is not mapping or (H.fail_msg.keys() | list | sort) != cls or H.code is not string)) -%}
{%- set ns.w = ns.w + [[C.construct_role, T.construct_role | format(role=role, classes=(cls | tojson))]] -%}
{%- endif -%}
{%- endfor -%}
{%- for sdir, sfiles in tr.entry_sets | dictsort -%}
{%- for sname, sent in sfiles | dictsort -%}
{%- set sid = sdir ~ sep ~ sname -%}
{%- if sent.output not in F.outputs.values() | list -%}
{%- set ns.w = ns.w + [[C.output_kind, T.output_kind | format(entry=sid, output=sent.output, kinds=(F.outputs.values() | list | tojson))]] -%}
{%- elif sent.output == F.outputs.generated -%}
{%- for role in sent.head if role not in F.construct.roles -%}
{%- set ns.w = ns.w + [[C.role_not_constructed, T.role_not_constructed | format(entry=sid, role=role, roles=(F.construct.roles | tojson))]] -%}
{%- endfor -%}
{%- for d in sent.plays if d.body is not defined or d.body is not string -%}
{%- set ns.w = ns.w + [[C.body_undeclared, T.body_undeclared | format(entry=sid, play=d.id)]] -%}
{%- endfor -%}
{%- for d in sent.plays if d.body_sha256 is not defined or d.body_sha256 is not string or d.body_sha256 is not match(F.digest.pattern) -%}
{%- set ns.w = ns.w + [[C.body_digest_undeclared, T.body_digest_undeclared | format(entry=sid, play=d.id)]] -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- set out.v = ns.w -%}
{%- endmacro -%}

{#- dir_forms(out, tr, sep, tr_rel, dir_rel, head): the rendered guard / family include forms of ONE entry directory
    and its head law. out.violations (cause pairs), out.valid, out.guard, out.family, out.head. A directory without a
    declared form, a form that does not reach its target, a directory deeper than the route guard discovery
    (entry_forms.discovery.max_up) and a malformed head refuse; callers withhold every dependent evaluation. -#}
{%- macro dir_forms(out, tr, sep, tr_rel, dir_rel, head) -%}
{%- set F = tr.entry_forms -%}
{%- set R = F.roles -%}
{%- set T = F.texts -%}
{%- set C = F.codes -%}
{%- set g = tr.entry_guard -%}
{%- set ns = namespace(w=[]) -%}
{%- set gf = namespace(ok=false, include=none) -%}
{%- set ff = namespace(ok=false, include=none) -%}
{%- set d = F.by_dir[dir_rel] if dir_rel in F.by_dir else none -%}
{#- brr-follow BR-03 (S3-SEAM-10): the family guard target follows the DECLARED relativity -- repository-relative, or
    joined under THIS entry directory (entry_dir); the transfer directory is no longer implied -#}
{%- set family_target = g.family_rel if g.relativity.family_rel == 'repository' else dir_rel ~ sep ~ g.family_rel -%}
{%- if d is none -%}
{%- set ns.w = [[C.by_dir_undeclared, T.by_dir_undeclared | format(entry=dir_rel)]] -%}
{%- else -%}
{{- entry_include(gf, F, sep, dir_rel, d.guard_up, g.guard_route_rel) -}}
{{- entry_include(ff, F, sep, dir_rel, d.family_up, family_target) -}}
{%- if not gf.ok -%}{%- set ns.w = ns.w + [[C.guard_unreachable, T.guard_unreachable | format(entry=dir_rel, up=d.guard_up, target=g.guard_route_rel)]] -%}{%- endif -%}
{%- if not ff.ok -%}{%- set ns.w = ns.w + [[C.family_unreachable, T.family_unreachable | format(entry=dir_rel, up=d.family_up, target=family_target)]] -%}{%- endif -%}
{%- if (dir_rel.split(sep) | length) > (F.discovery.max_up | int) -%}
{%- set ns.w = ns.w + [[C.beyond_discovery, T.beyond_discovery | format(entry=dir_rel, depth=(dir_rel.split(sep) | length), max_up=F.discovery.max_up)]] -%}
{%- endif -%}
{%- if (head | length) < 2 or head[0] != R.guard or head[1] != R.family
       or (head | unique | list | length) != (head | length) or (head | reject('in', R.values() | list) | list | length) > 0
       or ((R.bind in head) != (R.assert in head)) -%}
{%- set ns.w = ns.w + [[C.head_law, T.head_law | format(entry=dir_rel, head=(head | tojson), guard_role=R.guard, family_role=R.family, roles=(R.values() | list | tojson), bind_role=R.bind, assert_role=R.assert)]] -%}
{%- endif -%}
{%- endif -%}
{%- set out.violations = ns.w -%}
{%- set out.valid = ns.w | length == 0 -%}
{%- set out.guard = gf.include -%}
{%- set out.family = ff.include -%}
{%- set out.head = head -%}
{%- endmacro -%}

{#- target_vars(out, tr): out.v = the connection vars of every target play (contract conn_vars, then the credential
    selectors bind_key and clear), each entry_forms.target_vars.format over the controller host and the contract fact,
    kept as runtime text. One source for the construction and the verifier's target-play check. -#}
{%- macro target_vars(out, tr) -%}
{%- set F = tr.entry_forms -%}
{%- set c = tr.contract -%}
{%- set ns = namespace(p=[]) -%}
{%- for cv in c.conn_vars + c.credential_selectors.bind_key + c.credential_selectors['clear'] -%}
{%- set ns.p = ns.p + [[cv, rt(F, F.target_vars.format | format(host=tr.controller_scope.delegate_to, fact=F.target_vars.fact, var=cv))]] -%}
{%- endfor -%}
{%- set out.v = dict(ns.p) -%}
{%- endmacro -%}

{#- head_task(out, tr, G, rf, fm, role, cls): out.v = one head task of a first entry: emit.keys.name per placement class,
    then the role's module key (entry_guard.task_keys[role] | first) with the rendered guard / family include, or for the
    bare-name refusal an assert of [bare `that`] and the fail_msg rf[G.macro](G, head_tasks.refuse_bare.code, [class
    detail]) (the shared grammar macro; s9), then construct.assert_fixed. The refusal bytes embed the admitted grammar at
    generation time; the generated entry needs no runtime rh. A role that is none of guard / family / bare carries no
    module key (form_law refuses it). -#}
{%- macro head_task(out, tr, G, rf, fm, role, cls) -%}
{%- set F = tr.entry_forms -%}
{%- set R = F.roles -%}
{%- set K = F.emit.keys -%}
{%- set H = F.construct.head_tasks[role] -%}
{%- set mk = tr.entry_guard.task_keys[role] | first -%}
{%- set bare = (dict([[K.that, [bare_that(F) | trim]],
                      [K.fail_msg, rf[G.macro](G, H.code, [H.fail_msg[cls] | format(host=rt(F, F.bare.host_expr), pinned=rt(F, F.bare.pinned_expr))]) | trim]]
                     + (F.construct.assert_fixed.items() | list))) if role == R.bare else none -%}
{%- set arg = fm.guard if role == R.guard else (fm.family if role == R.family else bare) -%}
{%- set out.v = dict([[K.name, H.name[cls]]] + ([[mk, arg]] if arg is not none else [])) -%}
{%- endmacro -%}

{#- entry_plays(out, tr, G, rf, sep, tr_rel, sdir, sname): the constructed plays (data) of ONE roster member, or its cause
    pairs. out.ok, out.violations, out.entry, out.plays. Order (fail-closed): form_law, roster membership, bootstrap
    output, output kind, dir_forms; any cause withholds construction. Per play: emit.keys name / hosts [/ connection],
    play.fixed, [vars], then emit.tasks_key: the first-entry head of its placement and ONE construct.body_task whose
    argument is the body's magic-rooted form (entry_include at construct.body_task.up). No body byte is read here. -#}
{%- macro entry_plays(out, tr, G, rf, sep, tr_rel, sdir, sname) -%}
{%- set F = tr.entry_forms -%}
{%- set T = F.texts -%}
{%- set C = F.codes -%}
{%- set K = F.emit.keys -%}
{%- set B = F.construct.body_task -%}
{%- set g = tr.entry_guard -%}
{%- set sid = sdir ~ sep ~ sname -%}
{%- set fl = namespace(v=[]) -%}
{{- form_law(fl, tr, sep) -}}
{%- set ns = namespace(w=fl.v, plays=[], seen=[]) -%}
{%- set sent = tr.entry_sets[sdir][sname] if (sdir in tr.entry_sets and tr.entry_sets[sdir] is mapping and sname in tr.entry_sets[sdir]) else none -%}
{%- set fm = namespace(violations=[], valid=false, guard=none, family=none, head=[]) -%}
{%- set rx = namespace(v={}) -%}
{%- set tv = namespace(v={}) -%}
{%- if sent is none -%}{%- set ns.w = ns.w + [[C.not_in_roster, T.not_in_roster | format(entry=sid)]] -%}{%- endif -%}
{#- the protected set (codex-tick440 P5): entry_guard.protected_set_members names the entry_guard keys whose paths are
    never outputs; brr-follow BR-03: each member path is resolved by its DECLARED relativity (repository-relative, or
    under this entry directory) and, fail-closed, also relative to the transfer directory -#}
{%- for k in g.protected_set_members if sid in [(g[k] if g.relativity[k] == 'repository' else sdir ~ sep ~ g[k]), g[k], tr_rel ~ sep ~ g[k]] -%}{%- set ns.w = ns.w + [[C.bootstrap_output, T.bootstrap_output | format(entry=sid)]] -%}{%- endfor -%}
{%- if ns.w | length == 0 and sent.output != F.outputs.generated -%}{%- set ns.w = ns.w + [[C.not_generated, T.not_generated | format(entry=sid, output=sent.output)]] -%}{%- endif -%}
{%- if ns.w | length == 0 -%}{{- dir_forms(fm, tr, sep, tr_rel, sdir, sent.head) -}}{%- endif -%}
{%- for c in fm.violations -%}{%- set ns.w = ns.w + [[c[0], T.entry_cause | format(entry=sid, cause=c[1])]] -%}{%- endfor -%}
{%- if ns.w | length == 0 -%}
{{- remote_hosts(rx, tr) -}}
{{- target_vars(tv, tr) -}}
{%- for d in sent.plays -%}
{%- set pa = T.play_id | format(entry=sid, play=d.id) -%}
{%- set cls = F.placement.target if (d.hosts == F.placement.target or d.hosts in rx.v) else (F.placement.controller if d.hosts == tr.controller_scope.delegate_to else none) -%}
{%- set first = cls is not none and d.hosts not in ns.seen -%}
{%- set bi = namespace(ok=false, include=none) -%}
{%- set ht = namespace(v={}) -%}
{%- set hs = namespace(t=[]) -%}
{{- entry_include(bi, F, sep, sdir, B.up, d.body) -}}
{%- if first -%}
{%- set ns.seen = ns.seen + [d.hosts] -%}
{%- for role in sent.head -%}{{- head_task(ht, tr, G, rf, fm, role, cls) -}}{%- set hs.t = hs.t + [ht.v] -%}{%- endfor -%}
{%- endif -%}
{%- if cls is none -%}
{%- set ns.w = ns.w + [[C.placement_unconstructed, T.placement_unconstructed | format(play=pa, placement=d.hosts)]] -%}
{%- elif not bi.ok -%}
{%- set ns.w = ns.w + [[C.body_outside_entry, T.body_outside_entry | format(play=pa, body=d.body, entry_dir=sdir)]] -%}
{%- else -%}
{%- set ns.plays = ns.plays + [dict(
      [[K.name, d.id]]
      + ([[K.hosts, (tr.target_hosts_expr if d.hosts == F.placement.target else rx.v[d.hosts])]] if cls == F.placement.target
         else [[K.hosts, tr.controller_scope.delegate_to], [K.connection, F.placement.controller_connection]])
      + (F.play.fixed.items() | list)
      + ([[K.vars, tv.v]] if cls == F.placement.target else [])
      + [[F.emit.tasks_key, hs.t + [dict([[K.name, B.name | format(play=d.id, body=d.body)], [B.module, bi.include]])]]])] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- set out.ok = ns.w | length == 0 -%}
{%- set out.violations = ns.w -%}
{%- set out.entry = sid -%}
{%- set out.plays = ns.plays if ns.w | length == 0 else [] -%}
{%- endmacro -%}

{#- yaml_block(E, m, pad, lead, step, omit): ONE mapping as block YAML lines (the first key after `lead`, the rest after
    `pad`), skipping key `omit`; a non-empty mapping value nests one `step` deeper; every other value is its JSON form
    by the builtin tojson (a valid YAML double-quoted scalar / flow sequence; tojson writes < > & ' as \u00XX escapes,
    which YAML reads back to the same characters). Key terminator, value separator and newline are emit values. -#}
{%- macro yaml_block(E, m, pad, lead, step, omit) -%}
{%- for k, v in m.items() if k != omit -%}
{%- if v is mapping and v | length > 0 -%}
{{ (lead if loop.first else pad) ~ k ~ E.key_end ~ E.newline ~ yaml_block(E, v, pad ~ step, pad ~ step, step, omit) }}
{%- else -%}
{{ (lead if loop.first else pad) ~ k ~ E.key_end ~ E.value_sep ~ (v | tojson) ~ E.newline }}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{#- entry_document(out, tr, G, rf, sep, decl_rel, sdir, sname): the generated file of ONE roster member. out.ok,
    out.violations, out.entry, out.text (none when withheld). ENTRY IDENTITY (codex-tick425-426 E-1 / E-2): decl_rel is
    the admitted declaration's checkout-relative path; the transfer directory is derived from it with `sep`, and its last
    segment must be emit.decl_file (decl_identity). text = emit.document_start, the emit.header lines, then per play its
    metadata (yaml_block omitting emit.tasks_key) and its tasks (head + body import, one blank line between tasks). -#}
{%- macro entry_document(out, tr, G, rf, sep, decl_rel, sdir, sname) -%}
{%- set F = tr.entry_forms -%}
{%- set E = F.emit -%}
{%- set nl = E.newline -%}
{%- set step = E.indent_unit * (E.indent | int) -%}
{%- set segs = decl_rel.split(sep) -%}
{%- set tr_rel = segs[:-1] | join(sep) -%}
{%- set ep = namespace(ok=false, violations=[], entry=sdir ~ sep ~ sname, plays=[]) -%}
{%- set doc = namespace(t=[]) -%}
{%- if (segs | last) != E.decl_file or tr_rel | length == 0 -%}
{%- set ep.violations = [[F.codes.decl_identity, F.texts.decl_identity | format(decl=decl_rel, file=E.decl_file)]] -%}
{%- else -%}
{{- entry_plays(ep, tr, G, rf, sep, tr_rel, sdir, sname) -}}
{%- endif -%}
{%- if ep.ok -%}
{%- set doc.t = [E.document_start ~ nl] -%}
{%- for h in E.header -%}{%- set doc.t = doc.t + [h | format(entry=ep.entry, decl=decl_rel, dir=sdir, file=sname) ~ nl] -%}{%- endfor -%}
{%- for d in tr.entry_sets[sdir][sname].plays -%}{%- set doc.t = doc.t + [E.header_body | format(play=d.id, body=d.body) ~ nl] -%}{%- endfor -%}
{%- for p in ep.plays -%}
{%- if not loop.first -%}{%- set doc.t = doc.t + [nl] -%}{%- endif -%}
{%- set doc.t = doc.t + [yaml_block(E, p, step * (E.levels.play_key | int), E.sequence_lead, step, E.tasks_key),
                         step * (E.levels.play_key | int) ~ E.tasks_key ~ E.key_end ~ nl] -%}
{%- for t in p[E.tasks_key] -%}
{%- if not loop.first -%}{%- set doc.t = doc.t + [nl] -%}{%- endif -%}
{%- set doc.t = doc.t + [yaml_block(E, t, step * (E.levels.task_key | int), step * (E.levels.task_item | int) ~ E.sequence_lead, step, none)] -%}
{%- endfor -%}
{%- endfor -%}
{%- endif -%}
{%- set out.ok = ep.ok -%}
{%- set out.violations = ep.violations -%}
{%- set out.entry = ep.entry -%}
{%- set out.text = (doc.t | join('')) if ep.ok else none -%}
{%- endmacro -%}
