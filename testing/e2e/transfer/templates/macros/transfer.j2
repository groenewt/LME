{#- testing/e2e/transfer/macros/transfer.j2 -- genuine macros for the deploy_gate TARGET CONTRACT + TRANSFER.
    Every value comes from transfer.decl.yml (tr) or from a resolved contract (k); no free-standing policy literal.
    Consumers call them through lookup('ansible.builtin.template', templates/<t>.j2, template_vars=...), so each
    template is a one-line dispatcher and the logic lives here, once.
    Values reaching a shell body are regex-admitted before (paths, members, op ids); shq() quotes anyway. -#}

{#- ---- POSIX single-quote ---- -#}
{%- macro shq(s) -%}
'{{ s | string | replace("'", "'\\''") }}'
{%- endmacro -%}

{#- ---- ssh words of the contract (B's transport options, then the auth mode's ssh_common_args words, then port,
     key, proxy), identical for Ansible and for deploy_gate. k.mode_args = rh ssh_auth.modes[<mode>].ssh_common_args. -#}
{%- macro ssh_words(tr, k) -%}
{%- set w = [] -%}
{%- for o in tr.contract.options -%}{{ w.extend(['-o', o]) or '' }}{%- endfor -%}
{{- w.extend(k.mode_args.split()) or '' -}}
{%- if k.port is not none -%}{{ w.extend(['-o', 'Port=' ~ k.port]) or '' }}{%- endif -%}
{%- if k.key is not none -%}{{ w.extend(['-o', 'IdentityFile=' ~ k.key]) or '' }}{%- endif -%}
{%- if k.proxy is not none -%}{{ w.extend(['-o', 'ProxyJump=' ~ k.proxy]) or '' }}{%- endif -%}
{{ w | to_json }}
{%- endmacro -%}

{#- ---- the complete ssh argv deploy_gate runs (client, words, user@address) ---- -#}
{%- macro ssh_argv(tr, k) -%}
{{ ([tr.contract.ssh_client] + (ssh_words(tr, k) | from_json) + [k.user ~ '@' ~ k.address]) | to_json }}
{%- endmacro -%}

{#- ---- Ansible connection vars of the SAME contract (play vars outrank inventory host vars). Every declared
     credential selector is bound explicitly: bind_key -> the contract key ('' when the mode takes none), clear -> ''
     (B-INHERITED-OWNER-KEY: an inherited owner ansible_ssh_private_key_file is never consumed). -#}
{%- macro ansible_conn(tr, k) -%}
{%- set c = {'ansible_connection': 'ssh', 'ansible_host': k.address, 'ansible_user': k.user,
             'ansible_ssh_executable': tr.contract.ssh_client,
             'ansible_ssh_common_args': (ssh_words(tr, k) | from_json) | join(' '),
             'ansible_ssh_extra_args': ''} -%}
{%- set s = {} -%}
{%- for v in tr.contract.credential_selectors.bind_key -%}{{ s.update({v: (k.key if k.key is not none else '')}) or '' }}{%- endfor -%}
{#- credential_selectors['clear'] by SUBSCRIPT, never `.clear`: Jinja attribute access returns the dict METHOD clear, not
    the data key (route audit; the genesis `_l.env.clear` bug). Every read site of this key uses the subscript. -#}
{%- for v in tr.contract.credential_selectors['clear'] -%}{{ s.update({v: ''}) or '' }}{%- endfor -%}
{{ c | combine(s) | to_json }}
{%- endmacro -%}

{#- ---- the transfer manifest as ONE regex over repository-relative member paths ---- -#}
{%- macro exclusion_regex(excludes) -%}
{%- set a = [] -%}
{%- for e in excludes -%}
{%- if e.name is defined -%}{{ a.append('(^|/)' ~ (e.name | regex_escape) ~ '(/|$)') or '' }}
{%- elif e.path is defined -%}{{ a.append('^' ~ (e.path | regex_escape) ~ '(/|$)') or '' }}
{%- elif e.prefix is defined -%}{{ a.append('^' ~ (e.prefix | regex_escape)) or '' }}
{%- else -%}{{ a.append((e.suffix | regex_escape) ~ '$') or '' }}{%- endif -%}
{%- endfor -%}
{{ a | join('|') }}
{%- endmacro -%}

{#- ---- a parent walk that refuses a symlink or non-directory component below the deployment root ---- -#}
{%- macro sh_parent_guard() -%}
guard_parents() {  # $1 = member path relative to the deployment root
  _p=${1%/*}; [ "$_p" = "$1" ] && return 0
  _acc=.
  _IFS=$IFS; IFS=/
  for _c in $_p; do
    _acc=$_acc/$_c
    if [ -L "$_acc" ]; then echo "TRANSFER-TARGET-PARENT-LINK $_acc" >&2; IFS=$_IFS; return 1; fi
    if [ -e "$_acc" ] && [ ! -d "$_acc" ]; then echo "TRANSFER-TARGET-PARENT-NOT-DIR $_acc" >&2; IFS=$_IFS; return 1; fi
  done
  IFS=$_IFS
}
{%- endmacro -%}

{#- ---- promotion: set each verified staged member to its declared mode and rename it over its live path
     (per-member atomic, same filesystem), then prune the previously owned members the new edition no longer has
     (regular files only; every parent walked without following links first). cwd = the deployment root.
     Reads <state>/<ops>/<op>.modes ("<mode> <path>") and <op>.prune ("<path>"). -#}
{#- tl = {tool: canonical path} (rh os_tools, admitted in target_observe.yml); no PATH lookup below. -#}
{%- macro sh_promote(tr, op, tl) -%}
set -eu
{{ sh_parent_guard() }}
_st={{ shq(tr.target.state_dir ~ '/' ~ tr.target.staging_dir ~ '/' ~ op) }}
_ops={{ shq(tr.target.state_dir ~ '/' ~ tr.target.ops_dir ~ '/' ~ op) }}
while IFS=' ' read -r _mode m; do
  guard_parents "$m"
  _d=${m%/*}; [ "$_d" = "$m" ] || {{ tl.mkdir }} -p -m {{ tr.target.dir_mode }} -- "$_d"
  if [ -L "$m" ] || { [ -e "$m" ] && [ ! -f "$m" ]; }; then echo "TRANSFER-TARGET-MEMBER-NOT-FILE $m" >&2; exit 1; fi
  {{ tl.chmod }} "$_mode" -- "$_st/$m"
  {{ tl.mv }} -f -- "$_st/$m" "$m"
done < "$_ops.modes"
while IFS= read -r m; do
  guard_parents "$m"
  if [ -L "$m" ]; then echo "TRANSFER-TARGET-PRUNE-LINK $m" >&2; exit 1; fi
  if [ -f "$m" ]; then
    {{ tl.rm }} -f -- "$m"
    _d=${m%/*}; [ "$_d" = "$m" ] || {{ tl.rmdir }} -p --ignore-fail-on-non-empty -- "$_d" 2>/dev/null || true
  elif [ -e "$m" ]; then echo "TRANSFER-TARGET-PRUNE-NOT-FILE $m" >&2; exit 1; fi
done < "$_ops.prune"
{%- endmacro -%}

{#- ---- remove EXACTLY the given staging entries (paths relative to the deployment root, each under the owned
     state's staging/, incoming/ or ops/, classified by the observe play: dead ops of THIS controller or finished ops'
     residue). Never a glob, never an age rule. -#}
{%- macro sh_reap(tr, paths, tl) -%}
{% for p in paths %}
{{ tl.rm }} -rf -- {{ shq(p) }}
{% endfor %}
{%- endmacro -%}

{#- ---- run a body under the owned state lock (route E25-E27 lease/flock model): claim/reap never wait
     (flock -x -n), publish waits a bounded time (flock -x -w <publish_wait_s>); both exit <busy_rc> when the lock
     is held. cwd = the deployment root. rc busy_rc -> TRANSFER-TARGET-BUSY (the caller refuses). -#}
{%- macro sh_locked(tr, tl, body, wait) -%}
{{ tl.flock }} -x {{ ('-w ' ~ tr.target.publish_wait_s) if wait else '-n' }} -E {{ tr.target.busy_rc }} -- {{ shq(tr.target.state_dir ~ '/' ~ tr.target.lock) }} /bin/sh -c {{ shq(body) }}
{%- endmacro -%}

{#- ---- append ledger lines (inside a locked body; printf is the shell builtin). -#}
{%- macro sh_append(tr, lines) -%}
{% for l in lines %}
printf '%s\n' {{ shq(l) }} >> {{ shq(tr.target.state_dir ~ '/' ~ tr.target.ledger) }}
{% endfor %}
{%- endmacro -%}

{#- ---- CONTROLLER ledger append (B-CROSS-ROOT-RECOVERY residual): every root sharing the state dir takes the ONE
     ledger lock <state_dir>/<controller_state.ledger_lock>; under it the lines are appended with O_APPEND (`>>`),
     never read-modify-write, so no other writer's row is lost. umask 077: the lock and the ledger are created 0600.
     flock = the admitted os_tools.flock path; busy (lock held > ledger_wait_s) -> exit ledger_busy_rc, nothing written. -#}
{%- macro ctl_ledger_append(tr, flock, state_dir, lines) -%}
{%- set body = [] -%}
{%- for l in lines -%}{{ body.append("printf '%s\\n' " ~ shq(l) ~ ' >> ' ~ shq(state_dir ~ '/' ~ tr.controller_state.ledger)) or '' }}{%- endfor -%}
umask 077 && exec {{ shq(flock) }} -x -w {{ tr.controller_state.ledger_wait_s }} -E {{ tr.controller_state.ledger_busy_rc }} -- {{ shq(state_dir ~ '/' ~ tr.controller_state.ledger_lock) }} /bin/sh -c {{ shq(body | join('\n')) }}
{%- endmacro -%}

{#- ---- the claim (compare-and-swap on the ledger): the ledger must still be byte-identical to the one the observe
     play classified (sha256, or 'absent'); otherwise another writer moved it -> exit busy_rc, nothing changed.
     Then reap EXACTLY the observed reap set, record the abandon of this controller's dead ops, and record `start <op> <token>`. From here
     every other writer's observation sees this op as a foreign unfinished op and refuses. -#}
{%- macro sh_claim(tr, tl, observed, reap, dead, op, token) -%}
set -eu
_l={{ shq(tr.target.state_dir ~ '/' ~ tr.target.ledger) }}
if [ -e "$_l" ]; then _h=$({{ tl.sha256sum }} < "$_l"); _h=${_h%% *}; else _h=absent; fi
if [ "$_h" != {{ shq(observed) }} ]; then echo "TRANSFER-TARGET-LEDGER-MOVED $_h" >&2; exit {{ tr.target.busy_rc }}; fi
{{ sh_reap(tr, reap, tl) }}
{{ sh_append(tr, dead | map('regex_replace', '^', tr.target.verbs.abandon ~ ' ') | list + [tr.target.verbs.start ~ ' ' ~ op ~ ' ' ~ token]) }}
{%- endmacro -%}



{#- ---- readback of a tree against the op's expected manifest. cwd = the deployment root; tree = the tree to read
     (the staging tree or '.'). staging: exact digests + exact member set (unexpected members fail). live: exact
     digests + declared modes + every pruned path absent (unowned files are not members, so not checked). -#}
{%- macro sh_readback(tr, op, tree, staging, tl) -%}
set -eu
_ops="$PWD/"{{ shq(tr.target.state_dir ~ '/' ~ tr.target.ops_dir ~ '/' ~ op) }}
_fail=0
cd -- {{ shq(tree) }}
{{ tl.sha256sum }} --check --strict --quiet -- "$_ops.sha256" || { echo "TRANSFER-READBACK-DIGEST" >&2; _fail=1; }
{% if staging %}
{{ tl.find }} . -mindepth 1 ! -type d -printf '%P\n' | LC_ALL=C {{ tl.sort }} > "$_ops.found"
LC_ALL=C {{ tl.sort }} -- "$_ops.members" | {{ tl.cmp }} -s - "$_ops.found" || { echo "TRANSFER-READBACK-MEMBER-SET staging differs" >&2; _fail=1; }
{% else %}
while IFS=' ' read -r _m _p; do
  if [ -L "$_p" ] || [ ! -f "$_p" ]; then echo "TRANSFER-READBACK-MISSING $_p" >&2; _fail=1; continue; fi
  [ "$({{ tl.find }} "$_p" -maxdepth 0 -printf '%m')" = "$_m" ] || { echo "TRANSFER-READBACK-MODE $_p" >&2; _fail=1; }
done < "$_ops.modes"
while IFS= read -r _p; do
  if [ -e "$_p" ] || [ -L "$_p" ]; then echo "TRANSFER-READBACK-PRUNED-PRESENT $_p" >&2; _fail=1; fi
done < "$_ops.prune"
{% endif %}
exit $_fail
{%- endmacro -%}

{#- ---- check.yml: walk a task list, following blocks and B includes, and emit one JSON line per task.
     B includes must be written "{{ '{{' }} tr_dir {{ '}}' }}/<tasks_dir>/<file>" and are loaded and walked; route includes must be
     written with the rh_repo_root or playbook_dir-based repository prefix and are emitted (not walked) for binding
     by path + sha256; anything else is emitted as UNRESOLVED and refused by check.yml. -#}
{#- ---- execution scope (codex 163642 B-CONTROLLER-LEDGER-ANCESTRY-REFRESH; codex 164854
     B-CONTROLLER-SCOPE-CHECKER-FALSE-PASS). The walker carries the EFFECTIVE execution settings down the nesting the
     way Ansible inherits them, in TWO var layers (codex 170810 B-CONTROLLER-SCOPE-INCLUDE-PRECEDENCE; Ansible 2.19.11
     vars/manager.py:380-403 merges task vars -- the parent chain's block/`apply`/task vars, playbook/task.py get_vars --
     BEFORE include params, playbook/task.py:483-488 + block.py:413-417 get_include_params, the vars of EVERY ancestor
     include task, deeper ones replacing outer ones):
       layer 'task'  (a task, a block, an include's `apply`): every keyword in controller_scope.tracked_keywords the
                     level defines, and every pin_vars / invalidating_vars var it binds, replaces the inherited 'kw:' /
                     'var:' value (a descendant override always recomputes);
       layer 'param' (an include's own `vars`): replaces the inherited 'ip:' value, and an 'ip:' value OUTRANKS any
                     'var:' value of the same name at every depth below it -- a descendant block or task var can never
                     re-pin over an inherited include parameter.
     `scope_is_ctl` classifies the result as OWNER-CONTROLLER only when delegate_to is exactly
     controller_scope.delegate_to, no other tracked keyword is set, every pin var's EFFECTIVE value ('ip:' if bound,
     else 'var:') is the EXACT declared expression (a structural string equality; nothing is evaluated, so
     `'ssh' if 'controller_delegation.connection' else ...` is simply not the declared form), and no invalidating var is
     bound in either layer. Not modelled (no static source in B): extra vars (refused elsewhere), set_fact /
     include_vars caches (between the two layers). -#}
{%- macro scope_fold(cs, eff, node, layer) -%}
{%- set m = dict(eff if eff is mapping else {}) -%}
{%- set node = node if node is mapping else {} -%}
{%- set vp = 'ip:' if layer == 'param' else 'var:' -%}
{%- if layer == 'task' -%}
{%- for k in cs.tracked_keywords if k in node -%}{{ m.update({'kw:' ~ k: node[k] | string}) or '' }}{%- endfor -%}
{%- endif -%}
{%- set vs = node.vars if node.vars is defined and node.vars is mapping else {} -%}
{%- for k in (cs.pin_vars.keys() | list) + cs.invalidating_vars if k in vs -%}{{ m.update({vp ~ k: vs[k] | string}) or '' }}{%- endfor -%}
{{ m | to_json }}
{%- endmacro -%}

{%- macro scope_is_ctl(cs, eff) -%}
{%- set ns = namespace(ok=(eff['kw:delegate_to'] | default(none)) == cs.delegate_to) -%}
{%- for k in cs.tracked_keywords if k != 'delegate_to' and ('kw:' ~ k) in eff -%}{%- set ns.ok = false -%}{%- endfor -%}
{%- for k, want in cs.pin_vars.items() if (eff['ip:' ~ k] if ('ip:' ~ k) in eff else (eff['var:' ~ k] | default(none))) != want -%}{%- set ns.ok = false -%}{%- endfor -%}
{%- for k in cs.invalidating_vars if ('var:' ~ k) in eff or ('ip:' ~ k) in eff -%}{%- set ns.ok = false -%}{%- endfor -%}
{{ '1' if ns.ok else '' }}
{%- endmacro -%}

{%- macro walk(tasks, via, tr, tr_dir, depth, eff=none) -%}
{%- set eff = eff if eff is mapping else {} -%}
{%- set cs = tr.controller_scope -%}
{%- set kw = ['name', 'when', 'register', 'vars', 'loop', 'loop_control', 'changed_when', 'failed_when', 'tags',
              'delegate_to', 'run_once', 'environment', 'no_log', 'become', 'become_user', 'args', 'until', 'retries',
              'delay', 'ignore_errors', 'check_mode', 'notify', 'any_errors_fatal', 'listen', 'throttle', 'timeout',
              'diff', 'module_defaults', 'collections', 'connection', 'block', 'rescue', 'always', 'with_items'] -%}
{%- set bprefix = '{' ~ '{ tr_dir }' ~ '}/' ~ tr.tasks_dir ~ '/' -%}
{%- set rprefix = '^\\{\\{ (rh_repo_root|playbook_dir \\| dirname \\| dirname \\| dirname) \\}\\}/' -%}
{%- for t in (tasks or []) -%}
{#- teff: this task/block's own effective settings (keywords + vars overlay the inherited ones) -#}
{%- set teff = scope_fold(cs, eff, t, 'task') | trim | from_json -%}
{%- if t.block is defined -%}
{{ walk(t.block, via, tr, tr_dir, depth, teff) }}{{ walk(t.rescue | default([]), via, tr, tr_dir, depth, teff) }}{{ walk(t.always | default([]), via, tr, tr_dir, depth, teff) }}
{%- else -%}
{%- set mods = t.keys() | reject('in', kw) | list -%}
{%- set mod = (mods | first) if (mods | length == 1) else 'AMBIGUOUS:' ~ (mods | join(',')) -%}
{%- set isinc = mod in ['ansible.builtin.include_tasks', 'ansible.builtin.import_tasks'] -%}
{%- set ap = (t[mod].apply | default({})) if (isinc and t[mod] is mapping) else {} -%}
{#- an include's CHILDREN: the inherited settings, overlaid by `apply` (layer 'task': keywords + task vars), then by
    the include's own parameters (layer 'param': vars only, kept SEPARATE so they outrank every task/block var below).
    The include task's own keywords do not reach its children. -#}
{%- set ceff = (scope_fold(cs, scope_fold(cs, eff, ap, 'task') | trim | from_json, {'vars': t.vars | default({})}, 'param') | trim | from_json)
               if isinc else teff -%}
{%- set cctl = scope_is_ctl(cs, ceff) | trim == '1' -%}
{%- set row = {'module': mod, 'task': t.name | default(''), 'via': via, 'ctl': cctl,
               'delegate_to': t.delegate_to | default(none),
               'changed_when': (t.changed_when | string) if t.changed_when is defined else none,
               'ivars': ((t.vars | default({})).keys() | list) if mod in ['ansible.builtin.include_tasks', 'ansible.builtin.import_tasks'] else [],
               'ic_variant': (t.vars | default({})).rh_ic_variant | default(none),
               'become': (t.become is defined or t.become_user is defined)} -%}
{%- if mod in ['ansible.builtin.include_tasks', 'ansible.builtin.import_tasks'] -%}
{%- set f = t[mod] if t[mod] is string else (t[mod].file | default('')) -%}
{%- if f.startswith(bprefix) and depth < 6 -%}
{{ (row | combine({'include': 'b', 'file': f[bprefix | length:]}) | to_json) ~ '\n' }}
{{- walk(lookup('ansible.builtin.file', tr_dir ~ '/' ~ tr.tasks_dir ~ '/' ~ f[bprefix | length:]) | from_yaml, via ~ '>' ~ f[bprefix | length:], tr, tr_dir, depth + 1, ceff) -}}
{%- elif f is match(rprefix) -%}
{{ (row | combine({'include': 'route', 'file': f | regex_replace(rprefix, '')}) | to_json) ~ '\n' }}
{%- else -%}
{{ (row | combine({'include': 'UNRESOLVED', 'file': f}) | to_json) ~ '\n' }}
{%- endif -%}
{%- elif mod == 'ansible.builtin.include_role' or mod == 'ansible.builtin.import_role' -%}
{{ (row | combine({'include': 'UNRESOLVED', 'file': t[mod] | string}) | to_json) ~ '\n' }}
{%- else -%}
{{ (row | to_json) ~ '\n' }}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{#- ---- check.yml: every structural violation of the entry playbooks against the declaration, as a JSON list.
     Entry files are read here by lookup (their "{{ }}" strings stay data). -#}
{%- macro violations(tr, tr_dir, repo_root) -%}
{%- set v = [] -%}
{%- set n = namespace(rows=0) -%}
{%- set bfiles = [] -%}
{%- for ename, decl in tr.entries.items() -%}
{%- set plays = lookup('ansible.builtin.file', tr_dir ~ '/' ~ ename) | from_yaml -%}
{%- if (plays | map(attribute='name') | list) != (decl | map(attribute='id') | list) -%}
{{ v.append(ename ~ ': plays ' ~ (plays | map(attribute='name') | list | to_json) ~ ' != declared ' ~ (decl | map(attribute='id') | list | to_json)) or '' }}
{%- endif -%}
{%- for p in plays -%}
{%- set d = decl | selectattr('id', 'equalto', p.name | default('')) | first | default({'hosts': 'UNDECLARED', 'kind': 'UNDECLARED'}) -%}
{%- set placed = 'localhost' if (p.hosts == 'localhost' and p.connection | default('') == 'local')
                  else ('target' if p.hosts == tr.target_hosts_expr else 'OTHER:' ~ p.hosts) -%}
{%- set pa = ename ~ ':' ~ (p.name | default('?')) -%}
{%- if placed != d.hosts -%}{{ v.append(pa ~ ': placed on ' ~ placed ~ ', declared ' ~ d.hosts) or '' }}{%- endif -%}
{%- if p.any_errors_fatal | default(false) is not sameas true -%}{{ v.append(pa ~ ': not any_errors_fatal') or '' }}{%- endif -%}
{%- if p.gather_facts | default(true) is not sameas false -%}{{ v.append(pa ~ ': gathers facts') or '' }}{%- endif -%}
{%- if placed == 'target' -%}
{%- for cv in tr.contract.conn_vars + tr.contract.credential_selectors.bind_key + tr.contract.credential_selectors['clear'] -%}
{%- if (p.vars | default({}))[cv] | default('') != ('{' ~ "{ hostvars['localhost'].tr_conn." ~ cv ~ ' }' ~ '}') -%}
{{ v.append(pa ~ ': connection var ' ~ cv ~ ' not bound to the contract') or '' }}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- set rows = walk(p.tasks | default([]), pa, tr, tr_dir, 0) | trim | split('\n') | select | map('from_json') | list -%}
{%- set n.rows = n.rows + (rows | length) -%}
{%- if placed == 'target' -%}
{%- set ic = tr.initial_contact -%}
{%- for pv in ic.refused_play_vars -%}
{%- if pv in (p.vars | default({})) -%}{{ v.append(pa ~ ': root target play binds ' ~ pv ~ ' (the PRIVILEGED contact owns it)') or '' }}{%- endif -%}
{%- endfor -%}
{%- if p.become is defined or p.become_user is defined -%}{{ v.append(pa ~ ': root target play sets become') or '' }}{%- endif -%}
{%- set icn = namespace(seen=false) -%}
{%- for r in rows -%}
{%- set at = pa ~ ' [' ~ r.via ~ '] ' ~ r.task ~ ': ' -%}
{%- for iv in r.ivars | default([]) | select('in', ic.refused_include_vars) -%}{{ v.append(at ~ 'include parameter ' ~ iv ~ ' on a root target play') or '' }}{%- endfor -%}
{%- if r.become | default(false) -%}{{ v.append(at ~ 'become on a root target play') or '' }}{%- endif -%}
{%- if not icn.seen -%}
{%- if r.include | default('') == 'route' and r.file == ic.route_rel -%}{%- set icn.seen = true -%}
{%- if r.ic_variant != ic.variant -%}{{ v.append(at ~ 'INITIAL CONTACT variant ' ~ (r.ic_variant | string) ~ ' on a root target play (declared ' ~ ic.variant ~ ')') or '' }}{%- endif -%}
{%- elif r.include | default('') == 'route' and r.file not in ic.pre_contact_route -%}{{ v.append(at ~ 'route include ' ~ r.file ~ ' before INITIAL CONTACT') or '' }}
{%- elif r.module not in ic.contact_free_modules -%}{{ v.append(at ~ 'module ' ~ r.module ~ ' before INITIAL CONTACT') or '' }}
{%- endif -%}
{%- elif r.include | default('') == 'route' and r.file in ic.owner_only_route and not (r.ctl | default(false)) -%}{{ v.append(at ~ 'owner-only route include ' ~ r.file ~ ' in target context after the PRIVILEGED contact') or '' }}
{%- endif -%}
{%- endfor -%}
{%- if not icn.seen -%}{{ v.append(pa ~ ': target play never includes ' ~ ic.route_rel ~ ' (INITIAL CONTACT)') or '' }}{%- endif -%}
{%- endif -%}
{{- bfiles.extend(rows | selectattr('include', 'defined') | selectattr('include', 'equalto', 'b') | map(attribute='file') | list) or '' -}}
{%- for r in rows -%}
{%- set at = pa ~ ' [' ~ r.via ~ '] ' ~ r.task ~ ': ' -%}
{%- if r.include | default('') == 'UNRESOLVED' -%}{{ v.append(at ~ 'unresolved include ' ~ r.file) or '' }}{%- endif -%}
{%- if r.include | default('') == 'route' -%}
{%- set ri = tr.route_includes | selectattr('rel', 'equalto', r.file) | first | default(none) -%}
{%- if ri is none -%}{{ v.append(at ~ 'undeclared route include ' ~ r.file) or '' }}
{%- elif lookup('ansible.builtin.file', repo_root ~ '/' ~ r.file, rstrip=false) | hash('sha256') != ri.sha256 -%}{{ v.append(at ~ 'route include sha256 drift ' ~ r.file) or '' }}
{%- endif -%}
{%- endif -%}
{%- if d.kind == 'observe' -%}
