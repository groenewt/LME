    [magic, magic + up_filter, ..., magic + max_up x up_filter], and at least one must exist. The list punctuation
    ('[', ', ', ']') is the guard's Jinja list syntax (remaining violation RV-14). -#}
{%- set gtxt = lookup('ansible.builtin.file', repo_root ~ sep ~ tr.entry_guard.guard_route_rel, lstrip=BD.read.lstrip, rstrip=BD.read.rstrip) if (repo_root ~ sep ~ tr.entry_guard.guard_route_rel) is file else '' -%}
{%- set dl = namespace(t=[]) -%}
{%- for k in range((F.discovery.max_up | int) + 1) -%}{%- set dl.t = dl.t + [F.magic ~ (F.path.up_filter * k)] -%}{%- endfor -%}
{%- set dwant = '[' ~ (dl.t | join(', ')) ~ ']' -%}
{%- set dgot = gtxt | regex_findall('\\[' ~ (F.magic | regex_escape) ~ '[^\\]]*\\]') -%}
{%- if (dgot | length) == 0 or (dgot | reject('equalto', dwant) | list | length) > 0 -%}
{{ v.append([F.codes.discovery_unbound, F.texts.discovery_unbound | format(guard=tr.entry_guard.guard_route_rel, max_up=F.discovery.max_up, want=dwant, got=(dgot | unique | list | to_json))]) or '' }}
{%- endif -%}
{%- set gate = lookup('ansible.builtin.file', tr_dir ~ '/../deploy_gate.sh') -%}
{%- for k in ['contract_json', 'ssh_argv', 'machine_id', 'transfer_receipt'] -%}
{%- if (tr.outputs.prefix not in gate) or (tr.outputs[k] not in gate) -%}{{ v.append('deploy_gate.sh does not name output ' ~ tr.outputs.prefix ~ '<label>' ~ tr.outputs[k]) or '' }}{%- endif -%}
{%- endfor -%}
{%- if 'root@${HOST}' in gate or 'root@$HOST' in gate -%}{{ v.append('deploy_gate.sh builds its own root@HOST ssh target') or '' }}{%- endif -%}
{%- set il = [] -%}
{%- for ri in tr.route_includes | sort(attribute='rel') -%}
{{ il.append((lookup('ansible.builtin.file', repo_root ~ '/' ~ ri.rel, lstrip=BD.read.lstrip, rstrip=BD.read.rstrip) | hash('sha256')) ~ '  ' ~ ri.rel[(tr.route_interface.base | length) + 1:] ~ '\n') or '' }}
{%- endfor -%}
{%- if (il | join('')) | hash('sha256') != tr.route_interface.interface_sha256 -%}{{ v.append('route consumer interface drift: computed ' ~ ((il | join('')) | hash('sha256')) ~ ' != declared revision ' ~ tr.route_interface.revision ~ ' ' ~ tr.route_interface.interface_sha256) or '' }}{%- endif -%}
{%- for f in (tr.entries.keys() | list) + (bfiles | unique | map('regex_replace', '^', tr.tasks_dir ~ '/') | list) -%}
{%- if 'profiles/remote-harness.yml' in lookup('ansible.builtin.file', tr_dir ~ '/' ~ f) -%}{{ v.append(f ~ ' reads the raw remote-harness profile (consume the resolved policy rh)') or '' }}{%- endif -%}
{%- endfor -%}
{%- if n.rows == 0 -%}{{ v.append('no task walked') or '' }}{%- endif -%}
{{ {'rows': n.rows, 'violations': v} | to_json }}
{%- endmacro -%}
