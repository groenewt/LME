     check.yml play 1 binds from the R2 early-view producer and checks against the launcher's source binding BEFORE this
     call: path_separator (core controller.bootstrap.path_admission.separator), refusal_grammar (not read here; check.yml
     frames the refusal) and body_domain (controller.bootstrap.body_domain: undecodable_regex, read.lstrip, read.rstrip). -#}
{%- macro violations(tr, tr_dir, repo_root, ctx) -%}
{%- set v = [] -%}
{%- set n = namespace(rows=0) -%}
{%- set bfiles = [] -%}
{%- set F = tr.entry_forms -%}
{#- s9: the s8 verifier-only deviation (entry_forms.path.separator) is GONE; the separator is the early context's -#}
{%- set sep = ctx.path_separator -%}
{%- set BD = ctx.body_domain -%}
{%- set tr_rel = tr_dir[(repo_root | length) + (sep | length):] -%}
{%- set fl = namespace(v=[]) -%}
{{- ec.form_law(fl, tr, sep) -}}
{%- set law = fl.v -%}
{{- v.extend(law) or '' -}}
{%- set ok_law = law | length == 0 -%}
{%- set tv = namespace(v={}) -%}
{{- ec.target_vars(tv, tr) -}}
{%- set tvars = tv.v -%}
{%- set fm = namespace(violations=[], valid=false, guard=none, family=none, head=[]) -%}
{{- ec.dir_forms(fm, tr, sep, tr_rel, tr_rel, F.entries_head) -}}
{{- v.extend(fm.violations) or '' -}}
{%- for ename, decl in tr.entries.items() -%}
{%- set plays = lookup('ansible.builtin.file', tr_dir ~ '/' ~ ename) | from_yaml -%}
{%- if (plays | map(attribute='name') | list) != (decl | map(attribute='id') | list) -%}
{{ v.append(ename ~ ': plays ' ~ (plays | map(attribute='name') | list | to_json) ~ ' != declared ' ~ (decl | map(attribute='id') | list | to_json)) or '' }}
{%- endif -%}
{#- ENTRY GUARD (codex tick318-321 item 2; decl entry_guard): the derived names are never play vars; the FIRST play of
    each host class (localhost / target) starts with exactly the head of this directory's declared entry form (macro
    entry_head; rendered includes, codex-tick405 Q3); a later play of that host class never includes the guard again.
    Structural string equality only; nothing is evaluated. -#}
{%- set eg = namespace(seen=[]) -%}
{%- for p in plays -%}
{%- set d = decl | selectattr('id', 'equalto', p.name | default('')) | first | default({'hosts': F.placement.undeclared, 'kind': F.placement.undeclared}) -%}
{%- set pa = ename ~ ':' ~ (p.name | default('?')) -%}
{%- set pr = play_rules(tr, p, pa, d.hosts) | trim | from_json -%}
{{- v.extend(pr.violations) or '' -}}
{%- set placed = pr.placed -%}
{%- set g = tr.entry_guard -%}
{#- TRANSFER-FIRST-GUARD-CHECKER (codex-tick333) (a)/(c) and the positions of codex-tick333 (2), now through the
    rendered entry form of this directory (macro entry_head; codex-tick405 Q3) -#}
{%- set fst = placed not in eg.seen -%}
{%- if fst -%}{%- set eg.seen = eg.seen + [placed] -%}{%- endif -%}
{%- set eh = entry_head(F, g, sep, fm, p.tasks | default([]), pa, fst) | trim | from_json -%}
{{- v.extend(eh.violations) or '' -}}
{%- if placed == F.placement.target -%}
{%- for cv in tr.contract.conn_vars + tr.contract.credential_selectors.bind_key + tr.contract.credential_selectors['clear'] -%}
{%- if (p.vars | default({}))[cv] | default('') != tvars[cv] -%}
{{ v.append(pa ~ ': connection var ' ~ cv ~ ' not bound to the contract') or '' }}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- set rows = walk(p.tasks | default([]), pa, tr, tr_dir, sep, 0, none, fm.family) | trim | split('\n') | select | map('from_json') | list -%}
{%- set n.rows = n.rows + (rows | length) -%}
{#- TRANSFER-RECURSIVE-GUARD-REENTRY-COVERAGE (codex-tick341-347): the top-level collectors (entry_head guards / families) see only
    the play's DIRECT tasks. Re-entry is also possible through anything walk() reaches: a B tasks include (recursive,
    any depth it walks), a block / rescue / always, or a differently-rooted include. Every walked row whose included
    file is either guard (by basename: route, B, rendered family form or UNRESOLVED alike) is counted; the ONLY admitted ones
    are the direct top-level includes already counted in gin / fin (and position-checked above on first entry, refused
    above on a later play). Any surplus is a re-entry, refused with its walk path. -#}
{%- set grd = [g.guard_route_rel | basename, g.family_rel | basename] -%}
{%- set grows = rows | selectattr('include', 'defined') | selectattr('file', 'defined')
                     | selectattr('file', 'string') | list -%}
{%- set grows = grows | selectattr('file', 'match', '^(.*/)?(' ~ (grd | map('regex_escape') | join('|')) ~ ')$') | list -%}
{#- s6: no re-entry verdict from a withheld entry_head (its counts are not observations; the cause is recorded) -#}
{%- if not (eh.withheld | default(false)) and (grows | length) > (eh.guards | int) + (eh.families | int) -%}
{{ v.append(pa ~ ': re-enters an entry guard (' ~ (grd | join(' / ')) ~ ') through a nested include or block: '
            ~ (grows | rejectattr('via', 'equalto', pa) | map(attribute='via') | list
               + (grows | selectattr('via', 'equalto', pa) | map(attribute='task') | list)) | to_json
            ~ ' (a guard runs once, as a direct task of the first entry of its host; never reachable from another include)') or '' }}
{%- endif -%}
{%- if placed == F.placement.target -%}
{%- set ic = tr.initial_contact -%}
{%- for pv in ic.refused_play_vars -%}
{%- if pv in (p.vars | default({})) -%}{{ v.append(pa ~ ': root target play binds ' ~ pv ~ ' (the PRIVILEGED contact owns it)') or '' }}{%- endif -%}
{%- endfor -%}
{%- if p.become is defined or p.become_user is defined -%}{{ v.append(pa ~ ': root target play sets become') or '' }}{%- endif -%}
{%- set icn = namespace(seen=false) -%}
{%- for r in rows -%}
{%- set at = pa ~ ' [' ~ r.via ~ '] ' ~ r.task ~ ': ' -%}
{%- for iv in r.ivars | default([]) | select('in', ic.refused_include_vars) -%}{{ v.append(at ~ 'include parameter ' ~ iv ~ ' on a root target play') or '' }}{%- endfor -%}
{%- if r.become | default(false) -%}{{ v.append(at ~ 'become on a root target play') or '' }}{%- endif -%}
{%- if not icn.seen -%}
{%- if r.include | default('') == 'route' and r.file == ic.route_rel -%}{%- set icn.seen = true -%}
{%- if r.ic_variant != ic.variant -%}{{ v.append(at ~ 'INITIAL CONTACT variant ' ~ (r.ic_variant | string) ~ ' on a root target play (declared ' ~ ic.variant ~ ')') or '' }}{%- endif -%}
{%- elif r.include | default('') == 'route' and r.file not in ic.pre_contact_route -%}{{ v.append(at ~ 'route include ' ~ r.file ~ ' before INITIAL CONTACT') or '' }}
{%- elif r.module not in ic.contact_free_modules -%}{{ v.append(at ~ 'module ' ~ r.module ~ ' before INITIAL CONTACT') or '' }}
{%- endif -%}
{%- elif r.include | default('') == 'route' and r.file in ic.owner_only_route and not (r.ctl | default(false)) -%}{{ v.append(at ~ 'owner-only route include ' ~ r.file ~ ' in target context after the PRIVILEGED contact') or '' }}
{%- endif -%}
{%- endfor -%}
{%- if not icn.seen -%}{{ v.append(pa ~ ': target play never includes ' ~ ic.route_rel ~ ' (INITIAL CONTACT)') or '' }}{%- endif -%}
{%- endif -%}
{{- bfiles.extend(rows | selectattr('include', 'defined') | selectattr('include', 'equalto', 'b') | map(attribute='file') | list) or '' -}}
{%- for r in rows -%}
{%- set at = pa ~ ' [' ~ r.via ~ '] ' ~ r.task ~ ': ' -%}
{%- if r.include | default('') == 'UNRESOLVED' -%}{{ v.append(at ~ 'unresolved include ' ~ r.file) or '' }}{%- endif -%}
{%- if r.include | default('') == 'route' -%}
{%- set ri = tr.route_includes | selectattr('rel', 'equalto', r.file) | first | default(none) -%}
{%- if ri is none -%}{{ v.append(at ~ 'undeclared route include ' ~ r.file) or '' }}
{%- elif lookup('ansible.builtin.file', repo_root ~ '/' ~ r.file, lstrip=BD.read.lstrip, rstrip=BD.read.rstrip) | hash('sha256') != ri.sha256 -%}{{ v.append(at ~ 'route include sha256 drift ' ~ r.file) or '' }}
{%- endif -%}
{%- endif -%}
{%- if d.kind == 'observe' -%}
{%- if r.module not in tr.observe_modules -%}{{ v.append(at ~ 'module ' ~ r.module ~ ' in an observe play') or '' }}{%- endif -%}
{%- if r.module == 'ansible.builtin.command' and r.changed_when != 'False' -%}{{ v.append(at ~ 'command without changed_when false in an observe play') or '' }}{%- endif -%}
{%- if r.delegate_to is not none -%}{{ v.append(at ~ 'delegation in an observe play') or '' }}{%- endif -%}
{%- else -%}
{%- if r.module not in (tr.observe_modules + tr.effect_modules) -%}{{ v.append(at ~ 'undeclared module ' ~ r.module) or '' }}{%- endif -%}
{%- if r.delegate_to is not none and r.delegate_to != 'localhost' -%}{{ v.append(at ~ 'delegation to ' ~ r.delegate_to) or '' }}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{#- ---- DECLARED ENTRY SETS (codex-tick405 Q1): every other declared entry, read from <repo_root>/<dir>/<file>, against
