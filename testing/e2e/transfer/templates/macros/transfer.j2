{%- endfor -%}
{%- endif -%}
{%- endif -%}
{%- if (sp | map(attribute='name') | list) != (sdecl | map(attribute='id') | list) -%}
{{ v.append(sid ~ ': plays ' ~ (sp | map(attribute='name') | list | to_json) ~ ' != declared ' ~ (sdecl | map(attribute='id') | list | to_json)) or '' }}
{%- endif -%}
{%- set seg = namespace(seen=[]) -%}
{%- for p in sp -%}
{%- set d = sdecl | selectattr('id', 'equalto', p.name | default('')) | first | default({'hosts': F.placement.undeclared}) -%}
{%- set pa = sid ~ ':' ~ (p.name | default('?')) -%}
{%- set pr = play_rules(tr, p, pa, d.hosts) | trim | from_json -%}
{{- v.extend(pr.violations) or '' -}}
{%- set fst = pr.placed not in seg.seen -%}
{%- if fst -%}{%- set seg.seen = seg.seen + [pr.placed] -%}{%- endif -%}
{%- set eh = entry_head(F, tr.entry_guard, sep, sfm, p.tasks | default([]), pa, fst) | trim | from_json -%}
