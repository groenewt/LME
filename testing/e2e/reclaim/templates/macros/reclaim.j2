{#- testing/e2e/reclaim/templates/macros/reclaim.j2 -- B-owned reusable macros for the deploy_gate reclaim fragment
    (codex-tick333 TASK 1, render source (b)). Separately scoped: NOT part of transfer.j2, NOT a seed/bootstrap macro.
    Rendered only by the route's registered-artifact renderer (shared_artifacts.reclaim_gate; C1 proposal) from the
    resolved controller.bootstrap.reclaim node, which the entry template passes as the ONLY argument: this module has
    no free variables, uses builtin filters/tests (+ match) only, and never names the machine-binding field.
    Every value that reaches shell text is checked against a fixed safe-word pattern first; ANY mismatch renders
    fail-closed functions (cleanup BLOCKED, rc 2) instead of text built from the value. -#}

{%- macro safe(v) -%}{{ '1' if (v is string and v is match('^[A-Za-z0-9_./-]+$') and '..' ~ '/' ~ '..' not in v) else '0' }}{%- endmacro -%}

{%- macro node_ok(n) -%}
{%- set ok = namespace(v=(n is mapping and n.revision is defined and n.revision == 1
     and n.entry_rel is defined and n.check is defined and n.pass_statuses is defined
     and n.blocked_statuses is defined and n.stages is mapping)) -%}
{%- if ok.v -%}
{%- for w in [n.entry_rel, n.check] + n.pass_statuses + n.blocked_statuses -%}{%- if safe(w) != '1' -%}{%- set ok.v = false -%}{%- endif -%}{%- endfor -%}
{%- for k in n.stages | sort -%}
{%- set s = n.stages[k] -%}
{%- if not (s is mapping and safe(k) == '1' and safe(s.fn | default('')) == '1' and safe(s.op | default('')) == '1'
            and safe(s.say | default('')) == '1' and s.fn in ['do_wipe', 'do_teardown']) -%}{%- set ok.v = false -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ '1' if ok.v else '0' }}
{%- endmacro -%}

{#- the fail-closed body: same function names, cleanup BLOCKED, rc 2, no target contact -#}
{%- macro refused(fn) -%}
{{ fn }}() {
  say "RECLAIM REFUSED: the rendered reclaim node was not admitted at render time"
  emit_gate_result cleanup true true false BLOCKED none RECLAIM-RENDER-INPUT
  return 2
}
{% endmacro -%}

{#- one stage: the ONLY action is the seed launcher start of reclaim.yml (gate_seed_run, the gate's existing custody
    path); PASS only for a receipt carrying THIS call's nonce and a pass status. No hostname test, no ssh, no rm. -#}
{%- macro stage_fn(n, s) -%}
{{ s.fn }}() {
  local nonce receipt rc status
  nonce="$(date -u +%Y%m%dT%H%M%S)-$$-${RANDOM}${RANDOM}"
  receipt="$LME_TRANSFER_STATE_DIR/gate.$LABEL.reclaim.{{ s.op }}.json"
  say "{{ s.say }} (declared ownership only; reclaim.yml op={{ s.op }})"
  gate_seed_run {{ n.entry_rel }} -e "lme_reclaim_op={{ s.op }}" -e "lme_reclaim_nonce=$nonce" \
    -e "lme_reclaim_approval=${LME_RECLAIM_APPROVAL:-}"; rc=$?
  if [ "$rc" -ne 0 ]; then
    emit_gate_result {{ n.check }} true true false BLOCKED "$LOG" "RECLAIM_REFUSED: op={{ s.op }} rc=$rc"
    return 1
  fi
  if [ ! -s "$receipt" ] || ! grep -Fq "\"nonce\": \"$nonce\"" "$receipt"; then
    emit_gate_result {{ n.check }} true true true FAIL "$LOG" "RECLAIM_NO_RECEIPT: op={{ s.op }} rc=0 without a receipt for this call"
    return 1
  fi
  status=""
{%- for st in n.pass_statuses %}
  grep -Fq "\"status\": \"{{ st }}\"" "$receipt" && status=PASS
{%- endfor %}
{%- for st in n.blocked_statuses %}
  grep -Fq "\"status\": \"{{ st }}\"" "$receipt" && status="BLOCKED:{{ st }}"
{%- endfor %}
  case "$status" in
    PASS) emit_gate_result {{ n.check }} true true true PASS "$receipt" ""; return 0;;
    BLOCKED:*) emit_gate_result {{ n.check }} true true true BLOCKED "$receipt" "RECLAIM-JOIN-PENDING: ${status#BLOCKED:}"; return 1;;
    *) emit_gate_result {{ n.check }} true true true FAIL "$receipt" "RECLAIM_RECEIPT_STATUS: op={{ s.op }}"; return 1;;
  esac
}
{% endmacro -%}

{%- macro gate_functions(n) -%}
# generated by the route's registered-artifact renderer from controller.bootstrap.reclaim (B: templates/macros/reclaim.j2);
# sourced by deploy_gate.sh after its digest is verified against the bundle. Do not edit.
{% if node_ok(n) == '1' -%}
{%- for k in n.stages | sort %}
{{ stage_fn(n, n.stages[k]) }}
{%- endfor %}
{%- else -%}
{{ refused('do_wipe') }}
{{ refused('do_teardown') }}
{%- endif %}
{%- endmacro -%}
