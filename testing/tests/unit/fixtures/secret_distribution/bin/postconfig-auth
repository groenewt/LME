#!/usr/bin/env python3
"""Synthetic post-config consumer for the cluster secret handoff test."""

import json
import os
from pathlib import Path
import sys


root = Path(os.environ["LME_FAKE_PODMAN_ROOT"])
producer = root / "producer"
checks = json.load(sys.stdin)
for name, supplied in checks.items():
    if not supplied or supplied != (producer / name).read_text(encoding="utf-8"):
        raise SystemExit(23)

with open(root / "postconfig.log", "a", encoding="utf-8") as stream:
    stream.write("authenticated|%s|elastic,kibana_system\n" % os.environ["LME_SECRET_SCOPE_HOST"])
