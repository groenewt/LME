    path that starts controller.bootstrap. (one field). Returns {patch, why}; why != '' is a declaration error. -#}
{%- macro profile_case_patch(pc) -%}
{%- set pre = 'controller.bootstrap.' -%}
{%- if pc is not mapping -%}{{ {'patch': {}, 'why': 'profile case is not a mapping'} | to_json }}
{%- elif pc.patch_bootstrap is defined and pc.patch is defined -%}{{ {'patch': {}, 'why': 'profile case ' ~ (pc.id | default('?')) ~ ' declares both patch_bootstrap and patch'} | to_json }}
{%- elif pc.patch_bootstrap is defined -%}
{%- if pc.patch_bootstrap is mapping and pc.patch_bootstrap | length > 0 -%}{{ {'patch': pc.patch_bootstrap, 'why': ''} | to_json }}
{%- else -%}{{ {'patch': {}, 'why': 'profile case ' ~ (pc.id | default('?')) ~ ' patch_bootstrap is not a non-empty mapping'} | to_json }}{%- endif -%}
{%- elif pc.patch is defined and pc.patch is mapping and (pc.patch.keys() | list | sort) == ['path', 'value'] and pc.patch.path is string
      and pc.patch.path.startswith(pre) and (pc.patch.path[pre | length:].split('.') | reject('match', '^[A-Za-z0-9_]+$') | list | length == 0) -%}
