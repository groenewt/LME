{#- testing/remote_harness/tests/controls/templates/macros/controls.j2 -- the lifecycle-control engine's pure functions
    (owner: G). Every macro returns JSON text; tasks call them through templates/call.j2 and `from_json`.
    No macro touches the filesystem or executes anything: tasks gather observations, macros plan and judge.

    ctx (built by tasks/prepare.yml and tasks/one_control.yml):
      t          token map for {name} expansion (strings; `envelope_memory_plus_1` is an int)
      rh         the resolved harness policy (controller ...)
      refusals   controller.bootstrap.refusals
      vocab      controls.yml vocabulary
      env        {HOME, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS} carried from the runner
      tools      declared absolute tools the runner itself uses (strace, timeout, env, sh ...)
      repo       candidate repository root; variant_repo: admitted variant root or ''
      receipt    {ansible_config, collections_path} read from the shared root's published receipt (or {})
      bundles    {a: path, b: path}
      override   lme_global_override value for a declaration variant routed through SEED-06, or {} -#}

{#- ---------------------------------------------------------------- tokens ---------------------------------- -#}
{%- macro expand(s, t) -%}
{%- set ns = namespace(v = s | string) -%}
{%- for k in t -%}{%- set ns.v = ns.v | replace('{' ~ k ~ '}', t[k] | string) -%}{%- endfor -%}
{{- ns.v -}}
{%- endmacro -%}

{%- macro xjson(o, t) -%}
{%- if o is mapping -%}
{{ '{' }}{%- for k in o -%}{{ k | to_json }}: {{ xjson(o[k], t) }}{{ ', ' if not loop.last else '' }}{%- endfor -%}{{ '}' }}
{%- elif o is string -%}
{%- set m = o | regex_search('^\\{([a-z0-9_]+)\\}$', '\\1') -%}
{%- if m and (m[0] in t) and (t[m[0]] is number) -%}{{ t[m[0]] | to_json }}{%- else -%}{{ expand(o, t) | to_json }}{%- endif -%}
{%- elif o is iterable -%}
[{%- for v in o -%}{{ xjson(v, t) }}{{ ', ' if not loop.last else '' }}{%- endfor -%}]
{%- else -%}{{ o | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- tokens that survived expansion: a declaration error, never silently passed to an entrypoint -#}
{%- macro residual(text) -%}
{{ text | regex_findall('\\{[a-z][a-z0-9_]*\\}') | unique | list | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ vocabulary --------------------------------- -#}
{#- keys a control uses that the runner does not implement -> UNIMPLEMENTED (fails acceptance, never QUEUED) -#}
{#- ops: a list of op maps; returns reasons -#}
{%- macro _ops_unimpl(ops, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{#- an op map's FIRST key is its kind; the other keys (mode, content, target) are its options -#}
{%- for o in ops -%}
{%- set k = o | list | first -%}
{%- if k not in vocab.ops or k in (ni.ops | default([])) -%}{%- set ns.u = ns.u + ['op ' ~ k] -%}{%- endif -%}
{%- for opt in (o | list)[1:] if opt not in vocab.op_options -%}{%- set ns.u = ns.u + ['op option ' ~ k ~ '.' ~ opt] -%}{%- endfor -%}
{%- if o[k] is mapping -%}{%- for opt in o[k] if opt in (ni.op_options | default([])) -%}{%- set ns.u = ns.u + ['op option ' ~ k ~ '.' ~ opt] -%}{%- endfor -%}{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{%- macro _preds_unimpl(preds, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{%- for p in preds -%}
{%- set k = p | list | reject('in', ['exists', 'equal', 'contains', 'lacks', 'regex', 'json_equal', 'json_all']) | first -%}
{%- if k not in vocab.predicates or k in (ni.predicates | default([])) -%}{%- set ns.u = ns.u + ['predicate ' ~ k] -%}{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{%- macro _steps_unimpl(steps, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{%- for s in steps -%}
{%- set kinds = s | list | reject('in', vocab.step_common) | list -%}
{%- if kinds | length != 1 or kinds[0] not in vocab.steps or kinds[0] in (ni.steps | default([])) -%}{%- set ns.u = ns.u + ['step ' ~ (s.id | default('?')) ~ ' kinds ' ~ (kinds | join(','))] -%}{%- endif -%}
{%- for k in (s.expect | default({})) if k not in vocab.expect -%}{%- set ns.u = ns.u + ['expect ' ~ k] -%}{%- endfor -%}
{%- set ns.u = ns.u + (_preds_unimpl((s.state | default([])) + (s.post_state | default([])), vocab) | from_json) -%}
{%- set ns.u = ns.u + (_ops_unimpl(s.ops | default([]), vocab) | from_json) -%}
{%- if s.act is defined and s.act.kind not in vocab.acts -%}{%- set ns.u = ns.u + ['act ' ~ s.act.kind] -%}{%- endif -%}
{%- if s.wait is defined -%}{%- for k in s.wait if k not in vocab.waits + ['step'] -%}{%- set ns.u = ns.u + ['wait ' ~ k] -%}{%- endfor -%}{%- endif -%}
{%- if s.kill is defined -%}{%- for k in s.kill if k not in vocab.kill_options -%}{%- set ns.u = ns.u + ['kill ' ~ k] -%}{%- endfor -%}{%- endif -%}
{%- if s.act is defined -%}{%- for k in s.act if k not in vocab.act_keys -%}{%- set ns.u = ns.u + ['act key ' ~ k] -%}{%- endfor -%}{%- endif -%}
{#- G never reaches hosts: every declared target (and every address-valued host/extra var) is an RFC 5737 TEST-NET-1 address
    (vocab.target_address_regex); anything else is a declaration error -> UNIMPLEMENTED, never executed -#}
{%- if s.act is defined and s.act.inventory_targets is defined -%}
{%- for h in s.act.inventory_targets -%}
{%- set hv = s.act.inventory_targets[h] | default({}, true) -%}
{%- if not ((hv.ansible_host | default('') | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['inventory_targets ' ~ h ~ ' ansible_host is not a TEST-NET-1 address'] -%}{%- endif -%}
{%- for k in ['ansible_ssh_host'] if k in hv and not ((hv[k] | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['inventory_targets ' ~ h ~ ' ' ~ k ~ ' is not a TEST-NET-1 address'] -%}{%- endfor -%}
{%- endfor -%}
{%- endif -%}
{%- if s.act is defined -%}{%- for k in ['ansible_host', 'ansible_ssh_host'] if k in (s.act.extra_vars | default({})) and not ((s.act.extra_vars[k] | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['extra var ' ~ k ~ ' is not a TEST-NET-1 address'] -%}{%- endfor -%}{%- endif -%}
{%- if s.repeat is defined -%}{%- set ns.u = ns.u + (_steps_unimpl(s.repeat.steps, vocab) | from_json) -%}{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{#- keys a control uses that the runner does not implement -> UNIMPLEMENTED (fails acceptance, never QUEUED).
    Per variant: returns {variant id: [reasons]} ('base' when the control has no variants). -#}
{%- macro unimplemented(c, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(common = [], out = {}) -%}
{%- for k in c if k not in vocab.control_keys -%}{%- set ns.common = ns.common + ['control key ' ~ k] -%}{%- endfor -%}
{%- set ns.common = ns.common + (_ops_unimpl((c.setup | default([])) + (c.undo | default([])), vocab) | from_json)
                  + (_steps_unimpl(c.steps | default([]), vocab) | from_json) -%}
{%- if c.sweep is defined and (c.sweep.kind not in vocab.sweeps or c.sweep.kind in (ni.sweeps | default([]))) -%}{%- set ns.common = ns.common + ['sweep ' ~ c.sweep.kind] -%}{%- endif -%}
{%- for sc in c.static_checks | default([]) -%}
{%- for k in sc if k not in vocab.static_checks or k in (ni.static_checks | default([])) -%}{%- set ns.common = ns.common + ['static check ' ~ k] -%}{%- endfor -%}
{%- for k in sc -%}
{%- for n in (sc[k].negative_controls | default([])) if n.kind not in ((vocab.static_check_mutations | default({}))[k] | default([])) -%}{%- set ns.common = ns.common + ['static check ' ~ k ~ ' mutation ' ~ n.kind] -%}{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{%- if c.declared_only is defined -%}{%- set ns.common = ns.common + ['declared_only (no executable steps in this runner)'] -%}{%- endif -%}
{%- for v in (c.variants | default([{'id': 'base'}])) -%}
{%- set ns.v = [] -%}
{%- for k in v if k not in vocab.variant_keys -%}{%- set ns.v = ns.v + ['variant key ' ~ k] -%}{%- endfor -%}
{%- set ns.v = ns.v + (_ops_unimpl((v.ops | default([])) + (v.undo | default([])), vocab) | from_json) -%}
{%- for sid in (v.expect | default({})) -%}{%- for k in v.expect[sid] if k not in vocab.expect -%}{%- set ns.v = ns.v + ['expect ' ~ k] -%}{%- endfor -%}{%- endfor -%}
{%- set ns.out = ns.out | combine({v.id: (ns.common + ns.v) | unique | list}) -%}
{%- endfor -%}
{{ ns.out | to_json }}
{%- endmacro -%}

{#- status before execution. deps: {name: {met: bool, kind, why}}; unimpl: [reasons] for this variant.
    applies_when {ruling: <dependency of kind ruling>, options: [...]}: unruled -> QUEUED; ruled another option -> NOT-APPLICABLE.
    retire_when <dependency>: once it is met the control is RETIRED -> NOT-APPLICABLE (recorded, never coverage).
    A requirement of kind main_only -> MAIN-ONLY (MAIN's run population; G never runs it; never PASS/coverage on G).
    Returns {status: QUEUED|MAIN-ONLY|UNIMPLEMENTED|RESIDUAL|OPEN-REGRESSION|NOT-APPLICABLE|READY, why: [...]} -#}
{%- macro plan_status(c, variant, deps, unimpl) -%}
{#- a declaration variant requires its route: variant_checkout: clone -> the declared clone fixture (always that route,
    tasks/variant_admit.yml); otherwise variant:<id> (override or MAIN-staged copy, as that declaration permits) -#}
{%- set req = (c.requires | default([])) + (variant.requires | default([]))
              + (((['variant_clone_fixture'] if (c.variant_checkout | default('')) == 'clone' else ['variant:' ~ (variant.declaration | default(c.declaration))]))
                 if (variant.declaration | default(c.declaration | default(''))) else []) -%}
{%- set ns = namespace(queued = [], after = [], main = false) -%}
{%- for r in req -%}
{%- set d = deps[r] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared dependency'}) -%}
{%- if d.kind == 'main_only' -%}{%- set ns.main = true -%}{%- endif -%}
{%- if d.kind == 'control' and not d.met -%}{%- set ns.after = ns.after + ['after ' ~ d.control] -%}
{%- elif not d.met -%}{%- set ns.queued = ns.queued + [r ~ ': ' ~ d.why] -%}{%- endif -%}
{%- endfor -%}
{%- set aw = c.applies_when | default(none) -%}
{%- set ad = (deps[aw.ruling] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared ruling'})) if aw else none -%}
{%- set rw = c.retire_when | default(none) -%}
{%- set rd = (deps[rw] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared dependency'})) if rw else none -%}
{#- P04/P06: a control is planned only against the bytes it was authored for. bound_bytes_current (prepare.yml) digests every
    bound_bytes_at_authoring path; any mismatch or absence re-queues EVERY control before any other rule (also retire/applies_when,
    whose probes read the changed bytes). codex 023332 G-CURRENT-BINDING: a MISSING bound_bytes_current (binding never evaluated)
    is the same as an unmet one -- no older-harness fallback; an absent/empty/non-digest binding is refused in prepare.yml. -#}
{%- set bb = deps['bound_bytes_current'] | default({'met': false, 'why': 'binding not evaluated (no bound_bytes_current dependency; no older-harness fallback)'}) -%}
{%- if not bb.met -%}{{ {'status': 'QUEUED', 'why': ['stale-binding: ' ~ bb.why] + ns.queued} | to_json }}
{%- elif rw and rd.met -%}{{ {'status': 'NOT-APPLICABLE', 'why': ['retired: ' ~ rw ~ ' is met (' ~ rd.why ~ ')']} | to_json }}
{%- elif aw and ad.met and ad.value not in aw.options -%}{{ {'status': 'NOT-APPLICABLE', 'why': [aw.ruling ~ ' ruled ' ~ ad.value ~ '; this control declares option ' ~ (aw.options | join('|'))]} | to_json }}
{%- elif aw and not ad.met -%}{{ {'status': 'QUEUED', 'why': [aw.ruling ~ ': ' ~ ad.why] + ns.queued} | to_json }}
{#- a variant requiring a main_only dependency is MAIN's run population (root / another uid / a real target, or a codex
    ruling that made it MAIN's): never QUEUED on G, never NOT-APPLICABLE, never coverage here; its other unmet deps are listed -#}
{%- elif ns.main -%}{{ {'status': 'MAIN-ONLY', 'why': ns.queued} | to_json }}
{%- elif c.result_class is defined -%}{{ {'status': c.result_class, 'why': [c.declared_only | default(c.note | default(''))] + ns.queued} | to_json }}
{%- elif ns.queued -%}{{ {'status': 'QUEUED', 'why': ns.queued} | to_json }}
{%- elif unimpl -%}{{ {'status': 'UNIMPLEMENTED', 'why': unimpl} | to_json }}
{%- else -%}{{ {'status': 'READY', 'why': ns.after} | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- ------------------------------------------------------------ case binding ------------------------------ -#}
{#- sources: [{prefix, ids}] ; returns unknown ids per control and source ids no control names -#}
{%- macro coverage(controls, sources) -%}
{%- set ns = namespace(known = [], unknown = [], named = []) -%}
{%- for s in sources -%}{%- set ns.known = ns.known + (s.ids | map('regex_replace', '^', s.prefix) | list) -%}{%- endfor -%}
{%- for c in controls -%}
{%- for id in c.cases | default([]) -%}
{%- set ns.named = ns.named + [id] -%}
{%- if id not in ns.known -%}{%- set ns.unknown = ns.unknown + [c.id ~ ' -> ' ~ id] -%}{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{{ {'unknown': ns.unknown, 'uncovered': ns.known | reject('in', ns.named) | list, 'known_count': ns.known | length} | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ argv ------------------------------------- -#}
{%- macro envp(ctx, extra, unset) -%}
{%- set bs = ctx.rh.controller.bootstrap -%}
{#- TMPDIR = <run dir>/act-tmp (created by execute.yml): a direct entrypoint (package/acquire via the builder, command acts)
    never falls back to /tmp under env -i; a seed sets its own TMPDIR for what it runs; an act's env may still override it -#}
{%- set ns = namespace(e = {'HOME': ctx.env.HOME, 'XDG_RUNTIME_DIR': ctx.env.XDG_RUNTIME_DIR, 'DBUS_SESSION_BUS_ADDRESS': ctx.env.DBUS_SESSION_BUS_ADDRESS,
                            'TMPDIR': (ctx.t.run ~ '/act-tmp') if (ctx.t.run | default('')) else ''}) -%}
{%- set ns.e = ns.e | combine(bs.base_env) | combine(extra | default({})) -%}
{%- set ns.a = [ctx.tools.env, '-i'] -%}
{%- for k in ns.e | sort if k not in (unset | default([])) and (ns.e[k] | string | length) > 0 -%}{%- set ns.a = ns.a + [k ~ '=' ~ ns.e[k]] -%}{%- endfor -%}
{{ ns.a | to_json }}
{%- endmacro -%}

{#- strace prefix: record (network / exec) or inject a delay at a syscall set, optionally restricted to a path -#}
{%- macro stracep(ctx, act, base) -%}
{%- set ns = namespace(a = []) -%}
{%- if act.strace is defined -%}
{%- set i = act.strace.inject -%}
{%- set sc = i.syscalls if i.syscalls is string else (i.syscalls | join(',')) -%}
{%- set ns.a = [ctx.tools.strace, '-f'] + ([] if act.strace.detach_on_tracer_kill | default(false) else ['--kill-on-exit'])
               + ['-qq', '-ttt', '-o', base ~ '.strace', '-e', 'trace=' ~ sc, '-e', 'inject=' ~ sc ~ ':delay_' ~ i.when ~ '=' ~ i.hold] -%}
{%- for p in ([act.strace.trace_path] if act.strace.trace_path is defined else []) -%}{%- set ns.a = ns.a + ['-P', p] -%}{%- endfor -%}
{%- elif act.trace_network | default(false) or act.trace_exec | default(false) -%}
{%- set sc = (['connect'] if act.trace_network | default(false) else []) + (['execve'] if act.trace_exec | default(false) else []) -%}
{%- set ns.a = [ctx.tools.strace, '-f', '-qq', '-s', '256', '-o', base ~ '.strace', '-e', 'trace=' ~ (sc | join(','))] -%}
{%- endif -%}
{{ ns.a | to_json }}
{%- endmacro -%}

{#- one action -> {argv, unit, cwd, out, err, strace, inventory, kill_token, timeout_s, async} -#}
{%- macro plan_act(step, ctx) -%}
{%- set act = step.act -%}
{%- set bs = ctx.rh.controller.bootstrap -%}
{%- set base = ctx.t.ctl ~ '/' ~ step.id -%}
{%- set repo = ctx.variant_repo if ((act.repo | default('candidate')) == 'variant' and ctx.variant_repo) else ctx.repo -%}
{%- set tkey = act.kind ~ ('_' ~ act.op if act.op is defined else '') -%}
{%- set to = act.timeout_s | default(ctx.timeouts[tkey] | default(ctx.timeouts.playbook)) -%}
{%- set ns = namespace(argv = [], inv = none, invvars = {}, kill = none, pbargs = []) -%}
{%- if act.kind == 'seed' -%}
{%- set bdir = ctx.bundles[act.bundle] if act.bundle in ctx.bundles else act.bundle -%}
{%- set ns.argv = (envp(ctx, act.env | default({}), []) | from_json)
                  + ([bs.os_tools.sh.path] if (act.invoke | default('')) == 'declared_sh' else [])
                  + [bdir ~ '/' ~ ctx.entry.seed, act.op, '--root', act.root] -%}
{%- if act.op == 'purge' -%}{%- set ns.argv = ns.argv + ['--confirm', act.root] -%}{%- endif -%}
{%- if act.op == 'run' and not (act.no_ssh_auth | default(false)) -%}{%- set ns.argv = ns.argv + ['--ssh-auth', act.ssh_auth | default(ctx.seed_run_auth_mode)] -%}{%- endif -%}
{%- set ns.argv = ns.argv + (act.raw_args | default([])) + (act.args | default([])) -%}
{%- set ns.kill = ' --root ' ~ act.root -%}
{%- elif act.kind == 'command' -%}
{%- set ns.argv = (envp(ctx, act.env | default({}), act.unset_env | default([])) | from_json) + act.argv -%}
{%- set ns.kill = base ~ '.stdout' -%}
{%- else -%}
{#- playbook-shaped: package / acquire / controller / rendered control playbooks -#}
{%- set pb_key = act.playbook | default(act.kind) -%}
{%- set pb = (ctx.t.ctl ~ '/playbooks/' ~ pb_key ~ '.yml') if pb_key in ctx.rendered_playbooks else (repo ~ '/' ~ ctx.entry[pb_key]) -%}
{%- set via = act.via | default('builder') -%}
{%- set ns.inv = base ~ '.inventory.yml' -%}
{%- set iv = {'ansible_connection': 'local',
              'ansible_python_interpreter': bs.genesis.builder.python if via in ['builder', 'builder_ambient'] else '{{ ansible_playbook_python }}'} -%}
{%- if pb_key in ['package', 'acquire'] -%}
{%- set iv = iv | combine({'rh_artifact_source': act.source | default(ctx.t.src), 'rh_bundle_dir': act.dest | default(ctx.t.ctl ~ '/bundle')}) -%}
{%- elif not (act.inventory_omit_root | default(false)) -%}
{%- set iv = iv | combine({bs.inventory.root_var: act.inventory_root | default(act.root | default(ctx.t.shared)),
                           bs.inventory.owner_var: act.inventory_owner | default(ctx.t.user)}) -%}
{%- endif -%}
{%- set ns.invvars = iv | combine(act.inventory_extra | default({})) | combine((ctx.override_inventory | default({})) if (act.repo | default('candidate')) == 'variant' else {}) -%}
{%- set ns.pbargs = ['-i', ns.inv, pb] + (['--limit', act.limit] if act.limit is defined else []) -%}
{%- for k in (act.extra_vars | default({})) -%}{%- set ns.pbargs = ns.pbargs + ['-e', k ~ '=' ~ act.extra_vars[k]] -%}{%- endfor -%}
{#- extra_vars_json: ONE structured -e (JSON), after the k=v pairs -- e.g. the lme_resolved_run mapping a runner requires -#}
{%- if act.extra_vars_json is defined -%}{%- set ns.pbargs = ns.pbargs + ['-e', act.extra_vars_json | to_json] -%}{%- endif -%}
{%- if via == 'seed_run' -%}
{%- set b = act.bundle | default('a') -%}
{%- set bdir = ctx.bundles[b] if b in ctx.bundles else b -%}
{%- set ns.argv = (envp(ctx, act.env | default({}), []) | from_json)
                  + [bdir ~ '/' ~ ctx.entry.seed, 'run', '--root', act.root | default(ctx.t.shared), '--ssh-auth', act.ssh_auth | default(ctx.seed_run_auth_mode), '--'] + ns.pbargs -%}
{%- elif via == 'generation' -%}
{%- set ns.argv = (envp(ctx, {'ANSIBLE_CONFIG': ctx.receipt.ansible_config, 'ANSIBLE_COLLECTIONS_PATH': ctx.receipt.collections_path} | combine(act.env | default({})), act.unset_env | default([])) | from_json)
                  + [ctx.receipt.ansible_playbook] + ns.pbargs -%}
{%- else -%}
{%- set ns.argv = (envp(ctx, {'ANSIBLE_NOCOLOR': '1'} | combine(act.env | default({})), act.unset_env | default([])) | from_json)
                  + [act.executor | default(bs.genesis.builder.executable)] + ns.pbargs -%}
{%- endif -%}
{%- set ns.kill = ns.inv -%}
{%- endif -%}
{%- set pre = stracep(ctx, act, base) | from_json -%}
{%- set wrap = ctx.wraps[act.wrap | default('none')] -%}
{#- every act runs in its OWN transient user scope (r3e E30: a killed run is quiescent only once its recorded cgroup is
    empty; an act sharing the runner's session scope would stay LIVE forever). act.scope: shared opts out (E30 control). -#}
{%- set unit = (ctx.act_scope.unit_prefix ~ (base | hash('sha1'))[:20] ~ '.scope') if (act.scope | default(ctx.act_scope.default)) == 'own' else '' -%}
{%- set scope = [ctx.tools.systemd_run, '--user', '--scope', '--quiet', '--collect', '--unit=' ~ unit] if unit else [] -%}
{{ {'argv': scope + [ctx.tools.timeout, '--kill-after=10', (to | string) ~ 's'] + pre + wrap + ns.argv, 'unit': unit,
    'cwd': act.cwd | default(ctx.t.ctl ~ '/cwd'), 'out': base ~ '.stdout', 'err': base ~ '.stderr',
    'strace': (base ~ '.strace') if pre else '', 'inventory': ns.inv, 'inventory_vars': ns.invvars,
    'inventory_targets': act.inventory_targets | default({}), 'target_group': (bs.inventory | default({})).target_group | default(''),
    'kill_token': ns.kill, 'timeout_s': to | int, 'async': act.async | default(false),
    'kind': act.kind, 'op': act.op | default('')} | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ parsing ---------------------------------- -#}
{#- the task that failed: the last `TASK [..]` header before the first fatal:/failed: line -#}
{%- macro failed_task(stdout) -%}
{%- set ns = namespace(cur = '', hit = none) -%}
{%- for l in stdout.splitlines() if ns.hit is none -%}
{%- set h = l | regex_search('^TASK \\[(.*)\\] \\**$', '\\1') -%}
{%- if h -%}{%- set ns.cur = h[0] -%}{%- elif l is match('^(fatal|failed): ') -%}{%- set ns.hit = ns.cur -%}{%- endif -%}
{%- endfor -%}
{{ (ns.hit if ns.hit is not none else '') | to_json }}
{%- endmacro -%}

{%- macro outcome(stdout) -%}
{%- set ns = namespace(o = none) -%}
{%- for l in stdout.splitlines() -%}
{%- set m = l | regex_search('^(INSTALLED|UNCHANGED|VERIFIED|PURGED|ABSENT) (\\S+)(?: (\\S+))?$', '\\1', '\\2') -%}
{%- if m -%}{%- set ns.o = {'word': m[0], 'arg': m[1]} -%}{%- endif -%}
{%- endfor -%}
{{ ns.o | to_json }}
{%- endmacro -%}

{%- macro refusal(stderr) -%}
{%- set ns = namespace(r = none) -%}
{%- for l in stderr.splitlines() if ns.r is none -%}
{%- set m = l | regex_search('^REFUSED (\\S+)', '\\1') -%}
{%- if m -%}{%- set ns.r = m[0] -%}{%- endif -%}
{%- endfor -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{#- strace connect lines to anything but loopback -#}
{%- macro network_lines(trace) -%}
{{ trace.splitlines() | select('search', 'connect\\(') | select('search', 'AF_INET6?') | reject('search', 'inet_addr\\("127\\.') | reject('search', 'inet_pton\\(AF_INET6, "::1"') | list | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ judging ---------------------------------- -#}
{#- res: {rc, stdout, stderr, trace, killed_by_runner}; returns a list of failure reasons (empty = met) -#}
{%- macro judge(exp, res, ctx) -%}
{%- set ns = namespace(r = []) -%}
{%- set code = refusal(res.stderr | default('')) | from_json -%}
{%- set oc = outcome(res.stdout | default('')) | from_json -%}
{%- set ft = failed_task(res.stdout | default('')) | from_json -%}
{%- set rc = res.rc | default(-1) | int -%}
{%- set busy = ctx.rh.controller.bootstrap.lock.busy -%}
{%- if exp.record_only | default(false) -%}{{ [] | to_json }}
{%- elif exp.any_of is defined -%}
{#- met when ANY alternative is met (each judged alone, BUSY rule included); otherwise every alternative's reasons -#}
{%- set ns.alts = [] -%}
{%- for e in exp.any_of -%}{%- set ns.alts = ns.alts + [judge(e, res, ctx) | from_json] -%}{%- endfor -%}
{%- if ns.alts | select('equalto', []) | list | length > 0 -%}{{ [] | to_json }}
{%- else -%}{{ ['none of ' ~ (exp.any_of | length) ~ ' alternatives met: ' ~ (ns.alts | map('join', '; ') | join(' || '))] | to_json }}{%- endif -%}
{%- else -%}
{%- if code == busy and not (exp.busy_expected | default(false)) -%}{%- set ns.r = ns.r + ['BUSY-not-coverage: a step refused ' ~ busy ~ ' that did not expect it'] -%}{%- endif -%}
{#- r3e publish fence: a playbook refusing the staging busy code (RH-STAGING-BUSY) is never coverage unless the step expects BUSY -#}
{%- set pbusy = ctx.rh.controller.bootstrap.bundle.staging_retention.lease.busy_refusal | default('') if (ctx.rh.controller.bootstrap.bundle.staging_retention.lease is defined) else '' -%}
{%- if pbusy and ('REFUSED ' ~ pbusy) in (res.stdout | default('')) and not (exp.busy_expected | default(false)) -%}{%- set ns.r = ns.r + ['BUSY-not-coverage: the playbook refused ' ~ pbusy ~ ' and the step did not expect it'] -%}{%- endif -%}
{%- if (rc == 124 or rc == 137) and not (exp.killed | default(false)) -%}{%- set ns.r = ns.r + ['timed out or killed (rc ' ~ rc ~ ')'] -%}{%- endif -%}
{%- if exp.killed | default(false) and not (rc < 0 or rc >= 128) -%}{%- set ns.r = ns.r + ['expected to be killed by the runner, rc ' ~ rc] -%}{%- endif -%}
{%- if exp.rc is defined and rc != exp.rc | int -%}{%- set ns.r = ns.r + ['rc ' ~ rc ~ ' != ' ~ exp.rc] -%}{%- endif -%}
{%- if exp.rc_nonzero | default(false) and rc == 0 -%}{%- set ns.r = ns.r + ['rc 0, a refusal was expected'] -%}{%- endif -%}
{%- for want in ([exp.refusal] if exp.refusal is defined else []) -%}
{%- if code != want -%}{%- set ns.r = ns.r + ['refusal ' ~ (code | string) ~ ' != ' ~ want] -%}{%- endif -%}
{%- if rc != ctx.refusals[want] | default(-99) | int -%}{%- set ns.r = ns.r + ['exit ' ~ rc ~ ' != declared ' ~ want ~ ' status ' ~ (ctx.refusals[want] | default('undeclared'))] -%}{%- endif -%}
{%- endfor -%}
{%- if exp.refusal_any is defined -%}
{%- if code not in exp.refusal_any -%}{%- set ns.r = ns.r + ['refusal ' ~ (code | string) ~ ' not in ' ~ (exp.refusal_any | join('|'))] -%}
{%- elif rc != ctx.refusals[code] | int -%}{%- set ns.r = ns.r + ['exit ' ~ rc ~ ' != declared status of ' ~ code] -%}{%- endif -%}
{%- endif -%}
{%- if exp.outcome is defined and (oc is none or oc.word != exp.outcome) -%}{%- set ns.r = ns.r + ['outcome ' ~ ((oc.word if oc else 'none') | string) ~ ' != ' ~ exp.outcome] -%}{%- endif -%}
{%- if exp.outcome_any is defined and (oc is none or oc.word not in exp.outcome_any) -%}{%- set ns.r = ns.r + ['outcome ' ~ ((oc.word if oc else 'none') | string) ~ ' not in ' ~ (exp.outcome_any | join('|'))] -%}{%- endif -%}
{%- if exp.gen is defined and oc -%}
{%- if exp.gen == 'expected_a' and oc.arg != ctx.t.gen_id -%}{%- set ns.r = ns.r + ['generation ' ~ oc.arg ~ ' != bundle A ' ~ ctx.t.gen_id] -%}{%- endif -%}
{%- if exp.gen == 'new' and oc.arg == ctx.t.gen_id -%}{%- set ns.r = ns.r + ['generation did not change: ' ~ oc.arg] -%}{%- endif -%}
{%- endif -%}
{%- if exp.refused_at is defined and exp.refused_at is not none and not (ft is string and ft.startswith(exp.refused_at)) -%}{%- set ns.r = ns.r + ['failed task "' ~ ft ~ '" is not "' ~ exp.refused_at ~ '"'] -%}{%- endif -%}
{%- if exp.refused_at is defined and exp.refused_at is none and ft -%}{%- set ns.r = ns.r + ['unexpected failed task "' ~ ft ~ '"'] -%}{%- endif -%}
{%- if exp.refused_at_any is defined -%}
{%- set ns.ok = false -%}
{%- for n in exp.refused_at_any if ft and ft.startswith(n) -%}{%- set ns.ok = true -%}{%- endfor -%}
{%- if not ns.ok -%}{%- set ns.r = ns.r + ['failed task "' ~ ft ~ '" not among the expected'] -%}{%- endif -%}
{%- endif -%}
{%- if exp.failed_before_task is defined and (res.stdout | default('')) is search('TASK \\[' ~ (exp.failed_before_task | regex_escape)) -%}{%- set ns.r = ns.r + ['reached "' ~ exp.failed_before_task ~ '"'] -%}{%- endif -%}
{%- if exp.playbook_refusal is defined and ('REFUSED ' ~ exp.playbook_refusal) not in (res.stdout | default('')) -%}{%- set ns.r = ns.r + ['no "REFUSED ' ~ exp.playbook_refusal ~ '" in the playbook output'] -%}{%- endif -%}
{%- for s in exp.stdout_has | default([]) if s not in (res.stdout | default('')) -%}{%- set ns.r = ns.r + ['stdout lacks "' ~ s ~ '"'] -%}{%- endfor -%}
{%- for s in exp.stderr_has | default([]) if s not in (res.stderr | default('')) -%}{%- set ns.r = ns.r + ['stderr lacks "' ~ s ~ '"'] -%}{%- endfor -%}
{%- for s in exp.stdout_or_stderr_has | default([]) if s not in ((res.stdout | default('')) ~ (res.stderr | default(''))) -%}{%- set ns.r = ns.r + ['output lacks "' ~ s ~ '"'] -%}{%- endfor -%}
{%- if exp.stderr_regex is defined and not ((res.stderr | default('')) is search(exp.stderr_regex, multiline=true)) -%}{%- set ns.r = ns.r + ['stderr does not match ' ~ exp.stderr_regex] -%}{%- endif -%}
{%- if exp.stdout_regex is defined and not ((res.stdout | default('')) is search(exp.stdout_regex, multiline=true)) -%}{%- set ns.r = ns.r + ['stdout does not match ' ~ exp.stdout_regex] -%}{%- endif -%}
{%- for x in exp.stdout_not_regex | default([]) if (res.stdout | default('')) is search(x, multiline=true) -%}{%- set ns.r = ns.r + ['stdout matches forbidden ' ~ x] -%}{%- endfor -%}
{%- if exp.no_network | default(false) -%}
{%- set nl = network_lines(res.trace | default('')) | from_json -%}
{%- if nl | length > 0 -%}{%- set ns.r = ns.r + ['network connect: ' ~ (nl[:3] | join(' | '))] -%}{%- endif -%}
{%- if not res.trace | default('') and not res.trace_empty_ok | default(false) -%}{%- set ns.r = ns.r + ['no network trace recorded'] -%}{%- endif -%}
{%- endif -%}
{%- for x in exp.exec_seen | default([]) if ('execve("' ~ x ~ '"') not in (res.trace | default('')) -%}{%- set ns.r = ns.r + ['no execve of ' ~ x] -%}{%- endfor -%}
{%- for x in exp.no_exec_regex | default([]) -%}
{%- if (res.trace | default('')) is search('execve\\("' ~ x) -%}{%- set ns.r = ns.r + ['execve matching ' ~ x] -%}{%- endif -%}
{%- endfor -%}
{{ ns.r | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- two recorded results: exactly one meets `one_of`; the other meets one of `other_any` -#}
{%- macro judge_pair(spec, results, ctx) -%}
{%- set a = results[spec.steps[0]] -%}
{%- set b = results[spec.steps[1]] -%}
{%- set a1 = (judge(spec.one_of, a, ctx) | from_json) | length == 0 -%}
{%- set b1 = (judge(spec.one_of, b, ctx) | from_json) | length == 0 -%}
{%- set ns = namespace(r = []) -%}
{%- if a1 == b1 -%}{%- set ns.r = ['exactly one of ' ~ (spec.steps | join(', ')) ~ ' must meet ' ~ (spec.one_of | to_json) ~ '; both ' ~ ('did' if a1 else 'did not')] -%}
{%- else -%}
{%- set other = b if a1 else a -%}
{%- set ns.ok = false -%}
{%- for e in spec.other_any if (judge(e | combine({'busy_expected': true}), other, ctx) | from_json) | length == 0 -%}{%- set ns.ok = true -%}{%- endfor -%}
{%- if not ns.ok -%}{%- set ns.r = ['the other result meets none of ' ~ (spec.other_any | to_json)] -%}{%- endif -%}
{%- endif -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ state ------------------------------------ -#}
{#- obs: observations gathered by tasks/state.yml keyed by predicate index -#}
{%- macro judge_state(preds, obs, snaps) -%}
{%- set ns = namespace(r = []) -%}
{%- for p in preds -%}
{%- set o = obs[loop.index0] | default({}) -%}
{%- if p.path is defined and p.exists is defined and (o.exists | default(false)) != p.exists -%}{%- set ns.r = ns.r + [p.path ~ (' missing' if p.exists else ' exists')] -%}{%- endif -%}
{%- if p.glob is defined and (o.count | default(-1)) != p.glob.count | int -%}{%- set ns.r = ns.r + [p.glob.dir ~ '/' ~ p.glob.pattern ~ ': ' ~ (o.count | default('?')) ~ ' entries, expected ' ~ p.glob.count] -%}{%- endif -%}
{%- if p.file is defined -%}
{%- set text = o.text | default(none) -%}
{%- if text is none -%}{%- set ns.r = ns.r + [p.file ~ ' unreadable or missing'] -%}
{%- else -%}
{%- if p.contains is defined and p.contains not in text -%}{%- set ns.r = ns.r + [p.file ~ ' lacks "' ~ p.contains ~ '"'] -%}{%- endif -%}
{%- if p.lacks is defined and p.lacks in text -%}{%- set ns.r = ns.r + [p.file ~ ' contains "' ~ p.lacks ~ '"'] -%}{%- endif -%}
{%- if p.regex is defined and not (text is search(p.regex, multiline=true)) -%}{%- set ns.r = ns.r + [p.file ~ ' does not match ' ~ p.regex] -%}{%- endif -%}
{%- if p.json_equal is defined -%}
{%- set ns.v = text | from_json -%}
{%- for k in p.json_equal.path.split('.') -%}{%- set ns.v = ns.v[k] | default(none) if ns.v is mapping else none -%}{%- endfor -%}
{%- if ns.v != p.json_equal.value -%}{%- set ns.r = ns.r + [p.file ~ ' ' ~ p.json_equal.path ~ ' = ' ~ (ns.v | string) ~ ' != ' ~ p.json_equal.value] -%}{%- endif -%}
{%- endif -%}
{#- json_all {path, key, value}: the list at path is NON-EMPTY and every element's key equals value (e.g. every receipt row fetched) -#}
{%- if p.json_all is defined -%}
{%- set ns.v = text | from_json -%}
{%- for k in p.json_all.path.split('.') -%}{%- set ns.v = ns.v[k] | default(none) if ns.v is mapping else none -%}{%- endfor -%}
{%- if ns.v is string or ns.v is mapping or ns.v is not iterable or ns.v | length == 0 -%}{%- set ns.r = ns.r + [p.file ~ ' ' ~ p.json_all.path ~ ' is not a non-empty list'] -%}
{%- else -%}
{%- set bad = ns.v | rejectattr(p.json_all.key, 'defined') | list + (ns.v | selectattr(p.json_all.key, 'defined') | rejectattr(p.json_all.key, 'equalto', p.json_all.value) | list) -%}
{%- if bad -%}{%- set ns.r = ns.r + [p.file ~ ' ' ~ (bad | length) ~ ' of ' ~ (ns.v | length) ~ ' ' ~ p.json_all.path ~ ' entries have ' ~ p.json_all.key ~ ' != ' ~ p.json_all.value] -%}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- if p.same_bytes is defined and (o.checksums | default([]) | unique | list | length != 1 or (o.checksums | default([]) | length) != 2) -%}{%- set ns.r = ns.r + ['bytes differ: ' ~ (p.same_bytes | join(' vs '))] -%}{%- endif -%}
{%- if p.implies is defined and p.implies.then_exists is defined and (o.if_exists | default(false)) and not (o.then_exists | default(false)) -%}{%- set ns.r = ns.r + [p.implies.if_exists ~ ' visible without ' ~ p.implies.then_exists] -%}{%- endif -%}
{%- if p.implies is defined and p.implies.then_snapshot_equal is defined and (o.if_exists | default(false)) -%}
{%- set before = snaps[p.implies.then_snapshot_equal] | default(none) -%}
{%- if before is none or before.lines != (o.lines | default([])) -%}{%- set ns.r = ns.r + [p.implies.if_exists ~ ' exists but is not whole (snapshot ' ~ p.implies.then_snapshot_equal ~ ')'] -%}{%- endif -%}
{%- endif -%}
{%- if p.snapshot is defined -%}
{%- set before = snaps[p.snapshot] | default(none) -%}
{%- if before is none -%}{%- set ns.r = ns.r + ['no snapshot ' ~ p.snapshot] -%}
{%- elif (before.lines != (o.lines | default([]))) == p.equal -%}
{%- set ns.r = ns.r + ['snapshot ' ~ p.snapshot ~ (' changed: ' ~ ((before.lines | symmetric_difference(o.lines | default([])))[:6] | join(' | ')) if p.equal else ' unchanged')] -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{#- listing lines for a snapshot, with the declared exclusions -#}
{%- macro snapshot_lines(text, excl, incl) -%}
{%- set ns = namespace(l = text.splitlines() | sort) -%}
{%- for e in excl | default([]) -%}{%- set ns.l = ns.l | reject('search', e) | list -%}{%- endfor -%}
{%- if incl | default([]) -%}{%- set ns.l = ns.l | select('search', '(' ~ (incl | join(')|(')) ~ ')') | list -%}{%- endif -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- the budget scope of a running seed must carry the declared limits (T22) -#}
{%- macro scope_check(vals, bs) -%}
{%- set ns = namespace(r = []) -%}
{%- if (vals['memory.max'] | trim) != (bs.budget.memory_max_bytes | int | string) -%}{%- set ns.r = ns.r + ['memory.max ' ~ vals['memory.max'] | trim ~ ' != ' ~ bs.budget.memory_max_bytes] -%}{%- endif -%}
{%- if (vals['pids.max'] | trim) != (bs.budget.tasks_max | int | string) -%}{%- set ns.r = ns.r + ['pids.max ' ~ vals['pids.max'] | trim ~ ' != ' ~ bs.budget.tasks_max] -%}{%- endif -%}
{%- set cpu = (vals['cpu.max'] | trim).split(' ') -%}
{%- if cpu | length != 2 or cpu[0] == 'max' or ((cpu[0] | int) * 100 // (cpu[1] | int)) != bs.budget.cpu_quota_percent | int -%}{%- set ns.r = ns.r + ['cpu.max ' ~ vals['cpu.max'] | trim ~ ' != ' ~ bs.budget.cpu_quota_percent ~ '%'] -%}{%- endif -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ compile ---------------------------------- -#}
{#- control -> [{variant, declaration, requires, ops, steps(flat)}]. Sweeps are generated here into ordinary steps. -#}
{#- repeat: {count_token, steps} -> the sub-steps count times; ids, step references and '/<id>.' file names get -<n> -#}
{%- macro flatten(steps, t) -%}
{%- set ns = namespace(out = []) -%}
{%- for s in steps -%}
{%- if s.repeat is defined -%}
{%- set ids = s.repeat.steps | map(attribute='id') | list -%}
{%- for n in range(1, (t[s.repeat.count_token] | int) + 1) -%}
{%- set ns.j = s.repeat.steps | to_json -%}
{%- for i in ids -%}{%- set ns.j = ns.j | replace('"' ~ i ~ '"', '"' ~ s.id ~ '-' ~ i ~ '-' ~ n ~ '"') | replace('/' ~ i ~ '.', '/' ~ s.id ~ '-' ~ i ~ '-' ~ n ~ '.') -%}{%- endfor -%}
{%- set ns.out = ns.out + (ns.j | from_json | map('combine', s | dict2items | selectattr('key', 'in', ['only_variants', 'skip_variants']) | items2dict) | list) -%}
{%- endfor -%}
{%- else -%}{%- set ns.out = ns.out + [s] -%}{%- endif -%}
{%- endfor -%}
{{ ns.out | to_json }}
{%- endmacro -%}

{%- macro compile(c, ctx) -%}
{%- set ns = namespace(out = []) -%}
{%- for v in c.variants | default([{'id': 'base'}]) -%}
{%- set steps = c.steps | default([]) -%}
{%- if c.sweep is defined and c.sweep.kind == 'phases' -%}{%- set steps = sweep_phases(c, ctx) | from_json -%}{%- endif -%}
{%- if c.sweep is defined and c.sweep.kind == 'declared_points' -%}{%- set steps = sweep_points(c, ctx) | from_json -%}{%- endif -%}
{%- if c.sweep is defined and c.sweep.kind == 'pins' -%}{%- set steps = sweep_pins(c, ctx) | from_json -%}{%- endif -%}
{%- set steps = flatten(steps, ctx.t) | from_json -%}
{%- set ns.flat = [] -%}
{%- for s in steps if (s.only_variants is not defined or v.id in s.only_variants) and (v.id not in (s.skip_variants | default([]))) -%}
{%- set ns.flat = ns.flat + [s | combine({'expect': (s.expect | default({})) | combine((v.expect | default({}))[s.id] | default({}))}) if (s.expect is defined or ((v.expect | default({}))[s.id] is defined)) else s] -%}
{%- endfor -%}
{%- set ns.out = ns.out + [{'variant': v.id, 'declaration': v.declaration | default(c.declaration | default('')),
                           'requires': (c.requires | default([])) + (v.requires | default([])),
                           'ops': (c.setup | default([])) + (v.ops | default([])), 'steps': ns.flat,
                           'undo': (v.undo | default([])) + (c.undo | default([])), 'tokens': v.tokens | default({})}] -%}
{%- endfor -%}
{{ ns.out | to_json }}
{%- endmacro -%}

{%- macro sweep_phases(c, ctx) -%}
{%- set ns = namespace(s = []) -%}
{%- set pe = c.per_point_expect -%}
{%- for p in ctx.phases -%}
{%- set k = 'ph-' ~ p -%}
{%- set late = p in (pe.late_phases | default([])) -%}
{%- set ns.s = ns.s + [
  {'id': k ~ '-apply', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'apply', 'root': '{root}', 'async': true}},
  {'id': k ~ '-at', 'wait': {'phase': p, 'step': k ~ '-apply'}, 'timeout_s': ctx.timeouts.wait_phase},
  {'id': k ~ '-kill', 'kill': {'step': k ~ '-apply'}},
  {'id': k ~ '-join', 'join': k ~ '-apply', 'expect': {'record_only': true}},
  {'id': k ~ '-held', 'state': pe.interrupted_state | default([])},
  {'id': k ~ '-rerun', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'apply', 'root': '{root}'}, 'expect': (pe.rerun_late if late else pe.rerun)},
  {'id': k ~ '-after', 'state': pe.state | default([])},
  {'id': k ~ '-verify', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'verify', 'root': '{root}'}, 'expect': {'rc': 0, 'outcome': 'VERIFIED'}},
  {'id': k ~ '-reset', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'purge', 'root': '{root}'}, 'expect': {'rc': 0} | combine(pe.reset | default({'outcome_any': ['PURGED', 'ABSENT']}))},
  {'id': k ~ '-clear', 'ops': [{'remove_glob': {'dir': '{parent}', 'pattern': '.{rootname}.creating.*'}}]}] -%}
{%- endfor -%}
{{ ns.s | to_json }}
{%- endmacro -%}

{#- pins: every reserved name x channel x entrypoint -> one refused step (ctx.pin_names = C1 registry reserved_outputs + rh_repo_root + must_include) -#}
{%- macro sweep_pins(c, ctx) -%}
{%- set ns = namespace(s = []) -%}
{%- set pe = c.per_point_expect -%}
{%- for name in ctx.pin_names -%}
{%- for ch in pe.channels -%}
{%- for e in pe.entrypoints -%}
{%- set k = 'pin-' ~ e.playbook ~ '-' ~ ch ~ '-' ~ (name | regex_replace('[^A-Za-z0-9]', '_')) -%}
{%- set act = {'kind': 'playbook', 'playbook': e.playbook, 'via': e.via, 'dest': '{ctl}/bundle', 'root': '{shared}', 'bundle': 'a',
               'env': e.env | default({}), 'trace_network': e.trace_network | default(false)}
              | combine({'extra_vars': {name: 'rhc-pinned'}} if ch == 'extra_var' else {'inventory_extra': {name: 'rhc-pinned'}}) -%}
{%- set ns.s = ns.s + [{'id': k, 'act': act, 'expect': pe.expect | combine({'no_network': true} if e.trace_network | default(false) else {}),
                        'post_state': e.post_state | default([])}] -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{{ ns.s | to_json }}
{%- endmacro -%}

{%- macro sweep_points(c, ctx) -%}
{%- set ns = namespace(s = []) -%}
{%- set pe = c.per_point_expect -%}
{%- for p in ctx.points -%}
{%- set k = 'pt-' ~ p.id -%}
{%- set inj = {'inject': {'syscalls': p.syscalls, 'when': p.when, 'hold': ctx.hold}} | combine({'trace_path': p.trace_path} if p.trace_path is defined else {}) -%}
{%- set ns.s = ns.s + [
  {'id': k ~ '-apply', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'apply', 'root': '{root}', 'async': true, 'strace': inj}},
  {'id': k ~ '-at', 'wait': p.wait | combine({'step': k ~ '-apply'}), 'timeout_s': 900},
  {'id': k ~ '-valid', 'state': p.valid},
  {'id': k ~ '-kill', 'kill': {'step': k ~ '-apply'}},
  {'id': k ~ '-join', 'join': k ~ '-apply', 'expect': {'killed': true}},
  {'id': k ~ '-held', 'state': pe.interrupted_state | default([])}]
  + ([{'id': k ~ '-verify-held', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'verify', 'root': '{root}'}, 'expect': pe.publication_points_verify}] if p.publication | default(false) else [])
  + [{'id': k ~ '-rerun', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'apply', 'root': '{root}'}, 'expect': pe.rerun | combine(p.rerun | default({}))},
  {'id': k ~ '-after', 'state': pe.state | default([]) + (p.after | default([]))},
  {'id': k ~ '-verify', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'verify', 'root': '{root}'}, 'expect': {'rc': 0, 'outcome': 'VERIFIED'}},
  {'id': k ~ '-reset', 'act': {'kind': 'seed', 'bundle': 'a', 'op': 'purge', 'root': '{root}'}, 'expect': {'rc': 0, 'outcome_any': ['PURGED', 'ABSENT']}},
  {'id': k ~ '-clear', 'ops': [{'remove_glob': {'dir': '{parent}', 'pattern': '.{rootname}.creating.*'}}]}] -%}
{%- endfor -%}
{{ ns.s | to_json }}
{%- endmacro -%}

{#- the path and each ancestor strictly below stop (e.g. $HOME), deepest first -#}
{%- macro ancestry(path, stop) -%}
{%- set p = path.split('/') -%}
{%- set ns = namespace(l = []) -%}
{%- for i in range((stop.split('/') | length) + 1, (p | length) + 1) -%}{%- set ns.l = [p[:i] | join('/')] + ns.l -%}{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ static checks ----------------------------- -#}
{#- Pure judges of the independent static checks (X03, TR01). tasks/static_check.yml gathers the inputs (a template
    render, a repository-scoped file list, parsed declarations) and calls sc_<kind>(inp, spec, mut) once with
    mut = {} (the check itself: must return no failures) and once per declared negative control (mut = the mutation:
    must return at least one failure, matching `expect_failure` when declared). A negative control the judge accepts
    is a FAIL of the control: the check could not have caught that defect.
    Every sc_* returns {failures: [...], observations: [...]}. -#}

{#- a dotted path into a mapping; returns {found, value} -#}
{%- macro dig(o, dotted) -%}
{%- set ns = namespace(v = o, ok = true) -%}
{%- for k in dotted.split('.') if ns.ok -%}
{%- if ns.v is mapping and k in ns.v -%}{%- set ns.v = ns.v[k] -%}{%- else -%}{%- set ns.ok = false -%}{%- endif -%}
{%- endfor -%}
{{ {'found': ns.ok, 'value': ns.v if ns.ok else none} | to_json }}
{%- endmacro -%}

{#- C19: render with os_tools.<tool>.path changed. inp {base, patched, old}; spec {tool, path, min_sites}.
    Every line carrying the old path (path-boundary match) must carry the new one with nothing else changed, every
    other line must be byte-identical, and no line may keep the old path. mut.kind: unchanged | presence_only |
    stray_line (mut.line, '{old}' replaced) -#}
{%- macro sc_render_tool_path(inp, spec, mut) -%}
{%- set old = inp.old -%}
{%- set new = spec.path -%}
{%- set m = mut.kind | default('none') -%}
{%- if m == 'unchanged' -%}{%- set pt = inp.base -%}
{%- elif m == 'presence_only' -%}{%- set pt = inp.base | replace(old, new, 1) -%}
{%- elif m == 'stray_line' -%}{%- set pt = inp.patched ~ '\n' ~ (mut.line | replace('{old}', old)) -%}
{%- else -%}{%- set pt = inp.patched -%}{%- endif -%}
{%- set bl = inp.base.split('\n') -%}
{%- set pl = pt.split('\n') -%}
{%- set bre = '(^|[^A-Za-z0-9_./+-])' ~ (old | regex_escape) ~ '($|[^A-Za-z0-9_./+-])' -%}
{%- set ns = namespace(f = [], sites = 0, bad = [], other = []) -%}
{%- if old == new -%}{%- set ns.f = ns.f + ['declared path ' ~ new ~ ' equals the current path: nothing to observe'] -%}{%- endif -%}
{%- if bl | length != pl | length -%}
{%- set ns.f = ns.f + ['line count ' ~ (bl | length) ~ ' -> ' ~ (pl | length) ~ ': the render changed beyond the tool path'] -%}
{%- else -%}
{%- for b in bl -%}
{%- set p = pl[loop.index0] -%}
{%- if b is search(bre) -%}
{%- set ns.sites = ns.sites + 1 -%}
{%- if p != (b | replace(old, new)) -%}{%- set ns.bad = ns.bad + [loop.index] -%}{%- endif -%}
{%- elif p != b -%}{%- set ns.other = ns.other + [loop.index] -%}
{%- endif -%}
{%- endfor -%}
{%- if ns.bad -%}{%- set ns.f = ns.f + [(ns.bad | length) ~ ' line(s) carrying ' ~ old ~ ' did not change to ' ~ new ~ ' (lines ' ~ (ns.bad[:8] | join(',')) ~ ')'] -%}{%- endif -%}
{%- if ns.other -%}{%- set ns.f = ns.f + [(ns.other | length) ~ ' line(s) without the tool path changed (lines ' ~ (ns.other[:8] | join(',')) ~ ')'] -%}{%- endif -%}
{%- endif -%}
{%- set left = pl | select('search', bre) | list -%}
{%- if left -%}{%- set ns.f = ns.f + [(left | length) ~ ' line(s) still carry ' ~ old] -%}{%- endif -%}
{%- if ns.sites < spec.min_sites | default(2) | int -%}{%- set ns.f = ns.f + ['only ' ~ ns.sites ~ ' line(s) carry ' ~ old ~ ' (declared minimum ' ~ spec.min_sites | default(2) ~ ')'] -%}{%- endif -%}
{{ {'failures': ns.f, 'observations': [spec.tool ~ ': ' ~ ns.sites ~ ' line(s) carry the declared path; every one follows os_tools.' ~ spec.tool ~ '.path']} | to_json }}
{%- endmacro -%}

{#- C20: inp {files: repository-relative paths that would be committed under spec.under}; spec {under,
    allow_suffixes, forbid_basenames}. mut.kind: add_file (mut.path) | empty -#}
{%- macro sc_representation(inp, spec, mut) -%}
{%- set m = mut.kind | default('none') -%}
{%- set files = [] if m == 'empty' else (inp.files + ([mut.path] if m == 'add_file' else [])) -%}
{%- set sre = '(' ~ (spec.allow_suffixes | map('regex_escape') | join('|')) ~ ')$' -%}
{%- set ns = namespace(f = []) -%}
{%- if not files -%}{%- set ns.f = ['no file observed under ' ~ spec.under ~ ' (an empty observation is never a pass)'] -%}{%- endif -%}
{%- set bad = files | reject('search', sre) | list -%}
{%- if bad -%}{%- set ns.f = ns.f + ['not ' ~ (spec.allow_suffixes | join('/')) ~ ': ' ~ (bad[:10] | join(' '))] -%}{%- endif -%}
{%- set gen = files | map('basename') | select('in', spec.forbid_basenames | default([])) | list -%}
{%- if gen -%}{%- set ns.f = ns.f + ['generated output present: ' ~ (gen | join(' '))] -%}{%- endif -%}
{{ {'failures': ns.f, 'observations': [(files | length) ~ ' committable file(s) under ' ~ spec.under]} | to_json }}
{%- endmacro -%}

{#- D20: inp {rh}; spec {required_uses}. The selected adapter is admitted; its target tools cover the required uses;
    every os_tools name, adapter target tool and adapter controller tool is in packages.provides; every adapter target
    package is mapped for every declared os family. Observation (not a failure): target tools whose providing package
    is not in the adapter's target.packages. mut.kind: drop_provides (mut.tool) | drop_use (mut.use) | add_os_tool
    (mut.name) | drop_family_mapping (mut.package) -#}
{%- macro sc_adapter_closure(inp, spec, mut) -%}
{%- set m = mut.kind | default('none') -%}
{%- set rh = inp.rh -%}
{%- set sel = rh.transfer.adapter -%}
{%- set ad = rh.transfer.adapters[sel] | default({}) -%}
{%- set ns = namespace(f = [], o = [], prov = {}, tools = {}, fam = {}) -%}
{%- for k, v in (rh.packages.provides | default({})).items() -%}{%- set ns.prov = ns.prov | combine({k: (v | reject('equalto', mut.tool) | list) if m == 'drop_provides' else v}) -%}{%- endfor -%}
{%- for k, v in (ad.target.tools | default({})).items() -%}{%- set ns.tools = ns.tools | combine({k: v | combine({'used_by': (v.used_by | default([]) | reject('equalto', mut.use) | list) if m == 'drop_use' else v.used_by | default([])})}) -%}{%- endfor -%}
{%- for k, v in (rh.packages.by_os_family | default({})).items() -%}{%- set ns.fam = ns.fam | combine({k: (v | dict2items | rejectattr('key', 'equalto', mut.package) | items2dict) if m == 'drop_family_mapping' else v}) -%}{%- endfor -%}
{%- set os_names = (rh.controller.bootstrap.os_tools | default({})).keys() | list + ([mut.name] if m == 'add_os_tool' else []) -%}
{%- if not ad -%}{%- set ns.f = ns.f + ['selected adapter ' ~ sel ~ ' is not declared'] -%}{%- endif -%}
{%- if (ad.status | default('admitted')) == 'not_admitted' -%}{%- set ns.f = ns.f + ['selected adapter ' ~ sel ~ ' is not_admitted'] -%}{%- endif -%}
{%- set uses = ns.tools.values() | map(attribute='used_by') | flatten | unique | list -%}
{%- set mu = spec.required_uses | reject('in', uses) | list -%}
{%- if mu -%}{%- set ns.f = ns.f + ['adapter ' ~ sel ~ ' target tools cover no ' ~ (mu | join('/')) ~ ' use'] -%}{%- endif -%}
{%- set provided = ns.prov.values() | flatten | unique | list -%}
{%- set names = (os_names + (ns.tools.keys() | list) + (ad.controller.os_tools | default([]))) | unique | list -%}
{%- set up = names | reject('in', provided) | list -%}
{%- if up -%}{%- set ns.f = ns.f + ['not in packages.provides: ' ~ (up | sort | join(' '))] -%}{%- endif -%}
{%- if not ns.fam -%}{%- set ns.f = ns.f + ['packages.by_os_family declares no family'] -%}{%- endif -%}
{%- for fam, mp in ns.fam.items() -%}
{%- set um = (ad.target.packages | default([])) | reject('in', mp.keys() | list) | list -%}
{%- if um -%}{%- set ns.f = ns.f + ['adapter ' ~ sel ~ ' target package(s) ' ~ (um | join(' ')) ~ ' unmapped for ' ~ fam] -%}{%- endif -%}
{%- endfor -%}
{%- for t in ns.tools.keys() | sort -%}
{%- set pk = ns.prov | dict2items | selectattr('value', 'contains', t) | map(attribute='key') | list -%}
{%- if pk and (pk | select('in', ad.target.packages | default([])) | list | length == 0) -%}{%- set ns.o = ns.o + ['target tool ' ~ t ~ ' is provided by ' ~ (pk | join('/')) ~ ', not among adapter ' ~ sel ~ ' target.packages'] -%}{%- endif -%}
{%- endfor -%}
{{ {'failures': ns.f, 'observations': ns.o} | to_json }}
{%- endmacro -%}

{#- TR01 / M1-TRANSPORT-COMPOSITION: no supported case reclassified as covered because it refuses.
    inp {bcases: B's case rows, lids: lifecycle case ids, rh, bdecl: B's transfer declaration, controls, self_id};
    spec {cases (B-supported, prefixed), refused_cases, prefix, b_supported {expect_rc, kinds}, route_declaration,
    route_form_key, b_form_path, form_var, route_case, coverage_classes}.
    Failures: a listed B case missing or no longer supported (expects a refusal); the route case missing; a declared
    route form that differs from B's contract form, does not admit a B-supported form, or admits a B-refused form;
    another control naming a supported case outside the coverage classes. An undeclared route composition is an
    observation (the case stays OPEN). mut.kind: b_case_expect (mut.case, mut.rc) | drop_b_case (mut.case) |
    route_form (mut.regex) | drop_route_case | claim_coverage (mut.control, mut.case) -#}
{%- macro sc_transport_disposition(inp, spec, mut) -%}
{%- set m = mut.kind | default('none') -%}
{%- set pre = spec.prefix | default('transfer:') -%}
{%- set ns = namespace(f = [], o = [], rows = {}) -%}
{%- for r in inp.bcases -%}
{%- if m == 'drop_b_case' and (pre ~ r.id) == mut.case -%}
{%- elif m == 'b_case_expect' and (pre ~ r.id) == mut.case -%}{%- set ns.rows = ns.rows | combine({pre ~ r.id: r | combine({'kind': 'phase', 'expect': (r.expect | default({})) | combine({'rc': mut.rc})})}) -%}
{%- else -%}{%- set ns.rows = ns.rows | combine({pre ~ r.id: r}) -%}{%- endif -%}
{%- endfor -%}
{%- set lids = inp.lids | reject('equalto', spec.route_case) | list if m == 'drop_route_case' else inp.lids -%}
{%- set controls = inp.controls + ([{'id': mut.control, 'cases': [mut.case]}] if m == 'claim_coverage' else []) -%}
{%- for id in spec.cases -%}
{%- set r = ns.rows[id] | default(none) -%}
{%- if r is none -%}{%- set ns.f = ns.f + ['B row ' ~ id ~ ' is missing (a supported case may not disappear)'] -%}
{%- elif not ((r.expect.rc | default('none') | string) == (spec.b_supported.expect_rc | string) or (r.kind | default('')) in spec.b_supported.kinds) -%}
{%- set ns.f = ns.f + ['LOST SUPPORTED CASE ' ~ id ~ ': B now expects rc ' ~ (r.expect.rc | default('none') | string) ~ ' (a refusal is never coverage)'] -%}
{%- endif -%}
{%- endfor -%}
{%- if spec.route_case not in lids -%}{%- set ns.f = ns.f + ['route case ' ~ spec.route_case ~ ' is missing'] -%}{%- endif -%}
{%- set d = dig(inp.rh, spec.route_declaration) | from_json -%}
{%- if not d.found -%}{%- set ns.o = ns.o + ['route declares no ' ~ spec.route_declaration ~ ' (OPEN)'] -%}
{%- else -%}
{%- set rform = mut.regex if m == 'route_form' else d.value[spec.route_form_key] | default('') -%}
{%- set bform = (dig(inp.bdecl, spec.b_form_path) | from_json).value -%}
{%- if rform != bform -%}{%- set ns.f = ns.f + ['route form ' ~ rform ~ ' != B contract form ' ~ (bform | string)] -%}{%- endif -%}
{%- for id in spec.cases + spec.refused_cases -%}
{%- set r = ns.rows[id] | default({}) -%}
{%- set v = (r.phase.k_vars | default({}))[spec.form_var] | default(none) if r.phase is defined else none -%}
{%- if v is not none and rform -%}
{%- if id in spec.cases and not (v is match(rform)) -%}{%- set ns.f = ns.f + ['route form does not admit B-supported ' ~ id ~ ' (' ~ v ~ ')'] -%}{%- endif -%}
{%- if id in spec.refused_cases and (v is match(rform)) -%}{%- set ns.f = ns.f + ['route form admits B-refused ' ~ id ~ ' (' ~ v ~ ')'] -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- set ns.o = ns.o + ['route composition declared; ' ~ (spec.cases | join(', ')) ~ ' stay OPEN until the joined controls execute ' ~ spec.route_case ~ ' on a real target'] -%}
{%- endif -%}
{%- for c in controls if c.id != inp.self_id -%}
{%- for id in spec.cases if id in (c.cases | default([])) and (c.result_class | default('')) not in spec.coverage_classes and c.declared_only is not defined -%}
{%- set ns.f = ns.f + [c.id ~ ' names supported ' ~ id ~ ' as executable coverage (only ' ~ (spec.coverage_classes | join('/')) ~ ' or declared_only may)'] -%}
{%- endfor -%}
{%- endfor -%}
{{ {'failures': ns.f, 'observations': ns.o} | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ neutrality (Y03 helper) --------------------- -#}
{#- the dotted JSON paths where a and b differ (lists of equal length compared per index as path[i]) -#}
{%- macro diff_paths(a, b, path) -%}
{%- if a is mapping and b is mapping -%}
{%- set ns = namespace(o = []) -%}
{%- for k in ((a.keys() | list) + (b.keys() | list)) | map('string') | unique | sort -%}
{%- set p = (path ~ '.' ~ k) if path else k -%}
{%- if k not in a or k not in b -%}{%- set ns.o = ns.o + [p] -%}
{%- else -%}{%- set ns.o = ns.o + (diff_paths(a[k], b[k], p) | from_json) -%}{%- endif -%}
{%- endfor -%}
{{ ns.o | to_json }}
{%- elif a is sequence and a is not string and b is sequence and b is not string and (a | length) == (b | length) -%}
{%- set ns = namespace(o = []) -%}
{%- for i in range(a | length) -%}{%- set ns.o = ns.o + (diff_paths(a[i], b[i], path ~ '[' ~ i ~ ']') | from_json) -%}{%- endfor -%}
{{ ns.o | to_json }}
{%- else -%}{{ ([path if path else '$'] if a != b else []) | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- C1 Q-C1-NEUTRALITY predicate for ONE profile. base/cand: {refused: <refusal text or none>, facts: {<compared fact>:
    value}}; intended: dotted path prefixes the change under test may alter. Returns {class, paths, outside}:
    NEUTRAL-EXCEPT-INTENDED (every differing path inside intended), NOT-REACHED-PARITY (both refused before
    resolution with the same refusal), DIFFERENT (anything else: never neutral). -#}
{%- macro neutrality(base, cand, intended) -%}
{%- if base.refused or cand.refused -%}
{%- if base.refused and cand.refused and base.refused == cand.refused -%}{{ {'class': 'NOT-REACHED-PARITY', 'paths': [], 'outside': []} | to_json }}
{%- else -%}{{ {'class': 'DIFFERENT', 'paths': [], 'outside': ['refusal: ' ~ (base.refused | string) ~ ' vs ' ~ (cand.refused | string)]} | to_json }}{%- endif -%}
{%- else -%}
{%- set paths = diff_paths(base.facts, cand.facts, '') | from_json -%}
{%- set ns = namespace(out = []) -%}
{%- for p in paths -%}
{%- set ns.hit = false -%}
{%- for i in intended if p == i or p.startswith(i ~ '.') or p.startswith(i ~ '[') -%}{%- set ns.hit = true -%}{%- endfor -%}
{%- if not ns.hit -%}{%- set ns.out = ns.out + [p] -%}{%- endif -%}
{%- endfor -%}
{{ {'class': 'NEUTRAL-EXCEPT-INTENDED' if not ns.out else 'DIFFERENT', 'paths': paths, 'outside': ns.out} | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- negative controls rejected for ANOTHER reason than declared: neg = [{mutation, failures}] -#}
{%- macro sc_negative_reasons(kind, neg) -%}
{%- set ns = namespace(r = []) -%}
{%- for n in neg if n.failures and n.mutation.expect_failure is defined -%}
{%- if n.failures | select('search', n.mutation.expect_failure) | list | length == 0 -%}
{%- set ns.r = ns.r + ['negative control ' ~ kind ~ '/' ~ n.mutation.kind ~ ' rejected, but not for "' ~ n.mutation.expect_failure ~ '": ' ~ (n.failures | join('; '))] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.r | to_json }}
{%- endmacro -%}
