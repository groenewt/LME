{#- testing/remote_harness/tests/controls/templates/macros/controls.j2 -- the lifecycle-control engine's pure functions
    (owner: G). Every macro returns JSON text; tasks call them through templates/call.j2 and `from_json`.
    No macro touches the filesystem or executes anything: tasks gather observations, macros plan and judge.

    ctx (built by tasks/prepare.yml and tasks/one_control.yml):
      t          token map for {name} expansion (strings; `envelope_memory_plus_1` is an int)
      rh         the resolved harness policy (controller ...)
      refusals   controller.bootstrap.refusals
      vocab      controls.yml vocabulary
      env        {HOME, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS} carried from the runner
      tools      declared absolute tools the runner itself uses (strace, timeout, env, sh ...)
      repo       candidate repository root; variant_repo: admitted variant root or ''
      receipt    {ansible_config, collections_path} read from the shared root's published receipt (or {})
      bundles    {a: path, b: path}
      override   lme_global_override value for a declaration variant routed through SEED-06, or {} -#}

{#- ---------------------------------------------------------------- tokens ---------------------------------- -#}
{%- macro expand(s, t) -%}
{%- set ns = namespace(v = s | string) -%}
{%- for k in t -%}{%- set ns.v = ns.v | replace('{' ~ k ~ '}', t[k] | string) -%}{%- endfor -%}
{{- ns.v -}}
{%- endmacro -%}

{%- macro xjson(o, t) -%}
{%- if o is mapping -%}
{{ '{' }}{%- for k in o -%}{{ k | to_json }}: {{ xjson(o[k], t) }}{{ ', ' if not loop.last else '' }}{%- endfor -%}{{ '}' }}
{%- elif o is string -%}
{%- set m = o | regex_search('^\\{([a-z0-9_]+)\\}$', '\\1') -%}
{%- if m and (m[0] in t) and (t[m[0]] is number) -%}{{ t[m[0]] | to_json }}{%- else -%}{{ expand(o, t) | to_json }}{%- endif -%}
{%- elif o is iterable -%}
[{%- for v in o -%}{{ xjson(v, t) }}{{ ', ' if not loop.last else '' }}{%- endfor -%}]
{%- else -%}{{ o | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- tokens that survived expansion: a declaration error, never silently passed to an entrypoint -#}
{%- macro residual(text) -%}
{{ text | regex_findall('\\{[a-z][a-z0-9_]*\\}') | unique | list | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------------------ vocabulary --------------------------------- -#}
{#- keys a control uses that the runner does not implement -> UNIMPLEMENTED (fails acceptance, never QUEUED) -#}
{#- ops: a list of op maps; returns reasons -#}
{%- macro _ops_unimpl(ops, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{#- an op map's FIRST key is its kind; the other keys (mode, content, target) are its options -#}
{%- for o in ops -%}
{%- set k = o | list | first -%}
{%- if k not in vocab.ops or k in (ni.ops | default([])) -%}{%- set ns.u = ns.u + ['op ' ~ k] -%}{%- endif -%}
{%- for opt in (o | list)[1:] if opt not in vocab.op_options -%}{%- set ns.u = ns.u + ['op option ' ~ k ~ '.' ~ opt] -%}{%- endfor -%}
{%- if o[k] is mapping -%}{%- for opt in o[k] if opt in (ni.op_options | default([])) -%}{%- set ns.u = ns.u + ['op option ' ~ k ~ '.' ~ opt] -%}{%- endfor -%}{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{%- macro _preds_unimpl(preds, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{%- for p in preds -%}
{%- set k = p | list | reject('in', ['exists', 'equal', 'contains', 'lacks', 'regex', 'json_equal', 'json_all', 'kind', 'size', 'mode', 'uid', 'private_write']) | first -%}
{%- if k not in vocab.predicates or k in (ni.predicates | default([])) -%}{%- set ns.u = ns.u + ['predicate ' ~ k] -%}{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{%- macro _steps_unimpl(steps, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(u = []) -%}
{%- for s in steps -%}
{%- set kinds = s | list | reject('in', vocab.step_common) | list -%}
{%- if kinds | length != 1 or kinds[0] not in vocab.steps or kinds[0] in (ni.steps | default([])) -%}{%- set ns.u = ns.u + ['step ' ~ (s.id | default('?')) ~ ' kinds ' ~ (kinds | join(','))] -%}{%- endif -%}
{%- for k in (s.expect | default({})) if k not in vocab.expect -%}{%- set ns.u = ns.u + ['expect ' ~ k] -%}{%- endfor -%}
{%- set ns.u = ns.u + (_preds_unimpl((s.state | default([])) + (s.post_state | default([])), vocab) | from_json) -%}
{%- set ns.u = ns.u + (_ops_unimpl(s.ops | default([]), vocab) | from_json) -%}
{%- if s.act is defined and s.act.kind not in vocab.acts -%}{%- set ns.u = ns.u + ['act ' ~ s.act.kind] -%}{%- endif -%}
{%- if s.wait is defined -%}{%- for k in s.wait if k not in vocab.waits + ['step'] + (vocab.wait_options | default([])) -%}{%- set ns.u = ns.u + ['wait ' ~ k] -%}{%- endfor -%}
{%- if (s.wait | list | select('in', vocab.waits) | list | length) != 1 -%}{%- set ns.u = ns.u + ['wait names ' ~ (s.wait | list | select('in', vocab.waits) | list | length) ~ ' observables (exactly one)'] -%}{%- endif -%}
{%- if s.wait.poll_hold is defined and not (s.wait.phase is defined or s.wait.file_regex is defined) -%}{%- set ns.u = ns.u + ['wait poll_hold needs a phase or file_regex observable'] -%}{%- endif -%}{%- endif -%}
{%- if s.kill is defined -%}{%- for k in s.kill if k not in vocab.kill_options -%}{%- set ns.u = ns.u + ['kill ' ~ k] -%}{%- endfor -%}{%- endif -%}
{%- if s.act is defined -%}{%- for k in s.act if k not in vocab.act_keys -%}{%- set ns.u = ns.u + ['act key ' ~ k] -%}{%- endfor -%}{%- endif -%}
{#- G never reaches hosts: every declared target (and every address-valued host/extra var) is an RFC 5737 TEST-NET-1 address
    (vocab.target_address_regex); anything else is a declaration error -> UNIMPLEMENTED, never executed -#}
{%- if s.act is defined and s.act.inventory_targets is defined -%}
{%- for h in s.act.inventory_targets -%}
{%- set hv = s.act.inventory_targets[h] | default({}, true) -%}
{%- if not ((hv.ansible_host | default('') | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['inventory_targets ' ~ h ~ ' ansible_host is not a TEST-NET-1 address'] -%}{%- endif -%}
{%- for k in ['ansible_ssh_host'] if k in hv and not ((hv[k] | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['inventory_targets ' ~ h ~ ' ' ~ k ~ ' is not a TEST-NET-1 address'] -%}{%- endfor -%}
{%- endfor -%}
{%- endif -%}
{%- if s.act is defined -%}{%- for k in ['ansible_host', 'ansible_ssh_host'] if k in (s.act.extra_vars | default({})) and not ((s.act.extra_vars[k] | string) is match(vocab.target_address_regex)) -%}{%- set ns.u = ns.u + ['extra var ' ~ k ~ ' is not a TEST-NET-1 address'] -%}{%- endfor -%}{%- endif -%}
{%- if s.repeat is defined -%}{%- set ns.u = ns.u + (_steps_unimpl(s.repeat.steps, vocab) | from_json) -%}{%- endif -%}
{#- increment 2 (codex 230249 (a), 231744 option (a), 234857): produce / tree / fixture_ops shapes (tasks/produce.yml, tree.yml,
    fixture_ops.yml re-assert them at run time; a malformed one is a declaration error here, never executed) -#}
{%- if s.produce is defined -%}
{%- set pk = {'bundle': ['case', 'dest', 'src', 'task'], 'checkout': ['case', 'clone', 'ctl', 'task'], 'admit': ['dir', 'task']} -%}
{%- set pt = s.produce.task | default('') if s.produce is mapping else '' -%}
{%- if pt not in (vocab.producer_tasks | default({})) or pt not in pk or (s.produce | list | sort) != pk[pt] -%}{%- set ns.u = ns.u + ['produce ' ~ (s.produce | to_json)] -%}{%- endif -%}
{%- set ex = s.expect | default({}) -%}
{%- if (ex.produced | default(false)) == (ex.produce_refused is defined) -%}{%- set ns.u = ns.u + ['produce ' ~ (s.id | default('?')) ~ ' expects exactly one of produced / produce_refused'] -%}{%- endif -%}
{%- if ex.produce_refused is defined and ex.produce_task is not defined -%}{%- set ns.u = ns.u + ['produce ' ~ (s.id | default('?')) ~ ' refusal without produce_task (the exact leaf)'] -%}{%- endif -%}
{%- endif -%}
{%- if s.tree is defined and not (s.tree is mapping and (s.tree | list | sort) == ['name', 'of']) -%}{%- set ns.u = ns.u + ['tree ' ~ (s.tree | to_json)] -%}{%- endif -%}
{%- for o in s.fixture_ops | default([]) if not (o is mapping and (o | list | first) in ['mkdir', 'copy_tree', 'move', 'symlink']) -%}{%- set ns.u = ns.u + ['fixture_op ' ~ (o | to_json)] -%}{%- endfor -%}
{#- 003441 (G-STAGING-*): a declared staging outcome (controls.j2 judge_staging) belongs to a fixture_ops step and names exactly
    one of staging_refused CODE / staging_failed true, the exact leaf staging_task and a staging_index inside its list -#}
{%- set sx = s.expect | default({}) -%}
{%- if sx is mapping and (sx | list | select('match', '^staging_') | list | length) > 0 -%}
{%- set sref = sx.staging_refused is defined -%}
{%- set sfail = sx.staging_failed is defined -%}
{%- if s.fixture_ops is not defined or sref == sfail or (sfail and sx.staging_failed is not sameas true)
      or (sref and not (sx.staging_refused is string and sx.staging_refused | length > 0))
      or sx.staging_task is not defined or sx.staging_index is not defined or not ((sx.staging_index | string) is match('^[0-9]+$'))
      or (sx.staging_index | int) >= (s.fixture_ops | default([]) | length) -%}
{%- set ns.u = ns.u + ['fixture_ops ' ~ (s.id | default('?')) ~ ' staging expectation needs a fixture_ops step, exactly one of staging_refused CODE / staging_failed true, staging_task and a staging_index inside its list'] -%}
{#- G-FIXTURE-ITEM-STOP-CONTROL (codex tick330): every action after the declared outcome is declared in staging_skipped
    (exactly the later indexes; judged at run time by judge_staging_skipped against the per-item skip records) -#}
{%- elif ((sx.staging_skipped | default([])) is not sequence) or (sx.staging_skipped | default([])) is string
      or (sx.staging_skipped | default([]) | map('string') | list) != (range((sx.staging_index | int) + 1, s.fixture_ops | length) | map('string') | list) -%}
{%- set ns.u = ns.u + ['fixture_ops ' ~ (s.id | default('?')) ~ ' staging_skipped must list exactly the actions after staging_index ' ~ (sx.staging_index | string) ~ ' (' ~ (range((sx.staging_index | int) + 1, s.fixture_ops | length) | list | to_json) ~ '); got ' ~ (sx.staging_skipped | default([]) | to_json)] -%}
{%- endif -%}
{%- endif -%}
{#- G-OP-PER-ITEM-GUARD (codex tick330 item 2): a declared op outcome (judge_op_outcome / judge_op_skipped, tasks/op.yml)
    belongs to an ops step and names op_failed true, an op_index inside its list and at least one op_msg_has string; its
    op_skipped lists exactly the later indexes -#}
{%- if sx is mapping and (sx | list | select('match', '^op_') | list | length) > 0 -%}
{%- if s.ops is not defined or sx.op_failed is not sameas true
      or sx.op_index is not defined or not ((sx.op_index | string) is match('^[0-9]+$')) or (sx.op_index | int) >= (s.ops | default([]) | length)
      or sx.op_msg_has is not defined or sx.op_msg_has is string or sx.op_msg_has is not sequence or (sx.op_msg_has | length) == 0 -%}
{%- set ns.u = ns.u + ['ops ' ~ (s.id | default('?')) ~ ' op outcome needs an ops step, op_failed true, an op_index inside its list and at least one op_msg_has string'] -%}
{%- elif ((sx.op_skipped | default([])) is not sequence) or (sx.op_skipped | default([])) is string
      or (sx.op_skipped | default([]) | map('string') | list) != (range((sx.op_index | int) + 1, s.ops | length) | map('string') | list) -%}
{%- set ns.u = ns.u + ['ops ' ~ (s.id | default('?')) ~ ' op_skipped must list exactly the ops after op_index ' ~ (sx.op_index | string) ~ ' (' ~ (range((sx.op_index | int) + 1, s.ops | length) | list | to_json) ~ '); got ' ~ (sx.op_skipped | default([]) | to_json)] -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ ns.u | to_json }}
{%- endmacro -%}

{#- keys a control uses that the runner does not implement -> UNIMPLEMENTED (fails acceptance, never QUEUED).
    Per variant: returns {variant id: [reasons]} ('base' when the control has no variants). -#}
{%- macro unimplemented(c, vocab) -%}
{%- set ni = vocab.not_implemented | default({}) -%}
{%- set ns = namespace(common = [], out = {}) -%}
{%- for k in c if k not in vocab.control_keys -%}{%- set ns.common = ns.common + ['control key ' ~ k] -%}{%- endfor -%}
{%- set ns.common = ns.common + (_ops_unimpl((c.setup | default([])) + (c.undo | default([])), vocab) | from_json)
                  + (_steps_unimpl(c.steps | default([]), vocab) | from_json) -%}
{%- if c.sweep is defined and (c.sweep.kind not in vocab.sweeps or c.sweep.kind in (ni.sweeps | default([]))) -%}{%- set ns.common = ns.common + ['sweep ' ~ c.sweep.kind] -%}{%- endif -%}
{%- for sc in c.static_checks | default([]) -%}
{%- for k in sc if k not in vocab.static_checks or k in (ni.static_checks | default([])) -%}{%- set ns.common = ns.common + ['static check ' ~ k] -%}{%- endfor -%}
{%- for k in sc -%}
{%- for n in (sc[k].negative_controls | default([])) if n.kind not in ((vocab.static_check_mutations | default({}))[k] | default([])) -%}{%- set ns.common = ns.common + ['static check ' ~ k ~ ' mutation ' ~ n.kind] -%}{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{%- if c.declared_only is defined -%}{%- set ns.common = ns.common + ['declared_only (no executable steps in this runner)'] -%}{%- endif -%}
{%- for v in (c.variants | default([{'id': 'base'}])) -%}
{%- set ns.v = [] -%}
{%- for k in v if k not in vocab.variant_keys -%}{%- set ns.v = ns.v + ['variant key ' ~ k] -%}{%- endfor -%}
{#- G-STEP-LIVE-FAIL-GUARD: a declared stop names a string step id and carries its non-empty after_stop predicates -#}
{%- if (v.expect_stop_at is defined or v.after_stop is defined) and not (v.expect_stop_at is string and v.after_stop is sequence and v.after_stop is not string and v.after_stop | length > 0) -%}{%- set ns.v = ns.v + ['expect_stop_at needs a step id and non-empty after_stop predicates'] -%}{%- endif -%}
{%- set ns.v = ns.v + (_preds_unimpl(v.after_stop | default([]), vocab) | from_json) -%}
{#- expect_stop_failure_has (the undeclared-failure negative): only with expect_stop_at, a non-empty list of strings -#}
{%- if v.expect_stop_failure_has is defined and not (v.expect_stop_at is defined and v.expect_stop_failure_has is sequence and v.expect_stop_failure_has is not string
      and v.expect_stop_failure_has is not mapping and v.expect_stop_failure_has | length > 0 and (v.expect_stop_failure_has | reject('string') | list | length == 0)) -%}
{%- set ns.v = ns.v + ['expect_stop_failure_has needs expect_stop_at and a non-empty list of strings'] -%}{%- endif -%}
{%- set ns.v = ns.v + (_ops_unimpl((v.ops | default([])) + (v.undo | default([])), vocab) | from_json) -%}
{%- for sid in (v.expect | default({})) -%}{%- for k in v.expect[sid] if k not in vocab.expect -%}{%- set ns.v = ns.v + ['expect ' ~ k] -%}{%- endfor -%}{%- endfor -%}
{#- cleanup_purge (the cleanup race control): only the declared keys, a barrier of a declared kind at out / err, known
    expectations and predicates; a root: fresh control (the purge runs only there) -#}
{%- if v.cleanup_purge is defined -%}
{%- set cp = v.cleanup_purge -%}
{%- for k in cp if k not in (vocab.cleanup_purge_keys | default([])) -%}{%- set ns.v = ns.v + ['cleanup_purge key ' ~ k] -%}{%- endfor -%}
{%- for b in cp.record_barrier | default([]) -%}
{%- if not (b is mapping and b | length == 1 and (b | list | first) in ['fifo', 'regular'] and b[b | list | first] in ['out', 'err']) -%}{%- set ns.v = ns.v + ['cleanup_purge record_barrier ' ~ (b | to_json)] -%}{%- endif -%}
{%- endfor -%}
{%- for k in (cp.expect | default({})) if k not in vocab.expect -%}{%- set ns.v = ns.v + ['cleanup_purge expect ' ~ k] -%}{%- endfor -%}
{%- set ns.v = ns.v + (_preds_unimpl(cp.post_state | default([]), vocab) | from_json) -%}
{%- if (c.root | default('')) != 'fresh' -%}{%- set ns.v = ns.v + ['cleanup_purge on a control whose root is not fresh (the purge never runs)'] -%}{%- endif -%}
{%- endif -%}
{#- 003441 (G-STAGING-*): after_undo names non-empty predicates checked after the undo ops and the staging reversal (tasks/variant.yml) -#}
{%- if v.after_undo is defined and not (v.after_undo is sequence and v.after_undo is not string and v.after_undo | length > 0) -%}{%- set ns.v = ns.v + ['after_undo needs non-empty predicates'] -%}{%- endif -%}
{%- set ns.v = ns.v + (_preds_unimpl(v.after_undo | default([]), vocab) | from_json) -%}
{#- tick330 G-UNDO-PROTECTION-PROPAGATION: after_cleanup names non-empty predicates checked after the WHOLE undo and cleanup
    sequence (finish_variant + the fixture control dir removal; tasks/variant.yml); expect_undo_findings is a non-empty list of
    {path, why} (path exact, why a regex; controls.j2 judge_undo_findings) -#}
{%- if v.after_cleanup is defined and not (v.after_cleanup is sequence and v.after_cleanup is not string and v.after_cleanup | length > 0) -%}{%- set ns.v = ns.v + ['after_cleanup needs non-empty predicates'] -%}{%- endif -%}
{%- set ns.v = ns.v + (_preds_unimpl(v.after_cleanup | default([]), vocab) | from_json) -%}
{%- if v.expect_undo_findings is defined and not (v.expect_undo_findings is sequence and v.expect_undo_findings is not string and v.expect_undo_findings | length > 0
      and (v.expect_undo_findings | reject('mapping') | list | length == 0)
      and (v.expect_undo_findings | selectattr('path', 'string') | selectattr('why', 'string') | list | length == v.expect_undo_findings | length)
      and (v.expect_undo_findings | map('list') | map('sort') | map('join', ',') | unique | list == ['path,why'])) -%}
{%- set ns.v = ns.v + ['expect_undo_findings needs a non-empty list of {path, why} strings'] -%}{%- endif -%}
{%- set ns.out = ns.out | combine({v.id: (ns.common + ns.v) | unique | list}) -%}
{%- endfor -%}
{{ ns.out | to_json }}
{%- endmacro -%}

{#- status before execution. deps: {name: {met: bool, kind, why}}; unimpl: [reasons] for this variant.
    applies_when {ruling: <dependency of kind ruling>, options: [...]}: unruled -> QUEUED; ruled another option -> NOT-APPLICABLE.
    retire_when <dependency>: once it is met the control is RETIRED -> NOT-APPLICABLE (recorded, never coverage).
    A requirement of kind main_only -> MAIN-ONLY (MAIN's run population; G never runs it; never PASS/coverage on G).
    Returns {status: QUEUED|MAIN-ONLY|UNIMPLEMENTED|RESIDUAL|OPEN-REGRESSION|NOT-APPLICABLE|READY, why: [...]} -#}
{%- macro plan_status(c, variant, deps, unimpl) -%}
{#- a declaration variant requires its route: variant_checkout: clone -> the declared clone fixture (always that route,
    tasks/variant_admit.yml); otherwise variant:<id> (override or MAIN-staged copy, as that declaration permits) -#}
{%- set req = (c.requires | default([])) + (variant.requires | default([]))
              + (((['variant_clone_fixture'] if (c.variant_checkout | default('')) == 'clone' else ['variant:' ~ (variant.declaration | default(c.declaration))]))
                 if (variant.declaration | default(c.declaration | default(''))) else []) -%}
{#- codex 212700 dependency scope + codex 220515 G-EXPORT-CONSUMER-COVERAGE: a control/variant with ANY launcher-consuming
    path (launcher_consumers below: seed acts, playbook acts via seed_run, repeat-nested and sweep-generated steps, and the
    cleanup seed launches of finish_variant.yml, including the {vroot} purge a step's install makes necessary)
    IMPLICITLY requires route_launch_params_export (its launch parameters come only from the route export
    seed_launcher.params_rel), so without it the control is visibly QUEUED on that dependency, naming the consuming paths
    -- never dropped from coverage, never a PASS; every other control keeps its own binding -#}
{%- set lc = launcher_consumers(c, variant) | from_json -%}
{%- set req = req + (['route_launch_params_export'] if lc else []) -%}
{%- set ns = namespace(queued = [], after = [], main = false) -%}
{%- for r in req -%}
{%- set d = deps[r] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared dependency'}) -%}
{%- if d.kind == 'main_only' -%}{%- set ns.main = true -%}{%- endif -%}
{%- if d.kind == 'control' and not d.met -%}{%- set ns.after = ns.after + ['after ' ~ d.control] -%}
{%- elif not d.met -%}{%- set ns.queued = ns.queued + [r ~ ': ' ~ d.why
      ~ ((' [launcher consumers: ' ~ (lc | join('; ')) ~ ']') if r == 'route_launch_params_export' else '')] -%}{%- endif -%}
{%- endfor -%}
{%- set aw = c.applies_when | default(none) -%}
{%- set ad = (deps[aw.ruling] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared ruling'})) if aw else none -%}
{%- set rw = c.retire_when | default(none) -%}
{%- set rd = (deps[rw] | default({'met': false, 'kind': 'undeclared', 'why': 'undeclared dependency'})) if rw else none -%}
{#- P04/P06: a control is planned only against the bytes it was authored for. bound_bytes_current (prepare.yml) digests every
    bound_bytes_at_authoring path; any mismatch or absence re-queues EVERY control before any other rule (also retire/applies_when,
    whose probes read the changed bytes). codex 023332 G-CURRENT-BINDING: a MISSING bound_bytes_current (binding never evaluated)
    is the same as an unmet one -- no older-harness fallback; an absent/empty/non-digest binding is refused in prepare.yml. -#}
{%- set bb = deps['bound_bytes_current'] | default({'met': false, 'why': 'binding not evaluated (no bound_bytes_current dependency; no older-harness fallback)'}) -%}
{%- if not bb.met -%}{{ {'status': 'QUEUED', 'why': ['stale-binding: ' ~ bb.why] + ns.queued} | to_json }}
{%- elif rw and rd.met -%}{{ {'status': 'NOT-APPLICABLE', 'why': ['retired: ' ~ rw ~ ' is met (' ~ rd.why ~ ')']} | to_json }}
{%- elif aw and ad.met and ad.value not in aw.options -%}{{ {'status': 'NOT-APPLICABLE', 'why': [aw.ruling ~ ' ruled ' ~ ad.value ~ '; this control declares option ' ~ (aw.options | join('|'))]} | to_json }}
{%- elif aw and not ad.met -%}{{ {'status': 'QUEUED', 'why': [aw.ruling ~ ': ' ~ ad.why] + ns.queued} | to_json }}
{#- a variant requiring a main_only dependency is MAIN's run population (root / another uid / a real target, or a codex
    ruling that made it MAIN's): never QUEUED on G, never NOT-APPLICABLE, never coverage here; its other unmet deps are listed -#}
{%- elif ns.main -%}{{ {'status': 'MAIN-ONLY', 'why': ns.queued} | to_json }}
{%- elif c.result_class is defined -%}{{ {'status': c.result_class, 'why': [c.declared_only | default(c.note | default(''))] + ns.queued} | to_json }}
{%- elif ns.queued -%}{{ {'status': 'QUEUED', 'why': ns.queued} | to_json }}
{%- elif unimpl -%}{{ {'status': 'UNIMPLEMENTED', 'why': unimpl} | to_json }}
{%- else -%}{{ {'status': 'READY', 'why': ns.after} | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- ------------------------------------------------------------ launcher consumers + route export ------------ -#}
{#- G-EXPORT-CONSUMER-COVERAGE (codex 220515 / 220352; the same macros as m1-1g): every path of a control/variant that
    launches the seed through the bundle's generated launcher (plan_act -> seed_launch) and therefore consumes
    ctx.launch_params. Derived from the SAME shapes the runner executes, never from a list of control ids:
      steps       c.steps (compile executes c.steps only, and none when a sweep generates them), and every repeat.steps
                  nested at any depth, each step whose act is kind seed (any op / invoke) OR a playbook-shaped act with via
                  seed_run (plan_act: `seed run`) -- AFTER the SAME effective variant filtering execution applies
                  (G-EXPORT-VARIANT-SELECTION, codex 223100: step_selected below is the ONE predicate compile uses; a
                  repeat's only_variants / skip_variants override its sub-steps' as flatten combines them), so a variant
                  whose selected steps launch nothing is not queued because a sibling-only step does
      generated   sweep phases / declared_points (sweep_phases / sweep_points generate seed apply / verify / purge steps);
                  sweep pins: each per_point_expect.entrypoints entry with via seed_run (sweep_pins)
      cleanup     finish_variant.yml: root fresh -> the cleanup purge of {root}; root shared -> the cleanup re-verify of
                  {shared}; variant cleanup_purge -> that purge (a declared deviation of the same launch). The {vroot} purge
                  (cleanup-purge-vroot) runs only for a clone root a step installed -- that step is itself a consumer
    Returns the consuming paths (strings, stable order); [] = the control consumes no launcher. -#}
{#- G-EXPORT-VARIANT-SELECTION (codex 223100): the ONE effective step-selection predicate, used by compile (execution) and
    by launcher_consumers (planning). s: a (flattened) step; vid: the variant id. Returns JSON true / false. -#}
{%- macro step_selected(s, vid) -%}
{{ ((s.only_variants is not defined or vid in s.only_variants) and (vid not in (s.skip_variants | default([])))) | to_json }}
{%- endmacro -%}

{%- macro _step_launches(steps, prefix, vid, inherit) -%}
{%- set ns = namespace(r = []) -%}
{%- for s0 in steps | default([]) -%}
{%- if s0 is mapping -%}
{#- flatten: a repeat's own only_variants / skip_variants are combined OVER each sub-step's -#}
{%- set s = s0 | combine(inherit) -%}
{%- if s.repeat is defined -%}
{%- set ns.r = ns.r + (_step_launches(s.repeat.steps | default([]), prefix ~ s.id ~ ' > ', vid,
      s | dict2items | selectattr('key', 'in', ['only_variants', 'skip_variants']) | items2dict) | from_json) -%}
{%- elif step_selected(s, vid) | from_json -%}
{%- set a = s.act | default({}) -%}
{%- if a is mapping and (a.kind | default('')) == 'seed' -%}{%- set ns.r = ns.r + ['step ' ~ prefix ~ s.id ~ ' (seed ' ~ (a.op | default('?')) ~ ')'] -%}
{%- elif a is mapping and (a.via | default('')) == 'seed_run' -%}{%- set ns.r = ns.r + ['step ' ~ prefix ~ s.id ~ ' (' ~ (a.playbook | default(a.kind | default('?'))) ~ ' via seed_run)'] -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{%- macro launcher_consumers(c, variant) -%}
{%- set v = variant if variant is mapping else {} -%}
{%- set sw = (c.sweep | default({})).kind | default('') -%}
{%- set ns = namespace(r = [] if sw in ['phases', 'declared_points', 'pins']
                            else (_step_launches(c.steps | default([]), '', v.id | default('base'), {}) | from_json)) -%}
{%- if sw in ['phases', 'declared_points'] -%}{%- set ns.r = ns.r + ['sweep ' ~ sw ~ ' (generated seed apply / verify / purge steps)'] -%}{%- endif -%}
{%- if sw == 'pins' -%}
{%- for e in (c.per_point_expect | default({})).entrypoints | default([]) if (e.via | default('')) == 'seed_run' -%}
{%- set ns.r = ns.r + ['sweep pins entrypoint ' ~ e.playbook ~ ' via seed_run'] -%}
{%- endfor -%}
{%- endif -%}
{%- if (c.root | default('')) == 'fresh' -%}{%- set ns.r = ns.r + ['cleanup purge of the fresh root (finish_variant)'] -%}{%- endif -%}
{%- if (c.root | default('')) == 'shared' -%}{%- set ns.r = ns.r + ['cleanup re-verify of the shared root (finish_variant)'] -%}{%- endif -%}
{%- if v.cleanup_purge is defined and (c.root | default('')) != 'fresh' -%}{%- set ns.r = ns.r + ['variant cleanup_purge (finish_variant)'] -%}{%- endif -%}
{{ ns.r | to_json }}
{%- endmacro -%}

{#- G-EXPORT-AVAILABILITY-ORDER (codex 220515 / 220352): the route export's availability, decided BEFORE anything renders
    it (tasks/export_availability.yml gathers the stat; this judges it). rel = the resolved seed_launcher.params_rel;
    st = the registered stat result of <checkout>/<rel> (follow false; skipped or {} when not stat-ed). A repository-relative
    path is required for the stat to be confined to the checkout (an absolute or '..' path is never stat-ed); the loader's
    own admission of params_rel (C1 contract_admission) is not restated or relaxed here.
    Returns {state: undeclared | declared-unconfined | declared-missing | declared-not-regular | available, met, why}. -#}
{%- macro export_availability(rel, st) -%}
{%- set r = rel if (rel is string) else '' -%}
{%- set s = (st.stat | default({})) if (st is mapping) else {} -%}
{%- set k = 'controller.bootstrap.seed_launcher.params_rel' -%}
{%- if r | length == 0 -%}{{ {'state': 'undeclared', 'met': false, 'why': k ~ ' undeclared in the resolved profile'} | to_json }}
{%- elif r.startswith('/') or ('..' in r.split('/')) -%}{{ {'state': 'declared-unconfined', 'met': false,
      'why': k ~ ' = ' ~ r ~ ' is not a repository-relative path (never stat-ed or rendered)'} | to_json }}
{%- elif not (s.exists | default(false)) -%}{{ {'state': 'declared-missing', 'met': false,
      'why': k ~ ' = ' ~ r ~ ' is declared but absent from this checkout (route defect; no guessed export, no default parameter list)'} | to_json }}
{%- elif (s.islnk | default(false)) or not (s.isreg | default(false)) -%}{{ {'state': 'declared-not-regular', 'met': false,
      'why': k ~ ' = ' ~ r ~ ' is not a regular file (link or other type; never followed or rendered)'} | to_json }}
{%- else -%}{{ {'state': 'available', 'met': true, 'why': k ~ ' = ' ~ r ~ ' declared and present'} | to_json }}
{%- endif -%}
{%- endmacro -%}

{#- the rendered export is consumed only in its declared shape: a mapping whose keys are EXACTLY the resolved
    seed_launch.mode_args modes, each value a list of non-empty strings (the mode's positional parameter names, in order).
    Returns {met, why}; anything else is shape-invalid (a route defect; nothing is defaulted or repaired). -#}
{%- macro export_shape(params, modes) -%}
{%- set ns = namespace(bad = []) -%}
{%- if params is not mapping -%}{%- set ns.bad = ['not a mapping'] -%}
{%- else -%}
{%- set pk = params | list | sort -%}
{%- set mk = modes | list | sort -%}
{%- if pk != mk -%}{%- set ns.bad = ns.bad + ['modes ' ~ (pk | to_json) ~ ' != seed_launch.mode_args modes ' ~ (mk | to_json)] -%}{%- endif -%}
{%- for m in pk -%}
{%- set v = params[m] -%}
{%- if v is string or v is mapping or v is not iterable -%}{%- set ns.bad = ns.bad + [m ~ ': not a list'] -%}
{%- elif (v | reject('string') | list | length > 0) or (v | select('string') | reject('match', '.') | list | length > 0) -%}{%- set ns.bad = ns.bad + [m ~ ': an entry is not a non-empty string'] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ {'met': ns.bad | length == 0, 'why': ('shape-invalid: ' ~ (ns.bad | join('; '))) if ns.bad else 'shape as declared'} | to_json }}
{%- endmacro -%}

{#- ------------------------------------------------ Route 3 clone fixtures (codex 220953 / 223100) ---------- -#}
{#- the controller.bootstrap-relative patch of a route catalog profile_cases entry (tests/bundle_fixtures.yml): either
