---
# rendered per control into <ctl>/playbooks/probe_env.yml (G). Prints whether the running playbook's environment holds
# SSH_AUTH_SOCK, so the seed launcher's env.carried rule (lifecycle E84: carried ONLY for mode run with an ssh auth mode
# whose agent is carried) is observable from inside `seed run`. Reads the environment only; writes nothing.
- name: Probe the carried agent socket variable
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Print the playbook environment's SSH_AUTH_SOCK
      ansible.builtin.debug:
        msg: "RHC-SSH-AUTH-SOCK={% raw %}{{ lookup('ansible.builtin.env', 'SSH_AUTH_SOCK', default='<unset>') }}{% endraw %}"
