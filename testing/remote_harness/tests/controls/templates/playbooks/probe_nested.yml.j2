---
# rendered per control into <ctl>/playbooks/probe_nested.yml (G). Runs ONLY the shared nested-probe executor binding
# (testing/remote_harness/tests/tasks/bind_probe_executor.yml of the candidate) as the acceptance runner does, with the
# lme_resolved_run the act passes as its JSON -e. The binding's identity act prints RHC-NESTED-EXEC=/RHC-NESTED-CONFIG=/
# RHC-NESTED-PYTHON=/RHC-NESTED-WORK-ROOT=/RHC-NESTED-ANSIBLE-HOME= (control executor.nested.resolved-run;
# RH-NESTED-PROBE-EXECUTOR, RH-RUNNER-RESOLVED-WORKROOT). When the act also passes rhc_probe_extra_env (a control input
# in the same JSON -e), one more nested probe argv is composed through the shared builder (probe_argv.yml) with that
# extra env, as a runner's per-case probe would be (codex 152001 extra-env coverage). Generic: no control-specific token
# is rendered here.
- name: Probe the nested-probe executor binding
  hosts: localhost
  connection: local
  gather_facts: false
  become: false
  tasks:
    - name: Bind this play and the nested probe to the resolved run (the acceptance runner's binding)
      ansible.builtin.include_tasks: "{{ rhc_ctx_static.repo }}/testing/remote_harness/tests/tasks/bind_probe_executor.yml"
      vars:
        bpe_runner: acceptance

    - name: Compose one per-case nested probe argv with the control's extra env (the runners' probe builder)
      ansible.builtin.include_tasks: "{{ rhc_ctx_static.repo }}/testing/remote_harness/tests/tasks/probe_argv.yml"
      vars:
{% raw %}
        bpe_case_dir: "{{ lme_resolved_run.work_root }}/_extra-env"
        bpe_args: [--version]
        bpe_extra_env: "{{ rhc_probe_extra_env }}"
      when: rhc_probe_extra_env is defined

    - name: Print the composed extra-env probe argv names (control marker)
      ansible.builtin.debug:
        msg: "RHC-EXTRA-ENV-NAMES={{ bpe_argv | select('match', '^[A-Z_][A-Z0-9_]*=') | map('regex_replace', '=.*$', '') | join(',') }}"
      when: rhc_probe_extra_env is defined
{% endraw %}
