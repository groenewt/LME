---
# rendered per control into <ctl>/playbooks/seed_installed_set.yml (G). SEED-INSTALLED-SET-VERSION-MANGLING regression
# fixture (control seed.wheels.installed-set-gate), codex tick313 R1 + R2(a) with G1-G3 (transfer-pass-macro-join).
# The gate text is NEVER read out of the seed: it is RENDERED by the template engine from route's ONE implementation --
# the export template at the resolved controller.bootstrap.seed_fragments.installed_set_gate_rel (which emits
# macros/controller_seed.j2 refusal_fn(bs.refusals), a newline, installed_set_gate(bs, lock)) -- through
# lookup('ansible.builtin.template') with lme_seed_bs = the fixture bs and lme_seed_lock = the lock the profile names.
#   G2  fixture bs = the resolved controller.bootstrap (embedded at render time) carrying seed_fragments.installed_set_gate_rel;
#       a grep-failure case (grep_exit n) overrides ONLY bs.os_tools.grep.path with a G stub exiting n, so route's macro
#       itself emits the stub invocation (no text substitution, no slurp, no regex extraction). Each case's freeze
#       listing is G1's isg_listing (controls.j2, via the call.j2 dispatcher) over the lock -- never the seed's pins literal.
#   G3  the export rendered with the REAL bs (no override) must be contained verbatim in the shipped seed rhc_seed: its
#       refusal_fn part and its installed-set gate part each occur EXACTLY once there; otherwise nothing is written.
# Per declared case it writes <ctl>/freeze/<case>.sh: the bs sh shebang, `set -u`, the bs base_env LC_ALL (the gate's
# grep uses bracket ranges), a G-built `_inv`, the rendered export, then (only if the gate fell through) the normalized
# set to <ctl>/freeze/<case>.norm and `RHC-ISG-ADMITTED <set>` on stdout. <ctl>/freeze/lock-pins is G1's isg_lock_pins
# (the lock-side set computed independently of the seed); the positives' .norm must equal it byte for byte.
# Case vocabulary: controls.j2 isg_listing (G1): id, spell, version, replace, insert, drop, empty, grep_exit.
# FRAGMENT KEY (codex-tick318-321-decisions): the resolved profile is the SOLE authority -- no caller-supplied or pending
# fallback. Until C1 registers controller.bootstrap.seed_fragments.installed_set_gate_rel, the fixture refuses BEFORE
# rendering anything: REFUSED RHC-ISG-FRAGMENT-KEY-UNRESOLVED (nothing rendered, nothing written).
{% set _bs = rh.controller.bootstrap %}
{% set _lk = lookup('ansible.builtin.file', rh_repo_root ~ '/' ~ rh.controller.lock_file_rel) | from_yaml %}
- name: Render the seed installed-set gate cases from route's export template (G2) and prove it is the shipped seed's (G3)
  hosts: localhost
  connection: local
  gather_facts: false
  vars:
    rhc_isg_repo_root: {{ rh_repo_root | to_json }}
    rhc_isg_call_j2: {{ rhc_call_j2 | to_json }}
    rhc_isg_lock_rel: {{ rh.controller.lock_file_rel | to_json }}
    # the declarations travel as NEVER-templated JSON strings (a declared value is data, not a template)
    rhc_isg_bs_json: !unsafe {{ _bs | to_json | to_json }}
    rhc_isg_lock_json: !unsafe {{ _lk | to_json | to_json }}
    rhc_isg_frag_resolved: {{ ((_bs.seed_fragments | default({})).installed_set_gate_rel | default('')) | to_json }}
{% raw %}
  tasks:
    - name: Admit the inputs (a control dir, the shipped seed path, declared cases with unique ids)
      ansible.builtin.assert:
        that:
          - rhc_ctl is string and rhc_ctl is match('^/')
          - rhc_seed is string and rhc_seed is match('^/')
          - rhc_isg_cases is sequence and rhc_isg_cases is not string and rhc_isg_cases | length > 0
          - rhc_isg_cases | map(attribute='id') | unique | list | length == rhc_isg_cases | length
        fail_msg: >-
          RHC-ISG: inputs not admitted (ctl {{ rhc_ctl | default('?') }}, seed {{ rhc_seed | default('?') }}, lock {{ rhc_isg_lock_rel }})
        quiet: true

    - name: Refuse before rendering while the resolved profile carries no fragment key (the profile is the sole authority)
      ansible.builtin.assert:
        that:
          - rhc_isg_frag_resolved is string and rhc_isg_frag_resolved | length > 0
        fail_msg: >-
          REFUSED RHC-ISG-FRAGMENT-KEY-UNRESOLVED: the resolved controller.bootstrap carries no
          seed_fragments.installed_set_gate_rel (C1 registers it; no fallback); nothing rendered, nothing written
        quiet: true

    - name: Bind the fixture bs (the resolved bootstrap, carrying the fragment key), the lock and the fragment path
      ansible.builtin.set_fact:
        _isg_frag_rel: "{{ rhc_isg_frag_resolved }}"
        _isg_frag_abs: "{{ rhc_isg_repo_root ~ '/' ~ rhc_isg_frag_resolved }}"
        _isg_bs: "{{ rhc_isg_bs_json | from_json }}"
        _isg_lock: "{{ rhc_isg_lock_json | from_json }}"
        _isg_dir: "{{ rhc_ctl }}/freeze"

    - name: Admit the fixture bs and the lock (the tools and values the export and the case scripts use; a dotted, dashed lock)
      vars:
        _pins: "{{ lookup('ansible.builtin.template', rhc_isg_call_j2, template_vars={'rhc_call': {'fn': 'isg_lock_pins', 'args': [_isg_lock.packages | default([])]}}) | from_json }}"
      ansible.builtin.assert:
        that:
          - _isg_frag_rel is string and _isg_frag_rel is not match('^/') and '..' not in _isg_frag_rel.split('/')
          - _isg_bs.macros_rel is defined
          - _isg_bs.os_tools.sh.path is defined and _isg_bs.os_tools.sh.path is match('^/\S+$')
          - _isg_bs.os_tools.grep.path is defined and _isg_bs.os_tools.sed.path is defined and _isg_bs.os_tools.sort.path is defined
          - _isg_bs.base_env.LC_ALL is defined
          - _isg_bs.refusals['RH-SEED-IDENTITY-MISMATCH'] is defined
          - _pins.errors | length == 0
        fail_msg: "RHC-ISG: fixture bs / lock not admitted (fragment {{ _isg_frag_rel }}; lock {{ rhc_isg_lock_rel }}: {{ _pins.errors }})"
        quiet: true

    - name: Stat the export template and the shipped seed (never followed)
      ansible.builtin.stat:
        path: "{{ item }}"
        follow: false
        checksum_algorithm: sha256
      loop: ["{{ _isg_frag_abs }}", "{{ rhc_seed }}"]
      register: _isg_st

    - name: Both are regular files
      ansible.builtin.assert:
        that: _isg_st.results | map(attribute='stat') | selectattr('isreg', 'defined') | selectattr('isreg') | list | length == 2
        fail_msg: "RHC-ISG: {{ _isg_frag_abs }} or {{ rhc_seed }} is not a regular file"
        quiet: true

    - name: Render the export with the REAL fixture bs (G3 subject; also every non-grep case's gate)
      ansible.builtin.set_fact:
        _isg_real: "{{ lookup('ansible.builtin.template', _isg_frag_abs, template_vars={'lme_seed_bs': _isg_bs, 'lme_seed_lock': _isg_lock}) }}"

    - name: Split the rendered export at its declared seam (refusal_fn's closing line, then the installed-set gate)
      vars:
        _lines: >-
          {{ _isg_real.split('\n') }}
        _n: >-
          {{ _lines.index('}') + 1 if '}' in _lines else 0 }}
      ansible.builtin.set_fact:
        _isg_real_refuse: >-
          {{ _lines[:(_n | int)] | join('\n') }}
        _isg_real_gate: >-
          {{ _lines[(_n | int):] | join('\n') }}

    - name: G3 -- the export's refusal_fn and installed-set gate each occur EXACTLY once, verbatim, in the shipped seed
      vars:
        _seed: "{{ lookup('ansible.builtin.file', rhc_seed, rstrip=false) }}"
      ansible.builtin.assert:
        that:
          - _isg_real_refuse is match('lme_refuse\(\) \{\n')
          - _isg_real_gate | length > 0
          - _isg_real_refuse ~ '\n' ~ _isg_real_gate == _isg_real
          - _seed.count(_isg_real_refuse) == 1
          - _seed.count(_isg_real_gate) == 1
        fail_msg: >-
          RHC-ISG-FRAGMENT-NOT-IN-SEED: the export {{ _isg_frag_rel }} rendered with the real bs is not contained exactly once in
          {{ rhc_seed }} (refusal_fn {{ _seed.count(_isg_real_refuse) }}x, gate {{ _seed.count(_isg_real_gate) }}x,
          export sha256 {{ _isg_real | hash('sha256') }})
        quiet: true

    - name: Create the case dir (0700)
      ansible.builtin.file:
        path: "{{ _isg_dir }}"
        state: directory
        mode: '0700'

    - name: Record the real-bs export and the lock-side pins (evidence; the positives' .norm must equal lock-pins)
      ansible.builtin.copy:
        dest: "{{ _isg_dir }}/{{ item.k }}"
        content: "{{ item.v }}\n"
        mode: '0600'
      loop:
        - {k: fragment-real, v: "{{ _isg_real }}"}
        - k: lock-pins
          v: "{{ (lookup('ansible.builtin.template', rhc_isg_call_j2, template_vars={'rhc_call': {'fn': 'isg_lock_pins', 'args': [_isg_lock.packages]}}) | from_json).pins }}"
      loop_control:
        label: "{{ item.k }}"

    - name: Build each case's freeze listing (G1 isg_listing over the lock)
      ansible.builtin.set_fact:
        _isg_listings: >-
          {{ _isg_listings | default({}) | combine({item.id: lookup('ansible.builtin.template', rhc_isg_call_j2,
               template_vars={'rhc_call': {'fn': 'isg_listing', 'args': [_isg_lock.packages, item]}}) | from_json}) }}
      loop: "{{ rhc_isg_cases }}"
      loop_control:
        label: "{{ item.id | default('?') }}"

    - name: Every case is a declared, well-formed vector
      ansible.builtin.assert:
        that: _isg_listings[item.id].errors | length == 0
        fail_msg: "RHC-ISG: case {{ item.id }} not admitted: {{ _isg_listings[item.id].errors }}"
        quiet: true
      loop: "{{ rhc_isg_cases }}"
      loop_control:
        label: "{{ item.id }}"

    - name: Write the grep stubs (each exits its declared status; reads nothing)
      ansible.builtin.copy:
        dest: "{{ _isg_dir }}/grep-exit-{{ item }}"
        content: "#!{{ _isg_bs.os_tools.sh.path }}\nexit {{ item | int }}\n"
        mode: '0700'
      loop: "{{ rhc_isg_cases | selectattr('grep_exit', 'defined') | map(attribute='grep_exit') | map('int') | unique | list }}"

    - name: Render each case's gate from the export (a grep_exit case = the fixture bs with ONLY os_tools.grep.path overridden)
      vars:
        _stub: "{{ _isg_dir ~ '/grep-exit-' ~ (item.grep_exit | default(0) | int) }}"
        _case_bs: >-
          {{ _isg_bs if item.grep_exit is not defined
             else (_isg_bs | combine({'os_tools': {'grep': {'path': _stub}}}, recursive=true)) }}
      ansible.builtin.set_fact:
        _isg_gates: >-
          {{ _isg_gates | default({}) | combine({item.id: _isg_real if item.grep_exit is not defined
               else lookup('ansible.builtin.template', _isg_frag_abs, template_vars={'lme_seed_bs': _case_bs, 'lme_seed_lock': _isg_lock})}) }}
      loop: "{{ rhc_isg_cases }}"
      loop_control:
        label: "{{ item.id }}"

    - name: A grep_exit case's gate invokes the stub and never the declared grep (the override reached route's macro)
      vars:
        _stub: "{{ _isg_dir ~ '/grep-exit-' ~ (item.grep_exit | int) }}"
      ansible.builtin.assert:
        that:
          - _isg_gates[item.id] != _isg_real
          - ("'" ~ _stub ~ "' -v -x -E ") in _isg_gates[item.id]
          - ("'" ~ _isg_bs.os_tools.grep.path ~ "' -v -x -E ") not in _isg_gates[item.id]
        fail_msg: "RHC-ISG: case {{ item.id }} does not run the stub {{ _stub }} in place of {{ _isg_bs.os_tools.grep.path }}"
        quiet: true
      loop: "{{ rhc_isg_cases | selectattr('grep_exit', 'defined') | list }}"
      loop_control:
        label: "{{ item.id }}"

    - name: Write each case script
      ansible.builtin.copy:
        dest: "{{ _isg_dir }}/{{ item.id }}.sh"
        mode: '0700'
        content: |
          #!{{ _isg_bs.os_tools.sh.path }}
          # G fixture {{ item.id }} (seed_installed_set.yml): lme_refuse and the installed-set gate are route's export
          # {{ _isg_frag_rel }} rendered with the fixture bs{{ ' (os_tools.grep.path = stub exit ' ~ item.grep_exit ~ ')' if item.grep_exit is defined else '' }}; only _inv is G's.
          set -u
          LC_ALL={{ _isg_bs.base_env.LC_ALL | quote }}; export LC_ALL
          _inv={{ _isg_listings[item.id].text | quote }}
          {{ _isg_gates[item.id] }}
          printf '%s\n' "$_norm" > {{ (_isg_dir ~ '/' ~ item.id ~ '.norm') | quote }}
          printf 'RHC-ISG-ADMITTED %s\n' "$_norm"
      loop: "{{ rhc_isg_cases }}"
      loop_control:
        label: "{{ item.id }}"

    - name: Report
      ansible.builtin.debug:
        msg: >-
          RHC-ISG-RENDERED cases={{ rhc_isg_cases | length }} RHC-ISG-FRAGMENT-IN-SEED seed_sha256={{ _isg_st.results[1].stat.checksum }}
          export_sha256={{ _isg_st.results[0].stat.checksum }} fragment_sha256={{ _isg_real | hash('sha256') }}
          fragment={{ _isg_frag_rel }} lock={{ rhc_isg_lock_rel }}
{% endraw %}
