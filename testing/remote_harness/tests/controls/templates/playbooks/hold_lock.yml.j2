---
# rendered per control into <ctl>/playbooks/hold_lock.yml (G). Runs under `seed run` (so the seed holds the root
# lock), signals ready, calls the seed on the SAME root from inside the run's managed environment exactly as
# inherited (D12), records its stderr/rc/elapsed seconds, then waits for the runner's release file (C05/D11).
- name: Hold the root lock and probe a nested seed call
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
{% raw %}
    - name: Signal that the run holds the lock
      ansible.builtin.copy:
        dest: "{{ rhc_ctl }}/ready"
        content: "ready\n"
        mode: '0600'

    - name: Note the start time of the nested call
      ansible.builtin.set_fact:
        _rhc_nested_t0: "{{ now(utc=true).timestamp() }}"

    - name: Call the seed on the same root from inside the run (must refuse BUSY at once)
      ansible.builtin.command:
        argv: ["{{ rhc_seed }}", verify, --root, "{{ rhc_root }}"]
      register: _rhc_nested
      changed_when: false
      failed_when: false
      timeout: 120

    - name: Record the nested call
      ansible.builtin.copy:
        dest: "{{ rhc_ctl }}/nested.{{ item.k }}"
        content: "{{ item.v }}\n"
        mode: '0600'
      loop:
        - {k: stderr, v: "{{ _rhc_nested.stderr | default('') }}"}
        - {k: rc, v: "{{ _rhc_nested.rc | default(-1) }}"}
        - {k: elapsed_s, v: "{{ ((now(utc=true).timestamp() | float) - (_rhc_nested_t0 | float)) | int }}"}

    - name: Wait for the runner to release the lock
      ansible.builtin.wait_for:
        path: "{{ rhc_ctl }}/release"
        timeout: 900
{% endraw %}
