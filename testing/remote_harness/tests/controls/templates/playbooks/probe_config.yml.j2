---
# rendered per control into <ctl>/playbooks/probe_config.yml (G). Prints the configuration file the running
# executor actually loaded, so a decoy ansible.cfg in the working directory is observable (G01).
- name: Probe the loaded Ansible configuration file
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Print the loaded configuration file
      ansible.builtin.debug:
        msg: "RHC-CONFIG-FILE={% raw %}{{ ansible_config_file | default('none') }}{% endraw %}"
