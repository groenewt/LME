{%- set out = s[xp.outputs.companions.macro](bs, {cm.sources.binding: rt[cm.sources.binding]}) -%}
{%- set got = out | from_json -%}
{%- if got is not mapping or (got.keys() | list | sort) != (xr.companions | sort) or (got | to_json(sort_keys=true)) != (rt[cm.sources.binding] | to_json(sort_keys=true)) -%}{{ ge[xp.refuse_macro](bs, ctl, cd.texts.cold_render_companions) }}{%- endif -%}
