{#- the ONE envelope word: {<var>: <record>} as JSON text (E1-E4 render checks, then s.record_text) -#}
{%- macro envelope(bs, ctl, var, transport, edition, digest, registry, comp) -%}
{%- set cd = bs.genesis.initializer.custody.cold_launch -%}
{%- import bs.macros_rel | relpath(cd.template_rel | dirname) as s -%}
{%- import bs.genesis.builder.checkout_members_render.macros_rel | relpath(cd.template_rel | dirname) as ge -%}
{%- set sa = bs.source_admission -%}
{%- set cm = sa.bootstrap_input.construction -%}
{%- set xr = bs.genesis.initializer.custody.external_invocation.cold_launch_release -%}
{%- set lw = namespace(n=bs, t=bs, inv=cd.initial.rows) -%}
{%- for k in xr.context_from -%}{%- set lw.n = lw.n[k] -%}{%- endfor -%}
{%- if lw.n != sa.early_view.launch_context_fields -%}{{ ge.render_refuse(bs, ctl, cd.texts.cold_render_context) }}{%- endif -%}
{%- for f, kp in sa.early_view.launch_context_fields | dictsort -%}{%- set w = namespace(n=bs) -%}{%- for k in kp -%}{%- set w.n = w.n[k] -%}{%- endfor -%}{%- if w.n == sa.invocation -%}{%- set lw.inv = lw.inv + [f] -%}{%- endif -%}{%- endfor -%}
{%- if lw.inv == cd.initial.rows -%}{{ ge.render_refuse(bs, ctl, cd.texts.cold_render_context) }}{%- endif -%}
{%- for k in xr.ingress.transport_from -%}{%- set lw.t = lw.t[k] -%}{%- endfor -%}
{%- if transport != lw.t or transport != xr.transport -%}{{ ge.render_refuse(bs, ctl, cd.texts.cold_render_transport) }}{%- endif -%}
{%- set bn = sa.bootstrap_input.record_keys | sort | map('extract', cm.fields) | selectattr('source', 'equalto', cm.sources.binding) | map(attribute='pinned') | list -%}
{%- if (bn | sort) != (xr.companions | sort) or comp is not mapping or (comp.keys() | list | sort) != (bn | sort) -%}{{ ge.render_refuse(bs, ctl, cd.texts.cold_render_companions) }}{%- endif -%}
{#- CPL-OP1B-B-ENVELOPE: runtime[binding] = {pinned var name: JSON text}, one entry per construction binding field -#}
{%- set bm = namespace(p=cd.initial.rows) -%}{%- for v in bn -%}{%- set bm.p = bm.p + [[v, comp[v] | tojson]] -%}{%- endfor -%}
{{ s.record_text(bs, var, {cm.sources.edition: edition | tojson, cm.sources.digest: digest | tojson, cm.sources.registry: registry | tojson, cm.sources.launch_transport: transport | tojson, cm.sources.binding: dict(bm.p)}) }}
{%- endmacro -%}

{#- the companion word: {<pinned var>: <value>} as JSON text, one mapping over exactly the row companions (E2) -#}
{%- macro companions(bs, ctl, comp) -%}
{%- set cd = bs.genesis.initializer.custody.cold_launch -%}
{%- import bs.genesis.builder.checkout_members_render.macros_rel | relpath(cd.template_rel | dirname) as ge -%}
{%- set xr = bs.genesis.initializer.custody.external_invocation.cold_launch_release -%}
{%- if comp is not mapping or (comp.keys() | list | sort) != (xr.companions | sort) -%}{{ ge.render_refuse(bs, ctl, cd.texts.cold_render_companions) }}{%- endif -%}
{{ comp | tojson }}
{%- endmacro -%}
