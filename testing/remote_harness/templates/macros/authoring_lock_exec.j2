{%- macro fd_identity(c, launch, tools, sh, descriptor) -%}
{%- set r=c.shell_render -%}{%- set l=c.lock -%}
{%- set path=[c.proc_root,l.proc_self,c.proc_fd,descriptor] | join(c.separator) -%}
{{- sh.line(r,sh.guarded(r,sh.assign(r,l.identity_variable,sh.sub(r,sh.command(r,tools.stat.path,l.preopen_stat_args,[sh.quote(r,path)]))),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,l.identity_variable),r.operators.equals,sh.quote(r,launch.root_identity)]),c.refusal_rc,c.absent)) -}}
{%- endmacro -%}
{%- macro lock_and_exec(c, launch, tools, sh) -%}
{%- set r=c.shell_render -%}{%- set l=c.lock -%}
{%- for descriptor in [l.preopen_fd,l.opened_fd,l.fd] -%}
{%- set path=[c.proc_root,l.proc_self,c.proc_fd,descriptor] | join(c.separator) -%}
{{- sh.line(r,sh.guarded(r,sh.test(r,[r.tests['not'],r.tests.exists,sh.quote(r,path)]),c.refusal_rc,c.absent)) -}}
{%- endfor -%}
{{- sh.line(r,l.read_open_format.format(descriptor=l.preopen_fd,path=sh.quote(r,launch.root))) -}}
{{- fd_identity(c,launch,tools,sh,l.preopen_fd) -}}
{%- set continuation -%}
{{- fd_identity(c,launch,tools,sh,l.opened_fd) -}}
{{- sh.line(r,l.duplicate_format.format(target=l.fd,source=l.opened_fd)) -}}
{{- sh.line(r,l.close_format.format(descriptor=l.opened_fd)) -}}
{{- sh.line(r,l.close_format.format(descriptor=l.preopen_fd)) -}}
{{- sh.line(r,sh.words(r,[l.export_word,sh.assign(r,l.pid_environment,l.pid_expansion)])) -}}
{%- set command=namespace(words=c.empty_list) -%}
{%- for arg in launch.argv -%}{%- set command.words=command.words+[sh.quote(r,arg)] -%}{%- endfor -%}
{{- sh.line(r,sh.words(r,[l.exec_word,sh.words(r,command.words)])) -}}
{%- endset -%}
{%- set prepath=[c.proc_root,l.proc_self,c.proc_fd,l.preopen_fd] | join(c.separator) -%}
{{- sh.line(r,sh.words(r,[l.exec_word,sh.command(r,tools.flock.path,[l.no_fork_arg,l.exclusive_arg,l.nonblock_arg],[sh.quote(r,prepath),sh.command(r,tools.sh.path,c.shell_args,[sh.quote(r,continuation)])])])) -}}
{%- endmacro -%}
