{#- testing/remote_harness/templates/macros/refusal.j2 -- the ONE formatter of a route refusal (controller.bootstrap
    .refusal_grammar; codex-tick399). g = the resolved refusal_grammar, code = the caller's declared refusal code,
    detail = a list of declared texts and observed values. Prints ONE line. AUTHORED, NEVER RENDERED. -#}
{%- macro refused(g, code, detail) -%}
{{ g.marker ~ g.code_separator ~ code ~ g.delimiter ~ g.detail_separator ~ (detail | join(g.detail_separator)) }}
{%- endmacro -%}
