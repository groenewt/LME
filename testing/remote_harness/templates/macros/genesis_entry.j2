{%- set j = '{' ~ (bs.genesis.source_record.anchor.var | tojson) ~ ': {' ~ (p.parts | join(', ')) ~ '}}' -%}
{{ j | replace('\\', '\\\\') | replace('%', '%%') | replace((cm.runtime_mark | tojson) | replace('%', '%%'), '"%s"') }}
