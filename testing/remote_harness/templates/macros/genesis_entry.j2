    own '/'): that '/' is the argv template's spelling (launch.argv), not a path join of this file -#}

{#- ONE plan step at runtime (the stage phase body; si = the stage's union index for its closure sums) -#}
{%- macro run_step(bs, ctl, p, pk, stp, si) -%}
{%- set e = bs.genesis.entry -%}
{%- set sel = e.selection -%}
{%- set l = bs.genesis.launch -%}
{%- set sr = bs.genesis.source_record -%}
{%- set rb = bs.run_binding -%}
{%- set bi = bs.source_admission.bootstrap_input -%}
{%- set gr = bs.source_admission.rel_path_grammar -%}
{%- set n = stp.stage -%}
{%- set st = l.stages[n] -%}
{%- set kd = l.inventory_kinds[stp.inventory_kind] -%}
lme_phase {{ s.shq(e.phases.stage ~ ' ' ~ n) }}
_sr="$_T${_S}{{ n }}${_S}$ACT"
_ev="$_V${_S}{{ n }}${_S}$ACT"
printf '%s' "$_cs_{{ si }}" | (cd "$CO" && {{ s.x(bs, 'sha256sum') }} --check --strict --quiet -) >/dev/null 2>&1 || lme_refuse {{ e.codes.closure }} {{ s.shq(e.texts.race) }} {{ s.shq(n) }}
lme_verify_content
lme_verify_published
set --{% for w in l.argv %} {{ gword(bs, ctl, w, st, n, stp) }}{% endfor %}

_nrec=0; _nanc=0; _w1=''; _w2=''
for _w in "$@"; do
  [ -z "$REC" ] || [ "$_w" != "$REC" ] || _nrec=$((_nrec + 1))
  [ "$_w" != "$ANCHOR" ] || _nanc=$((_nanc + 1))
  _w1=$_w2; _w2=$_w
done
{% if n == sr.stage %}
[ -z "$REC" ] && [ "$_nanc" -eq 1 ] || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.argv) }} {{ s.shq(n) }}
{% else %}
[ -n "$REC" ] && [ "$_nrec" -eq 1 ] && [ "$_w2" = "$REC" ] && [ "$_w1" = {{ s.shq(l.extra_vars_flag) }} ] && [ "$_nanc" -eq 0 ] || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.argv) }} {{ s.shq(n) }}
{% endif %}
_t0=$({{ s.x(bs, 'date') }} -u +%Y-%m-%dT%H:%M:%SZ)
(cd "$CO" && exec "$@" 9<&-); _rc=$?
_t1=$({{ s.x(bs, 'date') }} -u +%Y-%m-%dT%H:%M:%SZ)
{
  printf 'schema: %s\nformat: %s\nflow: %s\nstage: %s\nact: %s\nstage_root: %s\nargv:\n' {{ s.shq(l.step_record.schema) }} {{ s.shq(l.step_record.format) }} {{ s.shq(sel.flows[pk]) }} {{ s.shq(n) }} "$(lme_yq "$ACT")" "$(lme_yq "$_sr")"
  for _w in "$@"; do printf -- '- %s\n' "$(lme_yq "$_w")"; done
  printf 'cwd: %s\n' "$(lme_yq "$CO")"
  printf 'env:\n  declaration: %s\n  pairs:\n' {{ s.shq(l.step_record.fields.env.declaration) }}
{% for v in l.env.order %}
  printf -- '  - %s\n' "$(lme_yq {{ env_word(bs, v) }})"
{% endfor %}
  printf 'source: {checkout: %s, commit: %s, tree: %s, status: %s}\n' "$(lme_yq "$CO")" "$ED" "$_tr" "''"
  printf 'config:\n  profile_rel: %s\n  profile_sha256: %s\n  inventory_kind: %s\n  inventory:\n' {{ s.shq(bi.declaration_rel) }} "$DS" {{ s.shq(stp.inventory_kind) }}
{% for r in kd.files %}
  printf '  - {role: %s, path: %s, sha256: %s}\n' {{ s.shq(r) }} "$(lme_yq "$_a_{{ fa(sel, rb, r) }}")" "$_dg_{{ r }}"
{% endfor %}
{% if kd.receipt is defined %}
  printf '  binding_receipt: {path: %s, sha256: %s}\n' "$(lme_yq "$RCP")" "$_dg_{{ kd.receipt }}"
{% else %}
  printf '  binding_receipt: none\n'
{% endif %}
  printf '  ansible_config_file: %s\n' "$(lme_yq "$G${_S}{{ bs.layout.config_file }}")"
{% if stp.extra_vars | length == 0 %}
  printf 'extra_vars: []\n'
{% else %}
  printf 'extra_vars:\n'
{% for nm in st.extra_vars %}{% for role, arg in stp.extra_vars | dictsort(case_sensitive=true) if rb.inputs[role] == nm %}
  printf -- '- {name: %s, value: %s}\n' {{ s.shq(nm) }} "$(lme_yq "$_a_{{ arg }}")"
{% endfor %}{% endfor %}
{% endif %}
  printf 'builder: {generation: %s, executable: %s, executable_sha256: %s, python: %s, tree_manifest_sha256: %s}\n' "$GEN_ID" "$(lme_yq "$BX")" "${_bxd%% *}" "$(lme_yq "$BP")" "${_tmd%% *}"
  printf 'started_at_utc: %s\nended_at_utc: %s\n' "$_t0" "$_t1"
  printf 'capture: {reference: %s, fidelity: {streams: separate, complete: false}}\n' {{ s.shq(e.capture_reference | tojson) }}
  printf 'exit_status: %s\n' "$_rc"
} > "$_ev${_S}{{ l.step_record.files.record }}" || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.step_record) }} {{ s.shq(n) }}
[ "$_rc" -eq 0 ] || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.stage_exit) }} {{ s.shq(n) }} "$_rc"
{% if n == sr.stage %}
_rf="$_sr${_S}{{ sr.output.record_rel }}"
[ -f "$_rf" ] && [ ! -L "$_rf" ] && [ "$({{ s.x(bs, 'stat') }} -c '%u %a' -- "$_rf")" = "$_uid {{ sr.output.mode | int }}" ] || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.record_file) }} "$_rf"
REC=$({{ s.x(bs, 'cat') }} -- "$_rf") && [ -n "$REC" ] || lme_refuse {{ e.codes.stage }} {{ s.shq(e.texts.record_read) }} "$_rf"
{% endif %}
{% if p.binding is defined and n == p.binding.stage %}
{#- THE ONE POST-CLOSURE FILE ADMISSION (measurement binding): the produced binding file and its receipt exist only
    after the render stage exits; both are admitted HERE, before the next step launches -- the binding as a data-only
    inventory file (owner, no group/other write, no execute / set-id / sticky bit, adjacent auto-load absent, digest),
    the receipt (<binding dir> ~ run_binding.receipt_suffix) as an owned regular file outside every -i of the plan -#}
_dg_{{ p.binding.produced }}=$(lme_admit_inv "$_a_{{ sel.file_args[p.binding.produced] }}") || exit $?
RCP="${_a_{{ sel.file_args[p.binding.produced] }}%"$_S"*}"{{ s.shq(rb.receipt_suffix) }}
{% for r in l.inventory_kinds[p.binding.kind].files %}
[ "$RCP" != "$_a_{{ fa(sel, rb, r) }}" ] || lme_refuse {{ e.codes.inventory }} {{ s.shq(e.texts.binding_file) }} "$RCP"
{% endfor %}
_dg_{{ l.inventory_kinds[p.binding.kind].receipt }}=$(lme_admit_receipt "$RCP") || exit $?
{% endif %}
{%- endmacro -%}

{%- macro genesis_entry(bs, ctl, lock, seed_sha256) -%}
{% set e = bs.genesis.entry %}
{% set sel = e.selection %}
{% set l = bs.genesis.launch %}
{% set sr = bs.genesis.source_record %}
{% set b = bs.genesis.builder %}
{% set sa = bs.source_admission %}
{% set gr = sa.rel_path_grammar %}
{% set bi = sa.bootstrap_input %}
{% set g = sa.git %}
{% set cm = bi.construction %}
{% set rb = bs.run_binding %}
{% set rows = bs.artifacts + lock.packages + lock.collections %}
{% set st_ = e.store %}
{% set cl = e.closure %}
{% set cs = cl.case_sensitive %}
{#- MR03-STAGING (codex-tick611 G03 / tick616): the ONE staging producer declaration, its ordered source argument
    list (files-key order) and the measurement root location (ONE authority: the controller-operation input) -#}
{% set sg = e.staging %}
{% set _sga = namespace(a=[]) %}{% for k, f in sg.files | dictsort(case_sensitive=cs) %}{% set _sga.a = _sga.a + [f.source_arg] %}{% endfor %}
{% set _sgl = bs.inventory.controller_operations[sg.measurement.operation].inputs[sg.measurement.input].location %}
{#- ---- RENDER-TIME CHECKS (each refuses through the ONE refusal grammar with its declared text) ---- -#}
{% if (e.codes.keys() | list | sort) != (e.statuses.keys() | list | sort)
   or e.codes.values() | select('in', bs.refusals.keys() | list) | list | length != 0
   or e.codes.values() | select('in', sr.refusals.values() | list) | list | length != 0
   or e.statuses.values() | select('in', bs.refusals.values() | list) | list | length != 0
   or e.codes.values() | unique(case_sensitive=cs) | list | length != e.codes | length
   or e.statuses.values() | unique(case_sensitive=cs) | list | length != e.statuses | length %}{{ render_refuse(bs, ctl, e.texts.render_codes) }}{% endif %}
{% if cs is not sameas true %}{{ render_refuse(bs, ctl, e.texts.render_stages) }}{% endif %}
{#- SELECTION (render_selection): flows <-> plans; the selection input is an operator input whose domain IS the flows;
    file_args values are cli.args keys and no base argument; every plan starts with the producer stage, names each
    stage once, admits each step kind on its stage, carries exactly the projected run-binding inputs of the genesis
    render stage (required roles present) and none elsewhere, names only declared operations of that kind, declared
    prerequisite phases and marker, a boolean acquisition_inputs, and a binding exactly when a step kind needs a
    produced file (the genesis launch stage of run_binding, its inventory kind, a produced role of the binding kind
    whose steps follow the render stage, and that kind's receipt role) -#}
{% set _sb = namespace(bad=false) %}
{% set _rq = namespace(req=[]) %}{% for role, ir in rb.input_roles | dictsort(case_sensitive=cs) if ir.required is sameas true %}{% set _rq.req = _rq.req + [role] %}{% endfor %}
{% if (sel.flows.keys() | list | sort) != (sel.plans.keys() | list | sort)
   or sel.flows.values() | unique(case_sensitive=cs) | list | length != sel.flows | length
   or sel.input not in l.operator_inputs or l.operator_inputs[sel.input].class != l.input_sources.operator
   or walk(ctl, l.operator_inputs[sel.input].domain) != (sel.flows | tojson)
   or sel.file_args.values() | reject('in', e.cli.args.keys() | list) | list | length != 0
   or sel.file_args.values() | unique(case_sensitive=cs) | list | length != sel.file_args | length
   or rb.lab_role in sel.file_args or rb.lab_role in e.cli.args %}{% set _sb.bad = true %}{% endif %}
{% for pk, p in sel.plans | dictsort(case_sensitive=cs) %}
{% set _ps = p.steps | map(attribute='stage') | list %}
{% if _ps | length == 0 or _ps[0] != sr.stage or _ps | unique(case_sensitive=cs) | list | length != _ps | length
   or p.marker not in e.markers or p.acquisition_inputs is not boolean
   or (p.binding is defined and (p.binding.stage != rb.launches.genesis.stage or p.binding.stage not in _ps
       or p.binding.kind not in l.inventory_kinds or p.binding.produced not in l.inventory_kinds[p.binding.kind].files
       or rb.lab_role not in l.inventory_kinds[p.binding.kind].files or rb.lab_role == p.binding.produced or l.inventory_kinds[p.binding.kind].receipt is not defined
       or p.binding.produced not in sel.file_args)) %}{% set _sb.bad = true %}{% endif %}
