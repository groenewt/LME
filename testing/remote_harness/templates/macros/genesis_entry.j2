{%- elif w == l.scalar_slots.builder -%}"$G${_S}{{ bs.layout.gen_dirs[b.executable.gen_dir] }}${_S}{{ b.executable.rel }}"
{%- elif w == l.slots.inventory_args -%}{% for r in l.inventory_kinds[stp.inventory_kind].files %} {{ s.shq(bs.ssh_auth.run_grammar.inventory_flag) }} "$_a_{{ fa(sel, rb, r) }}"{% endfor %}
