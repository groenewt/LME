{% macro stage_input_fns(bs) %}
{# lme_value_ok <value> <ERE>: 0 admitted, 1 holds the terminator (refused FIRST: a line matcher sees only its first
    line), 2 not ONE whole line fully matching the ERE. codex-tick626 LI-NEW-VALUE-SOURCING: the ONE value matcher --
    lme_rel_ok's own words moved here (the pattern now its second argument), not restated. lme_rel_ok <rel>: 0
    admitted, 1 / 2 as lme_value_ok against the declared path pattern (its status returned unchanged), 2 a refused
    component -#}
lme_value_ok() {
  case "$1" in *"$_N"*) return 1 ;; esac
  printf '%s%s' "$1" "$_N" | {{ s.x(bs, 'grep') }} -E -x -q -- "$2" || return 2
  return 0
}
{# lme_chars_ok <value> <chars>: 0 every character of the value is a LITERAL member of chars, else 1 (codex-tick632
    LI-PATTERN-JSON-ENCODING). Membership is a QUOTED case pattern (*"<c>"*: quoted pattern characters match only
    themselves), so ! ^ - [ ] \ in chars are members like any other byte and never bracket syntax. One character per
    step (${v%"${v#?}"} is the first character); an empty step -- a byte the locale cannot read as a character --
    refuses instead of matching the empty pattern. The empty value has no character: admitted here, the pattern
    decides -#}
lme_chars_ok() {
  _lc_v=$1
  while [ -n "$_lc_v" ]; do
    _lc_c=${_lc_v%"${_lc_v#?}"}
    [ -n "$_lc_c" ] || return 1
    case "$2" in *"$_lc_c"*) ;; *) return 1 ;; esac
    _lc_v=${_lc_v#?}
  done
  return 0
}{% endmacro %}
