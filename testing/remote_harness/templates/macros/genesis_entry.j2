{%- elif c.source == cm.sources.policy -%}{%- set p.parts = p.parts + [(k | tojson) ~ ': ' ~ walk(bs, c.path)] -%}
{%- else -%}{%- set p.parts = p.parts + [(k | tojson) ~ ': ' ~ (cm.runtime_mark | tojson)] -%}
{%- endif -%}
