{%- elif w == l.slots.stage_extra_vars -%}{% for nm in st.extra_vars %}{% for role, arg in stp.extra_vars | dictsort(case_sensitive=true) if rb.inputs[role] == nm %} {{ s.shq(l.extra_vars_flag) }} {{ s.shq(nm ~ '=') }}"$_a_{{ arg }}"{% endfor %}{% endfor %}
{%- elif w == l.slots.stage_inputs -%}{% for i in st.stage_inputs %} {{ s.shq(l.extra_vars_flag) }} {% if i.source == sr.anchor.source %}"$ANCHOR"{% else %}"$_in_{{ i.name }}"{% endif %}{% endfor %}
{%- elif w == l.scalar_slots.checkout ~ '/' ~ l.scalar_slots.playbook -%}"$CO${_S}{{ st.playbook_rel }}"
{%- elif w == l.slots.source_record -%}{% if stage != sr.stage %} {{ s.shq(l.extra_vars_flag) }} "$REC"{% endif %}
