{%- macro read_bound(c, root, receipt, uid_var, tools, q, sh) -%}
{%- set r = c.shell_render -%}{%- set v = r.variables -%}
{%- set identifier = namespace(ok=(uid_var is string and uid_var == c.bound_read_uid_var and uid_var | length > c.zero)) -%}
{%- if uid_var is string -%}
{%- for ch in uid_var -%}{%- if (loop.first and ch not in c.shell_var_first) or ch not in c.shell_var_rest -%}{%- set identifier.ok = c.absent -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- if not identifier.ok -%}
{{- sh.line(r,sh.refuse(r,c.refusal_rc,c.present)) -}}
{%- else -%}
{{- sh.line(r,sh.guarded(r,sh.test(r,[q(receipt.path),r.operators.equals,q(root ~ c.separator ~ c.active_rel)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.test(r,[r.tests.directory,q(root)]),sh.test(r,[r.tests['not'],r.tests.link,q(root)])],r.operators['and']),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.test(r,[r.tests.file,q(receipt.path)]),sh.test(r,[r.tests['not'],r.tests.link,q(receipt.path)])],r.operators['and']),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.read_custody,sh.sub(r,sh.command(r,tools.stat.path,c.file_stat_args,[q(receipt.path)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,v.read_custody),r.operators.equals,sh.ref(r,uid_var) ~ q(c.identity_separator ~ c.file_stat_mode)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.read_size,sh.sub(r,sh.command(r,tools.stat.path,c.size_stat_args,[q(receipt.path)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,v.read_size),r.operators.le,c.publication_max_bytes]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.read_digest,sh.sub(r,sh.command(r,tools.sha256sum.path,[c.path_terminator],[q(receipt.path)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.assign(r,v.read_digest,r.formats.suffix_remove | replace(r.placeholders.suffix_name,v.read_digest) | replace(r.placeholders.suffix_pattern,r.patterns.digest_suffix))) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,v.read_digest),r.operators.equals,q(receipt.sha256)]),c.refusal_rc,c.present)) -}}
{%- endif -%}
{%- endmacro -%}
