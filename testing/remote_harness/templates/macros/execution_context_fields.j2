{% macro kind(value, allowed, tests, structural) -%}
{%- set found = namespace(count=structural.zero) -%}
{%- for name in allowed -%}
  {%- set rule = tests[name] -%}
  {%- set candidate = namespace(ok=([value] | select(rule.test) | list | length == structural.one)) -%}
  {%- for exclusion in rule.excludes -%}
    {%- if [value] | select(exclusion) | list | length != structural.zero -%}
      {%- set candidate.ok = structural.refused -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if candidate.ok -%}{%- set found.count = found.count + structural.one -%}{%- endif -%}
{%- endfor -%}
{{- (found.count == structural.one) | to_json -}}
{%- endmacro %}

{% macro fields(value, field_names, kinds, patterns, tests, registry_patterns, path_law, structural, match_type) -%}
{%- set result = namespace(ok=(value is mapping)) -%}
{%- if result.ok -%}
  {%- set result.ok = (value | list | sort == field_names | sort) -%}
{%- endif -%}
{%- if result.ok -%}
  {%- for field in field_names -%}
    {%- if not (kind(value[field], kinds[field], tests, structural) | from_json) -%}
      {%- set result.ok = structural.refused -%}
    {%- elif field in patterns -%}
      {%- set grammar = registry_patterns[patterns[field]] -%}
      {%- if grammar is mapping -%}
        {%- if not (value[field] is regex(grammar.pattern, match_type=match_type)) or value[field].split(path_law.separator) | intersect(grammar.refused_components) | length != structural.zero -%}
          {%- set result.ok = structural.refused -%}
        {%- endif -%}
      {%- elif not (value[field] is regex(grammar, match_type=match_type)) -%}
        {%- set result.ok = structural.refused -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{{- result.ok | to_json -}}
{%- endmacro %}
