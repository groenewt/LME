{%- macro iface(bs) -%}
{%- set e = bs.genesis.entry -%}
{%- set sel = e.selection -%}
{%- set acq = bs.genesis.acquisition -%}
{%- set sr = bs.genesis.source_record -%}
{%- set l = bs.genesis.launch -%}
{%- set b = bs.genesis.builder -%}
{%- set sa = bs.source_admission -%}
{%- set bi = sa.bootstrap_input -%}
{%- set wr = bs.work_roots -%}
{%- set sep = bs.path_admission.separator -%}
{#- the policy-sourced record values of the declared construction map, walked over the RESOLVED declaration -#}
{%- set pv = namespace(p=[]) -%}
{%- for k, c in bi.construction.fields | dictsort if c.source == bi.construction.sources.policy -%}
{%- set w = namespace(n=bs) -%}{%- for p in c.path -%}{%- set w.n = w.n[p] -%}{%- endfor -%}
{%- set pv.p = pv.p + [[k, w.n]] -%}
{%- endfor -%}
{#- flow word -> the plan's acquisition_inputs (selection.flows maps plan key -> flow word) -#}
{%- set af = namespace(p=[]) -%}
{%- for pk, p in sel.plans | dictsort -%}{%- set af.p = af.p + [[sel.flows[pk], p.acquisition_inputs]] -%}{%- endfor -%}
{%- set i = {
  'policy_values': dict(pv.p),
  'anchor_var': sr.anchor.var,
  'record_var': bi.var,
  'record_keys': bi.record_keys | sort,
  'construction': bi.construction,
  'context_fields': sa.early_view.context_fields,
  'launch_context_fields': sa.early_view.launch_context_fields,
  'stage': sr.stage,
  'act_var': l.stage_root.act.var,
  'output': sr.output,
  'stage_root': [wr.root_rel, wr.sub_roots[l.stage_root.sub], l.stage_root.rel, sr.stage] | join(sep),
  'refusals': sr.refusals,
  'texts': sr.texts,
  'declaration_rel': bi.declaration_rel,
  'declaration_path': bi.declaration_path,
  'controller_delegate': sa.controller_delegate,
  'edition_regex': sa.git.edition_regex,
  'digest_regex': e.digest_regex,
  'rel_path_grammar': sa.rel_path_grammar,
  'separator': sep,
  'override_var': sa.early_view.override.var,
  'builder': {
    'core': b.core,
    'root_rel': [wr.root_rel, wr.sub_roots[b.root.sub]] | join(sep),
    'authoring_root_rel': [wr.root_rel, wr.sub_roots[b.authoring.root.sub]] | join(sep),
    'generations_dir': bs.layout.generations_dir,
    'python_rel': [bs.layout.gen_dirs[b.python.gen_dir], b.python.rel] | join(sep),
    'executable_rel': [bs.layout.gen_dirs[b.executable.gen_dir], b.executable.rel] | join(sep),
    'config_rel': bs.layout.config_file,
  },
  'initializer_admission_var': bs.genesis.initializer.admission.var,
  'store_rel': [wr.root_rel, wr.sub_roots[e.store.sub], e.store.rel] | join(sep),
  'source_var': acq.source_var,
  'receipt_var': acq.receipt_var,
  'bundle_var': acq.bundle_var,
  'flow_input': sel.input,
  'acquisition_by_flow': dict(af.p),
  'acquisition_vars': [acq.source_var, acq.receipt_var, acq.bundle_var],
} -%}
{{ i | tojson }}
{%- endmacro -%}
{#- FROZEN, no further writes -#}
