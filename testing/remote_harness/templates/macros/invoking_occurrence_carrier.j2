{% macro invoking_carrier(bs, o) -%}
{% set c = o.carrier %}
{% set s = o.structural %}
{% set a = c.f %}
{% set r = o.reference %}
{% set stage = namespace(variable=bs, fd=bs, root=bs) %}
{% for key in c.stage_variable_from %}{% set stage.variable = stage.variable[key] %}{% endfor %}
{% for key in c.stage_fd_from %}{% set stage.fd = stage.fd[key] %}{% endfor %}
{% for key in c.fd_root_from %}{% set stage.root = stage.root[key] %}{% endfor %}
{% for variable in [c.path_variable, c.self_variable, stage.variable] %}
case "${{ variable }}" in {{ s.path_separator | quote }}*) ;; *) lme_refuse {{ c.refusal | quote }};; esac
case "${{ variable }}" in *[!{{ bs.path_admission.charset }}]*{% for value in bs.path_admission.forbidden %}|{{ value }}{% endfor %}) lme_refuse {{ c.refusal | quote }};; esac
{% endfor %}
case "${{ c.generation_variable }}" in {% for value in c.generation_refuse %}{{ value if value else o.shell.empty_case }}{{ o.shell.case_separator if not loop.last else o.structural.empty_text }}{% endfor %}) lme_refuse {{ c.refusal | quote }};; esac
case "${{ c.uid_variable }}" in {% for value in c.decimal_refuse %}{{ value if value else o.shell.empty_case }}{{ o.shell.case_separator if not loop.last else o.structural.empty_text }}{% endfor %}) lme_refuse {{ c.refusal | quote }};; esac
{% set command %}{{ bs.os_tools[c.hash_tool].path | quote }} {{ c.hash_args | map(o.filters.quote) | join(o.shell.separator) }} "${{ c.path_variable }}"{% endset %}
{{ o.shell.command_assignment_format | format(c.digest_variable, command) }} || lme_refuse {{ c.refusal | quote }}
{{ o.shell.suffix_assignment_format | format(c.digest_variable, o.shell.parameter_open, c.digest_variable, c.digest_separator | quote, o.shell.parameter_close) }}
{% for variable in [c.digest_variable, c.seed_sha_variable] %}
case "${{ variable }}" in {% for value in c.digest_refuse %}{{ value if value else o.shell.empty_case }}{{ o.shell.case_separator if not loop.last else o.structural.empty_text }}{% endfor %}) lme_refuse {{ c.refusal | quote }};; esac
[ "{{ o.shell.length_reference_format | format(o.shell.parameter_open, variable, o.shell.parameter_close) }}" -eq {{ c.digest_length }} ] || lme_refuse {{ c.refusal | quote }}
{% endfor %}
[ -d "${{ stage.variable }}" ] && [ ! -L "${{ stage.variable }}" ] || lme_refuse {{ c.refusal | quote }}
{% set command %}{{ bs.os_tools[c.stat_tool].path | quote }} {{ c.stat_path_args | map(o.filters.quote) | join(o.shell.separator) }} {{ c.identity_format | quote }} {{ c.end_of_options | quote }} "${{ stage.variable }}"{% endset %}
{{ o.shell.command_assignment_format | format(c.stage_path_identity_variable, command) }} || lme_refuse {{ c.refusal | quote }}
{% set command %}{{ bs.os_tools[c.stat_tool].path | quote }} {{ c.stat_fd_args | map(o.filters.quote) | join(o.shell.separator) }} {{ c.identity_format | quote }} {{ c.end_of_options | quote }} {{ (stage.root ~ s.path_separator ~ stage.fd) | quote }}{% endset %}
{{ o.shell.command_assignment_format | format(c.stage_fd_identity_variable, command) }} || lme_refuse {{ c.refusal | quote }}
[ "${{ c.stage_path_identity_variable }}" = "${{ c.stage_fd_identity_variable }}" ] || lme_refuse {{ c.refusal | quote }}
{% set command %}{{ o.shell.printf_command }} {{ c.printf_format | quote }} {{ o.source_carrier | quote }} {{ a.active | quote }} {{ r.path | quote }} "${{ c.path_variable }}" {{ r.sha256 | quote }} "${{ c.digest_variable }}" {{ a.program | quote }} {{ r.path | quote }} "${{ c.self_variable }}" {{ r.sha256 | quote }} "${{ c.seed_sha_variable }}" {{ a.generation | quote }} "${{ c.generation_variable }}" {{ a.uid | quote }} "${{ c.uid_variable }}" {{ a.directory | quote }} "${{ stage.variable }}" {{ a.identity | quote }} "${{ c.stage_path_identity_variable }}"{% endset %}
{{ o.shell.command_assignment_format | format(c.output, command) }} || lme_refuse {{ c.refusal | quote }}
{%- endmacro %}
