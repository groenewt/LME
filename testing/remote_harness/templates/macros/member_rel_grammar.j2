{#- testing/remote_harness/templates/macros/member_rel_grammar.j2 -- the ONE member rel grammar consumer (codex-tick755
    OPEN-S17-RF-MEMBER-GRAMMAR-CONSUMER). reg = the admitted contract_admission slice (_rh_sa_reg); every name, field,
    selector and word is an atom of reg.member_rel_grammar, reg.vocabulary, reg.patterns or reg.path_law. Returns
    {<output.form>: the canonical form (grammar_fields of the declared path grammar + law_fields of the path law),
     <output.refused>: the refused members}. A member is admitted only if it is a string (vocabulary tests.string),
    holds no path_law terminator, fully matches the grammar pattern, and has no refused component after the split on
    the path_law separator. Full match: the grammar pattern TEXT must hold no terminator and fully match the declared
    path ERE syntax (patterns[path_law.syntax], anchored), else every member is refused (fail-closed); the match test
    on a terminator-free value is then a full match. No regex is composed. -#}
{%- macro member_rel_grammar(reg, members) -%}
{%- set mg = reg.member_rel_grammar -%}
{%- set t = reg.vocabulary.tests -%}
{%- set ak = reg.vocabulary.attributes.item_key -%}
{%- set form = (reg.patterns[mg.pattern] | dict2items | selectattr(ak, t.in, mg.grammar_fields) | items2dict)
               | combine(reg.path_law | dict2items | selectattr(ak, t.in, mg.law_fields) | items2dict) -%}
{%- set ok = ([form.pattern] | select(t.string) | list | length) == 1
             and ([form.terminator] | select(t.in, form.pattern) | list | length) == 0
             and ([form.pattern] | select(t.fullmatch, reg.patterns[reg.path_law.syntax]) | list | length) == 1 -%}
{%- set bad = namespace(rels=[]) -%}
{%- for m in members -%}
{%- if not ok
      or ([m] | select(t.string) | list | length) != 1
      or ([form.terminator] | select(t.in, m) | list | length) != 0
      or ([m] | select(t.fullmatch, form.pattern) | list | length) != 1
      or (m.split(form.separator) | select(t.in, form.refused_components) | list | length) != 0 -%}
{%- set bad.rels = bad.rels + [m] -%}
{%- endif -%}
{%- endfor -%}
{{ dict([[mg.output.form, form], [mg.output.refused, bad.rels]]) | to_json }}
{%- endmacro -%}
