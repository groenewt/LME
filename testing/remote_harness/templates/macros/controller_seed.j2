{#- testing/remote_harness/templates/macros/controller_seed.j2 -- GENUINE, PARAMETERIZED Jinja macros that emit the
    managed-controller seed (POSIX sh) from the declarations:
      bs   = profile remote_harness.controller.bootstrap   (pins, artifacts, os_tools, budget, layout, refusals)
      ctl  = profile remote_harness.controller             (expect_core)
      lock = the file named by remote_harness.controller.lock_file_rel (wheels + collections)
    The seed is a BUILD OUTPUT rendered by package.yml into a local bundle; it is never committed.
    Every system executable is emitted through x(bs, name) = bs.os_tools[name].path (SEED-07b): an undeclared
    tool is a render error, a changed path changes the invocation. Every declared value reaches the shell
    through shq() (single-quote serialization); runtime values (root, generation path, op id) are the ONLY
    double-quoted expansions. Pure Jinja (no Ansible-only filters); block tags stay at column 0 so the
    ansible.builtin.template render (trim_blocks) and the lookup('template') render agree.
-#}
{%- macro shq(v) -%}
'{{ v | string | replace("'", "'\\''") }}'
{%- endmacro -%}

{%- macro cmt(v) -%}
{{ v | string | replace('\r', ' ') | replace('\n', ' ') }}
{%- endmacro -%}

{#- the declared executable for a tool name (quoted) -#}
{%- macro x(bs, n) -%}
{{ shq(bs.os_tools[n].path) }}
{%- endmacro -%}

{#- ---- declared pins as one table (recorded in receipts/pins.txt; the generation id binds the whole seed) ---- -#}
{%- macro pins_table(bs, ctl, lock) -%}
schema lme-controller-seed/v2
core {{ ctl.expect_core }}
python {{ bs.python.version }} pbs {{ bs.python.pbs_release }} mode {{ bs.python.install_mode }}
uv {{ bs.uv.version }} method {{ bs.uv.install_method }}
{% for a in bs.artifacts %}
artifact {{ a.key }} {{ a.file }} {{ a.sha256 }}
{% endfor %}
{% for p in lock.packages %}
wheel {{ p.name }} {{ p.version }} {{ p.file }} {{ p.sha256 }}
{% endfor %}
{% for c in lock.collections %}
collection {{ c.name }} {{ c.version }} {{ c.file }} {{ c.sha256 }}
{% endfor %}
{%- endmacro -%}

{#- ---- refusal vocabulary -> one shell function ---- -#}
{%- macro refusal_fn(refusals) -%}
lme_refuse() {
  _code=$1; shift
  case "$_code" in
{% for code, status in refusals | dictsort %}
    {{ code }}) _st={{ status | int }} ;;
{% endfor %}
    *) _st=1 ;;
  esac
  printf 'REFUSED %s %s\n' "$_code" "$*" >&2
  exit "$_st"
}
{%- endmacro -%}

{#- ---- env -i prefix: declared base env + literal extras + runtime words ---- -#}
{%- macro env_i(bs, extra_literal={}, runtime=[]) -%}
{{ x(bs, 'env') }} -i HOME="$HOME"{% for k, v in bs.base_env | dictsort %} {{ k }}={{ shq(v) }}{% endfor %}{% for k, v in extra_literal | dictsort %} {{ k }}={{ shq(v) }}{% endfor %}{% for w in runtime %} {{ w }}{% endfor %}
{%- endmacro -%}

{#- managed ansible environment: declared managed_env + the SEALED generation ansible.cfg (SEED-01) -#}
{#- the managed runtime names as `NAME=<shell value>` lines: the ONE list behind managed_env and the run-local
    lme_resolved_run.env record (so the record is exactly what is exported) -#}
{%- macro managed_pairs(bs, home_dir, tmp_dir) -%}
ANSIBLE_HOME={{ home_dir }}
ANSIBLE_LOCAL_TEMP={{ tmp_dir }}/ansible-local
ANSIBLE_GALAXY_CACHE_DIR={{ tmp_dir }}/galaxy-cache
ANSIBLE_COLLECTIONS_PATH=$G/{{ bs.layout.gen_dirs.collections }}
ANSIBLE_CONFIG=$G/{{ bs.layout.config_file }}
TMPDIR={{ tmp_dir }}
{%- endmacro -%}

{#- ---- SEED LAUNCH CONTRACT (bs.seed_launch; codex 183510) ---- -#}
{#- (1) base_check: every base_env name equals its declared value -- emitted BEFORE any case pattern (the pre-scope
    checks use bracket ranges whose meaning depends on the locale) -#}
{%- macro launch_base_check(bs) -%}
{% set sl = bs.seed_launch %}
{% if sl.base_check == 'exact' %}
{% for k, v in bs.base_env | dictsort %}
[ "${{ '{' ~ k ~ '-}' }}" = {{ shq(v) }} ] || lme_refuse {{ sl.refusal }} {{ shq('seed launch: ' ~ k ~ ' must be exactly ' ~ v ~ ' (seed_launch.base_check; start the seed through seed_launch)') }}
{% endfor %}
{% else %}
lme_refuse {{ sl.refusal }} {{ shq('undeclared seed_launch.base_check mode: ' ~ sl.base_check) }}
{% endif %}
{%- endmacro -%}

{#- (2) the ONE invoker derivation (after the os-tool identity checks): uid, passwd home == HOME, the user manager
    runtime dir (declared {uid} rule, owned, declared mode) and bus socket, caller-supplied names unset or equal,
    the account name. Sets _uid _home _xrd _bus _user; run-local and the budget scope consume these. -#}
{%- macro launch_derive(bs) -%}
{% set sl = bs.seed_launch %}
{% set dh = sl.derive.home %}
{% set um = bs.target_bootstrap.user_manager %}
{% set un = bs.work_roots.run_local.user_manager_env %}
{% set rt = um.runtime_dir.split('{uid}') %}
{% set hp = '*:' * ((dh.field | int) - 1) %}
_uid=$({{ x(bs, 'id') }} -u) || lme_refuse {{ sl.refusal }} 'seed launch: cannot read the invoking uid'
case "$_uid" in ''|*[!0-9]*) lme_refuse {{ sl.refusal }} "seed launch: unadmitted uid: $_uid" ;; esac
_pw=$({{ x(bs, dh.tool) }} {{ shq(dh.database) }} "$_uid") || lme_refuse {{ sl.refusal }} "seed launch: no {{ dh.database }} entry for uid $_uid"
_home=${_pw#{{ hp ~ '}' }}
_home=${_home%%:*}
case "$_home" in /*) : ;; *) lme_refuse {{ sl.refusal }} "seed launch: the {{ dh.database }} home of uid $_uid is not absolute: $_home" ;; esac
[ -d "$_home" ] && [ ! -L "$_home" ] && [ "$({{ x(bs, 'stat') }} -c %u -- "$_home")" = "$_uid" ] || lme_refuse {{ sl.refusal }} "seed launch: the {{ dh.database }} home $_home of uid $_uid is not an owned real directory"
[ "${HOME-}" = "$_home" ] || lme_refuse {{ sl.refusal }} "seed launch: HOME=${HOME-} is not the {{ dh.database }} home $_home of uid $_uid"
_xrd={{ shq(rt[0]) }}"$_uid"{{ shq(rt[1] if rt | length > 1 else '') }}
[ -d "$_xrd" ] && [ ! -L "$_xrd" ] && [ "$({{ x(bs, 'stat') }} -c '%u %a' -- "$_xrd")" = "$_uid "{{ shq(um.runtime_dir_mode) }} ] || lme_refuse {{ sl.budget_refusal }} "seed launch: the user manager runtime dir $_xrd is not a real directory owned by uid $_uid mode {{ um.runtime_dir_mode }} (no user manager)"
[ -S "$_xrd/"{{ shq(um.bus) }} ] && [ ! -L "$_xrd/"{{ shq(um.bus) }} ] || lme_refuse {{ sl.budget_refusal }} "seed launch: no user manager bus socket at $_xrd/{{ um.bus }}"
_bus="unix:path=$_xrd/"{{ shq(um.bus) }}
_user=$({{ x(bs, 'id') }} -un) || lme_refuse {{ sl.refusal }} 'seed launch: cannot read the account name'
case "$_user" in ''|*[!A-Za-z0-9._-]*) lme_refuse {{ sl.refusal }} "seed launch: unadmitted account name: $_user" ;; esac
{% if sl.derive.caller_values == 'refuse_if_different' %}
{% for n, v in [(un.runtime_dir_env, '$_xrd'), (un.bus_env, '$_bus'), (un.user_env, '$_user')] %}
[ -z "${{ '{' ~ n ~ '+x}' }}" ] || [ "${{ '{' ~ n ~ '}' }}" = "{{ v }}" ] || lme_refuse {{ sl.refusal }} "seed launch: caller {{ n }}=${{ '{' ~ n ~ '}' }} is not the derived {{ v }}"
{% endfor %}
{% else %}
lme_refuse {{ sl.refusal }} {{ shq('undeclared seed_launch.derive.caller_values mode: ' ~ sl.derive.caller_values) }}
{% endif %}
{%- endmacro -%}

{#- (3) the ONLY environment of `systemd-run --user` (probe and scope exec): env -i with exactly seed_launch.scope_env -#}
{%- macro launch_scope_env(bs) -%}
{%- set sl = bs.seed_launch -%}
{%- set un = bs.work_roots.run_local.user_manager_env -%}
{%- set ns = namespace(w=[]) -%}
{%- for e in sl.scope_env -%}
{%- if e == 'HOME' -%}{%- set ns.w = ns.w + ['HOME="$HOME"'] -%}
{%- elif e == 'base_env' -%}{%- for k, v in bs.base_env | dictsort -%}{%- set ns.w = ns.w + [k ~ '=' ~ shq(v)] -%}{%- endfor -%}
{%- elif e == 'runtime_dir_env' -%}{%- set ns.w = ns.w + [un.runtime_dir_env ~ '="$_xrd"'] -%}
{%- elif e == 'bus_env' -%}{%- set ns.w = ns.w + [un.bus_env ~ '="$_bus"'] -%}
{%- else -%}{{ sl['undeclared scope_env entry ' ~ e].render_error }}{%- endif -%}
{%- endfor -%}
{{ x(bs, 'env') }} -i {{ ns.w | join(' ') }}
{%- endmacro -%}

{%- macro managed_env(bs, home_dir, tmp_dir, extra=[]) -%}
{%- set ns = namespace(w=[]) -%}
{%- for l in (managed_pairs(bs, home_dir, tmp_dir) | string).split('\n') + extra -%}{%- set kv = l.split('=', 1) -%}{%- set ns.w = ns.w + [kv[0] ~ '="' ~ kv[1] ~ '"'] -%}{%- endfor -%}
{{ env_i(bs, bs.managed_env, ns.w) }}
{%- endmacro -%}

{#- ---- preconditions that need no root and no artifact ---- -#}
{%- macro combination_check(bs, ctl) -%}
{% if bs.python.major_minor not in bs.core_supported_python %}
lme_refuse RH-SEED-UNSUPPORTED-COMBINATION {{ shq('core ' ~ ctl.expect_core ~ ' does not support Python ' ~ bs.python.major_minor) }}
{% else %}
: # combination core {{ cmt(ctl.expect_core) }} on Python {{ cmt(bs.python.major_minor) }} is inside {{ cmt(bs.core_supported_python | join(',')) }}
{% endif %}
{%- endmacro -%}

{#- every declared tool present; every uv_installer tool is exactly what base_env.PATH resolves -#}
{%- macro os_tool_checks(bs) -%}
_missing=''
{% for n, t in bs.os_tools | dictsort %}
{% if 'seed' in t.required_by or 'uv_installer' in t.required_by %}
[ -x {{ shq(t.path) }} ] || _missing="$_missing {{ n }}={{ t.path }}({{ t.required_by | join('+') }})"
{% endif %}
{% endfor %}
[ -z "$_missing" ] || lme_refuse RH-SEED-OS-TOOL-MISSING "absent:$_missing"
_wrong=''
{% for n, t in bs.os_tools | dictsort %}
{% if 'uv_installer' in t.required_by %}
[ "$({{ x(bs, 'env') }} -i PATH={{ shq(bs.base_env.PATH) }} {{ x(bs, 'sh') }} -c 'command -v "$1"' _ {{ shq(n) }})" = {{ shq(t.path) }} ] || _wrong="$_wrong {{ n }}"
{% endif %}
{% endfor %}
[ -z "$_wrong" ] || lme_refuse RH-SEED-OS-TOOL-MISSING "base PATH resolves a different file than declared for:$_wrong"
{% set ti = bs.os_tool_identity %}
# SEED-06 os_tools_integrity: identity of every selected executable, independent of the tool verifying itself
_badid=''
{% for n, t in bs.os_tools | dictsort %}
{% if 'seed' in t.required_by or 'uv_installer' in t.required_by %}
_st=$({{ x(bs, 'stat') }} -L -c '%u %a %F' -- {{ shq(t.path) }} 2>/dev/null) || _st='unreadable'
case "$_st" in {{ ti.owner_uid | int }}' '*' regular file') : ;; *) _badid="$_badid {{ n }}($_st)" ;; esac
_m=${_st#* }; _m=${_m%% *}; _m=${_m#"${_m%??}"}
case "$_m" in [2367]?|?[2367]) _badid="$_badid {{ n }}(group/other-writable)" ;; esac
{% endif %}
{% endfor %}
[ -z "$_badid" ] || {{ 'lme_refuse ' ~ ti.refusal }} "executables must be regular files owned by uid {{ ti.owner_uid }} and not group/other-writable:$_badid"
{% for k in ti.known_answers %}
[ "$(printf '%s' {{ shq(k.stdin) }} | {{ x(bs, k.tool) }})" = "$(printf '%s' {{ shq(k.stdout) }})" ] || {{ 'lme_refuse ' ~ ti.refusal }} {{ shq(k.tool ~ ' at ' ~ bs.os_tools[k.tool].path ~ ' fails its known-answer identity check') }}
{% endfor %}
{%- endmacro -%}

{%- macro platform_check(bs) -%}
[ "$({{ x(bs, 'uname') }} -s)" = {{ shq(bs.platform.os) }} ] || lme_refuse RH-SEED-UNSUPPORTED-PLATFORM "os $({{ x(bs, 'uname') }} -s) != {{ bs.platform.os }}"
[ "$({{ x(bs, 'uname') }} -m)" = {{ shq(bs.platform.arch) }} ] || lme_refuse RH-SEED-UNSUPPORTED-PLATFORM "arch $({{ x(bs, 'uname') }} -m) != {{ bs.platform.arch }}"
_ldd=$({{ x(bs, 'ldd') }} --version 2>&1 | {{ x(bs, 'sed') }} -n '1p')
case "$_ldd" in
  *GLIBC*|*'GNU libc'*) : ;;
  *) lme_refuse RH-SEED-UNSUPPORTED-PLATFORM "libc is not {{ bs.platform.libc }}: $_ldd" ;;
esac
_glibc=${_ldd##* }
_gmaj=${_glibc%%.*}; _gmin=${_glibc#*.}; _gmin=${_gmin%%[!0-9]*}
case "$_gmaj$_gmin" in ''|*[!0-9]*) lme_refuse RH-SEED-UNSUPPORTED-PLATFORM "unparsed glibc version: $_ldd" ;; esac
if [ "$_gmaj" -lt {{ bs.platform.glibc_min.major | int }} ] || { [ "$_gmaj" -eq {{ bs.platform.glibc_min.major | int }} ] && [ "$_gmin" -lt {{ bs.platform.glibc_min.minor | int }} ]; }; then
  lme_refuse RH-SEED-UNSUPPORTED-PLATFORM "glibc $_glibc < {{ bs.platform.glibc_min.major }}.{{ bs.platform.glibc_min.minor }}"
fi
{{ x(bs, 'curl') }} --version 2>/dev/null | {{ x(bs, 'grep') }} -E -q '^Protocols:.* file( |$)' || lme_refuse RH-SEED-OS-TOOL-MISSING 'curl lacks the file protocol (uv installer artifact base)'
{%- endmacro -%}

{#- ---- path admission: the ONE declared rule (bs.path_admission), shared with verify_toolchain_receipt.yml ---- -#}
{%- macro path_arg_check(bs, var, label) -%}
case "${{ var }}" in
  /*) : ;;
  *) lme_refuse RH-SEED-USAGE "{{ label }} must be an absolute path: ${{ var }}" ;;
esac
case "${{ var }}" in
  *[!{{ bs.path_admission.charset }}]*{% for f in bs.path_admission.forbidden %}|{{ f }}{% endfor %}) lme_refuse RH-SEED-USAGE "{{ label }} must be a normalized path of [{{ bs.path_admission.charset }}]: ${{ var }}" ;;
esac
{%- endmacro -%}

{#- ---- OWNER-PRIVATE-GROUP decision (path_admission.ancestry.owner_private_group; codex 143342): ONE generated awk
     program, a pure function of a tagged facts stream (facts_schema private-group-facts/1: `<tag>TAB<value>` lines,
     tags owner path dir rc nsl pwl grl acl). The seed pipes the facts it gathers into it; playbook consumers render
     the same program (templates/private_group_program.j2) and run it on the controller (tasks/decide_private_group.yml);
     the synthetic fixtures (tests/private_group_fixtures.yml) run it unchanged. Prints `ADMIT <dir>` (exit 0) or
     `REFUSE <dir>: <reasons>` (exit 1). No single quote inside (it travels through shq). ---- -#}
{%- macro private_group_program(bs) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
function no(m) { ok = 0; why = why " " m }
BEGIN { ok = 1; why = ""; np = 0; ng = 0; na = 0; nallow = 0; ndb = 0; ou = ""; dp = ""; du = ""; dg = ""; dm = ""
{% for s in pg.identity_provider.allowed_sources %}
  allow[{{ loop.index }}] = "{{ s | join(' ') }}"; nallow = {{ loop.index }}
{% endfor %}
{% for d in pg.identity_provider.databases %}
  dbs[{{ loop.index }}] = "{{ d }}"; ndb = {{ loop.index }}
{% endfor %}
  nstep = split("dir nss passwd group acl", steps, " ") }
{ t = index($0, "\t"); if (t == 0) { no("malformed-fact"); next }; tag = substr($0, 1, t - 1); v = substr($0, t + 1) }
tag == "owner" { if (ou != "") no("owner-fact-repeated"); ou = v; next }
tag == "path" { if (dp != "") no("path-fact-repeated"); dp = v; next }
tag == "dir" { n = split(v, d, " "); if (n != 3) no("dir-fact-malformed"); du = d[1]; dg = d[2]; dm = d[3]; next }
tag == "rc" { n = split(v, r, "\t"); if (n != 2) { no("rc-fact-malformed"); next }; rc[r[1]] = r[2]; next }
tag == "nsl" { s = v; sub(/#.*/, "", s); c = index(s, ":"); if (c == 0) next; db = substr(s, 1, c - 1); gsub(/[ \t]/, "", db)
  src = substr(s, c + 1); gsub(/[ \t]+/, " ", src); sub(/^ /, "", src); sub(/ $/, "", src)
  if (db in nss) nssdup[db] = 1; nss[db] = src; next }
tag == "pwl" { n = split(v, f, ":"); if (n != 7) { no("passwd-record-malformed"); next }; np++; pwn[np] = f[1]; pwu[np] = f[3]; pwg[np] = f[4]; next }
tag == "grl" { n = split(v, f, ":"); if (n != 4) { no("group-record-malformed"); next }; ng++; grn[ng] = f[1]; grg[ng] = f[3]; grm[ng] = f[4]; next }
tag == "acl" { na++; ae[na] = v; next }
{ no("unknown-fact-" tag) }
END {
  for (i = 1; i <= nstep; i++) { s = steps[i]; if (!(s in rc)) no("step-" s "-unreported"); else if (rc[s] != "0") no("step-" s "-failed-rc-" rc[s]) }
  if (ou == "" || dp == "" || du == "" || dg == "" || dm == "") no("facts-incomplete")
  for (i = 1; i <= ndb; i++) { db = dbs[i]
    if (!(db in nss)) no("nsswitch-" db "-absent")
    else if (db in nssdup) no("nsswitch-" db "-repeated")
    else { hit = 0; for (a = 1; a <= nallow; a++) if (nss[db] == allow[a]) hit = 1
      if (!hit) { x = nss[db]; gsub(/ /, "+", x); no("nsswitch-" db "-sources-unsupported:" x) } } }
  if (np == 0) no("passwd-enumeration-empty")
  if (ng == 0) no("group-enumeration-empty")
  if (du != ou) no("dir-owner-" du "-is-not-owner-" ou)
  if (substr(dm, length(dm), 1) ~ /[2367]/) no("other-writable")
  oc = 0; og = ""
  for (i = 1; i <= np; i++) if (pwu[i] == ou) { oc++; og = pwg[i]; oname[pwn[i]] = 1 }
  if (oc != 1) no("owner-uid-" ou "-passwd-records-" oc)
  if (oc == 1 && dg != og) no("dir-gid-" dg "-is-not-owner-primary-gid-" og)
  for (i = 1; i <= np; i++) {
    if (pwg[i] == dg && pwu[i] != ou) no("account-" pwn[i] "-shares-primary-gid-" dg)
    if ((pwn[i] in oname) && pwu[i] != ou) no("account-name-" pwn[i] "-ambiguous") }
  gc = 0; mem = ""
  for (j = 1; j <= ng; j++) if (grg[j] == dg) { gc++; mem = grm[j] }
  if (gc != 1) no("group-gid-" dg "-records-" gc)
  if (gc == 1 && mem != "") { k = split(mem, mm, ","); for (i = 1; i <= k; i++) if (!(mm[i] in oname)) no("supplementary-member-" mm[i]) }
  for (i = 1; i <= na; i++) { e = ae[i]; sub(/#.*/, "", e); gsub(/[ \t]/, "", e); if (e == "") continue
    sub(/^default:/, "", e); n = split(e, p, ":"); if (n != 3) { no("acl-entry-malformed"); continue }
    if (index(p[3], "w") == 0) continue
    if (p[1] == "user") { if (p[2] != "" && p[2] != ou) no("acl-user-" p[2] "-writes") }
    else if (p[1] == "group") { if (p[2] != "" && p[2] != dg) no("acl-group-" p[2] "-writes") }
    else if (p[1] == "other") no("acl-other-writes")
    else if (p[1] != "mask") no("acl-entry-" p[1] "-unknown") }
  if (ok) { print "ADMIT " dp; exit 0 }
  print "REFUSE " dp ":" why; exit 1 }
{%- endmacro -%}

{#- the fact gathering for ONE group-writable directory ${dvar} (declared tools only; needs $_uid): prints the
    private-group-facts/1 stream on stdout. The seed pipes it into the program; target_bootstrap.yml runs the same
    text over its initial-contact raw channel and decides on the controller (tasks/decide_private_group.yml). -#}
{%- macro private_group_facts(bs, dvar) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_pgd=$({{ x(bs, 'stat') }} -c '%u %g %a' -- "${{ dvar }}"); _pgd_rc=$?
_pgn=$({{ x(bs, 'cat') }} -- {{ shq(pg.identity_provider.nsswitch_file) }}); _pgn_rc=$?
_pgp=$({{ x(bs, pg.identity_provider.enumeration_tool) }} passwd); _pgp_rc=$?
_pgg=$({{ x(bs, pg.identity_provider.enumeration_tool) }} group); _pgg_rc=$?
_pga=$({{ x(bs, pg.acl_tool) }} -c -n -p -P -- "${{ dvar }}"); _pga_rc=$?
{
  printf 'owner\t%s\npath\t%s\ndir\t%s\n' "$_uid" "${{ dvar }}" "$_pgd"
  printf 'rc\tdir\t%s\nrc\tnss\t%s\nrc\tpasswd\t%s\nrc\tgroup\t%s\nrc\tacl\t%s\n' "$_pgd_rc" "$_pgn_rc" "$_pgp_rc" "$_pgg_rc" "$_pga_rc"
  printf '%s\n' "$_pgn" | {{ x(bs, 'sed') }} 's/^/nsl\t/'
  printf '%s\n' "$_pgp" | {{ x(bs, 'sed') }} 's/^/pwl\t/'
  printf '%s\n' "$_pgg" | {{ x(bs, 'sed') }} 's/^/grl\t/'
  printf '%s\n' "$_pga" | {{ x(bs, 'sed') }} 's/^/acl\t/'
}
{%- endmacro -%}

{%- macro private_group_admit(bs, dvar) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_pgv=$(
{{ private_group_facts(bs, dvar) }} | {{ x(bs, pg.decision_tool) }} {{ shq(private_group_program(bs)) }}
) || lme_refuse {{ pg.refusal }} "group-writable directory ${{ dvar }} is not an admitted owner-private group: $_pgv"
{%- endmacro -%}

{#- ---- ancestry (path_admission.ancestry, the ONE rule): every existing ancestor a real dir owned by 0 or the owner;
     other-writable (sticky included) refuses; group-writable refuses unless owner_private_group admits it ---- -#}
{%- macro ancestry_check(bs, var) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_a=${{ var }}
while [ "$_a" != / ]; do
  _a=${_a%/*}; [ -n "$_a" ] || _a=/
  [ -e "$_a" ] || [ -L "$_a" ] || continue
  [ ! -L "$_a" ] && [ -d "$_a" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor is not a real directory: $_a"
  _st=$({{ x(bs, 'stat') }} -c '%u %a' -- "$_a") || lme_refuse RH-SEED-ROOT-NOT-OWNED "cannot stat ancestor $_a"
  _o=${_st%% *}; _m=${_st#* }
  [ "$_o" = 0 ] || [ "$_o" = "$_uid" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a owned by uid $_o (allowed: 0, $_uid)"
  _go=${_m#"${_m%??}"}
  case "$_go" in
    ?[2367]) lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a is other-writable (mode $_m; sticky directories are not excepted)" ;;
    [2367]?)
{% if pg.enabled %}
      [ "$_o" = "$_uid" ] || lme_refuse {{ pg.refusal }} "ancestor $_a is group-writable and owned by uid $_o, not the owner $_uid (mode $_m)"
      {{ private_group_admit(bs, '_a') | indent(6) }}
{% else %}
      lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a is group-writable (mode $_m)"
{% endif %}
      ;;
  esac
done
{%- endmacro -%}

{#- the rule as ONE shell function (lme_ancestry <path>), called at admission and re-called at every use boundary -#}
