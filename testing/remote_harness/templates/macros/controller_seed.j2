lme_phase python-install
[ ! -e "$G/{{ py.install_dir }}" ] || lme_refuse RH-SEED-INSTALL-FAILED 'interpreter install dir already exists in a fresh generation'
{{ env_i(bs, {'UV_NO_CONFIG': '1', 'UV_PYTHON_PREFERENCE': 'only-managed', 'UV_PYTHON_DOWNLOADS': 'manual', 'UV_NO_PROGRESS': '1'}, ['TMPDIR="' ~ tmp ~ '"', 'UV_CACHE_DIR="' ~ tmp ~ '/uv-cache"', 'UV_PYTHON_CACHE_DIR="' ~ tmp ~ '/uv-python-cache"', 'UV_PYTHON_INSTALL_DIR="$G/' ~ py.install_dir ~ '"', 'UV_PYTHON_BIN_DIR="' ~ tmp ~ '/uv-python-bin"', 'UV_TOOL_DIR="' ~ tmp ~ '/uv-tool"', 'XDG_DATA_HOME="' ~ tmp ~ '/xdg-data"', 'XDG_CACHE_HOME="' ~ tmp ~ '/xdg-cache"', 'XDG_CONFIG_HOME="' ~ tmp ~ '/xdg-config"']) }} "$G/{{ bs.layout.gen_dirs.uv }}/uv" python install \
  --no-config --no-bin --install-dir "$G/{{ py.install_dir }}" --python-downloads-json-url "{{ tmp }}/python-downloads.json" \
  {{ shq(py.download_key) }} || lme_refuse RH-SEED-INSTALL-FAILED 'uv python install from the admitted local downloads JSON failed (no other build, no network fallback)'
lme_phase python-verify
# 1. the install dir holds exactly the declared key dir plus declared bookkeeping names
for _e in "$G/{{ py.install_dir }}"/* "$G/{{ py.install_dir }}"/.[!.]* "$G/{{ py.install_dir }}"/..?*; do
  [ -e "$_e" ] || [ -L "$_e" ] || continue
  case "${_e##*/}" in
    {{ py.download_key }}{% for n in py.install_dir_bookkeeping %}|{{ shq(n) }}{% endfor %}) : ;;
    {{ shq(py.minor_link) }}) [ -L "$_e" ] && [ "$({{ x(bs, 'realpath') }} -e -- "$_e")" = "$G/{{ py.installed_rel }}" ] || lme_refuse RH-SEED-IDENTITY-MISMATCH "minor-version entry is not a link to the installed key: ${_e##*/}" ;;
    *) lme_refuse RH-SEED-IDENTITY-MISMATCH "undeclared entry in the interpreter install dir: ${_e##*/}" ;;
  esac
done
[ -d "$G/{{ py.installed_rel }}" ] && [ ! -L "$G/{{ py.installed_rel }}" ] || lme_refuse RH-SEED-IDENTITY-MISMATCH 'uv did not install the declared key {{ py.download_key }}'
# 2. independent unpack of the admitted archive; the ELF must be byte-equal, the trees may differ ONLY in declared uv-patched files
{{ x(bs, 'tar') }} -xzf "$A/"{{ shq(pa.file) }} -C "$G/{{ bs.layout.gen_dirs.verify }}/pbs" --no-same-owner || lme_refuse RH-SEED-INSTALL-FAILED 'independent PBS unpack failed'
{{ x(bs, 'cmp') }} -s -- "$G/{{ bs.layout.gen_dirs.verify }}/pbs/{{ py.archive_interpreter_rel }}" "$G/{{ py.interpreter_rel }}" || lme_refuse RH-SEED-IDENTITY-MISMATCH 'installed interpreter ELF differs from the admitted archive member'
_dv=$({{ x(bs, 'diff') }} -r --no-dereference -q -- "$G/{{ bs.layout.gen_dirs.verify }}/pbs/{{ py.archive_top }}" "$G/{{ py.installed_rel }}" 2>&1)
_dx=$(printf '%s\n' "$_dv" | {{ x(bs, 'grep') }} -v -x -F -e '' \
{% for f in py.uv_patched_rel %}
  -e "Files $G/{{ bs.layout.gen_dirs.verify }}/pbs/{{ py.archive_top }}/{{ f }} and $G/{{ py.installed_rel }}/{{ f }} differ" \
{% endfor %}
  || :)
[ -z "$_dx" ] || lme_refuse RH-SEED-IDENTITY-MISMATCH "installed interpreter tree differs from the admitted archive beyond the declared uv-patched files: $_dx"
# 3. runtime identity
_v=$({{ env_i(bs) }} "$G/{{ py.interpreter_rel }}" -I -B -c 'import sys, platform; print(platform.python_implementation(), platform.python_version(), sys.base_prefix)' 2>&1) || lme_refuse RH-SEED-IDENTITY-MISMATCH "python identity probe failed: $_v"
[ "$_v" = "CPython {{ py.version }} $G/{{ py.installed_rel }}" ] || lme_refuse RH-SEED-IDENTITY-MISMATCH "interpreter reports '$_v'"
{%- endmacro -%}

{%- macro install_venv(bs, lock) -%}
lme_phase venv
{{ env_i(bs) }} "$G/{{ bs.python.interpreter_rel }}" -I -B -m venv --without-pip "$G/{{ bs.layout.gen_dirs.venv }}" || lme_refuse RH-SEED-INSTALL-FAILED 'venv creation failed'
{{ x(bs, 'grep') }} -q -x -F "home = $G/{{ bs.python.interpreter_dir_rel }}" -- "$G/{{ bs.layout.gen_dirs.venv }}/pyvenv.cfg" || lme_refuse RH-SEED-IDENTITY-MISMATCH 'venv home is not the pinned interpreter'
lme_phase wheels
{{ env_i(bs, {'UV_NO_CONFIG': '1', 'UV_OFFLINE': '1', 'UV_PYTHON_DOWNLOADS': 'never', 'PYTHONDONTWRITEBYTECODE': '1'}, ['TMPDIR="$G/' ~ bs.layout.gen_dirs.tmp ~ '"', 'UV_CACHE_DIR="$G/' ~ bs.layout.gen_dirs.tmp ~ '/uv-cache"']) }} "$G/{{ bs.layout.gen_dirs.uv }}/uv" pip install --python "$G/{{ bs.layout.gen_dirs.venv }}/bin/python" --offline --no-index --no-deps --no-build --no-cache --link-mode copy --strict \
{% for p in lock.packages %}
  "$A/"{{ shq(p.file) }} \
{% endfor %}
  || lme_refuse RH-SEED-INSTALL-FAILED 'wheel install failed'
_inv=$({{ env_i(bs, {'UV_NO_CONFIG': '1', 'UV_OFFLINE': '1', 'UV_PYTHON_DOWNLOADS': 'never'}, ['TMPDIR="$G/' ~ bs.layout.gen_dirs.tmp ~ '"']) }} "$G/{{ bs.layout.gen_dirs.uv }}/uv" pip list --python "$G/{{ bs.layout.gen_dirs.venv }}/bin/python" --format freeze --no-cache) || lme_refuse RH-SEED-IDENTITY-MISMATCH 'uv pip list failed'
printf '%s\n' "$_inv" > "$G/{{ bs.layout.receipts_dir }}/installed-inventory.txt"
_norm=$(printf '%s\n' "$_inv" | {{ x(bs, 'sed') }} 'y/ABCDEFGHIJKLMNOPQRSTUVWXYZ_./abcdefghijklmnopqrstuvwxyz--/' | {{ joinsorted(bs) }})
{% set ns = namespace(pins=[]) %}
{% for p in lock.packages %}
{% set ns.pins = ns.pins + [(p.name | lower | replace('_', '-') | replace('.', '-')) ~ '==' ~ p.version] %}
{% endfor %}
[ "$_norm" = {{ shq(ns.pins | sort(case_sensitive=true) | join(' ')) }} ] \
  || lme_refuse RH-SEED-IDENTITY-MISMATCH "installed set != lock: $_norm"
{%- endmacro -%}

{%- macro install_collections(bs, lock) -%}
lme_phase ansible-config
printf '%s' {{ shq(bs.ansible_config_content) }} > "$G/{{ bs.layout.config_file }}" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot write the generation ansible.cfg'
lme_phase collections
{{ managed_env(bs, '$G/' ~ bs.layout.gen_dirs.tmp ~ '/ansible-home', '$G/' ~ bs.layout.gen_dirs.tmp) }} "$G/{{ bs.layout.gen_dirs.venv }}/bin/ansible-galaxy" collection install --offline --no-deps -p "$G/{{ bs.layout.gen_dirs.collections }}" \
{% for c in lock.collections %}
  "$A/"{{ shq(c.file) }} \
{% endfor %}
  || lme_refuse RH-SEED-INSTALL-FAILED 'collection install failed'
[ "$({{ x(bs, 'find') }} "$G/{{ bs.layout.gen_dirs.collections }}/ansible_collections" -mindepth 2 -maxdepth 2 -type d -printf '%P\n' | {{ joinsorted(bs) }})" = {{ shq(lock.collections | map(attribute='name') | map('replace', '.', '/') | sort(case_sensitive=true) | join(' ')) }} ] \
  || lme_refuse RH-SEED-IDENTITY-MISMATCH 'installed collections != lock'
{% for c in lock.collections %}
{{ x(bs, 'grep') }} -E -q {{ shq('"version": *"' ~ (c.version | replace('.', '\\.')) ~ '"') }} -- "$G/{{ bs.layout.gen_dirs.collections }}/ansible_collections/"{{ shq(c.name | replace('.', '/')) }}/MANIFEST.json || lme_refuse RH-SEED-IDENTITY-MISMATCH {{ shq(c.name ~ ' is not ' ~ c.version) }}
{% endfor %}
{%- endmacro -%}

{#- ---- smoke (install and verify): core, interpreter, executable path AND the sealed config file ---- -#}
{%- macro smoke(bs, ctl, home_dir, tmp_dir, out) -%}
_s=$({{ managed_env(bs, home_dir, tmp_dir) }} "$G/{{ bs.layout.gen_dirs.venv }}/bin/ansible-playbook" --version 2>&1) || lme_refuse RH-SEED-IDENTITY-MISMATCH "ansible-playbook --version failed: $_s"
printf '%s\n' "$_s" > "{{ out }}"
[ "$(printf '%s\n' "$_s" | {{ x(bs, 'sed') }} -n '1p')" = {{ shq('ansible-playbook [core ' ~ ctl.expect_core ~ ']') }} ] || lme_refuse RH-SEED-IDENTITY-MISMATCH 'ansible-playbook is not the declared core'
printf '%s\n' "$_s" | {{ x(bs, 'grep') }} -q -F {{ shq('python version = ' ~ bs.python.version ~ ' ') }} || lme_refuse RH-SEED-IDENTITY-MISMATCH 'ansible-playbook does not run on the pinned interpreter'
printf '%s\n' "$_s" | {{ x(bs, 'grep') }} -q -x -F "  executable location = $G/{{ bs.layout.gen_dirs.venv }}/bin/ansible-playbook" || lme_refuse RH-SEED-IDENTITY-MISMATCH 'ansible-playbook executable location is not the generation venv'
printf '%s\n' "$_s" | {{ x(bs, 'grep') }} -q -x -F "  config file = $G/{{ bs.layout.config_file }}" || lme_refuse RH-SEED-IDENTITY-MISMATCH 'ansible-playbook did not start on the sealed generation ansible.cfg'
{%- endmacro -%}

{%- macro tree_list(bs) -%}
(cd "$G" && {{ x(bs, 'find') }} -P {{ bs.layout.sealed | join(' ') }} -printf '%y %m %s %p -> %l\n' | LC_ALL=C {{ x(bs, 'sort') }})
{%- endmacro -%}

{#- tree.sha256 members confined to the sealed names before any checksum read (SEED-04) -#}
{%- macro tree_confine(bs) -%}
{{ x(bs, 'grep') }} -v -E {{ shq('^[0-9a-f]{64}  (' ~ (bs.layout.sealed | map('replace', '.', '\\.') | join('|')) ~ ')(/[^/]+)*$') }} -- "$G/{{ bs.layout.receipts_dir }}/tree.sha256" >/dev/null \
  && lme_refuse RH-SEED-GENERATION-DRIFT 'receipts/tree.sha256 names a member outside the sealed trees'
{{ x(bs, 'grep') }} -E {{ shq('  (.*/)?\\.\\.?(/|$)') }} -- "$G/{{ bs.layout.receipts_dir }}/tree.sha256" >/dev/null \
  && lme_refuse RH-SEED-GENERATION-DRIFT 'receipts/tree.sha256 names a . or .. segment'
:
{%- endmacro -%}

{#- ---- verification: content (no pointer) and publication (pointer + receipt, unconditional) ---- -#}
{%- macro verify_fns(bs, ctl) -%}
lme_verify_content() {
  [ -f "$G/{{ bs.layout.complete_marker }}" ] && [ ! -L "$G/{{ bs.layout.complete_marker }}" ] || lme_refuse RH-SEED-GENERATION-DRIFT "no complete generation $GEN_ID under $R"
  [ "$({{ x(bs, 'cat') }} -- "$G/{{ bs.layout.complete_marker }}")" = "$GEN_ID" ] || lme_refuse RH-SEED-GENERATION-DRIFT "completion marker does not name $GEN_ID"
  {{ tree_confine(bs) | indent(2) }}
  (cd "$G" && {{ x(bs, 'sha256sum') }} --check --strict --quiet -- {{ bs.layout.receipts_dir }}/tree.sha256) >/dev/null 2>&1 || lme_refuse RH-SEED-GENERATION-DRIFT 'installed content differs from receipts/tree.sha256'
  [ ! -L "$R/{{ bs.layout.check_dir }}" ] && [ -d "$R/{{ bs.layout.check_dir }}" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "$R/{{ bs.layout.check_dir }} is not a real directory"
  {{ prune_dir(bs, '"$R/' ~ bs.layout.check_dir ~ '"', bs.layout.check_dir, bs.layout.check_retention.keep) | indent(2) }}
  _chk=$({{ x(bs, 'mktemp') }} -d "$R/{{ bs.layout.check_dir }}/$UTC.XXXXXXXX") || lme_refuse RH-SEED-STORAGE "cannot create a check directory under $R"
  {{ x(bs, 'mkdir') }} -- "$_chk/tmp" "$_chk/ansible-home" || lme_refuse RH-SEED-STORAGE "cannot create $_chk"
  {{ tree_list(bs) }} > "$_chk/tree.list" || lme_refuse RH-SEED-GENERATION-DRIFT 'tree listing failed'
  {{ x(bs, 'cmp') }} -s -- "$G/{{ bs.layout.receipts_dir }}/tree.list" "$_chk/tree.list" || lme_refuse RH-SEED-GENERATION-DRIFT 'installed paths, modes or links differ from receipts/tree.list'
  {{ smoke(bs, ctl, '$_chk/ansible-home', '$_chk/tmp', '$_chk/ansible-playbook-version.txt') | indent(2) }}
}
lme_verify_published() {
  [ -f "$R/{{ bs.layout.active_file }}" ] && [ ! -L "$R/{{ bs.layout.active_file }}" ] || lme_refuse RH-SEED-GENERATION-DRIFT "no active pointer $R/{{ bs.layout.active_file }}"
  [ "$({{ x(bs, 'cat') }} -- "$R/{{ bs.layout.active_file }}")" = "$GEN_ID" ] || lme_refuse RH-SEED-GENERATION-DRIFT "active pointer does not name $GEN_ID"
