{% for mode, words in sl.mode_args | dictsort %}
{% set ps = (launch_params(words) | string).split() %}
#   <bundle>/{{ cmt(b.launcher_file) }} {{ cmt(mode) }} <root>{% for p in ps %} <{{ cmt(p) }}>{% endfor %}{{ ' [<args> ...]' if '{args}' in words else '' }}
{% endfor %}
set -u
{{ refusal_fn(bs.refusals) }}
{# route op1q (C1 SR922g; s64 seed_launch.texts launcher_* :3680-3684, text_refusal :3686-3691, launcher_forms :3692; route op2c retarget):
