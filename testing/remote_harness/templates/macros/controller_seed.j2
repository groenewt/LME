{%- elif kv[0] in shell -%}"{{ shell[kv[0]] }}"
{%- else -%}{{ node.texts['diag_text ' ~ key ~ ': no source for placeholder ' ~ kv[0]].render_error }}
{%- endif -%}
{{ shq(kv[1]) }}
{%- endfor -%}
