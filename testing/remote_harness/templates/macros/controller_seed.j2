  _rs="$_parent/.$_rb.{{ bs.layout.creating_infix }}.$OP_ID"
  {{ x(bs, 'mkdir') }} -m 0700 -- "$_rs" || lme_refuse RH-SEED-ROOT-NOT-OWNED "cannot create $_rs"
  printf '%s\n' "$_marker" > "$_rs/{{ bs.layout.root_marker }}" || lme_refuse RH-SEED-ROOT-NOT-OWNED "cannot write the root marker"
  {{ x(bs, 'mv') }} -T -- "$_rs" "$R" || { {{ x(bs, 'rm') }} -rf --one-file-system -- "$_rs"; lme_refuse RH-SEED-ROOT-NOT-OWNED "$R appeared concurrently; not adopted"; }
  [ "$({{ x(bs, 'cat') }} -- "$R/{{ bs.layout.root_marker }}")" = "$_marker" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root marker mismatch after creation: $R"
elif [ "$MODE" = apply ]; then
  lme_bundle_check
fi
exec 9<"$R" || lme_refuse RH-SEED-ROOT-NOT-OWNED "cannot open $R for locking"
{{ x(bs, 'flock') }} -n 9 || lme_refuse RH-SEED-BUSY "another seed operation holds the lock on $R"
# the creator keeps the parent lock until it holds the root lock, so a serialized second apply meets BUSY, never a
# half-initialised root
[ -z "${_pl:-}" ] || exec 8<&-
# use boundary: the ancestry rule again, now that the root lock is held and before the first write under R
lme_ancestry "$R/."

if [ "$MODE" = purge ]; then
  {{ purge_inventory(bs) | indent(2) }}
  {{ x(bs, 'chmod') }} -R u+w -- "$R" || lme_refuse RH-SEED-INSTALL-FAILED "cannot make $R writable"
  {{ x(bs, 'rm') }} -rf --one-file-system -- "$R" || lme_refuse RH-SEED-INSTALL-FAILED "purge of $R failed"
  [ ! -e "$R" ] || lme_refuse RH-SEED-INSTALL-FAILED "$R still exists after purge"
  printf 'PURGED %s\n' "$R"
  exit 0
fi

if [ "$MODE" = verify ] || [ "$MODE" = run ] || [ "$MODE" = {{ rlm }} ]; then
  lme_verify_content
  lme_verify_published
  if [ "$MODE" = verify ]; then
    printf '%s verify %s ok\n' "$UTC" "$GEN_ID" >> "$R/{{ bs.layout.check_dir }}/verify.log"
    printf 'VERIFIED %s %s\n' "$GEN_ID" "$G"
    exit 0
  fi
  _rd="$R/{{ bs.layout.run_dir }}"
  [ ! -L "$_rd" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "$_rd is a link"
  [ -d "$_rd" ] || {{ x(bs, 'mkdir') }} -m 0700 -- "$_rd" || lme_refuse RH-SEED-STORAGE "cannot create $_rd"
  {{ prune_dir(bs, '"$_rd"', bs.layout.run_dir, bs.run_retention.keep) | indent(2) }}
  {{ storage_check(bs, 'R', bs.run_retention.free_required_bytes) | indent(2) }}
  # WORK ROOT (work_roots): W, anchored and admitted by admit_storage BEFORE any effect (WORKSPACE ANCHOR: through
  # the last /{{ bs.work_roots.root_rel }}/ of R, bound to the packaged checkout); its capacity is re-read here, after
  # the retention prune, immediately before the sub-roots are prepared
  [ -n "$W" ] || lme_refuse {{ bs.work_roots.admission.refusal }} "no admitted work root for $R"
  {{ work_root_check(bs, 'W') | indent(2) }}
  {{ work_root_prepare(bs, 'W') | indent(2) }}
  _run=$({{ x(bs, 'mktemp') }} -d "$_rd/$UTC.XXXXXXXX") || lme_refuse RH-SEED-STORAGE "cannot create a run directory under $_rd"
  {{ x(bs, 'mkdir') }} -- "$_run/ansible-home" "$_run/tmp" || lme_refuse RH-SEED-STORAGE "cannot create $_run"
  if [ "$MODE" = {{ rlm }} ]; then
    {{ run_local_exec(bs) | indent(4) }}
  fi
  # the lock (fd 9) stays held BY THIS PROCESS for the whole playbook run (no concurrent apply/purge can swap the
  # generation); the playbook gets fd 9 CLOSED, so ssh ControlPersist masters it spawns never retain the lock
  # Q-D12 (codex-001716): the playbook inherits THIS run's budget scope (LME_SEED_SCOPED=1); a seed it invokes
  # re-verifies the declared limits from its own cgroup (budget enforcement kept) and then meets the root lock held
  # by this process: a nested same-root call refuses BUSY (15) at once, never waits, never runs unbudgeted.
  lme_ancestry "$_run/."
  {{ managed_env(bs, '$_run/ansible-home', '$_run/tmp') }} {{ work_env(bs, 'W') }} LME_SEED_SCOPED=1 {{ ssh_auth.env_mode }}="$SSH_AUTH" ANSIBLE_SSH_COMMON_ARGS="$_ssh_args" ${LME_CARRY_SOCK:+{{ ssh_auth.modes.agent.socket_env }}="$LME_CARRY_SOCK"} "$G/{{ bs.layout.gen_dirs.venv }}/bin/ansible-playbook" "$@" 9<&-
  exit $?
fi

# ---- apply ----
for _d in "$R/{{ bs.layout.generations_dir }}" "$R/{{ bs.layout.abandoned_dir }}" "$R/{{ bs.layout.check_dir }}"; do
  [ -L "$_d" ] && lme_refuse RH-SEED-ROOT-NOT-OWNED "$_d is a link"
  [ -d "$_d" ] || {{ x(bs, 'mkdir') }} -m 0700 -- "$_d" || lme_refuse RH-SEED-STORAGE "cannot create $_d"
done

# SEED2-EARLY-INTERRUPTION recovery: a generation staging dir whose op recorded `start` is ours (removed); others preserved
for _e in "$R/{{ bs.layout.generations_dir }}/.{{ bs.layout.creating_infix }}."*; do
  [ -e "$_e" ] || [ -L "$_e" ] || continue
  _op=${_e##*/.{{ bs.layout.creating_infix }}.}
  case "$_op" in ''|*[!0-9TZ-]*) printf 'PRESERVED-UNKNOWN %s\n' "$_e" >&2; continue ;; esac
  if [ ! -L "$_e" ] && [ -d "$_e" ] && [ "$({{ x(bs, 'stat') }} -c %u -- "$_e")" = "$_uid" ] \
     && {{ x(bs, 'awk') }} -v o="$_op" '$1 == "start" && $2 == o { m = 1 } END { exit !m }' "$R/{{ bs.layout.operations_log }}" 2>/dev/null; then
    {{ x(bs, 'chmod') }} -R u+w -- "$_e" && {{ x(bs, 'rm') }} -rf --one-file-system -- "$_e" || lme_refuse RH-SEED-INSTALL-FAILED "cannot remove stale generation staging $_e"
    lme_log removed-staging "$_op"
  else
    printf 'PRESERVED-UNKNOWN %s\n' "$_e" >&2
  fi
done

if [ -f "$G/{{ bs.layout.complete_marker }}" ]; then
  lme_verify_content
  lme_publish_active
  lme_verify_published
  lme_log unchanged "$GEN_ID"
  printf 'UNCHANGED %s %s\n' "$GEN_ID" "$G"
  exit 0
fi

if [ -e "$G" ] || [ -L "$G" ]; then
  # interrupted install: replaced ONLY when this seed recorded the operation that created it
  [ ! -L "$G" ] && [ -d "$G" ] && [ "$({{ x(bs, 'stat') }} -c %u -- "$G")" = "$_uid" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "incomplete generation is not an owned directory: $G"
  [ -f "$G/{{ bs.layout.operation_file }}" ] && [ ! -L "$G/{{ bs.layout.operation_file }}" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "incomplete generation without {{ bs.layout.operation_file }} is preserved, not removed: $G"
  _prev=$({{ x(bs, 'cat') }} -- "$G/{{ bs.layout.operation_file }}")
  case "$_prev" in ''|*[!0-9TZ-]*) lme_refuse RH-SEED-ROOT-NOT-OWNED "unrecognised operation id in $G/{{ bs.layout.operation_file }}" ;; esac
  {{ x(bs, 'grep') }} -q -x -F "start $_prev $GEN_ID" -- "$R/{{ bs.layout.operations_log }}" 2>/dev/null || lme_refuse RH-SEED-ROOT-NOT-OWNED "incomplete generation's operation $_prev is not recorded in {{ bs.layout.operations_log }}; preserved: $G"
  _ab="$R/{{ bs.layout.abandoned_dir }}/$GEN_ID.$_prev"
  [ ! -e "$_ab" ] && [ ! -L "$_ab" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "abandon target already exists: $_ab"
  {{ x(bs, 'mv') }} -- "$G" "$_ab" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot move the incomplete generation aside'
  lme_log abandon "$GEN_ID.$_prev"
  printf 'REPLACING-INCOMPLETE %s %s\n' "$GEN_ID" "$_prev" >&2
  {{ x(bs, 'chmod') }} -R u+w -- "$_ab" && {{ x(bs, 'rm') }} -rf --one-file-system -- "$_ab" || lme_refuse RH-SEED-INSTALL-FAILED "cannot remove $_ab"
  lme_log removed "$GEN_ID.$_prev"
fi

[ -d "$A" ] && [ ! -L "$A" ] || lme_refuse RH-SEED-ARTIFACT-MISSING "bundle artifact directory missing: $A"
{{ artifact_checks(bs, lock) }}
{{ storage_check(bs, 'R') }}

lme_log start "$GEN_ID"
# SEED2-EARLY-INTERRUPTION: the generation becomes visible only WITH its .operation (staging dir + one rename)
_gs="$R/{{ bs.layout.generations_dir }}/.{{ bs.layout.creating_infix }}.$OP_ID"
{{ x(bs, 'mkdir') }} -m 0700 -- "$_gs" || lme_refuse RH-SEED-INSTALL-FAILED "cannot create $_gs"
printf '%s\n' "$OP_ID" > "$_gs/{{ bs.layout.operation_file }}" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot record the operation'
{{ x(bs, 'mv') }} -T -- "$_gs" "$G" || lme_refuse RH-SEED-INSTALL-FAILED "cannot publish $G"
{{ x(bs, 'mkdir') }} -m 0700 -- "$G/{{ bs.layout.receipts_dir }}" "$G/{{ bs.layout.gen_dirs.tmp }}" "$G/{{ bs.layout.gen_dirs.verify }}" "$G/{{ bs.layout.gen_dirs.verify }}/uv" "$G/{{ bs.layout.gen_dirs.verify }}/pbs" "$G/{{ bs.layout.gen_dirs.collections }}" \
  || lme_refuse RH-SEED-INSTALL-FAILED 'cannot create the generation layout'
PHASE_LOG="$G/{{ bs.layout.receipts_dir }}/phases.tsv"
lme_phase artifacts-verified
printf '%s\n' {{ shq(artifact_rows(bs, lock) | trim) }} > "$G/{{ bs.layout.receipts_dir }}/artifacts.sha256"
{{ startup_snapshot(bs, '_pre') }}
{{ install_uv(bs) }}
{{ install_python(bs) }}
{{ install_venv(bs, lock) }}
{{ install_collections(bs, lock) }}
lme_phase smoke
{{ smoke(bs, ctl, '$G/' ~ bs.layout.gen_dirs.tmp ~ '/ansible-home', '$G/' ~ bs.layout.gen_dirs.tmp, '$G/' ~ bs.layout.receipts_dir ~ '/ansible-playbook-version.txt') }}
{{ startup_snapshot(bs, '_post') }}
[ "$_pre" = "$_post" ] || lme_refuse RH-SEED-IDENTITY-MISMATCH 'a shell startup or uv/ansible home file changed during install'

lme_phase seal
{{ x(bs, 'chmod') }} -R u+w -- "$G/{{ bs.layout.gen_dirs.verify }}" "$G/{{ bs.layout.gen_dirs.tmp }}" && {{ x(bs, 'rm') }} -rf --one-file-system -- "$G/{{ bs.layout.gen_dirs.verify }}" "$G/{{ bs.layout.gen_dirs.tmp }}" \
  || lme_refuse RH-SEED-INSTALL-FAILED 'cannot remove the verification and temp trees'
{{ x(bs, 'chmod') }} -R a-w -- {% for d in bs.layout.sealed %}"$G/{{ d }}" {% endfor %}|| lme_refuse RH-SEED-INSTALL-FAILED 'cannot seal the installed trees'
(cd "$G" && {{ x(bs, 'find') }} -P {{ bs.layout.sealed | join(' ') }} -type f -exec {{ x(bs, 'sha256sum') }} -- '{}' '+') > "$G/{{ bs.layout.receipts_dir }}/tree.sha256" || lme_refuse RH-SEED-INSTALL-FAILED 'content manifest failed'
{{ tree_list(bs) }} > "$G/{{ bs.layout.receipts_dir }}/tree.list" || lme_refuse RH-SEED-INSTALL-FAILED 'tree listing failed'
{{ tree_confine(bs) }}
(cd "$G" && {{ x(bs, 'sha256sum') }} --check --strict --quiet -- {{ bs.layout.receipts_dir }}/tree.sha256) >/dev/null || lme_refuse RH-SEED-IDENTITY-MISMATCH 'content manifest does not re-verify'
_du=$({{ x(bs, 'du') }} -sb -- "$G"); _du=${_du%%[!0-9]*}
[ "$_du" -le {{ bs.budget.generation_max_bytes | int }} ] || lme_refuse RH-SEED-STORAGE "generation uses $_du > {{ bs.budget.generation_max_bytes | int }} bytes"
printf '%s\n' "$LME_PINS" > "$G/{{ bs.layout.receipts_dir }}/pins.txt"
_owner=$({{ x(bs, 'id') }} -un) || lme_refuse RH-SEED-INSTALL-FAILED 'cannot name the owner account'
lme_sha() { _x=$({{ x(bs, 'sha256sum') }} -- "$1") || lme_refuse RH-SEED-INSTALL-FAILED "cannot digest $1"; printf '%s' "${_x%% *}"; }
_d_art=$(lme_sha "$G/{{ bs.layout.receipts_dir }}/artifacts.sha256") || exit $?
_d_tree=$(lme_sha "$G/{{ bs.layout.receipts_dir }}/tree.sha256") || exit $?
_d_list=$(lme_sha "$G/{{ bs.layout.receipts_dir }}/tree.list") || exit $?
_d_py=$(lme_sha "$G/{{ bs.python.interpreter_rel }}") || exit $?
_d_ap=$(lme_sha "$G/{{ bs.layout.gen_dirs.venv }}/bin/ansible-playbook") || exit $?
_d_uv=$(lme_sha "$G/{{ bs.layout.gen_dirs.uv }}/uv") || exit $?
_d_cfg=$(lme_sha "$G/{{ bs.layout.config_file }}") || exit $?
( {{ toolchain_json(bs, ctl) }} ) > "$G/{{ bs.layout.receipts_dir }}/toolchain.json" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot write the toolchain receipt'
lme_phase complete
PHASE_LOG=''
{{ x(bs, 'chmod') }} -R a-w -- "$G/{{ bs.layout.receipts_dir }}" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot seal the receipts'
printf '%s\n' "$GEN_ID" > "$G/{{ bs.layout.complete_marker }}" || lme_refuse RH-SEED-INSTALL-FAILED 'cannot write the completion marker'
lme_log complete "$GEN_ID"
lme_publish_active
lme_verify_published
printf 'INSTALLED %s %s\n' "$GEN_ID" "$G"
{%- endmacro -%}
