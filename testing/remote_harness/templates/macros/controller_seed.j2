{{ x(bs, 'tar') }} -xzf "$A/"{{ shq(arch.file) }} -C "$G/{{ bs.layout.gen_dirs.verify }}/uv" --no-same-owner || lme_refuse RH-SEED-INSTALL-FAILED 'independent uv archive unpack failed'
{% for m in bs.uv.members %}
{{ x(bs, 'cmp') }} -s -- "$G/{{ bs.layout.gen_dirs.verify }}/uv/"{{ shq(m.archive) }} "$G/{{ bs.layout.gen_dirs.uv }}/"{{ shq(m.installed) }} || lme_refuse RH-SEED-IDENTITY-MISMATCH {{ shq('installed ' ~ m.installed ~ ' != pinned archive member ' ~ m.archive) }}
{% endfor %}
_v=$({{ env_i(bs, {'UV_NO_CONFIG': '1'}) }} "$G/{{ bs.layout.gen_dirs.uv }}/uv" --version 2>&1) || lme_refuse RH-SEED-IDENTITY-MISMATCH "uv --version failed: $_v"
case "$_v" in {{ shq(bs.uv.version_prefix) }}|{{ shq(bs.uv.version_prefix) }}' '*) : ;; *) lme_refuse RH-SEED-IDENTITY-MISMATCH "uv reports '$_v'" ;; esac
