{#- ---- S3: the ssh auth mode (run only; no default). agent mode carries SSH_AUTH_SOCK deliberately after
     validating it (admitted path, a socket, owned by us); every other mode carries nothing. ---- -#}
{%- macro ssh_auth_check(bs, sa) -%}
LME_CARRY_SOCK=''; _ssh_args=''
if [ "$MODE" = run ]; then
  case "$SSH_AUTH" in
{% for m, d in sa.modes | dictsort %}
    {{ m }}) _ssh_args={{ shq(d.ssh_common_args) }} ;;
{% endfor %}
    '') lme_refuse RH-SEED-USAGE 'run needs --ssh-auth <mode> (no default): {{ sa.modes | list | sort | join(", ") }}' ;;
    *) lme_refuse RH-SEED-AUTH "unsupported ssh auth mode: $SSH_AUTH" ;;
  esac
  if [ "$SSH_AUTH" = agent ]; then
    _sock=${SSH_AUTH_SOCK:-}
    [ -n "$_sock" ] || lme_refuse RH-SEED-AUTH 'agent mode needs SSH_AUTH_SOCK'
    {{ path_arg_check(bs, '_sock', 'SSH_AUTH_SOCK') | indent(4) }}
    [ -S "$_sock" ] && [ ! -L "$_sock" ] || lme_refuse RH-SEED-AUTH "SSH_AUTH_SOCK is not a socket: $_sock"
    [ "$({{ x(bs, 'stat') }} -c %u -- "$_sock")" = "$({{ x(bs, 'id') }} -u)" ] || lme_refuse RH-SEED-AUTH "SSH_AUTH_SOCK is not owned by this account: $_sock"
    LME_CARRY_SOCK=$_sock
  fi
else
  [ -z "$SSH_AUTH" ] || lme_refuse RH-SEED-USAGE "--ssh-auth applies to run only"
fi
{%- endmacro -%}

{#- ---- SEED2-BUNDLE-COMPLETION: apply refuses before ANY mutation unless its own directory is a complete, bound
     package.yml bundle (exact members with modes, exact check-file names, seed line = running seed digest,
     sha256sum --check, bundle.json binds the seed and check-file digests). ---- -#}
{%- macro bundle_check(bs, lock) -%}
{% set b = bs.bundle %}
{% set cf = b.checksum_format %}
{% set rows = bs.artifacts + lock.packages + lock.collections %}
{% set ns = namespace(members=['d 700 ' ~ b.artifacts_dir, 'f 500 ' ~ b.seed_file, 'f 400 ' ~ b.manifest_file, 'f 400 ' ~ b.checksum_file], names=[b.seed_file]) %}
{% for a in rows %}
{% set ns.members = ns.members + ['f 400 ' ~ b.artifacts_dir ~ '/' ~ a.file] %}
{% set ns.names = ns.names + [b.artifacts_dir ~ '/' ~ a.file] %}
{% endfor %}
lme_bundle_check() {
  _B=${SELF%/*}
  for _f in {{ shq(b.checksum_file) }} {{ shq(b.manifest_file) }}; do
    [ -f "$_B/$_f" ] && [ ! -L "$_B/$_f" ] || lme_refuse RH-SEED-ARTIFACT-MISSING "incomplete bundle (no $_f; package.yml publishes it last): $_B"
  done
  [ "$({{ x(bs, 'find') }} -P "$_B" -mindepth 1 -printf '%y %m %P\n' | {{ joinsorted(bs) }})" = {{ shq(ns.members | sort(case_sensitive=true) | join(' ')) }} ] \
    || lme_refuse RH-SEED-ARTIFACT-MISSING "bundle members/modes are not exactly the declared set: $_B"
  # the ONE declared checksum_file grammar (bundle.checksum_format), shared with package_bundle.yml
  ! {{ x(bs, 'grep') }} -v -q -x -E {{ shq(cf.digest ~ cf.separator ~ cf.name) }} -- "$_B/"{{ shq(b.checksum_file) }} \
    || lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq(b.checksum_file ~ ' has a malformed line') }}
{% if cf.terminator == 'newline' %}
  _t=$({{ x(bs, 'cat') }} -- "$_B/"{{ shq(b.checksum_file) }} && printf .) || lme_refuse RH-SEED-DIGEST-MISMATCH 'cannot read the check file'
  case "${_t%.}" in *'
') : ;; *) lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq(b.checksum_file ~ ' is not newline-terminated') }} ;; esac
{% else %}
  lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq('undeclared bundle.checksum_format.terminator: ' ~ cf.terminator) }}
{% endif %}
  [ "$({{ x(bs, 'sed') }} -E -n {{ shq('s/^' ~ cf.digest ~ cf.separator ~ '//p') }} -- "$_B/"{{ shq(b.checksum_file) }} | {{ joinsorted(bs) }})" = {{ shq(ns.names | sort(case_sensitive=true) | join(' ')) }} ] \
    || lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq(b.checksum_file ~ ' does not list exactly the declared members') }}
  {{ x(bs, 'grep') }} -q -x -F "$SEED_SHA"{{ shq(cf.separator ~ b.seed_file) }} -- "$_B/"{{ shq(b.checksum_file) }} \
    || lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq(b.checksum_file ~ ' does not bind the running seed digest') }}
  (cd "$_B" && {{ x(bs, 'sha256sum') }} --check --strict --quiet -- {{ shq(b.checksum_file) }}) >/dev/null 2>&1 \
    || lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq('bundle content differs from ' ~ b.checksum_file) }}
  _cs=$({{ x(bs, 'sha256sum') }} -- "$_B/"{{ shq(b.checksum_file) }}) || lme_refuse RH-SEED-DIGEST-MISMATCH 'cannot digest the check file'
  _cs=${_cs%% *}
  {{ x(bs, 'grep') }} -q -F "\"seed_sha256\": \"$SEED_SHA\"" -- "$_B/"{{ shq(b.manifest_file) }} \
    && {{ x(bs, 'grep') }} -q -F "\"checksum_file_sha256\": \"$_cs\"" -- "$_B/"{{ shq(b.manifest_file) }} \
    && {{ x(bs, 'grep') }} -q -F {{ shq('"schema": "' ~ b.schema ~ '"') }} -- "$_B/"{{ shq(b.manifest_file) }} \
    || lme_refuse RH-SEED-DIGEST-MISMATCH {{ shq(b.manifest_file ~ ' does not bind this seed, its check file and schema') }}
}
{%- endmacro -%}

{#- ---- SEED2-PURGE-OWNERSHIP: admit an exact owned-removal inventory before ANY destruction ---- -#}
{%- macro purge_inventory(bs) -%}
{% set L = bs.layout %}
{% set ci = '.' ~ L.creating_infix ~ '.' %}
_log="$R/{{ L.operations_log }}"
lme_recorded() {
  [ -f "$_log" ] && [ ! -L "$_log" ] || return 1
  {{ x(bs, 'awk') }} -v v="$1" -v o="$2" -v n="$3" '$1 == v && (o == "" || $2 == o) && (n == "" || $3 == n) { m = 1 } END { exit !m }' "$_log"
}
_unk=''
for _e in "$R"/* "$R"/.[!.]* "$R"/..?*; do
  [ -e "$_e" ] || [ -L "$_e" ] || continue
  _b=${_e##*/}
  if [ -L "$_e" ]; then _unk="$_unk $_b(link)"; continue; fi
  case "$_b" in
    {{ shq(L.root_marker) }}|{{ shq(L.operations_log) }}|{{ shq(L.active_file) }}|{{ shq(bs.toolchain_receipt) }}|{{ shq(L.publish_tmp_prefix) }}*) [ -f "$_e" ] || _unk="$_unk $_b(not-a-file)" ;;
    {{ shq(L.generations_dir) }}|{{ shq(L.abandoned_dir) }}|{{ shq(L.check_dir) }}|{{ shq(L.run_dir) }}) [ -d "$_e" ] || _unk="$_unk $_b(not-a-dir)" ;;
    *) _unk="$_unk $_b" ;;
  esac
done
for _e in "$R/{{ L.generations_dir }}"/* "$R/{{ L.generations_dir }}"/.[!.]* "$R/{{ L.generations_dir }}"/..?*; do
  [ -e "$_e" ] || [ -L "$_e" ] || continue
  _b=${_e##*/}
  [ ! -L "$_e" ] && [ -d "$_e" ] || { _unk="$_unk {{ L.generations_dir }}/$_b(not-a-dir)"; continue; }
  case "$_b" in
    {{ shq(ci) }}*) lme_recorded start "${_b#{{ ci }}}" '' || _unk="$_unk {{ L.generations_dir }}/$_b(unrecorded-staging)" ;;
    *) lme_recorded start '' "$_b" || _unk="$_unk {{ L.generations_dir }}/$_b(unrecorded)" ;;
