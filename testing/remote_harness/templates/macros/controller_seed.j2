[ "$({{ x(bs, 'grep') }} -c -F {{ shq('_checksum_value="' ~ bs.uv.installer_embedded_archive_sha256 ~ '"') }} -- "$A/"{{ shq((bs.artifacts | selectattr('key', 'equalto', bs.uv.installer_artifact) | first).file) }})" = 1 ] \
