{%- macro toolchain_json(bs, ctl) -%}
{% set v = '$G/' ~ bs.layout.gen_dirs.venv ~ '/bin/' %}
printf '{"schema":"%s","generation":"%s","root":"%s","owner_uid":%s,"owner_name":"%s","generation_dir":"%s","sealed_receipt":"%s","seed_path":"%s","seed_sha256":"%s","expect_core":"%s","python_version":"%s","python_install_mode":"%s","uv_version":"%s","ansible_playbook":"%s","ansible_galaxy":"%s","ansible_inventory":"%s","ansible":"%s","python":"%s","interpreter":"%s","uv":"%s","collections_path":"%s","ansible_config":"%s","artifacts_manifest_sha256":"%s","tree_manifest_sha256":"%s","tree_list_sha256":"%s","interpreter_sha256":"%s","ansible_playbook_sha256":"%s","uv_sha256":"%s","ansible_config_sha256":"%s","operation":"%s","completed_utc":"%s"}\n' \
  {{ shq(bs.toolchain_receipt_schema) }} "$GEN_ID" "$R" "$_uid" "$_owner" "$G" "$G/{{ bs.layout.receipts_dir }}/toolchain.json" "$SELF" "$SEED_SHA" \
  {{ shq(ctl.expect_core) }} {{ shq(bs.python.version) }} {{ shq(bs.python.install_mode) }} {{ shq(bs.uv.version) }} \
  "{{ v }}ansible-playbook" "{{ v }}ansible-galaxy" "{{ v }}ansible-inventory" "{{ v }}ansible" "{{ v }}python" \
  "$G/{{ bs.python.interpreter_rel }}" "$G/{{ bs.layout.gen_dirs.uv }}/uv" "$G/{{ bs.layout.gen_dirs.collections }}" "$G/{{ bs.layout.config_file }}" \
  "$_d_art" "$_d_tree" "$_d_list" "$_d_py" "$_d_ap" "$_d_uv" "$_d_cfg" "$OP_ID" "$UTC"
