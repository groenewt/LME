_self=$({{ x(bs, 'realpath') }} -e -- "$0") || {{ seed_refuse(bs, 'launcher_self', {}, {}) }}
_B=${_self%/*}
[ $# -ge 2 ] || {{ seed_refuse(bs, 'launcher_usage', {'modes': sl.mode_args | list | sort | join(sl.launcher_forms.mode_join)}, {}) }}
_mode=$1; _root=$2; shift 2
{{ launch_home(bs) }}
case "$_mode" in
{% for mode, words in sl.mode_args | dictsort %}
{% set ps = (launch_params(words) | string).split() %}
  {{ shq(mode) }})
{# launcher_arity composition (sr922g_c1 composition_rule): params = param_open + ps joined by param_join + param_close
   for a mode with positional params, the empty text of zero params otherwise (a count from mode_args, not a
   substitute); tail = tail_args when the mode's words hold {args}, else tail_fixed #}
{% set lf = sl.launcher_forms %}
{% if ps | length > 0 %}{% set pt = lf.param_open ~ (ps | join(lf.param_join)) ~ lf.param_close %}{% else %}{% set pt = '' %}{% endif %}
{% if '{args}' in words %}{% set tt = lf.tail_args %}{% else %}{% set tt = lf.tail_fixed %}{% endif %}
    [ $# -{{ 'ge' if '{args}' in words else 'eq' }} {{ ps | length }} ] || {{ seed_refuse(bs, 'launcher_arity', {'mode': mode, 'params': pt, 'tail': tt}, {}) }}
{% for p in ps %}
