{#- ---- refusal vocabulary -> one shell function ---- -#}
{%- macro refusal_fn(refusals) -%}
lme_refuse() {
  _code=$1; shift
  case "$_code" in
{% for code, status in refusals | dictsort %}
    {{ code }}) _st={{ status | int }} ;;
{% endfor %}
    *) _st=1 ;;
  esac
  printf 'REFUSED %s %s\n' "$_code" "$*" >&2
  exit "$_st"
}
{%- endmacro -%}

