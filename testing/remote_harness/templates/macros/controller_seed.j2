{%- endmacro -%}

{#- ---- budget: one transient user scope; limits read back from our own cgroup ---- -#}
{%- macro budget_props(bs) -%}
-p MemoryMax={{ bs.budget.memory_max_bytes | int }} -p CPUQuota={{ bs.budget.cpu_quota_percent | int }}% -p TasksMax={{ bs.budget.tasks_max | int }}
{%- endmacro -%}

{%- macro budget_enter(bs) -%}
if [ "${LME_SEED_SCOPED:-}" != 1 ]; then
  {{ launch_scope_env(bs) }} {{ x(bs, 'systemd-run') }} --user --scope --quiet --collect {{ budget_props(bs) }} -- {{ x(bs, 'true') }} >/dev/null 2>&1 \
    || lme_refuse {{ bs.seed_launch.budget_refusal }} 'systemd-run --user --scope with the declared limits failed (no user manager or controller delegation); never run unbudgeted'
  exec {{ launch_scope_env(bs) }} {{ x(bs, 'systemd-run') }} --user --scope --quiet --collect {{ budget_props(bs) }} -- {{ env_i(bs, {}, ['LME_SEED_SCOPED=1']) }} ${LME_CARRY_SOCK:+SSH_AUTH_SOCK="$LME_CARRY_SOCK"} {{ x(bs, 'sh') }} "$SELF" "$@"
fi
_cg=$({{ x(bs, 'sed') }} -n 's/^0:://p' {{ shq(bs.budget.cgroup_self) }})
_cgd={{ shq(bs.budget.cgroup_mount) }}"$_cg"
_mem=$({{ x(bs, 'cat') }} -- "$_cgd/memory.max" 2>/dev/null || :)
_cpu=$({{ x(bs, 'cat') }} -- "$_cgd/cpu.max" 2>/dev/null || :)
