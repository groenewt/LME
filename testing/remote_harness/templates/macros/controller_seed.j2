{{ out }}=''
{% for p in bs.startup_files_unchanged %}
{{ out }}="${{ out }}|$({{ x(bs, 'stat') }} -c '%n %i %s %Y' -- "$HOME/"{{ shq(p) }} 2>/dev/null || printf 'absent %s' {{ shq(p) }})"
{% endfor %}
