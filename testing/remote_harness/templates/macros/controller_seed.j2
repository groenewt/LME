  lme_ancestry "$W/."
  {{ work_root_check(bs, 'W') | indent(2) }}
  _wdev=$({{ x(bs, 'stat') }} -c %d -- "$W") || lme_refuse {{ wr.admission.refusal }} "cannot stat work root $W"
  lme_dest "$R" d
{% for d in [L.generations_dir, L.abandoned_dir, L.check_dir, L.run_dir] %}
  lme_dest "$R/"{{ shq(d) }} d
{% endfor %}
{% for f in [L.root_marker, L.operations_log, L.active_file, bs.toolchain_receipt] %}
  lme_dest "$R/"{{ shq(f) }} f
{% endfor %}
  if [ "$MODE" = run ] || [ "$MODE" = {{ rlm }} ]; then
