{#- ---- OWNER-PRIVATE-GROUP decision (path_admission.ancestry.owner_private_group; codex 143342): ONE generated awk
     program, a pure function of a tagged facts stream (facts_schema private-group-facts/1: `<tag>TAB<value>` lines,
     tags owner path dir rc nsl pwl grl acl). The seed pipes the facts it gathers into it; playbook consumers render
     the same program (templates/private_group_program.j2) and run it on the controller (tasks/decide_private_group.yml);
     the synthetic fixtures (tests/private_group_fixtures.yml) run it unchanged. Prints `ADMIT <dir>` (exit 0) or
     `REFUSE <dir>: <reasons>` (exit 1). No single quote inside (it travels through shq). ---- -#}
{%- macro private_group_program(bs) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
function no(m) { ok = 0; why = why " " m }
BEGIN { ok = 1; why = ""; np = 0; ng = 0; na = 0; nallow = 0; ndb = 0; ou = ""; dp = ""; du = ""; dg = ""; dm = ""
{% for s in pg.identity_provider.allowed_sources %}
  allow[{{ loop.index }}] = "{{ s | join(' ') }}"; nallow = {{ loop.index }}
{% endfor %}
{% for d in pg.identity_provider.databases %}
  dbs[{{ loop.index }}] = "{{ d }}"; ndb = {{ loop.index }}
{% endfor %}
  nstep = split("dir nss passwd group acl", steps, " ") }
{ t = index($0, "\t"); if (t == 0) { no("malformed-fact"); next }; tag = substr($0, 1, t - 1); v = substr($0, t + 1) }
tag == "owner" { if (ou != "") no("owner-fact-repeated"); ou = v; next }
tag == "path" { if (dp != "") no("path-fact-repeated"); dp = v; next }
tag == "dir" { n = split(v, d, " "); if (n != 3) no("dir-fact-malformed"); du = d[1]; dg = d[2]; dm = d[3]; next }
tag == "rc" { n = split(v, r, "\t"); if (n != 2) { no("rc-fact-malformed"); next }; rc[r[1]] = r[2]; next }
tag == "nsl" { s = v; sub(/#.*/, "", s); c = index(s, ":"); if (c == 0) next; db = substr(s, 1, c - 1); gsub(/[ \t]/, "", db)
  src = substr(s, c + 1); gsub(/[ \t]+/, " ", src); sub(/^ /, "", src); sub(/ $/, "", src)
  if (db in nss) nssdup[db] = 1; nss[db] = src; next }
tag == "pwl" { n = split(v, f, ":"); if (n != 7) { no("passwd-record-malformed"); next }; np++; pwn[np] = f[1]; pwu[np] = f[3]; pwg[np] = f[4]; next }
tag == "grl" { n = split(v, f, ":"); if (n != 4) { no("group-record-malformed"); next }; ng++; grn[ng] = f[1]; grg[ng] = f[3]; grm[ng] = f[4]; next }
tag == "acl" { na++; ae[na] = v; next }
{ no("unknown-fact-" tag) }
END {
  for (i = 1; i <= nstep; i++) { s = steps[i]; if (!(s in rc)) no("step-" s "-unreported"); else if (rc[s] != "0") no("step-" s "-failed-rc-" rc[s]) }
  if (ou == "" || dp == "" || du == "" || dg == "" || dm == "") no("facts-incomplete")
  for (i = 1; i <= ndb; i++) { db = dbs[i]
    if (!(db in nss)) no("nsswitch-" db "-absent")
    else if (db in nssdup) no("nsswitch-" db "-repeated")
    else { hit = 0; for (a = 1; a <= nallow; a++) if (nss[db] == allow[a]) hit = 1
      if (!hit) { x = nss[db]; gsub(/ /, "+", x); no("nsswitch-" db "-sources-unsupported:" x) } } }
  if (np == 0) no("passwd-enumeration-empty")
  if (ng == 0) no("group-enumeration-empty")
  if (du != ou) no("dir-owner-" du "-is-not-owner-" ou)
  if (substr(dm, length(dm), 1) ~ /[2367]/) no("other-writable")
  oc = 0; og = ""
  for (i = 1; i <= np; i++) if (pwu[i] == ou) { oc++; og = pwg[i]; oname[pwn[i]] = 1 }
  if (oc != 1) no("owner-uid-" ou "-passwd-records-" oc)
  if (oc == 1 && dg != og) no("dir-gid-" dg "-is-not-owner-primary-gid-" og)
  for (i = 1; i <= np; i++) {
    if (pwg[i] == dg && pwu[i] != ou) no("account-" pwn[i] "-shares-primary-gid-" dg)
    if ((pwn[i] in oname) && pwu[i] != ou) no("account-name-" pwn[i] "-ambiguous") }
  gc = 0; mem = ""
  for (j = 1; j <= ng; j++) if (grg[j] == dg) { gc++; mem = grm[j] }
  if (gc != 1) no("group-gid-" dg "-records-" gc)
  if (gc == 1 && mem != "") { k = split(mem, mm, ","); for (i = 1; i <= k; i++) if (!(mm[i] in oname)) no("supplementary-member-" mm[i]) }
  for (i = 1; i <= na; i++) { e = ae[i]; sub(/#.*/, "", e); gsub(/[ \t]/, "", e); if (e == "") continue
    sub(/^default:/, "", e); n = split(e, p, ":"); if (n != 3) { no("acl-entry-malformed"); continue }
    if (index(p[3], "w") == 0) continue
    if (p[1] == "user") { if (p[2] != "" && p[2] != ou) no("acl-user-" p[2] "-writes") }
    else if (p[1] == "group") { if (p[2] != "" && p[2] != dg) no("acl-group-" p[2] "-writes") }
    else if (p[1] == "other") no("acl-other-writes")
    else if (p[1] != "mask") no("acl-entry-" p[1] "-unknown") }
  if (ok) { print "ADMIT " dp; exit 0 }
  print "REFUSE " dp ":" why; exit 1 }
{%- endmacro -%}

{#- the fact gathering for ONE group-writable directory ${dvar} (declared tools only; needs $_uid): prints the
    private-group-facts/1 stream on stdout. The seed pipes it into the program; target_bootstrap.yml runs the same
    text over its initial-contact raw channel and decides on the controller (tasks/decide_private_group.yml).
    codex-tick395 R2: every executable is a DECLARED role of owner_private_group (facts_tools.stat / .read / .filter,
    identity_provider.enumeration_tool, acl_tool) -- the SAME references tasks/initial_contact.yml admits. -#}
{%- macro private_group_facts(bs, dvar) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_pgd=$({{ x(bs, pg.facts_tools.stat) }} -c '%u %g %a' -- "${{ dvar }}"); _pgd_rc=$?
_pgn=$({{ x(bs, pg.facts_tools.read) }} -- {{ shq(pg.identity_provider.nsswitch_file) }}); _pgn_rc=$?
_pgp=$({{ x(bs, pg.identity_provider.enumeration_tool) }} passwd); _pgp_rc=$?
_pgg=$({{ x(bs, pg.identity_provider.enumeration_tool) }} group); _pgg_rc=$?
_pga=$({{ x(bs, pg.acl_tool) }} -c -n -p -P -- "${{ dvar }}"); _pga_rc=$?
{
  printf 'owner\t%s\npath\t%s\ndir\t%s\n' "$_uid" "${{ dvar }}" "$_pgd"
  printf 'rc\tdir\t%s\nrc\tnss\t%s\nrc\tpasswd\t%s\nrc\tgroup\t%s\nrc\tacl\t%s\n' "$_pgd_rc" "$_pgn_rc" "$_pgp_rc" "$_pgg_rc" "$_pga_rc"
  printf '%s\n' "$_pgn" | {{ x(bs, pg.facts_tools.filter) }} 's/^/nsl\t/'
  printf '%s\n' "$_pgp" | {{ x(bs, pg.facts_tools.filter) }} 's/^/pwl\t/'
  printf '%s\n' "$_pgg" | {{ x(bs, pg.facts_tools.filter) }} 's/^/grl\t/'
  printf '%s\n' "$_pga" | {{ x(bs, pg.facts_tools.filter) }} 's/^/acl\t/'
}
{%- endmacro -%}

{%- macro private_group_admit(bs, dvar) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_pgv=$(
{{ private_group_facts(bs, dvar) }} | {{ x(bs, pg.decision_tool) }} {{ shq(private_group_program(bs)) }}
) || lme_refuse {{ pg.refusal }} "group-writable directory ${{ dvar }} is not an admitted owner-private group: $_pgv"
{%- endmacro -%}

{#- ---- ancestry (path_admission.ancestry, the ONE rule): every existing ancestor a real dir owned by 0 or the owner;
     other-writable (sticky included) refuses; group-writable refuses unless owner_private_group admits it ---- -#}
{%- macro ancestry_check(bs, var) -%}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
_a=${{ var }}
while [ "$_a" != / ]; do
  _a=${_a%/*}; [ -n "$_a" ] || _a=/
  [ -e "$_a" ] || [ -L "$_a" ] || continue
  [ ! -L "$_a" ] && [ -d "$_a" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor is not a real directory: $_a"
  _st=$({{ x(bs, 'stat') }} -c '%u %a' -- "$_a") || lme_refuse RH-SEED-ROOT-NOT-OWNED "cannot stat ancestor $_a"
  _o=${_st%% *}; _m=${_st#* }
  [ "$_o" = 0 ] || [ "$_o" = "$_uid" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a owned by uid $_o (allowed: 0, $_uid)"
  _go=${_m#"${_m%??}"}
  case "$_go" in
    ?[2367]) lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a is other-writable (mode $_m; sticky directories are not excepted)" ;;
    [2367]?)
{% if pg.enabled is not boolean %}{{ pg['owner_private_group.enabled: not a boolean word (route op1q; no truthiness)'].render_error }}{% elif pg.enabled %}
      [ "$_o" = "$_uid" ] || lme_refuse {{ pg.refusal }} "ancestor $_a is group-writable and owned by uid $_o, not the owner $_uid (mode $_m)"
      {{ private_group_admit(bs, '_a') | indent(6) }}
{% else %}
      lme_refuse RH-SEED-ROOT-NOT-OWNED "ancestor $_a is group-writable (mode $_m)"
{% endif %}
      ;;
  esac
done
{%- endmacro -%}

{#- the rule as ONE shell function (lme_ancestry <path>), called at admission and re-called at every use boundary -#}
{%- macro ancestry_fn(bs) -%}
lme_ancestry() {
  _anc=$1
  {{ ancestry_check(bs, '_anc') | indent(2) }}
  return 0
}
{%- endmacro -%}

{#- ---- DESTINATION CUSTODY (work_roots.destination_custody; codex 143844 RH-ENGINE-CONFIG-CUSTODY): lme_dest <path>
     <d|f> admits an EXISTING destination (absent -> nothing to admit): not a link, the declared type, owned by the
     running uid, not other-writable, group-writable only as an admitted owner-private-group directory (files never),
     on the admitted work root's device $_wdev (a nested mount refuses) and not on a refused fs type ---- -#}
{%- macro dest_fn(bs) -%}
{% set a = bs.work_roots.admission %}
{% set pg = bs.path_admission.ancestry.owner_private_group %}
lme_dest() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  [ ! -L "$1" ] || lme_refuse {{ a.refusal }} "destination is a link: $1"
  case "$2" in d) [ -d "$1" ] ;; *) [ -f "$1" ] ;; esac || lme_refuse {{ a.refusal }} "destination is not of type $2: $1"
  _ds=$({{ x(bs, 'stat') }} -c '%u %a %d' -- "$1") || lme_refuse {{ a.refusal }} "cannot stat destination $1"
  _du=${_ds%% *}; _dr=${_ds#* }; _dm=${_dr%% *}; _dd=${_dr#* }
  [ "$_du" = "$_uid" ] || lme_refuse {{ a.refusal }} "destination $1 is owned by uid $_du, not $_uid"
  case "${_dm#"${_dm%??}"}" in
    ?[2367]) lme_refuse {{ a.refusal }} "destination $1 is other-writable (mode $_dm)" ;;
    [2367]?)
{% if pg.enabled is not boolean %}{{ pg['owner_private_group.enabled: not a boolean word (route op1q; no truthiness)'].render_error }}{% elif pg.enabled %}
      [ "$2" = d ] || lme_refuse {{ a.refusal }} "destination file $1 is group-writable (mode $_dm)"
      {{ private_group_admit(bs, '1') | indent(6) }}
{% else %}
      lme_refuse {{ a.refusal }} "destination $1 is group-writable (mode $_dm)"
{% endif %}
      ;;
  esac
  [ "$_dd" = "$_wdev" ] || lme_refuse {{ a.refusal }} "destination $1 is on device $_dd, not the admitted work root device $_wdev (nested mount)"
  _dt=$({{ x(bs, 'stat') }} -f -c %T -- "$1") || lme_refuse {{ a.refusal }} "filesystem type unreadable for $1"
  case "$_dt" in {% for t in a.refused_fs_types %}{{ shq(t) }}{% if not loop.last %}|{% endif %}{% endfor %}) lme_refuse {{ a.refusal }} "destination $1 is on $_dt (refused: {{ a.refused_fs_types | join(' ') }})" ;; esac
  return 0
}
{%- endmacro -%}

{#- ---- an EXISTING root is admitted only as this seed's: real dir, resolves to itself, uid + 0700, our marker ---- -#}
{%- macro root_existing(bs) -%}
[ ! -L "$R" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root is a symlink: $R"
[ -d "$R" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root is not a directory: $R"
[ "$({{ x(bs, 'realpath') }} -e -- "$R")" = "$R" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root does not resolve to itself: $R"
[ "$({{ x(bs, 'stat') }} -c '%u %a' -- "$R")" = "$_uid 700" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root is not uid $_uid mode 700: $R"
[ -f "$R/{{ bs.layout.root_marker }}" ] && [ ! -L "$R/{{ bs.layout.root_marker }}" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "existing root lacks {{ bs.layout.root_marker }} (never adopted): $R"
[ "$({{ x(bs, 'cat') }} -- "$R/{{ bs.layout.root_marker }}")" = "$_marker" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "root marker is not '$_marker': $R"
{%- endmacro -%}

{#- ---- root ownership: absent (owned, admitted parent) or carries this seed's marker, our uid, mode 0700 ---- -#}
{%- macro root_check(bs) -%}
_uid=$({{ x(bs, 'id') }} -u)
_marker="lme-controller-root v1 uid=$_uid"
lme_ancestry "$R"
if [ -e "$R" ] || [ -L "$R" ]; then
  {{ root_existing(bs) | indent(2) }}
  ROOT_STATE=present
else
  _parent=${R%/*}; [ -n "$_parent" ] || _parent=/
  [ "$({{ x(bs, 'realpath') }} -e -- "$_parent")" = "$_parent" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "parent does not resolve to itself: $_parent"
  [ "$({{ x(bs, 'stat') }} -c %u -- "$_parent")" = "$_uid" ] || lme_refuse RH-SEED-ROOT-NOT-OWNED "parent not owned by uid $_uid: $_parent"
  ROOT_STATE=absent
fi
{%- endmacro -%}

{#- ---- budget: one transient user scope; limits read back from our own cgroup ---- -#}
{%- macro budget_props(bs) -%}
-p MemoryMax={{ bs.budget.memory_max_bytes | int }} -p CPUQuota={{ bs.budget.cpu_quota_percent | int }}% -p TasksMax={{ bs.budget.tasks_max | int }} -p {{ shq(bs.source_admission.custody_lease.supervision.scope_property) }}
{%- endmacro -%}

{%- macro budget_enter(bs) -%}
{# records-route-lifecycle-01 (J-S28E-ROUTE-SCOPE b, d, e): _cgo is the own cgroup at entry; the walk over the kernel
   path alone gives _cgk (kinds.nested beneath a consumer leaf, else kinds.top) and _cgb, the enclosing budget scope.
   budget_enter never sets _cg or _cgd (the first lme_consume_open does). A nested seed never runs systemd-run. #}
{% set xs = bs.source_admission.custody_lease.supervision %}{% set sep = env_pair_sep(bs) | string %}
_cgo=
{ while read -r _cgl; do case "$_cgl" in 0::/*) _cgo=${_cgl#0::} ;; esac; done < {{ shq(bs.budget.cgroup_self) }}; } 2>/dev/null || _cgo=
_cgw=$_cgo; _cgk={{ xs.kinds.top }}
while :; do
  _cgn=${_cgw##*/}
  case "$_cgn" in {{ xs.leaf_prefix }}.*) : ;; *) break ;; esac
  _cgv=${_cgn#{{ xs.leaf_prefix }}.}
  [ -n "$_cgv" ] || break
  case "$_cgv" in *[!0-9]*) break ;; esac
  _cgk={{ xs.kinds.nested }}; _cgw=${_cgw%/*}
  case "${_cgw##*/}" in {{ xs.nested_root_prefix }}.*) _cgw=${_cgw%/*} ;; esac
done
_cgb=$_cgw
if [ "$_cgk" = {{ xs.kinds.top }} ] && [ "${LME_SEED_SCOPED+$LME_SEED_SCOPED}" != 1 ]; then
  {{ launch_scope_env(bs) }} {{ x(bs, 'systemd-run') }} --user --scope --quiet --collect {{ budget_props(bs) }} -- {{ x(bs, 'true') }} >/dev/null 2>&1 \
    || {{ seed_refuse(bs, 'scope_failed', {}, {}) }}
  exec {{ launch_scope_env(bs) }} {{ x(bs, 'systemd-run') }} --user --scope --quiet --collect {{ budget_props(bs) }} -- {{ env_i(bs, {}, ['LME_SEED_SCOPED' ~ sep ~ '1']) }} ${LME_CARRY_SOCK:+SSH_AUTH_SOCK{{ sep }}"$LME_CARRY_SOCK"} {{ x(bs, 'sh') }} "$SELF" "$@"
fi
_cgbd={{ shq(bs.budget.cgroup_mount) }}"$_cgb"
_mem=$({{ x(bs, 'cat') }} -- "$_cgbd/memory.max" 2>/dev/null || :)
_cpu=$({{ x(bs, 'cat') }} -- "$_cgbd/cpu.max" 2>/dev/null || :)
_pids=$({{ x(bs, 'cat') }} -- "$_cgbd/pids.max" 2>/dev/null || :)
case "$_mem" in ''|*[!0-9]*) lme_refuse RH-SEED-BUDGET-UNAVAILABLE "memory.max unreadable or unlimited in $_cgbd: '$_mem'" ;; esac
[ "$_mem" -le {{ bs.budget.memory_max_bytes | int }} ] && [ "$_mem" -gt {{ (bs.budget.memory_max_bytes | int) - 65536 }} ] || lme_refuse RH-SEED-BUDGET-UNAVAILABLE "memory.max $_mem != {{ bs.budget.memory_max_bytes | int }} (page-rounded)"
[ "$_cpu" = {{ shq(((bs.budget.cpu_quota_percent | int) * 1000) ~ ' 100000') }} ] || lme_refuse RH-SEED-BUDGET-UNAVAILABLE "cpu.max '$_cpu' != '{{ (bs.budget.cpu_quota_percent | int) * 1000 }} 100000'"
[ "$_pids" = {{ shq(bs.budget.tasks_max | int) }} ] || lme_refuse RH-SEED-BUDGET-UNAVAILABLE "pids.max '$_pids' != {{ bs.budget.tasks_max | int }}"
{%- endmacro -%}

{#- route op1q (HOLE-SEAT-COERCION-FILTER-SWEEP): need is REQUIRED (the op1p `need=none` parameter default and its
    `if need is none else` substitution retired; every caller names its declared word) and admitted by int_word, never
    the int filter. Callers: work_root_check a.free_bytes_min (r51 :4346 positive_int), the bundle check
    bs.budget.free_required_bytes (r51 :1252-1259 positive_int_paths), the run branch run_retention.free_required_bytes
    (route op1r: r51 :4400 positive_int, C1 SR922h; GUARDED; route op2c retarget). -#}
{#- route op1t (codex 937 ROUTE-SEED-CAPACITY-PRODUCER-STATUS, HIGH, inherited): the ONE df capacity read of the seed,
    shared by storage_check (free bytes) and work_root_check (free inodes). It applies the capture_then_parse rule
    declared as s64 transaction.producer_status (:8511 = s63 :8480 = s61 :8379 = s60 :8341 = s58 :8290 = s56 :8206 = s55 :8145 = s51 :8050 = s50 :7978 = s49 :7947: producers are never piped into their parser; the producer's
    output is captured by its own command, its status decides, and only then the parse role reads the captured text;
    shell_options none): (1) df runs alone in its own command substitution and a nonzero status REFUSES before any
    parse (a failing df that still printed a numeric row is never read); (2) the captured text must be exactly two
    lines (header and one row); (3) only then sed reads the captured text (row 2, blanks removed) and the value must be
    a non-empty digit string. No shell option, no pipefail. The df and sed executables stay x(bs, ...) (os_tools
    identity), the df argument words stay those each caller passed before op1t, and the refusal code stays each
    site's: `args` and `code` are the caller's, `what` only names the value in the refusal detail. Writes ${out}.
    route op1u (C1 SR922k SEED DF WORDS, s64 work_roots.admission.df_capacity :4429-4434, pinned whole r51 :4352): every
    part of the read is now a declared word, admitted at render (a missing or different word is a render error, nothing
    is emitted): `key` selects df_capacity.args[key] (the os_tools.df argument words of that value, end_of_options
    already last; only the path is appended); the captured text must be exactly rows.header_rows + rows.data_rows lines
    (data_rows must be 1: the seed reads ONE value per call, s64 :4419-4420); the cell is row header_rows + 1 with its
    blanks removed (cell.blanks removed); the value must FULLY match the decimal grammar walked from controller by
    grammar_from (transaction.grammar.decimal_ere), anchored at both ends, with the declared os_tools grep as the ERE
    matcher (no shell glob), so a leading zero, a sign or an empty cell refuses; producer_status_from must walk to
    {rule: capture_then_parse, shell_options: none}, which the steps below implement. ctl = remote_harness.controller
    (the seed's ctl input; every renderer binds it to rh.controller / the policy's controller). -#}
{%- macro df_value(bs, ctl, var, key, out, code, what) -%}
{%- if 'df_capacity' not in bs.work_roots.admission -%}{{ {}['df_value: controller.bootstrap.work_roots.admission.df_capacity is not declared'].render_error }}{%- endif -%}
{%- set dc = bs.work_roots.admission.df_capacity -%}
{%- set w = namespace(g=ctl, p=ctl, ok=true) -%}
{%- for k in dc.grammar_from -%}{%- if w.g is mapping and k in w.g -%}{%- set w.g = w.g[k] -%}{%- else -%}{%- set w.ok = false -%}{%- endif -%}{%- endfor -%}
{%- for k in dc.producer_status_from -%}{%- if w.p is mapping and k in w.p -%}{%- set w.p = w.p[k] -%}{%- else -%}{%- set w.ok = false -%}{%- endif -%}{%- endfor -%}
{%- set hr = dc.rows.header_rows -%}{%- set dr = dc.rows.data_rows -%}
{%- if not (w.ok and w.g is string and w.p is mapping and w.p.rule == 'capture_then_parse' and w.p.shell_options == 'none'
            and hr is integer and hr is not boolean and dr is integer and dr is not boolean and dr == 1
            and dc.cell.blanks == 'removed' and dc.args is mapping and key in dc.args) -%}
{{ {}['df_value: df_capacity (grammar_from, producer_status_from, rows, cell, args.' ~ key ~ ') is not the declared form this macro implements'].render_error }}
{%- endif -%}
_dfo=$({{ x(bs, 'df') }}{% for a in dc.args[key] %} {{ shq(a) }}{% endfor %} "${{ var }}") || lme_refuse {{ code }} "{{ what }}: df failed for ${{ var }} (status $?)"
_dfn=$(printf '%s\n' "$_dfo" | {{ x(bs, 'sed') }} -n '$=') || lme_refuse {{ code }} "{{ what }} unreadable for ${{ var }}"
[ "$_dfn" = {{ hr + dr }} ] || lme_refuse {{ code }} "{{ what }} unreadable for ${{ var }} (df printed $_dfn lines, not {{ hr }} header and {{ dr }} data)"
{{ out }}=$(printf '%s\n' "$_dfo" | {{ x(bs, 'sed') }} -n '{{ hr + 1 }}{s/[[:blank:]]//g;p;}') || lme_refuse {{ code }} "{{ what }} unreadable for ${{ var }}"
printf '%s\n' "${{ out }}" | {{ x(bs, 'grep') }} -E -q -- {{ shq('^(' ~ w.g ~ ')$') }} || lme_refuse {{ code }} "{{ what }} for ${{ var }} is not a canonical decimal: '${{ out }}'"
{%- endmacro -%}

{%- macro storage_check(bs, ctl, var, need) -%}
{% set need = int_word(need, 'storage_check need') %}
{{ df_value(bs, ctl, var, 'avail', '_avail', 'RH-SEED-STORAGE', 'free space') }}
[ "$_avail" -ge {{ need }} ] || lme_refuse RH-SEED-STORAGE "free $_avail < required {{ need }} bytes at ${{ var }}"
{%- endmacro -%}

{#- ---- WORK-ROOT admission (profile controller.bootstrap.work_roots.admission): the work root in ${var} is not under a
     refused prefix, not on a refused filesystem type, and has the declared free bytes AND free inodes ---- -#}
{%- macro work_root_check(bs, ctl, var) -%}
{% set a = bs.work_roots.admission %}
case "${{ var }}/" in
  {% for p in a.refused_prefixes %}{{ shq(p) }}*{% if not loop.last %}|{% endif %}{% endfor %}) lme_refuse {{ a.refusal }} "work root ${{ var }} is under a refused prefix ({{ a.refused_prefixes | join(' ') }})" ;;
esac
_fst=$({{ x(bs, 'stat') }} -f -c %T -- "${{ var }}") || lme_refuse {{ a.refusal }} "filesystem type unreadable for work root ${{ var }}"
case "$_fst" in
  {% for t in a.refused_fs_types %}{{ shq(t) }}{% if not loop.last %}|{% endif %}{% endfor %}) lme_refuse {{ a.refusal }} "work root ${{ var }} is on $_fst (refused: {{ a.refused_fs_types | join(' ') }})" ;;
esac
{{ storage_check(bs, ctl, var, a.free_bytes_min) }}
{{ df_value(bs, ctl, var, 'iavail', '_iavail', a.refusal, 'free inodes of work root') }}
[ "$_iavail" -ge {{ int_word(a.free_inodes_min, 'work_roots.admission.free_inodes_min') }} ] || lme_refuse {{ a.refusal }} "free inodes $_iavail < required {{ int_word(a.free_inodes_min, 'work_roots.admission.free_inodes_min') }} at work root ${{ var }}"
{%- endmacro -%}

{#- the declared sub-root dirs of a work root (relative), the ONE list behind admission and preparation -#}
{%- macro work_dirs(bs) -%}
{%- set w = bs.work_roots -%}
{%- set ns = namespace(d=[]) -%}
{%- for s in w.run_env | map(attribute='sub') | unique(case_sensitive=true) -%}{%- set ns.d = ns.d + [w.sub_roots[s]] -%}{%- endfor -%}
{%- for e in w.run_env | selectattr('kind', 'equalto', 'dir') -%}{%- set ns.d = ns.d + [w.sub_roots[e.sub] ~ '/' ~ e.rel] -%}{%- endfor -%}
{%- for r in [w.engine_storage_conf.graphroot_rel, w.engine_storage_conf.runroot_rel, w.engine_containers_conf.image_copy_tmp_rel] -%}{%- set ns.d = ns.d + [w.sub_roots.engine_storage ~ '/' ~ r] -%}{%- endfor -%}
{{ ns.d | join('\n') }}
{%- endmacro -%}

{#- ---- WORKSPACE ANCHOR + STORAGE ADMISSION (codex 143844 RH-WORKSPACE-ANCHOR, RH-STORAGE-ADMISSION-ORDER,
     RH-ENGINE-CONFIG-CUSTODY): runs after the budget scope and BEFORE root creation, the root lock, any prune, log
     write, sub-root creation or install, in apply / verify / run / run-local (purge exempt). ---- -#}
{%- macro admit_storage(bs, ctl, rlm) -%}
{% set wr = bs.work_roots %}
{% set cb = wr.checkout_binding %}
{% set L = bs.layout %}
{% set rr = wr.root_rel %}
if [ "$MODE" != purge ]; then
  if [ "$MODE" = run ] || [ "$MODE" = {{ rlm }} ]; then
    case "$R" in */{{ shq(rr) }}/*) : ;; *) lme_refuse {{ cb.refusal }} "$MODE needs a root under <checkout>/{{ rr }}/: $R" ;; esac
    W=${R%/{{ shq(rr) }}/*}/{{ shq(rr) }}
    _co=${W%/*}
    [ -n "$_co" ] || lme_refuse {{ cb.refusal }} "the work root $W has no checkout parent"
{# records-custody-lease-01 (codex-tick782 OPEN-S27-SAME-UID, 783 :31-34): the custody READ lease on the D2 checkout,
   before the first admission digest; never closed at an exec line, so every descendant holds it. #}
{% set xl = bs.source_admission.custody_lease %}
{% set xk = bs.source_admission.checkout_custody %}
    exec {{ xl.fds.checkout }}<"$_co" || lme_refuse {{ xl.refusals.open }} "$_co" {{ shq(xl.texts.open) }}
    {{ x(bs, xl.tool) }} {{ xl.flags.read }} {{ xl.flags.nonblocking }} {{ xl.fds.checkout }} || lme_refuse {{ bs.lock.busy }} "$_co" {{ shq(xl.texts.busy_read) }}
    _xl_p=$({{ x(bs, xk.tools.mode) }} -c {{ shq(xk.stat_identity) }} -- "$_co") || lme_refuse {{ xl.refusals.identity }} "$_co" {{ shq(xl.texts.identity) }}
    _xl_d=$({{ x(bs, xk.tools.mode) }} -L -c {{ shq(xk.stat_identity) }} -- {{ shq(xl.fd_dir) }}/{{ xl.fds.checkout }}) || lme_refuse {{ xl.refusals.identity }} "$_co" {{ shq(xl.texts.identity) }}
    [ "$_xl_p" = "$_xl_d" ] || lme_refuse {{ xl.refusals.identity }} "$_co" {{ shq(xl.texts.identity) }}
    [ "$W" != "$HOME" ] && [ "$W" != "${HOME%/}" ] || lme_refuse {{ wr.admission.refusal }} "the work root $W is \$HOME"
    if [ "$MODE" = {{ rlm }} ]; then
      [ "$R" = "$W/"{{ shq(wr.sub_roots.toolchain) }} ] || lme_refuse {{ cb.refusal }} "{{ rlm }} needs --root exactly <checkout>/{{ rr }}/{{ wr.sub_roots.toolchain }}, not $R"
    fi
    # the checkout is the one this bundle was packaged from: bundle.json (bound to this seed's sha256) names it, and
    # the declared file's digest there equals its digest in the checkout
    _bm="${SELF%/*}/"{{ shq(bs.bundle.manifest_file) }}
    [ -f "$_bm" ] && [ ! -L "$_bm" ] || lme_refuse {{ cb.refusal }} "no bundle manifest next to the seed: $_bm"
    {{ x(bs, 'grep') }} -q -F "\"seed_sha256\": \"$SEED_SHA\"" -- "$_bm" || lme_refuse {{ cb.refusal }} "$_bm does not bind this seed"
    {{ x(bs, 'grep') }} -q -F "\"{{ cb.manifest_field_checkout }}\": \"$_co\"" -- "$_bm" || lme_refuse {{ cb.refusal }} "checkout $_co is not the checkout this bundle was packaged from ($_bm {{ cb.manifest_field_checkout }})"
    _cf="$_co/"{{ shq(cb.file_rel) }}
    [ -f "$_cf" ] && [ ! -L "$_cf" ] || lme_refuse {{ cb.refusal }} "checkout $_co has no regular {{ cb.file_rel }}"
    _cfs=$({{ x(bs, 'sha256sum') }} -- "$_cf") || lme_refuse {{ cb.refusal }} "cannot digest $_cf"
    {{ x(bs, 'grep') }} -q -F "\"{{ cb.file_rel }}  ${_cfs%% *}\"" -- "$_bm" || lme_refuse {{ cb.refusal }} "checkout $_co {{ cb.file_rel }} differs from the packaged source ($_bm)"
  else
    W=${R%/*}; [ -n "$W" ] || W=/
  fi
  [ -d "$W" ] && [ ! -L "$W" ] || lme_refuse {{ wr.admission.refusal }} "work root $W is not an existing real directory"
  lme_ancestry "$W/."
  {{ work_root_check(bs, ctl, 'W') | indent(2) }}
  _wdev=$({{ x(bs, 'stat') }} -c %d -- "$W") || lme_refuse {{ wr.admission.refusal }} "cannot stat work root $W"
  lme_dest "$R" d
{% for d in [L.generations_dir, L.abandoned_dir, L.check_dir, L.run_dir] %}
  lme_dest "$R/"{{ shq(d) }} d
{% endfor %}
{% for f in [L.root_marker, L.operations_log, L.active_file, bs.toolchain_receipt] %}
  lme_dest "$R/"{{ shq(f) }} f
{% endfor %}
  if [ "$MODE" = run ] || [ "$MODE" = {{ rlm }} ]; then
    for _wd in {% for d in (work_dirs(bs) | string).split('\n') %}"$W/"{{ shq(d) }} {% endfor %}"$W/"{{ shq(wr.sub_roots.run) }}{% for k, v in wr.runners | dictsort %} "$W/"{{ shq(wr.sub_roots.run ~ '/' ~ v) }}{% endfor %}; do
      lme_dest "$_wd" d
    done
{% for e in wr.run_env | selectattr('kind', 'in', ['engine_storage_conf', 'engine_containers_conf']) %}
    lme_dest "$W/"{{ shq(wr.sub_roots[e.sub] ~ '/' ~ e.rel) }} f
{% endfor %}
  fi
fi
{%- endmacro -%}

{#- ---- WORK-ROOT sub-roots of ${var} for `seed run`: each declared dir (no -p; a link refuses) and the rootless engine
     configs, published safely (mktemp in the admitted dir + mv -T; admit_storage already refused a linked or foreign
     existing config) ---- -#}
{%- macro work_root_prepare(bs, var) -%}
{% set w = bs.work_roots %}
for _wd in {% for d in (work_dirs(bs) | string).split('\n') %}"${{ var }}/"{{ shq(d) }}{% if not loop.last %} {% endif %}{% endfor %}; do
  [ ! -L "$_wd" ] || lme_refuse {{ w.admission.refusal }} "$_wd is a link"
  [ -d "$_wd" ] || {{ x(bs, 'mkdir') }} -m 0700 -- "$_wd" || lme_refuse {{ w.admission.refusal }} "cannot create $_wd"
  lme_dest "$_wd" d
done
{% for e in w.run_env | selectattr('kind', 'in', ['engine_storage_conf', 'engine_containers_conf']) %}
_cd="${{ var }}/"{{ shq(w.sub_roots[e.sub]) }}
_cn="$_cd/"{{ shq(e.rel) }}
lme_dest "$_cn" f
_ct=$({{ x(bs, 'mktemp') }} "$_cd/."{{ shq(e.rel) }}".XXXXXXXX") || lme_refuse {{ w.admission.refusal }} "cannot create a temp file in $_cd"
{% if e.kind == 'engine_storage_conf' %}
printf '[storage]\nrunroot = "%s"\ngraphroot = "%s"\n' "${{ var }}/"{{ shq(w.sub_roots.engine_storage ~ '/' ~ w.engine_storage_conf.runroot_rel) }} "${{ var }}/"{{ shq(w.sub_roots.engine_storage ~ '/' ~ w.engine_storage_conf.graphroot_rel) }} > "$_ct" \
{% else %}
printf '[engine]\nimage_copy_tmp_dir = "%s"\n' "${{ var }}/"{{ shq(w.sub_roots.engine_storage ~ '/' ~ w.engine_containers_conf.image_copy_tmp_rel) }} > "$_ct" \
{% endif %}
  && {{ x(bs, 'mv') }} -f -T -- "$_ct" "$_cn" || { {{ x(bs, 'rm') }} -f -- "$_ct"; lme_refuse {{ w.admission.refusal }} "cannot publish $_cn"; }
{% endfor %}
{%- endmacro -%}

{#- the run_env words (NAME="<work root>/<sub>/<rel>") appended to the managed env of `seed run` -#}
{%- macro work_env(bs, var) -%}
{%- set sep = env_pair_sep(bs) | string -%}
{% for e in bs.work_roots.run_env %}{{ e.name }}{{ sep }}"${{ var }}/"{{ shq(bs.work_roots.sub_roots[e.sub] ~ '/' ~ e.rel) }}{% if not loop.last %} {% endif %}{% endfor %}
{%- endmacro -%}

{#- ---- S4 retention: keep the newest keep-1 seed scratch dirs (names of the declared mktemp shape) before a new one
     is created. A matching name that is not an owned real directory refuses; other names (verify.log, receipts)
     are neither counted nor touched. Removal is logged. Runs only under the exclusive root lock. ---- -#}
{%- macro prune_dir(bs, dexpr, rel, keep) -%}
_pd={{ dexpr }}; _n=0
for _e in "$_pd"/* "$_pd"/.[!.]* "$_pd"/..?*; do
  [ -e "$_e" ] || [ -L "$_e" ] || continue
  _b=${_e##*/}
  case "$_b" in {{ bs.run_retention.name_case }}) : ;; *) continue ;; esac
  {#- route op1p (C1 SR922f; s43 run_retention texts / text_codes :4514-4518): the declared code and text -#}
  [ ! -L "$_e" ] && [ -d "$_e" ] && [ "$({{ x(bs, 'stat') }} -c %u -- "$_e")" = "$_uid" ] || lme_refuse {{ bs.run_retention.text_codes.entry_not_owned }} {{ diag_text(bs.run_retention, 'entry_not_owned', {}, {'path': '$_e'}) }}
  _n=$((_n + 1))
done
{# route op1q (HOLE-SEAT-COERCION-FILTER-SWEEP): keep (layout.check_retention.keep r51 :4405 / run_retention.keep r51 :4404, both int_range min 1; route op1r GUARDED)
   is admitted by int_word and the shell does the arithmetic: _n - (keep - 1) = _n - keep + 1 (no int filter) #}
_drop=$((_n - {{ int_word(keep, 'prune_dir keep') }} + 1))
for _e in "$_pd"/*; do
  [ "$_drop" -gt 0 ] || break
  case "${_e##*/}" in {{ bs.run_retention.name_case }}) : ;; *) continue ;; esac
  {#- route op1o: an unmeasured size (du failed, no digits) is REPORTED, never counted as 0 bytes (run_retention
     .max_bytes_each: "reported (not silently kept)"); retention itself is unchanged. route op1p (codex 928
     ROUTE_FAILED_SIZE_STATUS): du's exit status is tested BEFORE its stdout is read; a nonzero status is unmeasured
     even when it printed digits (a partial count is never a measurement). route op1p (C1 SR922f; s43 run_retention
     .size_report :4506-4511, texts :4514-4517): the du arguments are measure_args; measured = status_zero and
     leading_decimal, unmeasured = status_nonzero or no_leading_decimal, compare greater_than_max_bytes_each, stream
     stderr are the rule this block implements (any other word is a render error); the texts are the declared ones #}
{% set sr = bs.run_retention.size_report %}
{% if (sr.measured | sort | list) != ['leading_decimal', 'status_zero'] or (sr.unmeasured | sort | list) != ['no_leading_decimal', 'status_nonzero'] or sr.compare != 'greater_than_max_bytes_each' or sr.stream != 'stderr' %}{{ sr['run_retention.size_report: a rule word this seed does not implement'].render_error }}{% endif %}
  if _s=$({{ x(bs, 'du') }}{% for a in sr.measure_args %} {{ shq(a) }}{% endfor %} "$_e"); then _s=${_s%%[!0-9]*}; else _s=''; fi
  case "$_s" in
    '') printf '%s\n' {{ diag_text(bs.run_retention, 'unmeasured', {}, {'path': '$_e'}) }} >&2 ;;
    *) [ "$_s" -le {{ int_word(bs.run_retention.max_bytes_each, 'run_retention.max_bytes_each') }} ] || printf '%s\n' {{ diag_text(bs.run_retention, 'oversize', {}, {'bytes': '$_s', 'path': '$_e'}) }} >&2 ;;
  esac
{# records-custody-lease-02: a directory leased by a running reader, or holding a live or unresolved consumption
   record, is never pruned. #}
{% set xl = bs.source_admission.custody_lease %}
  exec {{ xl.fds.run }}<"$_e" || lme_refuse {{ xl.refusals.open }} "$_e" {{ shq(xl.texts.open) }}
  {{ x(bs, xl.tool) }} {{ xl.flags.write }} {{ xl.flags.nonblocking }} {{ xl.fds.run }} || lme_refuse {{ bs.lock.busy }} "$_e" {{ shq(xl.texts.busy_write) }}
  lme_consume_check "$_e" '*' || lme_refuse {{ bs.lock.busy }} "$_e" {{ shq(xl.texts.consuming) }}
  {{ x(bs, 'chmod') }} -R u+w -- "$_e" && {{ x(bs, 'rm') }} -rf --one-file-system -- "$_e" || lme_refuse RH-SEED-STORAGE "cannot prune $_e"
  exec {{ xl.fds.run }}<&-
  lme_log pruned "{{ rel }}/${_e##*/}"
  _drop=$((_drop - 1))
done
{%- endmacro -%}

{#- ---- artifacts: presence of EVERY file first, then EVERY digest; each refusal names all offenders ---- -#}
{%- macro artifact_rows(bs, lock) -%}
