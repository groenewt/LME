  {{ x(bs, 'cmp') }} -s -- "$R/{{ bs.toolchain_receipt }}" "$G/{{ bs.layout.receipts_dir }}/toolchain.json" || lme_refuse RH-SEED-GENERATION-DRIFT 'published toolchain receipt differs from the sealed generation receipt'
}
lme_publish_active() {
  _t=$({{ x(bs, 'mktemp') }} "$R/{{ bs.layout.publish_tmp_prefix }}XXXXXXXX") || lme_refuse RH-SEED-STORAGE 'cannot create a publication temp file'
  {{ x(bs, 'cat') }} -- "$G/{{ bs.layout.receipts_dir }}/toolchain.json" > "$_t" && {{ x(bs, 'mv') }} -f -- "$_t" "$R/{{ bs.toolchain_receipt }}" || lme_refuse RH-SEED-STORAGE 'cannot publish the toolchain receipt'
  _t=$({{ x(bs, 'mktemp') }} "$R/{{ bs.layout.publish_tmp_prefix }}XXXXXXXX") || lme_refuse RH-SEED-STORAGE 'cannot create a publication temp file'
  printf '%s\n' "$GEN_ID" > "$_t" && {{ x(bs, 'mv') }} -f -- "$_t" "$R/{{ bs.layout.active_file }}" || lme_refuse RH-SEED-STORAGE 'cannot publish the active generation'
}
lme_log() { printf '%s %s %s\n' "$1" "$OP_ID" "$2" >> "$R/{{ bs.layout.operations_log }}" || lme_refuse RH-SEED-STORAGE 'cannot append the operations log'; }
