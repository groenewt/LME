{%- import 'macros/controller_seed.j2' as s -%}
{%- import 'macros/genesis_entry.j2' as ge -%}

{#- the custody declaration node -#}
{%- macro cu(bs) -%}{{ bs.genesis.initializer.custody | tojson }}{%- endmacro -%}

{#- render-time refusal of an undeclared tool use (the custody tool list is the whole tool set of the artifact) -#}
{%- macro tool_ok(bs, k) -%}
{%- set c = bs.genesis.initializer.custody -%}
{%- if c.tool_argv[k][0] not in c.tools or c.tool_argv[k][0] not in bs.os_tools -%}{{ c['undeclared custody tool ' ~ c.tool_argv[k][0]].render_error }}{%- endif -%}
{%- endmacro -%}

{#- one declared tool vector as shell words: the admitted absolute path, then each declared word single-quoted -#}
{%- macro tv(bs, k) -%}
{%- set c = bs.genesis.initializer.custody -%}
{{ tool_ok(bs, k) }}{{ s.x(bs, c.tool_argv[k][0]) }}{% for w in c.tool_argv[k][1:] %} {{ s.shq(w) }}{% endfor %}
{%- endmacro -%}

{#- the refusal function: the seed vocabulary + the caller's role codes with their declared statuses -#}
{%- macro refusals(bs, c, st) -%}
{#- records-route-life-20 (lineage-rh p6-12 OW-612-ROUTE-02): the genesis_entry render_codes form (life6 :279-284). The role
    codes and role statuses name the same roles; no code is a bootstrap.refusals code and no status is a
    bootstrap.refusals status; codes and statuses are each distinct. One exit status of the process then names one code;
    otherwise the render fails here -#}
{%- if (c.keys() | list | sort) != (st.keys() | list | sort)
   or c.values() | select('in', bs.refusals.keys() | list) | list | length != 0
   or st.values() | select('in', bs.refusals.values() | list) | list | length != 0
   or c.values() | unique | list | length != c | length
   or st.values() | unique | list | length != st | length -%}{{ st['custody: the role codes / statuses differ in roles, repeat, or equal a bootstrap.refusals code or status'].render_error }}{%- endif -%}
{%- set p = namespace(p=[]) -%}{%- for r, code in c | dictsort -%}{%- set p.p = p.p + [[code, st[r]]] -%}{%- endfor -%}
{{ s.refusal_fn(dict((bs.refusals | dictsort) + p.p)) }}
{%- endmacro -%}

{#- the phase log line (declared prefix) -#}
{%- macro phase_fn(bs, prefix) -%}
lme_phase() {
  printf '%s%s\n' {{ s.shq(prefix) }} "$1" >&2
}
{%- endmacro -%}

{#- K8: an argument value holding the line terminator refuses before any line matcher (needs _N from path_law) -#}
{%- macro value_ok(bs, c, t) -%}
lme_value_line_ok() {
  case "$1" in *"$_N"*) lme_refuse {{ c.usage }} {{ s.shq(t.value_line) }} ;; esac
}
{%- endmacro -%}

{#- K9: the sed script selecting the attribute-NAME field of each check-attr -z record (declared record shape) -#}
{%- macro attr_script(bs) -%}
{%- set g = bs.source_admission.git -%}
{%- set cd = bs.genesis.initializer.custody -%}
{%- set sw = cd.sed_words -%}
{%- if g.attr_record_fields is not defined or g.attr_record_order is not defined or g.attr_name_field is not defined -%}{{ g['custody: source_admission.git declares no attr_record_fields / attr_record_order / attr_name_field'].render_error }}{%- endif -%}
{%- if (g.attr_record_order | length) != g.attr_record_fields or (g.attr_record_order | select('equalto', g.attr_name_field) | list | length) != 1 -%}{{ g['custody: attr_record_order is not the admitted check-attr ordering with exactly one ' ~ g.attr_name_field ~ ' field'].render_error }}{%- endif -%}
{%- set ap = namespace(i=0) -%}{%- for f in g.attr_record_order -%}{%- if f == g.attr_name_field -%}{%- set ap.i = loop.index -%}{%- endif -%}{%- endfor -%}
{{ ap.i ~ sw.step ~ g.attr_record_fields ~ sw.print }}
{%- endmacro -%}

{#- PATH LAW: _S / _N from the declared grammar; lme_rel_ok and lme_admit_abs (c.usage / t.path_arg) -#}
{%- macro path_law(bs, c, t) -%}
{% set gr = bs.source_admission.rel_path_grammar %}
_S={{ s.shq(gr.separator) }}
_N={{ s.shq(gr.terminator) }}
lme_rel_ok() {
  case "$1" in *"$_N"*) return 1 ;; esac
  printf '%s%s' "$1" "$_N" | {{ tv(bs, 'grep_line') }} {{ s.shq(gr.pattern) }} || return 2
  case "$_S$1$_S" in{% for x in gr.refused_components %} *"$_S"{{ s.shq(x) }}"$_S"*{% if not loop.last %} |{% endif %}{% endfor %}) return 2 ;; esac
  return 0
}
lme_admit_abs() {
  case "$1" in "$_S"*) : ;; *) lme_refuse {{ c.usage }} {{ s.shq(t.path_arg) }} "$1" ;; esac
  lme_rel_ok "${1#"$_S"}" || lme_refuse {{ c.usage }} {{ s.shq(t.path_arg) }} "$1"
}
{%- endmacro -%}

{#- POSITIONAL USAGE: exactly the declared params, in the declared order (custody.params); each becomes _a_<param> -#}
{%- macro usage(bs, c, t) -%}
{% set cd = bs.genesis.initializer.custody %}
[ $# -eq {{ cd.params | length }} ] || lme_refuse {{ c.usage }} {{ s.shq(t.params) }}
{% for p in cd.params %}
_a_{{ p }}=${{ '{' ~ loop.index ~ '}' }}
{% endfor %}
{%- endmacro -%}

{#- every custody tool: executable, its declared identity sha256 (computed by the declared digest vector), then the
    declared known answers of the tools that have one (the digest tool's own circularity is closed by its answer and
    by MAIN's independent admission of the D2 tool root, codex-tick630 OD-FR1-01) -#}
{%- macro tools_admit(bs, c, t) -%}
{% set cd = bs.genesis.initializer.custody %}
_badtool=''
{% for n in cd.tools | sort %}
[ -x {{ s.shq(bs.os_tools[n].path) }} ] && _d=$({{ tv(bs, 'digest') }} {{ s.shq(bs.os_tools[n].path) }}) && [ "${_d%% *}" = {{ s.shq(bs.os_tools[n].identity.sha256) }} ] || _badtool="$_badtool {{ n }}"
{% endfor %}
[ -z "$_badtool" ] || lme_refuse {{ c.base }} {{ s.shq(t.base_tool) }} "$_badtool"
{% for k in bs.os_tool_identity.known_answers if k.tool in cd.tools %}
[ "$(printf '%s' {{ s.shq(k.stdin) }} | {{ s.x(bs, k.tool) }})" = "$(printf '%s' {{ s.shq(k.stdout) }})" ] || lme_refuse {{ c.base }} {{ s.shq(t.base_tool) }} {{ s.shq(k.tool) }}
{% endfor %}
{%- endmacro -%}

{#- the declared git invocation over the admitted checkout "$CO" (source_admission.git; the env and git words of the
    admitted tool roles) -#}
{%- macro git_fn(bs) -%}
{% set g = bs.source_admission.git %}
{% set tr = bs.source_admission.tool_roles %}
lme_git() { {{ s.x(bs, tr.env) }} {{ s.shq(g.env_clear) }}{% for p in g.env_pairs %} {{ s.shq(p) }}{% endfor %} {{ s.x(bs, tr.git) }}{% for w in g.global %} {{ s.shq(w) }}{% endfor %} "$CO" "$@"; }
{%- endmacro -%}

{#- HEAD == "$ED", the declared object format, no refused git configuration, a clean checkout (K6); binds _tr (the
    edition's tree). The caller's c.source / t.source_status refuse a non-clean status. -#}
{%- macro source_checks(bs, c, t) -%}
{% set sa = bs.source_admission %}
{% set g = sa.git %}
{% if g.rev_verify is not defined or g.tree_peel is not defined %}{{ sa['custody: source_admission.git declares no rev_verify / tree_peel'].render_error }}{% endif %}
_head=$(lme_git{% for w in g.head %} {{ s.shq(w) }}{% endfor %}) || lme_refuse {{ sa.refusals.git.edition }} {{ s.shq(sa.texts.git.edition) }}
[ "$_head" = "$ED" ] || lme_refuse {{ sa.refusals.git.edition }} {{ s.shq(sa.texts.git.edition) }} "$_head"
_of=$(lme_git{% for w in g.object_format_argv %} {{ s.shq(w) }}{% endfor %}) && [ "$_of" = {{ s.shq(g.object_format) }} ] || lme_refuse {{ sa.refusals.git.object_format }} {{ s.shq(sa.texts.git.object_format) }}
_cfg=$(lme_git{% for w in g.config %} {{ s.shq(w) }}{% endfor %} | {{ tv(bs, 'grep_refused') }} {{ s.shq(g.config_refused_regex) }} | {{ tv(bs, 'first_byte') }})
[ -z "$_cfg" ] || lme_refuse {{ sa.refusals.git.config }} {{ s.shq(sa.texts.git.config) }}
_st=$(lme_git{% for w in g.status %} {{ s.shq(w) }}{% endfor %} | {{ tv(bs, 'first_byte') }}) && [ -z "$_st" ] || lme_refuse {{ c.source }} {{ s.shq(t.source_status) }}
_tr=$(lme_git{% for w in g.rev_verify %} {{ s.shq(w) }}{% endfor %} "$ED"{{ s.shq(g.tree_peel) }}) || lme_refuse {{ sa.refusals.git.edition }} {{ s.shq(sa.texts.git.edition) }}
{%- endmacro -%}

{#- one admitted repository rel: grammar FIRST, then tracked / unstaged / unconverted / committed regular blob ==
    worktree bytes (source_admission.git argv), then its digest; prints '<sha256><two spaces><rel>' + terminator -#}
{%- macro admit_rel_fn(bs, c, t) -%}
{% set sa = bs.source_admission %}
{% set g = sa.git %}
lme_admit_rel() {
  lme_rel_ok "$1"; _ok=$?
  [ "$_ok" -ne 1 ] || lme_refuse {{ c.closure }} {{ s.shq(t.rel_newline) }}
  [ "$_ok" -eq 0 ] || lme_refuse {{ c.closure }} {{ s.shq(t.grammar) }} "$1"
  _p="$CO$_S$1"
  [ -f "$_p" ] && [ ! -L "$_p" ] || lme_refuse {{ c.closure }} {{ s.shq(t.member) }} "$1"
  _s=$(lme_git{% for w in g.status %} {{ s.shq(w) }}{% endfor %} {{ s.shq(g.end_of_options) }} "$1" | {{ tv(bs, 'first_byte') }}) || lme_refuse {{ sa.refusals.git.untracked }} {{ s.shq(sa.texts.git.untracked) }} "$1"
  [ -z "$_s" ] || lme_refuse {{ sa.refusals.git.staged_change }} {{ s.shq(sa.texts.git.staged_change) }} "$1"
  _a=$(lme_git{% for w in g.attributes %} {{ s.shq(w) }}{% endfor %} {{ s.shq(g.end_of_options) }} "$1" | {{ tv(bs, 'attr_values') }} {{ s.shq(attr_script(bs)) }} | {{ tv(bs, 'grep_attr') }}{% for x in g.conversion_attrs %} -e {{ s.shq(x) }}{% endfor %} | {{ tv(bs, 'first_byte') }})
  [ -z "$_a" ] || lme_refuse {{ sa.refusals.git.conversion }} {{ s.shq(sa.texts.git.conversion) }} "$1"
  _t=$(lme_git{% for w in g.tree %} {{ s.shq(w) }}{% endfor %} "$ED" {{ s.shq(g.end_of_options) }} "$1") || lme_refuse {{ sa.refusals.git.commit_bytes }} {{ s.shq(sa.texts.git.commit_bytes) }} "$1"
  _tm=${_t%% *}; _tt=${_t#* }; _tt=${_tt%% *}; _to=${_t#* * }; _to=${_to%%"{{ g.record.path }}"*}
  case "$_tm" in {{ g.blob.modes | map('tojson') | join('|') }}) : ;; *) lme_refuse {{ sa.refusals.git.commit_bytes }} {{ s.shq(sa.texts.git.commit_bytes) }} "$1" ;; esac
  [ "$_tt" = {{ s.shq(g.blob.type) }} ] && [ "${_t#*"{{ g.record.path }}"}" = "$1" ] || lme_refuse {{ sa.refusals.git.commit_bytes }} {{ s.shq(sa.texts.git.commit_bytes) }} "$1"
  _w=$(lme_git{% for w in g.worktree %} {{ s.shq(w) }}{% endfor %} {{ s.shq(g.end_of_options) }} "$1") || lme_refuse {{ sa.refusals.git.uncommitted }} {{ s.shq(sa.texts.git.uncommitted) }} "$1"
  [ "$_w" = "$_to" ] || lme_refuse {{ sa.refusals.git.uncommitted }} {{ s.shq(sa.texts.git.uncommitted) }} "$1"
  _h=$({{ tv(bs, 'digest') }} "$_p") || lme_refuse {{ c.closure }} {{ s.shq(t.member) }} "$1"
  printf '%s  %s%s' "${_h%% *}" "$1" "$_N"
}
{%- endmacro -%}

{#- a DATA-ONLY inventory file: regular, unlinked, invoker-owned, no group/other write, no execute / set-id / sticky
    bit, no adjacent auto-load location (genesis.entry.closure.inventory_adjacent_absent); prints its sha256 -#}
{%- macro admit_inv_fn(bs, c, t) -%}
{% set cl = bs.genesis.entry.closure %}
{% set cd = bs.genesis.initializer.custody %}
lme_admit_inv() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ "$({{ tv(bs, 'owner') }} "$1")" = "$_uid" ] || lme_refuse {{ c.inventory }} {{ s.shq(t.inventory_file) }} "$1"
  case "$({{ tv(bs, 'symbolic') }} "$1")" in {{ cd.mode_globs.group_or_other_write | join('|') }}) lme_refuse {{ c.inventory }} {{ s.shq(t.inventory_file) }} "$1" ;; esac
  case "$({{ tv(bs, 'symbolic') }} "$1")" in {{ cd.mode_globs.exec_or_special | join('|') }}) lme_refuse {{ c.inventory }} {{ s.shq(t.inventory_exec) }} "$1" ;; esac
  _id=${1%"$_S"*}; [ -n "$_id" ] || _id=$_S
{% for x in cl.inventory_adjacent_absent %}
  [ ! -e "$_id$_S"{{ s.shq(x) }} ] && [ ! -L "$_id$_S"{{ s.shq(x) }} ] || lme_refuse {{ c.closure }} {{ s.shq(t.autoload) }} "$_id$_S"{{ s.shq(x) }}
{% endfor %}
  _d=$({{ tv(bs, 'digest') }} "$1") || lme_refuse {{ c.inventory }} {{ s.shq(t.inventory_file) }} "$1"
  printf '%s' "${_d%% *}"
}
{%- endmacro -%}

{#- GEN-PREEXEC-CLOSURE of ONE playbook (members + documents + its declared importer closure + itself; then its
    generated-play obligations with their body digests; then the auto-load locations next to it), accumulated in
    _cs (sha256sum --check rows, each framed by the declared terminator) -- the closure the C1 dispatch / importer row
    of the playbook declares (PROVISIONAL-ON-C1 for the N1 row) -#}
{%- macro closure_playbook(bs, c, t, pb) -%}
{% set sa = bs.source_admission %}
{% set gr = sa.rel_path_grammar %}
{% set cl = bs.genesis.entry.closure %}
{% set cs = cl.case_sensitive %}
{% if pb not in sa.importers or pb not in sa.importer_obligations or sa.importer_obligations[pb] is not mapping %}{{ sa['custody: the playbook ' ~ pb ~ ' has no declared importer closure / obligations row'].render_error }}{% endif %}
_cs=''
{% for r in (sa.members_rel + (sa.document_rels | dictsort(case_sensitive=cs) | map('last') | list) + sa.importers[pb] + [pb]) | unique(case_sensitive=cs) | sort(case_sensitive=cs) %}
_l=$(lme_admit_rel {{ s.shq(r) }}) || exit $?
_cs="$_cs$_l$_N"
{% endfor %}
{% for gr_, pairs in sa.importer_obligations[pb] | dictsort(case_sensitive=cs) %}
_l=$(lme_admit_rel {{ s.shq(gr_) }}) || exit $?
_cs="$_cs$_l$_N"
{% for pr in pairs %}
_l=$(lme_admit_rel {{ s.shq(pr[0]) }}) || exit $?
[ "${_l%% *}" = {{ s.shq(pr[1]) }} ] || lme_refuse {{ c.closure }} {{ s.shq(t.member) }} {{ s.shq(pr[0]) }}
_cs="$_cs$_l$_N"
{% endfor %}{% endfor %}
{% set pd = (pb.split(gr.separator))[:-1] | join(gr.separator) %}
{% for x in cl.adjacent_absent %}
[ ! -e "$CO$_S"{{ s.shq(pd ~ gr.separator ~ x) }} ] && [ ! -L "$CO$_S"{{ s.shq(pd ~ gr.separator ~ x) }} ] || lme_refuse {{ c.closure }} {{ s.shq(t.autoload) }} {{ s.shq(pd ~ gr.separator ~ x) }}
{% endfor %}
{% for r in cl.role_rel %}{% for x in cl.role_absent %}
[ ! -e "$CO$_S"{{ s.shq(r ~ gr.separator ~ x) }} ] && [ ! -L "$CO$_S"{{ s.shq(r ~ gr.separator ~ x) }} ] || lme_refuse {{ c.closure }} {{ s.shq(t.autoload) }} {{ s.shq(r ~ gr.separator ~ x) }}
{% endfor %}{% endfor %}
{% for x in cl.system_absent %}
[ ! -e {{ s.shq(x) }} ] && [ ! -L {{ s.shq(x) }} ] || lme_refuse {{ c.closure }} {{ s.shq(t.autoload) }} {{ s.shq(x) }}
{% endfor %}
{% for pdir in cl.plugin_dirs %}
{% set pf = pdir.rel ~ gr.separator %}
{% set pn = namespace(m=[]) %}{% for m in sa.members_rel if m.startswith(pf) and gr.separator not in m[pf | length:] %}{% set pn.m = pn.m + [m[pf | length:]] %}{% endfor %}
for _f in "$CO$_S"{{ s.shq(pdir.rel) }}"$_S"*{{ s.shq(pdir.suffix) }}; do
  [ -e "$_f" ] || [ -L "$_f" ] || continue
  case "${_f##*"$_S"}" in {% for m in pn.m %}{{ s.shq(m) }}) : ;; {% endfor %}*) lme_refuse {{ c.closure }} {{ s.shq(t.plugin) }} "$_f" ;; esac
done
{% endfor %}
{%- endmacro -%}

{#- the AUTHORING builder A (codex-tick630 OD-FR1-04 / tick633: independently admitted by MAIN's seed apply / verify;
    the a276 seed run restriction unchanged): its generation id from the PINNED seed digest (authoring.seed_sha256)
    through the seed's OWN generation_id macro, its root under the authoring sub root; publication check READ-ONLY
    (lme_verify_published: active pointer and published receipt == the sealed generation receipt). Content
    verification (tree, smoke) is MAIN's independent seed verify, never run here (it writes check dirs under A's root).
    Binds G GEN_ID BX BP _bxd _tmd (the step record's builder fields). -#}
{%- macro builder_bind(bs, ctl, c, t) -%}
{% set b = bs.genesis.builder %}
{% set gr = bs.source_admission.rel_path_grammar %}
W="$CO$_S"{{ s.shq(bs.work_roots.root_rel) }}
R="$W$_S"{{ s.shq(bs.work_roots.sub_roots[b.authoring.root.sub]) }}
SEED_SHA={{ s.shq(b.authoring.seed_sha256) }}
{{ s.generation_id(bs, ctl) }}
{{ s.verify_fns(bs, ctl) }}
[ -d "$G" ] && [ ! -L "$G" ] || lme_refuse {{ c.builder }} {{ s.shq(t.builder_pin) }} "$G"
lme_verify_published
BX="$G$_S"{{ s.shq(bs.layout.gen_dirs[b.executable.gen_dir] ~ gr.separator ~ b.executable.rel) }}
BP="$G$_S"{{ s.shq(bs.layout.gen_dirs[b.python.gen_dir] ~ gr.separator ~ b.python.rel) }}
_bxd=$({{ tv(bs, 'digest') }} "$BX") || lme_refuse {{ c.builder }} {{ s.shq(t.builder) }} "$BX"
_tmd=$({{ tv(bs, 'digest') }} "$G$_S"{{ s.shq(bs.layout.receipts_dir ~ gr.separator ~ bs.layout.tree_manifest_file) }}) || lme_refuse {{ c.builder }} {{ s.shq(t.builder) }} "$G"
{%- endmacro -%}

{#- PREPARATION (genesis.launch.prepare): the work root dirs only if absent (owned real dirs, prepare mode), the stage
    dir, then the act dir EXCLUSIVELY (one mkdir, no parents: an existing act refuses) and its declared dirs; the
    evidence dir of the act likewise. Binds _sr (stage root) and _ev (evidence dir). -#}
{%- macro prepare(bs, c, t, stage) -%}
{% set l = bs.genesis.launch %}
{% set gr = bs.source_admission.rel_path_grammar %}
{% set wr = bs.work_roots %}
_T="$W$_S"{{ s.shq(wr.sub_roots[l.stage_root.sub] ~ gr.separator ~ l.stage_root.rel) }}
{% set es = l.step_record.emit.evidence_sub %}
_V="$W$_S"{{ s.shq(wr.sub_roots[es] ~ gr.separator ~ l.stage_root.rel) }}
for _p in "$W" "$W$_S"{{ s.shq(wr.sub_roots[l.stage_root.sub]) }} "$_T" "$W$_S"{{ s.shq(wr.sub_roots[es]) }} "$_V" "$_T$_S"{{ s.shq(stage) }} "$_V$_S"{{ s.shq(stage) }}; do
  [ -e "$_p" ] || [ -L "$_p" ] || {{ tv(bs, 'mkdir') }} {{ s.shq(l.prepare.mode) }} {{ s.shq(bs.genesis.initializer.custody.end_of_options) }} "$_p" || lme_refuse {{ c.prepare }} {{ s.shq(t.dir) }} "$_p"
  [ -d "$_p" ] && [ ! -L "$_p" ] && [ "$({{ tv(bs, 'owner') }} "$_p")" = "$_uid" ] || lme_refuse {{ c.prepare }} {{ s.shq(t.dir) }} "$_p"
done
_sr="$_T$_S"{{ s.shq(stage) }}"$_S$ACT"
_ev="$_V$_S"{{ s.shq(stage) }}"$_S$ACT"
{{ tv(bs, 'mkdir') }} {{ s.shq(l.prepare.mode) }} {{ s.shq(bs.genesis.initializer.custody.end_of_options) }} "$_sr"{% for d in l.prepare.dirs_rel_to_stage_root if d not in l.prepare.exclusive and d not in bs.genesis.initializer.custody.parent_rels %} "$_sr$_S"{{ s.shq(d) }}{% endfor %} "$_ev" || lme_refuse {{ c.prepare }} {{ s.shq(t.act_dir) }} {{ s.shq(stage) }}
{%- endmacro -%}

{#- ONE typed JSON stage input word {<name>: <value>}: value composed by the caller as JSON text (printf-safe) -#}
{%- macro input_word(name, json_fmt) -%}
{{ s.shq('{' ~ (name | tojson) ~ ': ' ~ json_fmt ~ '}') }}
