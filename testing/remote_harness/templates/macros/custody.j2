{%- if ls.runtime[loop.index0] -%}
{%- if row[loop.index0] is not string -%}{%- set lb.bad = true -%}{%- endif -%}
{%- set ci.cells = ci.cells + [(f | tojson) ~ ': ' ~ (cm.runtime_mark | tojson)] -%}{%- set rp.order = rp.order + [row[loop.index0]] -%}
