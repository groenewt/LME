{%- set lb = namespace(bad=(k in cm.fields or k in rr or ls is not mapping)) -%}
{%- if not lb.bad -%}
{%- if (ls.keys() | list | sort) != (['fields', 'runtime', 'rows'] | sort) or ls.fields is string or ls.fields is mapping or ls.fields is not sequence
      or ls.fields | reject('string') | list | length != 0 or (ls.fields | unique | list | length) != (ls.fields | length)
      or ls.runtime is string or ls.runtime is mapping or ls.runtime is not sequence or (ls.runtime | length) != (ls.fields | length)
