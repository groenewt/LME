{% set f_hd = hd ~ lt %}
{% set f_seq = fm.sequence_item ~ fm.placeholder ~ lt %}
{% set f_ikv = fm.indent ~ kv ~ lt %}
{% set f_ihd = fm.indent ~ hd ~ lt %}
{% set f_iseq = fm.indent ~ fm.sequence_item ~ fm.placeholder ~ lt %}
{% set f_env = f_hd ~ f_ikv ~ f_ihd %}
{% set f_src = hv ~ fo ~ (([kv] * 4) | join(fs)) ~ fc ~ lt %}
{% set f_inv = fm.indent ~ fm.sequence_item ~ fo ~ (([kv] * 3) | join(fs)) ~ fc ~ lt %}
{% set f_bld = hv ~ fo ~ (([kv] * 5) | join(fs)) ~ fc ~ lt %}
{% set f_cap = hv ~ fo ~ kv ~ fs ~ hv ~ fo ~ (([kv] * 2) | join(fs)) ~ fc ~ fc ~ lt %}
{% set f_out = hv ~ fo ~ hv ~ fo ~ (([kv] * 2) | join(fs)) ~ fc ~ fc ~ lt %}
{% set f_onone = hv ~ fo ~ kv ~ fc ~ lt %}
{% set f_ibr = fm.indent ~ hv ~ fo ~ (([kv] * 2) | join(fs)) ~ fc ~ lt %}
{% set f_xv = fm.sequence_item ~ fo ~ (([kv] * 2) | join(fs)) ~ fc ~ lt %}
{% if (cfi.keys() | list | sort) != (cf.keys() | list | sort) %}{{ cf['step_record: the capture fidelity is not exactly the declared capture_fidelity words'].render_error }}{% endif %}
{% if l.step_record.capture_evidence.shapes.complete != l.step_record.context.shape_words.boolean or cfi.complete is not boolean or cfi.complete not in fm.boolean %}{{ cf['step_record: the capture fidelity complete is not a value of its declared capture shape'].render_error }}{% endif %}
{#- K17: the emitted top-level words in emission order; exactly the 18 fields words (== emit.keys keys), once each;
    capture exactly {reference, fidelity}; outputs a declared row of this stage ({path, sha256} words when a mapping) -#}
{% set top = [k.schema, k.format, k.flow, k.stage, k.act, k.stage_root, k.argv, k.cwd, k.env.key, k.source.key, k.config.key, k.extra_vars.key, k.builder.key, k.started_at_utc, k.ended_at_utc, k.capture.key, k.exit_status, k.outputs.key] %}
{% if (top | unique | list | length) != (top | length) or (top | sort) != (f.keys() | list | sort) or (top | sort) != (k.keys() | list | sort) %}{{ f['step_record: the emitted top-level words are not exactly the declared step_record.fields words'].render_error }}{% endif %}
{% if f[k.capture.key] is not mapping or (f[k.capture.key].keys() | list | sort) != ([k.capture.reference, k.capture.fidelity.key] | sort) %}{{ f['step_record: the emitted capture words are not exactly the declared capture fields (OD-S14-RK-NESTED)'].render_error }}{% endif %}
{% if f[k.outputs.key] is not mapping or stage not in f[k.outputs.key] or (f[k.outputs.key][stage] is mapping and (f[k.outputs.key][stage].keys() | list | sort) != ([k.outputs.path, k.outputs.sha256] | sort)) %}{{ f['step_record: the stage ' ~ stage ~ ' has no declared outputs row of the emitted shape (OD-S14-RK-NESTED)'].render_error }}{% endif %}
_pr="$_ev$_S"{{ s.shq(l.step_record.files.record_staging) }}
_pd="$_ev$_S"{{ s.shq(l.step_record.files.record) }}
(set -C; {
  printf {{ s.shq(f_kv) }} {{ s.shq(k.schema) }} {{ s.shq(l.step_record.schema) }} {{ s.shq(k.format) }} {{ s.shq(l.step_record.format) }} {{ s.shq(k.flow) }} {{ s.shq(flow) }} {{ s.shq(k.stage) }} {{ s.shq(stage) }} {{ s.shq(k.act) }} "$(lme_yq "$ACT")" {{ s.shq(k.stage_root) }} "$(lme_yq "$_sr")"
  printf {{ s.shq(f_hd) }} {{ s.shq(k.argv) }}
  for _w in "$@"; do printf {{ s.shq(eo) }} {{ s.shq(f_seq) }} "$(lme_yq "$_w")"; done
  printf {{ s.shq(f_kv) }} {{ s.shq(k.cwd) }} "$(lme_yq "$CO")"
  printf {{ s.shq(f_env) }} {{ s.shq(k.env.key) }} {{ s.shq(k.env.declaration) }} {{ s.shq(f.env.declaration) }} {{ s.shq(k.env.pairs) }}
  for _w in "$@"; do case "$_w" in {% for n in l.env.order %}{{ s.shq(n ~ '=') }}*{% if not loop.last %}|{% endif %}{% endfor %}) printf {{ s.shq(f_iseq) }} "$(lme_yq "$_w")" ;; esac; done
  printf {{ s.shq(f_src) }} {{ s.shq(k.source.key) }} {{ s.shq(k.source.checkout) }} "$(lme_yq "$CO")" {{ s.shq(k.source.commit) }} "$ED" {{ s.shq(k.source.tree) }} "$_tr" {{ s.shq(k.source.status) }} {{ s.shq(v.status_clean) }}
  printf {{ s.shq(f_hd) }} {{ s.shq(k.config.key) }}
  printf {{ s.shq(f_ikv) }} {{ s.shq(k.config.profile_rel) }} {{ s.shq(bs.source_admission.bootstrap_input.declaration_rel) }} {{ s.shq(k.config.profile_sha256) }} "$DS" {{ s.shq(k.config.inventory_kind) }} {{ s.shq(kind) }}
  printf {{ s.shq(f_ihd) }} {{ s.shq(k.config.inventory.key) }}
{% for r, slot in roles %}
  printf {{ s.shq(f_inv) }} {{ s.shq(k.config.inventory.role) }} {{ s.shq(r) }} {{ s.shq(k.config.inventory.path) }} "$(lme_yq "$_a_{{ slot }}")" {{ s.shq(k.config.inventory.sha256) }} "$_dg_{{ r }}"
{% endfor %}
{% if 'receipt' in kd %}
  printf {{ s.shq(f_ibr) }} {{ s.shq(k.config.binding_receipt.key) }} {{ s.shq(k.config.binding_receipt.path) }} "$(lme_yq "$RCP")" {{ s.shq(k.config.binding_receipt.sha256) }} "$_dg_{{ kd.receipt }}"
{% else %}
  printf {{ s.shq(f_ikv) }} {{ s.shq(k.config.binding_receipt.key) }} {{ s.shq(v.binding_receipt_none) }}
{% endif %}
  printf {{ s.shq(f_ikv) }} {{ s.shq(k.config.ansible_config_file) }} "$(lme_yq "$G$_S"{{ s.shq(bs.layout.config_file) }})"
{# records-b-ggen-cold-launch-13 (p6-16 OW-616-B-02): the extra_vars rows also carry each SUPPLIED and admitted
    lifecycle input of lv (name, raw value), in lv order after the xv rows; an absent one has no row (no default).
    extra_vars_empty only when xv is empty and no lifecycle input was supplied. -#}
{% if xv | length == 0 and lv | length == 0 %}
