{% for nm, w in xv %}
  printf {{ s.shq(eo) }} {{ s.shq(f_xv) }} {{ s.shq(k.extra_vars.name) }} {{ s.shq(nm) }} {{ s.shq(k.extra_vars.value) }} "$(lme_yq {{ w }})"
{% endfor %}
{% for n in lv %}
  [ -z "$_in_{{ n }}" ] || printf {{ s.shq(eo) }} {{ s.shq(f_xv) }} {{ s.shq(k.extra_vars.name) }} {{ s.shq(n) }} {{ s.shq(k.extra_vars.value) }} "$(lme_yq "$_iv_{{ n }}")"
{% endfor %}
{% if xv | length == 0 %}
  fi
{% endif %}
