{%- macro quote(r, value) -%}{{ r.quote.char ~ (value | string | replace(r.quote.char, r.quote.escape)) ~ r.quote.char }}{%- endmacro -%}
{%- macro assign(r, name, value) -%}{{ r.formats.assign.format(name=name, value=value) }}{%- endmacro -%}
{%- macro ref(r, name) -%}{{ r.formats.reference.format(name=name) }}{%- endmacro -%}
{%- macro positional(r, index) -%}{{ r.formats.positional.format(index=index) }}{%- endmacro -%}
{%- macro words(r, values) -%}{{ values | join(r.space) }}{%- endmacro -%}
{%- macro command(r, executable, args, operands) -%}{{ quote(r, executable) }}{% for a in args %}{{ r.space }}{{ quote(r, a) }}{% endfor %}{% for a in operands %}{{ r.space }}{{ a }}{% endfor %}{%- endmacro -%}
{%- macro sub(r, command) -%}{{ r.formats.command_substitution.format(command=command) }}{%- endmacro -%}
{%- macro test(r, args) -%}{{ r.formats.test.format(arguments=words(r, args)) }}{%- endmacro -%}
{%- macro refuse(r, code, local) -%}{{ words(r, [r.builtins['return'] if local else r.builtins.exit, code]) }}{%- endmacro -%}
{%- macro guarded(r, body, code, local) -%}{{ words(r, [body, r.operators['or'], refuse(r, code, local)]) }}{%- endmacro -%}
{%- macro chain(r, bodies, operator) -%}{{ bodies | join(r.space ~ operator ~ r.space) }}{%- endmacro -%}
{%- macro line(r, text) -%}{{ text ~ r.newline }}{%- endmacro -%}
