{%- macro publish(c, subject, publication, tools, sh) -%}
{%- set r = c.shell_render -%}{%- set v = r.variables -%}{%- set f = r.functions -%}
{%- for pair in [[v.root, subject.root], [v.sealed, publication.sealed], [v.active, publication.active], [v.pending, publication.pending], [v.expected, publication.sha256], [v.owner, publication.uid], [v.mode, c.file_stat_mode], [v.root_identity, publication.root_identity]] -%}
{{- sh.line(r, sh.assign(r, pair[c.zero], sh.quote(r, pair[c.one]))) -}}
{%- endfor -%}
{{- sh.line(r, sh.assign(r, v.root_now, sh.sub(r, sh.command(r, tools.stat.path, c.stat_args, [sh.ref(r, v.root)])))) -}}
{{- sh.line(r, sh.guarded(r, sh.test(r, [sh.ref(r,v.root_now),r.operators.equals,sh.ref(r,v.root_identity)]), c.refusal_rc, c.absent)) -}}
{{- sh.line(r, r.formats.function_open | replace(r.placeholders.function_name,f.verify_file)) -}}
{{- sh.line(r, sh.guarded(r, sh.chain(r,[sh.test(r,[r.tests['not'],r.tests.link,sh.positional(r,r.positionals.path)]),sh.test(r,[r.tests.file,sh.positional(r,r.positionals.path)])],r.operators['and']),c.refusal_rc,c.present)) -}}
{{- sh.line(r, sh.guarded(r, sh.assign(r,v.actual,sh.sub(r,sh.command(r,tools.stat.path,c.file_stat_args,[sh.positional(r,r.positionals.path)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r, sh.guarded(r, sh.test(r,[sh.ref(r,v.actual),r.operators.equals,sh.ref(r,v.owner) ~ sh.quote(r,c.identity_separator) ~ sh.ref(r,v.mode)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r, sh.guarded(r, sh.assign(r,v.actual,sh.sub(r,sh.command(r,tools.sha256sum.path,[c.path_terminator],[sh.positional(r,r.positionals.path)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r, sh.assign(r,v.actual,r.formats.suffix_remove | replace(r.placeholders.suffix_name,v.actual) | replace(r.placeholders.suffix_pattern,r.patterns.digest_suffix))) -}}
{{- sh.line(r, sh.guarded(r, sh.test(r,[sh.ref(r,v.actual),r.operators.equals,sh.ref(r,v.expected)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,r.formats.function_close) -}}
{{- sh.line(r,r.formats.function_open | replace(r.placeholders.function_name,f.same_root)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.actual,sh.sub(r,sh.command(r,tools.stat.path,c.stat_args,[sh.ref(r,v.root)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,v.actual),r.operators.equals,sh.ref(r,v.root_identity)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,r.formats.function_close) -}}
{{- sh.line(r,r.formats.function_open | replace(r.placeholders.function_name,f.sync_root)) -}}
{{- sh.line(r,sh.chain(r,[f.same_root,sh.command(r,tools.sync.path,c.sync_args,[sh.ref(r,v.root)])],r.operators['and'])) -}}
{{- sh.line(r,r.formats.function_close) -}}
{{- sh.line(r,r.formats.function_open | replace(r.placeholders.function_name,f.same_inode)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.sealed_inode,sh.sub(r,sh.command(r,tools.stat.path,c.inode_stat_args,[sh.ref(r,v.sealed)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.assign(r,v.active_inode,sh.sub(r,sh.command(r,tools.stat.path,c.inode_stat_args,[sh.ref(r,v.active)]))),c.refusal_rc,c.present)) -}}
{{- sh.line(r,sh.guarded(r,sh.test(r,[sh.ref(r,v.sealed_inode),r.operators.equals,sh.ref(r,v.active_inode)]),c.refusal_rc,c.present)) -}}
{{- sh.line(r,r.formats.function_close) -}}
{%- for name in [v.sealed,v.active,v.pending] -%}
{{- sh.line(r,r.formats.if_open.format(condition=sh.chain(r,[sh.test(r,[r.tests.exists,sh.ref(r,name)]),sh.test(r,[r.tests.link,sh.ref(r,name)])],r.operators['or']))) -}}
{{- sh.line(r,sh.guarded(r,sh.words(r,[f.verify_file,sh.ref(r,name)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{%- endfor -%}
{{- sh.line(r,r.formats.if_open.format(condition=sh.chain(r,[sh.test(r,[r.tests.file,sh.ref(r,v.sealed)]),sh.test(r,[r.tests.file,sh.ref(r,v.active)])],r.operators['and']))) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[f.same_inode,f.sync_root],r.operators['and']),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.command(r,r.builtins.printf,[c.status_format,c.unchanged_word],c.empty_list)) -}}
{{- sh.line(r,sh.words(r,[r.builtins.exit,c.success])) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,r.formats.if_open.format(condition=sh.test(r,[r.tests['not'],r.tests.file,sh.ref(r,v.sealed)]))) -}}
{{- sh.line(r,r.formats.if_open.format(condition=sh.test(r,[r.tests.file,sh.ref(r,v.active)]))) -}}
{{- sh.line(r,sh.guarded(r,sh.command(r,tools.ln.path,[c.path_terminator],[sh.ref(r,v.active),sh.ref(r,v.sealed)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats['else']) -}}
{{- sh.line(r,r.formats.if_open.format(condition=sh.test(r,[r.tests['not'],r.tests.file,sh.ref(r,v.pending)]))) -}}
{%- set create = sh.words(r,[sh.command(r,r.builtins.printf,[c.printf_format,publication.text],c.empty_list),r.operators.redirect_write,sh.ref(r,v.pending)]) -%}
{{- sh.line(r,sh.guarded(r,r.formats.subshell.format(body=[sh.words(r,[r.builtins.umask,c.create_umask]),sh.words(r,[r.builtins.set,r.noclobber_arg]),create] | join(r.sequence_separator)),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,sh.guarded(r,sh.words(r,[f.verify_file,sh.ref(r,v.pending)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.command(r,tools.sync.path,c.sync_args,[sh.ref(r,v.pending)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,f.same_root,c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.command(r,tools.ln.path,[c.path_terminator],[sh.ref(r,v.pending),sh.ref(r,v.sealed)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.words(r,[f.verify_file,sh.ref(r,v.sealed)]),f.sync_root],r.operators['and']),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,r.formats.if_open.format(condition=sh.test(r,[r.tests['not'],r.tests.file,sh.ref(r,v.active)]))) -}}
{{- sh.line(r,sh.guarded(r,f.same_root,c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.command(r,tools.ln.path,[c.path_terminator],[sh.ref(r,v.sealed),sh.ref(r,v.active)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.words(r,[f.verify_file,sh.ref(r,v.active)]),f.sync_root],r.operators['and']),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,r.formats.if_open.format(condition=sh.test(r,[r.tests.file,sh.ref(r,v.pending)]))) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.words(r,[f.verify_file,sh.ref(r,v.pending)]),f.same_root],r.operators['and']),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,sh.command(r,tools.rm.path,[c.path_terminator],[sh.ref(r,v.pending)]),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.guarded(r,f.sync_root,c.refusal_rc,c.absent)) -}}
{{- sh.line(r,r.formats.end_if) -}}
{{- sh.line(r,sh.guarded(r,sh.chain(r,[sh.words(r,[f.verify_file,sh.ref(r,v.sealed)]),sh.words(r,[f.verify_file,sh.ref(r,v.active)]),f.same_inode,f.sync_root],r.operators['and']),c.refusal_rc,c.absent)) -}}
{{- sh.line(r,sh.command(r,r.builtins.printf,[c.status_format,c.success_word],c.empty_list)) -}}
{%- endmacro -%}
