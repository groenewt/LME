{%- import 'producer_interface.j2' as pi -%}
{%- macro record(bs, rt) -%}
{%- set sa = bs.source_admission -%}
{%- set ev = sa.early_view -%}
{%- set cm = sa.bootstrap_input.construction -%}
{%- set cx = namespace(p=[]) -%}
{%- for f, kp in ((ev.context_fields | dictsort) + (ev.launch_context_fields | dictsort)) | sort(attribute='0') -%}
{%- set nn = namespace(n=bs) -%}{%- for k in kp -%}{%- set nn.n = nn.n[k] -%}{%- endfor -%}
{%- set cx.p = cx.p + [[f, nn.n]] -%}
{%- endfor -%}
{%- set ns = namespace(p=[]) -%}
{%- for k in sa.bootstrap_input.record_keys | sort -%}
{%- set c = cm.fields[k] -%}
{%- if c.source == cm.sources.context -%}{%- set ns.p = ns.p + [[k, dict(cx.p)]] -%}
{%- elif c.source == cm.sources.policy -%}
{%- set w = namespace(n=bs) -%}{%- for p in c.path -%}{%- set w.n = w.n[p] -%}{%- endfor -%}
{%- set ns.p = ns.p + [[k, w.n]] -%}
{%- else -%}{%- set ns.p = ns.p + [[k, rt[c.source]]] -%}
{%- endif -%}
{%- endfor -%}
{{ dict(ns.p) | tojson }}
{%- endmacro -%}
{%- if rh_rc_bs is defined -%}{{ record(rh_rc_bs, rh_rc_rt) }}{%- elif rh_pi_bs is defined -%}{{ pi.iface(rh_pi_bs) }}{%- endif -%}
{#- FROZEN, no further writes -#}
