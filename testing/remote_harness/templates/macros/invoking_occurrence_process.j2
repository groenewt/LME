{% macro setup(o, r, bs) -%}
{% set a = o.structural %}
{% set sh = o.shell %}
{% set sep = a.path_separator %}
set {{ sh.options | map(o.filters.quote) | join(sh.separator) }}
[ "$#" -eq {{ sh.argument_fields | length }} ] || exit {{ sh.refusal }}
{% for field in sh.argument_fields %}
{{ sh.positional_assignment_format | format(sh.process_variable_prefix ~ field, sh.parameter_open, loop.index, sh.parameter_close) }}
{% endfor %}
_fo_empty={{ a.empty_text | quote }}
_fo_root={{ r.proc_root | quote }}
_fo_sep={{ sep | quote }}
_fo_consumer="$_fo_scope$_fo_sep"{{ r.consumer_prefix | quote }}{{ a.dot | quote }}"$_fo_ordinal"
_fo_supervisor="$_fo_scope$_fo_sep"{{ r.supervisor_leaf | quote }}
_fo_fail() { exit {{ sh.refusal }}; }
_fo_stat() {
  case "$1" in {% for value in sh.refused_decimal %}{{ value if value else o.shell.empty_case }}{{ o.shell.case_separator if not loop.last else o.structural.empty_text }}{% endfor %}) return {{ sh.refusal }};; esac
  IFS= read -r _fo_line < "$_fo_root$_fo_sep$1$_fo_sep"{{ o.proc.stat | quote }} || return {{ sh.refusal }}
  case "$_fo_line" in "$1"{{ sh.separator | quote }}*) ;; *) return {{ sh.refusal }};; esac
  _fo_line=${_fo_line##*{{ sh.tail_close | quote }}}
  set -- $_fo_line
  [ "$#" -ge {{ o.proc.stat_minimum_fields }} ] || return {{ sh.refusal }}
  {{ sh.positional_assignment_format | format(sh.parent_variable, sh.parameter_open, o.proc.stat_parent_position, sh.parameter_close) }}
  {{ sh.positional_assignment_format | format(sh.start_variable, sh.parameter_open, o.proc.stat_start_position, sh.parameter_close) }}
  case "$_fo_start" in {% for value in sh.refused_decimal %}{{ value if value else o.shell.empty_case }}{{ o.shell.case_separator if not loop.last else o.structural.empty_text }}{% endfor %}) return {{ sh.refusal }};; esac
}
_fo_cgroup() {
  _fo_cg=$_fo_empty
  _fo_count={{ a.zero }}
  while IFS= read -r _fo_line; do
    _fo_count=$((_fo_count + {{ a.one }}))
    case "$_fo_line" in {{ o.proc.cgroup_prefix | quote }}/*) _fo_cg=${_fo_line#{{ o.proc.cgroup_prefix | quote }}};; *) return {{ sh.refusal }};; esac
  done < "$_fo_root$_fo_sep$1$_fo_sep"{{ o.proc.cgroup | quote }} || return {{ sh.refusal }}
  [ "$_fo_count" -eq {{ o.cgroup.cardinality }} ] && [ -n "$_fo_cg" ]
}
{% endmacro %}
{% macro identity(o, r, bs) -%}
{% set a = o.structural %}
{% set sh = o.shell %}
{% set sep = a.path_separator %}
[ "$$" != "$_fo_pid" ] || _fo_fail
_fo_claimed_start=$_fo_start
_fo_stat "$_fo_pid" || _fo_fail
[ "$_fo_start" = "$_fo_claimed_start" ] || _fo_fail
_fo_supervisor_start=$_fo_start
_fo_uid_read=$({{ bs.os_tools[o.tools.stat].path | quote }} {{ o.tools.stat_uid_args | map(o.filters.quote) | join(sh.separator) }} "$_fo_root$_fo_sep$_fo_pid") || _fo_fail
[ "$_fo_uid_read" = "$_fo_uid" ] || _fo_fail
{% for field, path in [(o.supervisor.machine, r.machine_path), (o.supervisor.boot, r.boot_path)] %}
IFS= read -r _fo_value < {{ path | quote }} || _fo_fail
[ "$_fo_value" = "$_fo_{{ field }}" ] || _fo_fail
{% endfor %}
{% for name, field in [(r.pid_namespace, o.supervisor.pid_namespace), (r.cgroup_namespace, o.supervisor.cgroup_namespace)] %}
for _fo_check_pid in "$$" "$_fo_pid"; do
  _fo_value=$({{ bs.os_tools[o.tools.stat].path | quote }} {{ o.tools.stat_namespace_args | map(o.filters.quote) | join(sh.separator) }} "$_fo_root$_fo_sep$_fo_check_pid$_fo_sep"{{ o.proc.namespace_directory | quote }}"$_fo_sep"{{ name | quote }}) || _fo_fail
  [ "$_fo_value" = "$_fo_{{ field }}" ] || _fo_fail
done
{% endfor %}
_fo_stat "$$" || _fo_fail
_fo_subject_start=$_fo_start
_fo_walk=$_fo_parent
_fo_count={{ a.zero }}
while [ "$_fo_walk" != "$_fo_pid" ]; do
  [ "$_fo_count" -lt {{ o.proc.maximum_ancestors }} ] || _fo_fail
  _fo_count=$((_fo_count + {{ a.one }}))
  _fo_stat "$_fo_walk" || _fo_fail
  [ "$_fo_walk" != "$_fo_parent" ] || _fo_fail
  _fo_walk=$_fo_parent
done
_fo_stat "$_fo_pid" || _fo_fail
[ "$_fo_start" = "$_fo_supervisor_start" ] || _fo_fail
{% endmacro %}
{% macro membership(o, r, bs) -%}
{% set a = o.structural %}
{% set sh = o.shell %}
{% set sep = a.path_separator %}
_fo_cgroup "$_fo_pid" || _fo_fail
[ "$_fo_cg" = "$_fo_supervisor" ] || _fo_fail
_fo_cgroup "$$" || _fo_fail
case "$_fo_cg" in "$_fo_consumer"|"$_fo_consumer$_fo_sep"*) ;; *) _fo_fail;; esac
_fo_members=$_fo_empty
while IFS= read -r _fo_line; do _fo_members="$_fo_members{{ sh.separator }}$_fo_line"; done < {{ r.cgroup_mount | quote }}"$_fo_supervisor$_fo_sep"{{ r.procs_file | quote }} || _fo_fail
[ "$_fo_members" = "{{ sh.separator }}$_fo_pid" ] || _fo_fail
_fo_members=$_fo_empty
while IFS= read -r _fo_line; do _fo_members="$_fo_members{{ sh.separator }}$_fo_line"; done < {{ r.cgroup_mount | quote }}"$_fo_scope$_fo_sep"{{ r.procs_file | quote }} || _fo_fail
[ "$_fo_members" = "$_fo_empty" ] || _fo_fail
_fo_cgroup "$_fo_pid" || _fo_fail
[ "$_fo_cg" = "$_fo_supervisor" ] || _fo_fail
{% endmacro %}
{% macro result(o) -%}
{% set sh = o.shell %}
{{ sh.printf_command }} {{ sh.observed_format | quote }} "$$" "$_fo_subject_start"
exit {{ sh.success }}
{% endmacro %}
