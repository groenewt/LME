{%- macro template_bad(bs, form, rt) -%}
{%- set l = bs.genesis.launch -%}
{%- set d = l.placeholder.delimiters -%}
{%- set e = bs.genesis.initializer.custody.cold_launch.initial.rows -%}
{%- set ns = namespace(b=e) -%}
{%- for w in form -%}
{%- set ph = w | regex_findall(l.placeholder.regex) -%}
{%- if w in l.slots.values() -%}
{%- if w not in rt -%}{%- set ns.b = ns.b + [w] -%}{%- endif -%}
{%- elif (w.count(d | first) != (ph | length)) or (w.count(d | last) != (ph | length))
        or (ph | reject('in', l.scalar_slots.values()) | list) != e
        or (ph | reject('in', rt) | list) != e -%}
{%- set ns.b = ns.b + [w] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.b | tojson }}
{%- endmacro -%}

{%- macro vector(bs, form, rt) -%}
{%- set l = bs.genesis.launch -%}
{%- set d = l.placeholder.delimiters -%}
{%- set ns = namespace(w=bs.genesis.initializer.custody.cold_launch.initial.rows) -%}
{%- for w in form -%}
{%- if w in l.slots.values() -%}
{%- set ns.w = ns.w + rt[w] -%}
{%- else -%}
{%- set parts = w.split(d | first) -%}
{%- set t = namespace(s=parts | first) -%}
{%- for p in parts -%}{%- if not loop.first -%}
{%- set q = p.split(d | last) -%}
{%- set t.s = t.s ~ rt[(d | first) ~ (q | first) ~ (d | last)] ~ (q | last) -%}
{%- endif -%}{%- endfor -%}
{%- set ns.w = ns.w + [t.s] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.w | tojson }}
{%- endmacro -%}

{%- macro record_bindings(bs, runtime) -%}
{%- set bi = bs.source_admission.bootstrap_input -%}
{%- set cm = bi.construction -%}
{%- set ns = namespace(p=bs.genesis.initializer.custody.cold_launch.initial.rows) -%}
{%- for k in bi.record_keys | sort -%}
{%- set c = cm.fields[k] -%}
{%- if c.source == cm.sources.binding -%}{%- set ns.p = ns.p + [[c.pinned, runtime[cm.sources.binding][c.pinned]]] -%}{%- endif -%}
{%- endfor -%}
{{ dict(ns.p) | tojson }}
{%- endmacro -%}

{#- record_multiplicity (envelope, record_text): c_ctx = #record keys whose source is sources.context; for each declared
    path P of context_fields + launch_context_fields + the policy record fields' paths, n(P) = c_ctx x #(context paths
    that are a prefix of or equal to P) + #(policy paths that are a prefix of or equal to P), with repetition; n_bind =
    max over pinned names of #binding fields naming it; n_src = max over the runtime sources other than context, policy
    and binding of #record fields naming it. Result max(1, every n(P), n_bind, n_src). -#}
{%- macro record_multiplicity(bs, floor) -%}
{%- set bi = bs.source_admission.bootstrap_input -%}
{%- set cm = bi.construction -%}
{%- set ev = bs.source_admission.early_view -%}
{%- set e = bs.genesis.initializer.custody.cold_launch.initial.rows -%}
{%- set fl = bi.record_keys | map('extract', cm.fields) | list -%}
{%- set c_ctx = fl | selectattr('source', 'equalto', cm.sources.context) | list | length -%}
{%- set cp = (ev.context_fields.values() | list) + (ev.launch_context_fields.values() | list) -%}
{%- set pp = fl | selectattr('source', 'equalto', cm.sources.policy) | map(attribute='path') | list -%}
{%- set ns = namespace(m=[floor]) -%}
{%- for p in cp + pp -%}
{%- set nc = namespace(c=e, q=e) -%}
{%- for c in cp -%}{%- if p[:(c | length)] == c -%}{%- set nc.c = nc.c + [c] -%}{%- endif -%}{%- endfor -%}
{%- for q in pp -%}{%- if p[:(q | length)] == q -%}{%- set nc.q = nc.q + [q] -%}{%- endif -%}{%- endfor -%}
{%- set ns.m = ns.m + [c_ctx * (nc.c | length) + (nc.q | length)] -%}
{%- endfor -%}
{%- set bp = fl | selectattr('source', 'equalto', cm.sources.binding) | map(attribute='pinned') | list -%}
{%- for v in bp -%}{%- set ns.m = ns.m + [bp | select('equalto', v) | list | length] -%}{%- endfor -%}
{%- for s in cm.sources.values() | reject('in', [cm.sources.context, cm.sources.policy, cm.sources.binding]) -%}
{%- set ns.m = ns.m + [fl | selectattr('source', 'equalto', s) | list | length] -%}
{%- endfor -%}
{{ ns.m | max | tojson }}
{%- endmacro -%}

{#- bindings_multiplicity (companions, record_bindings): ONE tojson of a mapping keyed by pinned name, so a repeated
    pinned name collapses; the result is max(1, max over the collapsed keys of their count), 1 by construction, derived
    from the same binding walk record_bindings makes. -#}
{#- op1i OBSERVED (codex tick928 class B_CASE_SENSITIVE_RUNTIME_KEYS): the bare unique over pinned names below compares
    case-insensitively. Each count is taken over the deduplicated list, so M is max(floor, 1) either way (no effect on
    the result, by reading). s43 key_identity is scoped to runtime-map keys; this macro reads only its bs view (the
    word is not in it), so the site is UNCHANGED and reported to Codex / C1. -#}
{%- macro bindings_multiplicity(bs, floor) -%}
{%- set bi = bs.source_admission.bootstrap_input -%}
{%- set cm = bi.construction -%}
{%- set ks = bi.record_keys | map('extract', cm.fields) | selectattr('source', 'equalto', cm.sources.binding) | map(attribute='pinned') | unique | list -%}
{%- set ns = namespace(m=[floor]) -%}
{%- for k in ks -%}{%- set ns.m = ns.m + [ks | select('equalto', k) | list | length] -%}{%- endfor -%}
{{ ns.m | max | tojson }}
{%- endmacro -%}

{#- argv_multiplicity (argv, vector over the admitted form at cold_launch_release.argv_from): occ(p) of a launch.slots
    word = #form words equal to it; occ(p) of a scalar placeholder = #regex_findall(placeholder.regex) hits equal to it
    over every form word that is not a slots word. m_sr = occ(slots.source_record); m_direct = max occ over every other
    slot and scalar placeholder. Result max(1, m_direct, m_sr x max(record_multiplicity, bindings_multiplicity)). -#}
{%- macro argv_multiplicity(bs, floor) -%}
{%- set l = bs.genesis.launch -%}
{%- set e = bs.genesis.initializer.custody.cold_launch.initial.rows -%}
{%- set fw = namespace(v=bs) -%}
{%- for k in bs.genesis.initializer.custody.external_invocation.cold_launch_release.argv_from -%}{%- set fw.v = fw.v[k] -%}{%- endfor -%}
{%- set sv = l.slots.values() | list -%}
{%- set hs = namespace(h=e) -%}
{%- for w in fw.v | reject('in', sv) -%}{%- set hs.h = hs.h + (w | regex_findall(l.placeholder.regex)) -%}{%- endfor -%}
{%- set ns = namespace(m=[floor]) -%}
{%- for p in sv | reject('equalto', l.slots.source_record) -%}{%- set ns.m = ns.m + [fw.v | select('equalto', p) | list | length] -%}{%- endfor -%}
{%- for p in l.scalar_slots.values() -%}{%- set ns.m = ns.m + [hs.h | select('equalto', p) | list | length] -%}{%- endfor -%}
{%- set m_sr = fw.v | select('equalto', l.slots.source_record) | list | length -%}
{%- set ns.m = ns.m + [m_sr * ([record_multiplicity(bs, floor) | from_json, bindings_multiplicity(bs, floor) | from_json] | max)] -%}
{{ ns.m | max | tojson }}
{%- endmacro -%}
