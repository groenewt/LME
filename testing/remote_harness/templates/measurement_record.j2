{#- testing/remote_harness/templates/measurement_record.j2 -- the ONE dispatcher of the controller preparation
    measurement macros (route-r4c; the R5d measure_call.j2 / transfer call.j2 pattern), reached through the existing
    ansible.builtin.template lookup at rh_repo_root <sep> preparation_measurement.record_template_rel. Nothing is named
    here: the import paths, the macro selector and its arguments are BINDINGS supplied by the caller
    (tasks/measure_controller_tools.yml fact rh_meas_call + the per-call selector / arguments), all derived from
    declarations:
      rh_meas_import     preparation_measurement.macros_rel relative to dirname(record_template_rel) -- the declared
                         macros_rel DRIVES this import (codex-tick400)
      rh_meas_rf_import  refusal_grammar.macros_rel relative to dirname(record_template_rel) (imported by the macros)
      rh_meas_rg         controller.bootstrap.refusal_grammar (common REFUSED <code>: grammar, C1)
      rh_meas_m          controller.bootstrap.preparation_measurement
      rh_meas_macro      a value of preparation_measurement.macros (the selector)
      rh_meas_args       the selected macro's positional arguments
    The macros import is WITH CONTEXT so the macros file can import the refusal grammar macro from rh_meas_rf_import.
    A selector outside the declared macros refuses through the common grammar (rh_meas_refused is the deliberately
    undefined failure sentinel, a reserved rh_meas_* name). Prints the selected macro's ONE JSON value. AUTHORED, NEVER
    RENDERED. -#}
{%- import rh_meas_import as mm with context -%}
{%- import rh_meas_rf_import as rf -%}
{%- if rh_meas_macro not in rh_meas_m.macros.values() -%}
{{ rh_meas_refused | mandatory(rf[rh_meas_rg.macro](rh_meas_rg, rh_meas_m.refusal, [rh_meas_m.diagnostics.dispatch, rh_meas_macro])) }}
{%- endif -%}
{{ mm[rh_meas_macro](*rh_meas_args) }}
