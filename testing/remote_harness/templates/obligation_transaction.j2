[ -n "$ot_cs" ] || return 1; ot_ca=${ot_ca%{{ sep | quote }}}{{ sep | quote }}$ot_cs;
[ -n "$ot_cr" ] || break; ot_anc "$ot_ca" || return 1; done; ot_cl=$ot_ca; };
