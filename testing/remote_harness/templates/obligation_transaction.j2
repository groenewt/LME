{%- set sep = bs.path_admission.separator -%}
{%- set rf = ob.record_fields -%}
{%- set mapk = ob.peer_charge.fields | map('extract', rf) | list -%}
{#- codex 936 item 5 (representation follow-up; not credited). Reconciled with declared words: every f_status value is
    a transaction.steps word (measure, scan, unaccountable, charge, temp_write, noreplace_landing, readback) or a
    transaction.params word (landing, reserve_bytes, reserve_inodes, own_device_bytes, own_metadata_copies,
    probe_dirs); every classifier reason is a record_parse.check_order word (N13 pins it set-equal to
    unaccountable.when); every recover output is a dead_holder.program.steps word -- N13 pins those lists exactly.
    SR922j (s50 :7955-7978, :7847-7850, :7927-7928) SOURCES what were B op1m markers SR922j-1, -2, -4 (placeholder),
    -5 (copy count), -6:
      decimal grammar -> tx.grammar.decimal_ere (dec, the device map dmap, ot_dec in both modes via the parse role);
      device-map key order and the read rule -> tx.record_parse.map_key_order / .read (their else words);
      the check order -> tx.record_parse.check_order (rendered in that order, first failing word wins);
      the unmeasured placeholder -> tx.unmeasured;
      the per-entry copy count 1 of R and T -> peer_charge.inodes.per_copy (registry_record, registry_temp: one copy
        each; metadata_copies the counted writer copies; device_bytes no per-copy term: aggregation_inodes_from);
      the mode representation -> tx.lstat (type in regular_types, perms == record_mode_perms).
    The shell-to-awk tag words (p / o / c / x) are the program's own wire between two of its parse invocations, not a
    representation of any read datum (no artifact carries them). The op1m list of literals without a declared word
    (HOLE-B-OP1M-REPR-STRING-CLASS, -UNREAD-DETAIL, -TEMP-GLOB, -FORM-PLACEHOLDERS) is CLOSED by SR922l (s55
    string_class :7968, unread_detail :8099, temp_glob :8098, staging_placeholders :7967); each is read from its word
    below. B readings of those words (recorded): the excluded class names map to ERE bracket members quote -> ",
    backslash -> \\, control -> [:cntrl:] (NOTE-B-OP1N-STRING-CLASS-MEMBERS); the reaping name swaps
    bundle.reaping_infix for the <staging_infix> placeholder's walked bundle.staging_infix (s55 :8247 "reaping_infix for
    staging_infix"; NOTE-B-OP1N-REAPING-NAME).
    Carried: canonical JSON separators ', ' / ': ' (DEV-B-OP1I-CANONICAL-RECORD-GRAMMAR). -#}
{%- set dec = tx.grammar.decimal_ere -%}
{%- set dmap = '\\{("' ~ dec ~ '": ' ~ dec ~ '(, "' ~ dec ~ '": ' ~ dec ~ ')*)?\\}' -%}
{%- set dh = wb.lifetime.dead_holder -%}
{%- set pg = rh_ot_program -%}
{%- set rd = wb.lifetime.release_durability -%}
{%- set rg = ob.record_grammar -%}
{#- SR922i record_grammar (s55 :7942-7969): a JSON string; an admitted path (path_admission.regex, its anchors dropped
    to embed it; N13 asserts they are its first and last characters); paths exactly recovery_path_roles; lease exactly
    lease.record_fields, JSON strings (the lease key that must equal the record token is the record_grammar.lease key
    whose value is equals_record_token) -#}
{#- SUCCESSOR-03 string_class (s55 :7968): sbody = the value body (no excluded character), strp = one JSON string,
    sesc = the escape / control test over the whole record text (quote excluded from it: quotes are JSON syntax). An
    excluded word without a member mapping is an undefined render error (no program text: the caller refuses); an
    escapes word other than none makes sesc match every record (string_class.else for every record: closed). -#}
{%- set scl = rg.string_class -%}
{%- set scm = {'quote': '"', 'backslash': '\\\\', 'control': '[:cntrl:]'} -%}
{%- set sbody = '[^' ~ (scl.excluded | map('extract', scm) | join('')) ~ ']*' -%}
{%- set strp = '"' ~ sbody ~ '"' -%}
{%- set sesc = namespace(v='[' ~ (scl.excluded | reject('equalto', 'quote') | map('extract', scm) | join('')) ~ ']') -%}
{%- if scl.escapes != 'none' -%}{%- set sesc.v = '.' -%}{%- endif -%}
{%- set pv = '"' ~ (bs.path_admission.regex[1:-1] | replace('/', '\\/')) ~ '"' -%}
{%- set pp = namespace(e=[]) -%}
{%- for r in ob.recovery_path_roles | sort -%}{%- set pp.e = pp.e + ['"' ~ r ~ '": ' ~ pv] -%}{%- endfor -%}
{%- set pathp = '\\{' ~ (pp.e | join(', ')) ~ '\\}' -%}
{%- set lp = namespace(e=[]) -%}
{%- for k in lz.record_fields | list | sort -%}{%- set lp.e = lp.e + ['"' ~ k ~ '": ' ~ strp] -%}{%- endfor -%}
{%- set leasep = '\\{' ~ (lp.e | join(', ')) ~ '\\}' -%}
{%- set ltk = rg.lease | dict2items | selectattr('value', 'equalto', 'equals_record_token') | map(attribute='key') | first -%}
{%- set family_patterns = namespace(v={}) -%}
{%- for family, declaration in ob.record_families.items() if declaration is mapping and 'keys' in declaration -%}
{%- set fp = namespace(k=[], f=[]) -%}
{%- for k in declaration['keys'] | sort -%}
{%- set fp.k = fp.k + ['"' ~ k ~ '": .*'] -%}
{%- if k in mapk -%}{%- set fp.f = fp.f + ['"' ~ k ~ '": ' ~ dmap] -%}
{%- elif k == rf.paths -%}{%- set fp.f = fp.f + ['"' ~ k ~ '": ' ~ pathp] -%}
{%- elif k == rf.lease -%}{%- set fp.f = fp.f + ['"' ~ k ~ '": ' ~ leasep] -%}
{%- elif k == rf.destination -%}{%- set fp.f = fp.f + ['"' ~ k ~ '": ' ~ pv] -%}
{%- else -%}{%- set fp.f = fp.f + ['"' ~ k ~ '": ' ~ strp] -%}{%- endif -%}
{%- endfor -%}
{%- set family_patterns.v = family_patterns.v | combine({family: {'keys': fp.k, 'full': fp.f}}) -%}
{%- endfor -%}
{%- set kp = family_patterns.v.v2_enveloped -%}
{%- set tokp = '"' ~ rf.token ~ '": "' -%}
{#- the staging name (record_grammar.staging_name.form, s55 :7945) as awk string pieces, each placeholder read through
    SUCCESSOR-03 staging_placeholders (s55 :7967): destination_basename -> db (the record destination's basename),
    record_token -> k, a walked path -> its bootstrap value as a constant (the reaping name: bundle.reaping_infix in
    place of the walked bundle.staging_infix, NOTE-B-OP1N-REAPING-NAME), {ere} (last piece only) -> the remainder,
    which must FULLY match that ere (fm.re); every other piece a constant. An undeclared placeholder, a source of
    another shape, or an {ere} that is not the last piece sets fm.ok false: staging_not_token_staging_name then fails
    every record (closed). staging role = the last word of staging_name.in.
    SUCCESSOR-04 (C1 SR922o addendum 2, s55 :7967): '<random>' is now {ere: [a-z0-9_] spelled 8 times, reserved_by,
    source, alphabet, length}. The reader below is UNCHANGED: its mapping test (v is mapping and 'ere' in v, last piece)
    reads only v.ere and ignores the other keys (N13 pins them exactly); the ere holds no interval, so any awk ERE reads
    it, and an underscore suffix now FULLY matches (HOLE-B-OP1N-MKDTEMP-RANDOM-CLASS closed). -#}
{%- macro awkstr(s) -%}"{{ s | replace('\\', '\\\\') | replace('"', '\\"') }}"{%- endmacro -%}
{%- set sr = rg.staging_name['in'] | regex_findall('[a-z0-9_]+') | last -%}
{%- set sph = rg.staging_placeholders -%}
{%- set fm = namespace(s=[], r=[], re='', ok=true) -%}
{%- for p in rg.staging_name.form | regex_findall('<[^>]+>|[^<>]+') -%}
{%- if p[:1] == '<' and (p in sph) -%}
{%- set v = sph[p] -%}
{%- if v is string and v == 'destination_basename' -%}{%- set fm.s = fm.s + ['db'] -%}{%- set fm.r = fm.r + ['db'] -%}
{%- elif v is string and v == 'record_token' -%}{%- set fm.s = fm.s + ['k'] -%}{%- set fm.r = fm.r + ['k'] -%}
{%- elif v is mapping and ('ere' in v) and loop.last -%}{%- set fm.re = v.ere -%}
{%- elif v is sequence and v is not string and v is not mapping and (v | length) > 0 -%}
{%- set pw = namespace(v=bs) -%}{%- for k in v -%}{%- set pw.v = pw.v[k] -%}{%- endfor -%}
{%- set fm.s = fm.s + [awkstr(pw.v)] -%}
{%- if v == ['bundle', 'staging_infix'] -%}{%- set fm.r = fm.r + [awkstr(bs.bundle.reaping_infix)] -%}{%- else -%}{%- set fm.r = fm.r + [awkstr(pw.v)] -%}{%- endif -%}
{%- else -%}{%- set fm.ok = false -%}{%- endif -%}
{%- elif p[:1] == '<' -%}{%- set fm.ok = false -%}
{%- else -%}{%- set fm.s = fm.s + [awkstr(p)] -%}{%- set fm.r = fm.r + [awkstr(p)] -%}{%- endif -%}
{%- endfor -%}
{%- if fm.re == '' -%}{%- set fm.ok = false -%}{%- endif -%}
{%- set legacy_grammar = ob.record_families.v1_six_fields -%}
{%- set legacy_last = legacy_grammar.staging_name.form | regex_findall('<[^>]+>|[^<>]+') | last -%}
{%- set legacy_suffix = legacy_grammar.staging_placeholders[legacy_last].ere -%}
{%- set seq = sep | replace('/', '\\/') -%}
{#- awk fragment: x = parent and y = basename of the path in variable P (sep) -#}
{%- macro awksplit(P, x, y) -%} {{ x }} = {{ P }}; sub(/{{ seq }}[^{{ seq }}]*$/, "", {{ x }}); {{ y }} = substr({{ P }}, length({{ x }}) + {{ (sep | length) + 1 }});{%- endmacro -%}
{%- set regcopies = ob.copy_locations.values() | select('equalto', ob.registry_role) | list | length -%}
{%- set dfi = namespace(a=0, i=0) -%}
{%- for c in lc.df_columns -%}
{%- if c == 'avail' -%}{%- set dfi.a = loop.index -%}{%- elif c == 'iavail' -%}{%- set dfi.i = loop.index -%}{%- endif -%}
{%- endfor -%}
{%- macro tool(name) -%}{{ bs.os_tools[name].path | quote }}{%- endmacro -%}
{%- macro role(r) -%}{{ tool(tx.program_tools[r]) }}{%- endmacro -%}
{%- macro words(l) -%}{{ l | map('quote') | join(' ') }}{%- endmacro -%}
{%- macro text_length(variable) -%}
{%- set sc = ob.staging_creation -%}
{%- set count = '{ n += length($' ~ sc.zero ~ '); if (NR > ' ~ sc.byte_count.maximum_rows ~ ') exit ' ~ sc.statuses.refused ~ ' } END { if (NR > ' ~ sc.byte_count.maximum_rows ~ ') exit ' ~ sc.statuses.refused ~ '; printf ' ~ (sc.formats.text | to_json) ~ ', n + ' ~ sc.zero ~ ' }' -%}
$(printf {{ sc.formats.text | quote }} "${{ variable }}" | LC_ALL={{ sc.byte_count.locale | quote }} {{ role('parse') }} {{ count | quote }})
{%- endmacro -%}
{%- macro txt(key) -%}
{%- for p in tx.texts[key] | regex_findall('\\{[a-z0-9_]+\\}|[^{}]+') -%}
{%- if p[:1] == '{' -%}"${f_{{ p[1:-1] }}}"{%- else -%}{{ p | quote }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro refuse(key) -%}ot_ref {{ rh_ot_codes[key] | quote }} {{ txt(key) }}{%- endmacro -%}
{#- awk: a canonical device map {"<dec>": <dec>, ...} (keys strictly ascending) -> "<tag> <device> <n> " pairs -#}
{%- set awk_map = '{ if ($0 !~ /^' ~ dmap ~ '$/) { b = 1; exit } s = substr($0, 2, length($0) - 2); m = split(s, a, /, /);'
      ~ ' for (i = 1; i <= m; i++) { split(a[i], kv, /: /); k = substr(kv[1], 2, length(kv[1]) - 2);'
      ~ ' if (i > 1 && !((p "") < (k ""))) { b = 1; exit } p = k; o = o t " " k " " kv[2] " " } }'
      ~ ' END { if (b || NR != 1) exit 1; printf "%s", o }' -%}
{#- awk: the probe_dirs array ["<dir>", ...] (path_admission charset) -> one dir per line -#}
{%- set pch = '[' ~ bs.path_admission.charset ~ ']+' -%}
{%- set awk_dirs = '{ if ($0 !~ /^\\[("' ~ pch ~ '"(, "' ~ pch ~ '")*)?\\]$/) { b = 1; exit } s = substr($0, 2, length($0) - 2);'
      ~ ' m = split(s, a, /, /); for (i = 1; i <= m; i++) print substr(a[i], 2, length(a[i]) - 2) }'
      ~ ' END { if (b || NR != 1) exit 1 }' -%}
{#- awk: the df rows (exactly one header and one data row of df_columns) -> "<avail> <iavail>" -#}
{%- set awk_df = '{ if (NF != ' ~ (lc.df_columns | length) ~ ') b = 1 } NR == 2 { a = $' ~ dfi.a ~ '; i = $' ~ dfi.i ~ ' }'
      ~ ' END { if (b || NR != 2) exit 1; print a, i }' -%}
{#- awk: one peer record (stdin = its text as read; n = its name, z = its lstat size, v = its device) -> the first failing
    record_parse.check_order word, or its peer_charge "x <device> <bytes> <copies> " entries -#}
{%- set tkw = namespace(v=bs) -%}{%- for k in ob.token_from -%}{%- set tkw.v = tkw.v[k] -%}{%- endfor -%}
{#- SUCCESSOR-02 (SR922i :8000-8001 + SR922j record_parse :7971-7976). Every value is extracted first, then each
    record_parse.check_order word is tested IN THAT DECLARED ORDER and the first failing one is the reason (a test
    reading a value is reached only after the words that admit that value passed). The read rule (record_parse.read:
    lines, read bytes == lstat size) and the device-map key order (record_parse.map_key_order: strictly ascending as
    text) each fail with their declared else word at that word's place in the order. unreadable is decided by the shell
    (lstat type / perms, read and digest status) before this parse runs, so it has no awk test here. A check_order word
    this template does not know fails every record with that word (fail closed). The record token is the value of the
    record-level token key: the LAST occurrence of that key followed only by the record keys sorted after it (N13 pins
    record_fields exactly, so token is the last sorted key and the lease's own token key is never taken). The staging
    name is checked against the record's own destination (parent equal, basename = the form's fixed prefix plus a
    remainder; SUCCESSOR-03: the remainder FULLY matches the <random> ere of staging_placeholders). After every word passed, a text that still is not the one object of the declared field
    shapes (the fields checked one by one could each match a different split) fails with the read rule's else word
    (B reading DEV-B-OP1M-RESIDUAL-SHAPE). -#}
{%- set dp = '"' ~ rf.destination ~ '": "' -%}
{%- set spk = '"' ~ sr ~ '": "' -%}
{%- set ltp = '"' ~ ltk ~ '": "' -%}
{%- set rp = tx.record_parse -%}
{%- set ka = namespace(s='', on=false) -%}
{%- for k in rf.values() | list | sort -%}
{%- if ka.on -%}{%- set ka.s = ka.s ~ ', "' ~ k ~ '": .*' -%}{%- endif -%}
{%- if k == rf.token -%}{%- set ka.on = true -%}{%- endif -%}
{%- endfor -%}
{%- set awk_rec = namespace(t='{ t = (NR == 1) ? $0 : t "\\n" $0 } END {'
      ~ ' r = (NR != ' ~ rp.read.lines ~ (' || length(t) != z' if rp.read.read_bytes_equal_lstat_size is sameas true else '') ~ '); mo = 0;'
      ~ ' legacy = (t ~ /^\\{' ~ (family_patterns.v.v1_six_fields.full | join(', ')) ~ '\\}$/);'
      ~ ' current = (t ~ /^\\{' ~ (family_patterns.v.v2_enveloped.full | join(', ')) ~ '\\}$/);') -%}
{%- for mk in mapk -%}
{%- set mp = '"' ~ mk ~ '": ' -%}
{%- set awk_rec.t = awk_rec.t ~ ' if (match(t, /' ~ mp ~ dmap ~ '[,}]/)) { match(t, /' ~ mp ~ '\\{[^}]*\\}/); s = substr(t, RSTART + ' ~ ((mp | length) + 1) ~ ', RLENGTH - ' ~ ((mp | length) + 2) ~ ');'
      ~ ' m = split(s, a, /, /); p = ""; for (i = 1; i <= m; i++) { split(a[i], kv, /: /); d = substr(kv[1], 2, length(kv[1]) - 2);'
      ~ ' if (i > 1 && !((p "") < (d ""))) mo = 1; p = d } }' -%}
{%- endfor -%}
{%- set awk_rec.t = awk_rec.t
      ~ ' k = ""; kt = match(t, /' ~ tokp ~ sbody ~ '"' ~ ka.s ~ '\\}$/); if (kt) { s = substr(t, RSTART); match(s, /^' ~ tokp ~ sbody ~ '"/);'
      ~ ' k = substr(s, ' ~ ((tokp | length) + 1) ~ ', RLENGTH - ' ~ ((tokp | length) + 1) ~ ') }'
      ~ ' match(t, /' ~ dp ~ sbody ~ '"/); D = substr(t, RSTART + ' ~ (dp | length) ~ ', RLENGTH - ' ~ ((dp | length) + 1) ~ ');'
      ~ ' match(t, /"' ~ rf.paths ~ '": ' ~ pathp ~ '/); P = substr(t, RSTART, RLENGTH);'
      ~ ' match(P, /' ~ spk ~ sbody ~ '"/); S = substr(P, RSTART + ' ~ (spk | length) ~ ', RLENGTH - ' ~ ((spk | length) + 1) ~ ');'
      ~ awksplit('D', 'dx', 'db') ~ awksplit('S', 'sx', 'sb') ~ ' e = ' ~ (fm.s | join(' ')) ~ ';'
      ~ ' match(t, /"' ~ rf.lease ~ '": ' ~ leasep ~ '/); L = substr(t, RSTART, RLENGTH);'
      ~ ' match(L, /' ~ ltp ~ sbody ~ '"/); lk = substr(L, RSTART + ' ~ (ltp | length) ~ ', RLENGTH - ' ~ ((ltp | length) + 1) ~ '); w = "";' -%}
{%- set rc = {
      'unreadable': '0',
      'not_one_json_object': 't !~ /^\\{.*\\}$/',
      'keys_not_record_fields': '!legacy && !current',
      'keys_not_admitted_record_family': '!legacy && !current',
      'device_bytes_not_device_to_nonneg_integer': 't !~ /"' ~ rf.device_bytes ~ '": ' ~ dmap ~ '[,}]/',
      'metadata_copies_not_device_to_nonneg_integer': 't !~ /"' ~ rf.metadata_copies ~ '": ' ~ dmap ~ '[,}]/',
      'token_not_token_regex': '!kt || k !~ /' ~ (tkw.v | replace('/', '\\/')) ~ '/',
      'token_not_file_name': 'k != n',
      'destination_not_admitted_path': 't !~ /"' ~ rf.destination ~ '": ' ~ pv ~ '[,}]/',
      'paths_not_role_to_admitted_path': 't !~ /"' ~ rf.paths ~ '": ' ~ pathp ~ '[,}]/',
      'staging_not_token_staging_name': ('sx != dx || index(sb, e) != 1 || (legacy ? substr(sb, length(e) + 1) !~ /^(' ~ (legacy_suffix | replace('/', '\\/')) ~ ')$/ : substr(sb, length(e) + 1) !~ /^(' ~ (fm.re | replace('/', '\\/')) ~ ')$/)'
                                         if fm.ok else '1'),
      'lease_not_lease_record_fields': 't !~ /"' ~ rf.lease ~ '": ' ~ leasep ~ '[,}]/',
      'lease_token_not_record_token': 'lk != k'} -%}
{%- set reasons = namespace(v=rc) -%}
{%- for field in mapk if field not in ob.record_families.v1_six_fields['keys'] -%}
{%- set reasons.v = reasons.v | combine({field ~ '_not_device_to_nonneg_integer': '(!legacy && t !~ /"' ~ field ~ '": ' ~ dmap ~ '[,}]/)'}) -%}
{%- endfor -%}
{%- for c in rp.check_order -%}
{%- set cx = namespace(e=[]) -%}
{%- if c in reasons.v -%}{%- set cx.e = cx.e + ['(' ~ reasons.v[c] ~ ')'] -%}{%- else -%}{%- set cx.e = cx.e + ['1'] -%}{%- endif -%}
{%- if c == rp.read['else'] -%}{%- set cx.e = cx.e + ['r'] -%}{%- endif -%}
{%- if c == rp.map_key_order['else'] -%}{%- set cx.e = cx.e + ['mo'] -%}{%- endif -%}
{#- SUCCESSOR-03 string_class.else (s55 :7968): an escape introducer or a control character anywhere in the text -#}
{%- if c == scl['else'] -%}{%- set cx.e = cx.e + ['(t ~ /' ~ sesc.v ~ '/)'] -%}{%- endif -%}
{%- set awk_rec.t = awk_rec.t ~ ' if (w == "" && (' ~ (cx.e | join(' || ')) ~ ')) w = ' ~ awkstr(c) ~ ';' -%}
{%- endfor -%}
{%- set awk_rec.t = awk_rec.t ~ ' if (w == "" && !legacy && !current) w = ' ~ awkstr(rp.read['else']) ~ ';'
      ~ ' if (w != "") { printf "%s", w; exit } o = "";' -%}
{%- for mk in mapk -%}
{%- set mp = '"' ~ mk ~ '": ' -%}
{%- set contribution = ob.peer_charge.awk_contribution[mk] -%}
{%- set cv = {'map_value': 'kv[2]', 'map_value_times_record_lstat_size': 'kv[2] * z', 0: '0'} -%}
{%- set awk_rec.t = awk_rec.t ~ ' if (match(t, /' ~ mp ~ '\\{[^}]*\\}/)) { s = substr(t, RSTART + ' ~ ((mp | length) + 1) ~ ', RLENGTH - ' ~ ((mp | length) + 2) ~ ');'
      ~ ' m = split(s, a, /, /); for (i = 1; i <= m; i++) { split(a[i], kv, /: /); d = substr(kv[1], 2, length(kv[1]) - 2);'
      ~ ' o = o ' ~ awkstr(tx.n13_protocol.tags.peer ~ ' ') ~ ' d " " (' ~ cv[contribution.bytes_X] ~ ') " " (' ~ cv[contribution.inodes_XI] ~ ') " ";'
      ~ ' if (legacy) o = o ' ~ awkstr(tx.n13_protocol.tags.legacy_device ~ ' ') ~ ' d " "; } }' -%}
{%- endfor -%}
{#- codex 936 B-OP1L-PEER-METADATA-INODES, SOURCED by SR922j peer_charge.inodes (s55 :7995-8009): every x entry is
    "x <device> <bytes> <copies>"; copies is the peer record's inode charge per_copy [metadata_copies, registry_record,
    registry_temp]: metadata_copies[d] writer copies on d, the registry record R (one copy, on R's device) and each
    adjacent registry temp T (one copy each, the scan). device_bytes: aggregation_inodes_from (no per-copy inode term:
    copies 0; the reserve ri carries inodes_from). admission: same_locked_admission (awk_charge, under the lock). -#}
{%- set awk_rec.t = awk_rec.t ~ ' if (legacy) o = o ' ~ awkstr(tx.n13_protocol.tags.legacy_device ~ ' ') ~ ' v " "; printf "%s", o ' ~ awkstr(tx.n13_protocol.tags.peer ~ ' ') ~ ' v " " z " 1 " }' -%}
{#- awk: the per-device admission over the tagged line (p <dev> <avail> <iavail> | o <dev> <bytes> | c <dev> <copies> |
    x <dev> <bytes> <copies>); g = the registry device, b = the record text bytes, rb / ri = the reserve; need inodes on
    d = own record copies + the peers' record copies on d (XI) + ri; prints the first failing device
    "<dev> <need_bytes> <need_inodes> <avail> <iavail> <own> <others>" and exits nonzero, or nothing -#}
{%- set awk_charge = '{ for (i = 1; i <= NF; ) { if ($i == ' ~ awkstr(tx.n13_protocol.tags.probe) ~ ') { d = $(i + 1); if (!(d in A) || $(i + 2) < A[d]) A[d] = $(i + 2);'
      ~ ' if (!(d in I) || $(i + 3) < I[d]) I[d] = $(i + 3); i += 4 } else if ($i == ' ~ awkstr(tx.n13_protocol.tags.own_bytes) ~ ') { O[$(i + 1)] += $(i + 2); i += 3 }'
      ~ ' else if ($i == ' ~ awkstr(tx.n13_protocol.tags.own_metadata_copies) ~ ') { C[$(i + 1)] += $(i + 2); i += 3 } else if ($i == ' ~ awkstr(tx.n13_protocol.tags.peer) ~ ') { X[$(i + 1)] += $(i + 2); XI[$(i + 1)] += $(i + 3); i += 4 }'
