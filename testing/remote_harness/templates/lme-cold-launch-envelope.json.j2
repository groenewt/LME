{#- testing/remote_harness/templates/lme-cold-launch-envelope.json.j2 -- X2P OUTPUT `envelope` (C1 s33
    external_invocation.envelope_projection.outputs.envelope; codex 912 X4_preparse_projection, 913, 914 P-B1, 915).
    NEW FILE. AUTHORED, NEVER RENDERED (UNRUN). Change record: b/op1c-projector/records-b-op1c-projector-01.yml.
    Rendered ONLY by testing/remote_harness/cold_launch_projection.yml through reserve_publish.yml (N13 -> N10), with the
    template vars named by the PROPOSED C1 word envelope_projection.template_vars {bs, ctl, rt} (C1-SR328-W-TEMPLATE-VARS;
    the identifiers below are that word's values: HOLE-B-912-TEMPLATE-IDENT class, not waived).
    OUTPUT: the X4 launch envelope {<early name>: <launch record>} as ONE JSON text, produced by the ONE shared construction
    reached by its declared macro word (outputs.envelope.macro, record_text) through its declared module rel
    (macros_from[<macro>] walked under controller.bootstrap). Nothing here builds a record field: the runtime roles are the
    construction source words (sources.edition / digest / registry / launch_transport / binding) carried by rt.
    Render checks (refusal through the shared ge.render_refuse with the declared cold_launch.texts.cold_render_*):
      X4 context_from is early_view.launch_context_fields and one of its key paths carries source_admission.invocation;
      rt transport == the walk of the X4 ingress.transport_from == X4 row transport == X2P row transport;
      the construction binding fields name exactly the X4 row companions, and rt[binding] carries exactly those names. -#}
{#- op1d: rendered ONLY through N10 successor-03 in MODULE scope (declared entry_generation.render options); vars from
    rh_ra_vars by the template_vars words; render_refuse by the PROPOSED refuse_macro word (below: ge[xp.refuse_macro]). -#}
{#- op1g (B; cp -n of op1f 54190f83, then Edit; change record b/op1g-projector/records-b-op1g-projector-01.yml; C1
    sr922b input_view.roles.envelope, CPL-SR922B-B-VIEW): bs / ctl / rt are the envelope role's NARROWED view
    (rh_ra_vars; genesis.entry is an anchor mapping); the ONE ambient read is the entry_read below; both macro modules
    are imported WITHOUT CONTEXT. -#}
{%- set tw = rh.controller.bootstrap.genesis.initializer.custody.external_invocation.envelope_projection.template_vars -%}
{%- set bs = rh_ra_vars[tw.bs] -%}
{%- set ctl = rh_ra_vars[tw.ctl] -%}
{%- set rt = rh_ra_vars[tw.rt] -%}
{%- set xi = bs.genesis.initializer.custody.external_invocation -%}
{%- set xp = xi.envelope_projection -%}
{%- set xr = xi.cold_launch_release -%}
{%- set cd = bs.genesis.initializer.custody.cold_launch -%}
{%- set sa = bs.source_admission -%}
{%- set cm = sa.bootstrap_input.construction -%}
{%- set mw = namespace(s=bs, g=bs) -%}
{%- for k in xp.macros_from[xp.outputs.envelope.macro] -%}{%- set mw.s = mw.s[k] -%}{%- endfor -%}
{%- for k in xp.macros_from[xp.refuse_macro] -%}{%- set mw.g = mw.g[k] -%}{%- endfor -%}
{%- import mw.s | relpath(xp.outputs.envelope.template_rel | dirname) as s without context -%}
{%- import mw.g | relpath(xp.outputs.envelope.template_rel | dirname) as ge without context -%}
{%- set lw = namespace(n=bs, t=bs, inv=cd.initial.rows) -%}
{%- for k in xr.context_from -%}{%- set lw.n = lw.n[k] -%}{%- endfor -%}
{%- if lw.n != sa.early_view.launch_context_fields -%}{{ ge[xp.refuse_macro](bs, ctl, cd.texts.cold_render_context) }}{%- endif -%}
{%- for f, kp in sa.early_view.launch_context_fields | dictsort -%}{%- set w = namespace(n=bs) -%}{%- for k in kp -%}{%- set w.n = w.n[k] -%}{%- endfor -%}{%- if w.n == sa.invocation -%}{%- set lw.inv = lw.inv + [f] -%}{%- endif -%}{%- endfor -%}
{%- if lw.inv == cd.initial.rows -%}{{ ge[xp.refuse_macro](bs, ctl, cd.texts.cold_render_context) }}{%- endif -%}
{%- for k in xr.ingress.transport_from -%}{%- set lw.t = lw.t[k] -%}{%- endfor -%}
{%- if rt[cm.sources.launch_transport] != lw.t or lw.t != xr.transport or lw.t != xp.transport -%}{{ ge[xp.refuse_macro](bs, ctl, cd.texts.cold_render_transport) }}{%- endif -%}
{%- set bn = sa.bootstrap_input.record_keys | sort | map('extract', cm.fields) | selectattr('source', 'equalto', cm.sources.binding) | map(attribute='pinned') | list -%}
{%- if (bn | sort) != (xr.companions | sort) or rt[cm.sources.binding] is not mapping or (rt[cm.sources.binding].keys() | list | sort) != (bn | sort) -%}{{ ge[xp.refuse_macro](bs, ctl, cd.texts.cold_render_companions) }}{%- endif -%}
{%- set bm = namespace(p=cd.initial.rows) -%}{%- for v in bn -%}{%- set bm.p = bm.p + [[v, rt[cm.sources.binding][v] | tojson]] -%}{%- endfor -%}
{{ s[xp.outputs.envelope.macro](bs, xr.ingress.envelope.early_name, {cm.sources.edition: rt[cm.sources.edition] | tojson, cm.sources.digest: rt[cm.sources.digest] | tojson, cm.sources.registry: rt[cm.sources.registry] | tojson, cm.sources.launch_transport: rt[cm.sources.launch_transport] | tojson, cm.sources.binding: dict(bm.p)}) }}
