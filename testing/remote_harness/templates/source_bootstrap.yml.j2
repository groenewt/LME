{%- set R = lme_entry_context[lme_entry_binding.key] -%}
{%- set bs = lme_entry_struct[R.bootstrap] -%}
{%- set e = bs.genesis.entry -%}
{%- set sel = e.selection -%}
{%- set acq = bs.genesis.acquisition -%}
{%- set sr = bs.genesis.source_record -%}
{%- set l = bs.genesis.launch -%}
{%- set b = bs.genesis.builder -%}
{%- set sa = bs.source_admission -%}
{%- set bi = sa.bootstrap_input -%}
{%- set wr = bs.work_roots -%}
{%- set sep = bs.path_admission.separator -%}
{#- the policy-sourced record values of the declared construction map, walked over the RESOLVED declaration -#}
{%- set pv = namespace(p=[]) -%}
{%- for k, c in bi.construction.fields | dictsort if c.source == bi.construction.sources.policy -%}
{%- set w = namespace(n=bs) -%}{%- for p in c.path -%}{%- set w.n = w.n[p] -%}{%- endfor -%}
{%- set pv.p = pv.p + [[k, w.n]] -%}
{%- endfor -%}
{#- flow word -> the plan's acquisition_inputs (selection.flows maps plan key -> flow word) -#}
{%- set af = namespace(p=[]) -%}
{%- for pk, p in sel.plans | dictsort -%}{%- set af.p = af.p + [[sel.flows[pk], p.acquisition_inputs]] -%}{%- endfor -%}
{%- set iface = {
  'policy_values': dict(pv.p),
  'anchor_var': sr.anchor.var,
  'record_var': bi.var,
  'record_keys': bi.record_keys | sort,
  'construction': bi.construction,
  'context_fields': sa.early_view.context_fields,
  'launch_context_fields': sa.early_view.launch_context_fields,
  'stage': sr.stage,
  'act_var': l.stage_root.act.var,
  'output': sr.output,
  'stage_root': [wr.root_rel, wr.sub_roots[l.stage_root.sub], l.stage_root.rel, sr.stage] | join(sep),
  'refusals': sr.refusals,
  'texts': sr.texts,
  'declaration_rel': bi.declaration_rel,
  'declaration_path': bi.declaration_path,
  'controller_delegate': sa.controller_delegate,
  'edition_regex': sa.git.edition_regex,
  'digest_regex': e.digest_regex,
  'rel_path_grammar': sa.rel_path_grammar,
  'separator': sep,
  'override_var': sa.early_view.override.var,
  'builder': {
    'core': b.core,
    'root_rel': [wr.root_rel, wr.sub_roots[b.root.sub]] | join(sep),
    'generations_dir': bs.layout.generations_dir,
    'python_rel': [bs.layout.gen_dirs[b.python.gen_dir], b.python.rel] | join(sep),
    'executable_rel': [bs.layout.gen_dirs[b.executable.gen_dir], b.executable.rel] | join(sep),
    'config_rel': bs.layout.config_file,
  },
  'store_rel': [wr.root_rel, wr.sub_roots[e.store.sub], e.store.rel] | join(sep),
  'source_var': acq.source_var,
  'receipt_var': acq.receipt_var,
  'bundle_var': acq.bundle_var,
  'flow_input': sel.input,
  'acquisition_by_flow': dict(af.p),
  'acquisition_vars': [acq.source_var, acq.receipt_var, acq.bundle_var],
} -%}
{%- set guard = iface | tojson -%}
---
# testing/remote_harness/source_bootstrap.yml -- GENERATED from {{ e.producer.template_rel }} by the declared authored ->
# generated sequence (context kind {{ e.render.context_kind }}); COMMITTED, drift-checked, never hand-edited.
# The GENESIS SOURCE RECORD PRODUCER stage ({{ sr.stage }}): ONE typed stage input {{ sr.anchor.var }} (source class
# {{ sr.anchor.source }}) = the PROVISIONAL launch record the genesis entry built from the RESOLVED declaration; NO
# source_record slot (it produces the record; OD-GEN-01). Order:
#   0. interface guard       the visible play interface is exactly the rendered one (first task; no other read)
#   1. refuse_pinned_outputs first-entry reserved-output guard + rh_repo_root (unchanged)
#   2. admit_controller      local, localhost, no become (unchanged)
#   3. genesis_source_record forged / anchor shape / builder identity before any module / interpreter bind; binds the
#                            provisional record under the record var ({{ bi.var }})
#   4. resolve_policy        the ONE resolver (admit_loader_source: full source admission + the existing effective-
#                            context / operator-override admission, override LAST)
#   5. admit_builder         the full builder admission of this stage (parent-owned)
#   6. genesis_source_record_emit  interface == resolved; the verified generation receipt; the inventory store binding;
#                            the record rebuilt from the RESOLVED projection == the provisional one; written once
- name: Produce the genesis source-bootstrap record (cold; one resolver; record rebuilt from the resolved projection)
  hosts: localhost
  connection: local
  gather_facts: false
  become: false
  vars:
    {{ sr.interface.var }}: {{ guard }}
  tasks:
    - name: "GENESIS SOURCE RECORD -- refuse an overridden producer interface (first task; before any read)"
      ansible.builtin.assert:
        that:
          - {{ ('(' ~ sr.interface.var ~ ' | to_json(sort_keys=true)) == (' ~ (guard | tojson) ~ ' | from_json | to_json(sort_keys=true))') | tojson }}
        fail_msg: {{ (bs.refusal_grammar.marker ~ bs.refusal_grammar.code_separator ~ sr.refusals.interface ~ bs.refusal_grammar.delimiter ~ bs.refusal_grammar.detail_separator ~ sr.texts.interface) | tojson }}
        quiet: true

    - name: Refuse pre-supplied derived outputs and derive the repository root
      ansible.builtin.include_tasks: tasks/refuse_pinned_outputs.yml

    - name: Bind the effective controller connection before any effect (local, localhost, no become)
      ansible.builtin.include_tasks: tasks/admit_controller.yml

    - name: Admit the anchor and the managed builder before any module, and bind the provisional record
      ansible.builtin.include_tasks: tasks/genesis_source_record.yml

    - name: Resolve the harness policy through the engine (admit_loader_source consumes the provisional record)
      ansible.builtin.include_tasks: tasks/resolve_policy.yml
      vars:
        # route op1q (CPL-SR922E-ROUTE-SOURCE-BOOTSTRAP-CALLER; codex 929; s41 include-site rule): the caller rel exactly as
        # C1 declares it, s64 resolve_phases.callers :7278-7283 (phase full), pinned by r51 :6458-6465 (route op2c retarget); copied literally
        rh_rp_caller: testing/remote_harness/source_bootstrap.yml
        rh_invocation_requirement: {{ bs.source_admission.invocation.requirements.ordinary_permitted | tojson }}

    - name: Admit exactly the declared builder before any write (GENESIS)
      ansible.builtin.include_tasks: tasks/admit_builder.yml
      vars:
        rh_gen_stage: {{ sr.stage }}

    - name: Prove interface == resolved, bind the verified generation and the store, rebuild and emit the record
      ansible.builtin.include_tasks: tasks/genesis_source_record_emit.yml
