{#- testing/remote_harness/templates/observation_step.j2 -- renders, for observe.yml and tasks/observe_step.yml, ONE
    part of the generic read-only observation runner from the macros in macros/observation.j2 (same import pattern as
    private_group_program.j2). Every part prints ONE JSON value; the caller reads it back with from_json.
    Inputs (template_vars, no defaults): rh_obs_part and the part's arguments:
      validate          rh_obs_jobs, rh_obs_ot
      job_tools         rh_obs_jobs, rh_obs_job
      identity_command  rh_obs_jobs, rh_obs_tools, rh_obs_ot, rh_obs_oti, rh_obs_loc
      identity_check    rh_obs_tools, rh_obs_ot, rh_obs_oti, rh_obs_pv, rh_obs_out
      principal_check   rh_obs_owner, rh_obs_out
      instances         rh_obs_jobs, rh_obs_job, rh_obs_step, rh_obs_ot, rh_obs_hin, rh_obs_prior, rh_obs_loc
      classify          rh_obs_jobs, rh_obs_step, rh_obs_insts, rh_obs_results, rh_obs_prior, rh_obs_extract
      stop              rh_obs_jobs, rh_obs_step, rh_obs_recs
      coverage          rh_obs_job, rh_obs_prior, rh_obs_hin
      host_result       rh_obs_jobs, rh_obs_job, rh_obs_prior, rh_obs_why, rh_obs_hin -#}
{%- import 'macros/observation.j2' as o -%}
{%- if rh_obs_part == 'validate' -%}
{{ o.validate(rh_obs_jobs, rh_obs_ot) }}
{%- elif rh_obs_part == 'job_tools' -%}
{{ o.job_tools(rh_obs_jobs, rh_obs_job) }}
{%- elif rh_obs_part == 'identity_command' -%}
{{ o.identity_command(rh_obs_jobs, rh_obs_tools, rh_obs_ot, rh_obs_oti, rh_obs_loc) }}
{%- elif rh_obs_part == 'identity_check' -%}
{{ o.identity_check(rh_obs_tools, rh_obs_ot, rh_obs_oti, rh_obs_pv, rh_obs_out) }}
{%- elif rh_obs_part == 'principal_check' -%}
{{ o.principal_check(rh_obs_owner, rh_obs_out) }}
{%- elif rh_obs_part == 'coverage' -%}
{{ o.coverage(rh_obs_job, rh_obs_prior, rh_obs_hin) }}
{%- elif rh_obs_part == 'instances' -%}
{{ o.instances(rh_obs_jobs, rh_obs_job, rh_obs_step, rh_obs_ot, rh_obs_hin, rh_obs_prior, rh_obs_loc) }}
{%- elif rh_obs_part == 'classify' -%}
{{ o.classify(rh_obs_jobs, rh_obs_step, rh_obs_insts, rh_obs_results, rh_obs_prior, rh_obs_extract) }}
{%- elif rh_obs_part == 'stop' -%}
{{ o.stop(rh_obs_jobs, rh_obs_step, rh_obs_recs) }}
{%- elif rh_obs_part == 'host_result' -%}
{{ o.host_result(rh_obs_jobs, rh_obs_job, rh_obs_prior, rh_obs_why, rh_obs_hin) }}
{%- else -%}
{{ undefined_rh_obs_part_must_be_a_declared_part }}
{%- endif -%}
