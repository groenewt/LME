{%- set sr = bs.genesis.source_record -%}
{%- set sel = bs.genesis.entry.selection -%}
{%- set sa = bs.source_admission -%}
{%- set bi = sa.bootstrap_input -%}
{%- set cm = bi.construction -%}
{%- set c = cd.refusals -%}
{%- set tw = namespace(n=bs) -%}{%- for k in cd.texts_from -%}{%- set tw.n = tw.n[k] -%}{%- endfor -%}
{%- if tw.n.keys() | list | select('in', cd.texts.keys() | list) | list | length != 0 -%}{{ cd['custody.texts overlaps the texts_from map'].render_error }}{%- endif -%}
{%- set t = dict((tw.n | dictsort) + (cd.texts | dictsort)) -%}
{%- set st = {'playbook_rel': gi.playbook_rel, 'extra_vars': [], 'stage_inputs': [{'name': gi.root_input.var, 'source': gi.root_input.source}]} -%}
{%- set stp = {'inventory_kind': cd.launch.inventory_kind, 'extra_vars': {}} -%}
{%- set kd = l.inventory_kinds[cd.launch.inventory_kind] -%}
{%- set fr = namespace(slots=[], pairs=[], bad=false) -%}
{%- for r in kd.files -%}
{%- if r in sel.file_args -%}{%- set fr.slots = fr.slots + [sel.file_args[r]] -%}{%- set fr.pairs = fr.pairs + [[r, sel.file_args[r]]] -%}
{%- else -%}{%- set fr.bad = true -%}{%- endif -%}
{%- endfor -%}
{%- if (gi.root_input.runtime.values() | unique | list | length) != 1 -%}{{ cd['this template binds exactly one runtime role (the admitted A python "$BP")'].render_error }}{%- endif -%}
{%- set rtw = {cm.sources.edition: '"$ED"', cm.sources.digest: '"$DS"', (gi.root_input.runtime.values() | first): '"$BP"'} -%}
{%- set dp = gi.dispatch -%}
{%- set ev = dp.evidence -%}
{%- set wr = bs.work_roots -%}
{%- set gr = sa.rel_path_grammar -%}
{%- set k = l.step_record.emit['keys'] -%}
{%- set v = l.step_record.emit['values'] -%}
{%- set fm = l.step_record.emit.formats -%}
{%- set pst = namespace(s=[], bad=(dp is not mapping or dp.flow not in sel.plans or dp.flow not in sel.flows)) -%}
{%- if not pst.bad -%}{%- for x in sel.plans[dp.flow].steps -%}{%- set pst.s = pst.s + [x.stage] -%}{%- endfor -%}{%- endif -%}
{%- set gk = ev.generation -%}
{%- set gb = namespace(bad=(gk is string or gk is mapping or gk is not sequence or (gk | length) != 2), h='', w='') -%}
{%- if not gb.bad and (gk[0] not in k or k[gk[0]] is not mapping or k[gk[0]].key is not string or gk[1] not in k[gk[0]]) -%}{%- set gb.bad = true -%}{%- endif -%}
{%- if not gb.bad -%}{%- set gb.h = k[gk[0]].key ~ fm.key_indicator ~ fm.value_space ~ fm.flow_mapping.open -%}{%- set gb.w = k[gk[0]][gk[1]] ~ fm.key_indicator ~ fm.value_space -%}{%- endif -%}
{%- set kv = fm.placeholder ~ fm.key_indicator ~ fm.value_space ~ fm.placeholder -%}
{%- set f_kv = kv ~ fm.line_terminator -%}
{%- set f_ikv = fm.indent ~ kv ~ fm.line_terminator -%}
{%- set f_src = fm.placeholder ~ fm.key_indicator ~ fm.value_space ~ fm.flow_mapping.open ~ (([kv] * 4) | join(fm.flow_mapping.item_separator)) ~ fm.flow_mapping.close ~ fm.line_terminator -%}
{%- set ci = k.config.inventory -%}
{%- set cl = namespace(m={}, bad=false) -%}
{%- set cr = namespace(rt=[], rows=[]) -%}
{%- for ck in gi.root_input.cold_only -%}
{%- if ck not in gi.root_input.cold_forms -%}{%- set cl.bad = true -%}
{%- else -%}
{%- set cl.form = gi.root_input.cold_forms[ck] -%}
{%- if cl.form.inventory_kind != cd.launch.inventory_kind or cl.form.fields is string or cl.form.fields is mapping or cl.form.fields is not sequence or (cl.form.fields | sort) != ([ci.role, ci.path, ci.sha256] | sort) -%}{%- set cl.bad = true -%}
{%- else -%}
{%- set cr.rt = [] -%}{%- set cr.rows = [] -%}
{%- for f in cl.form.fields -%}{%- set cr.rt = cr.rt + [f != ci.role] -%}{%- endfor -%}
{%- for r, slot in fr.pairs -%}
{%- set rc = namespace(c=[]) -%}
{%- for f in cl.form.fields -%}{%- if f == ci.role -%}{%- set rc.c = rc.c + [r] -%}{%- elif f == ci.path -%}{%- set rc.c = rc.c + ['"$_a_' ~ slot ~ '"'] -%}{%- else -%}{%- set rc.c = rc.c + ['"$_dg_' ~ r ~ '"'] -%}{%- endif -%}{%- endfor -%}
{%- set cr.rows = cr.rows + [rc.c] -%}
{%- endfor -%}
{%- set cl.m = dict((cl.m | dictsort) + [(ck, {'fields': cl.form.fields, 'runtime': cr.rt, 'rows': cr.rows})]) -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- set co = namespace(bad=(sa.carrier_state_schema.root_input_nodes is not mapping or sa.carrier_state_schema.root_input_nodes.carried is not string or sa.carrier_state_schema.root_input_nodes.carried not in gi.root_input or gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] is string or gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] is mapping or gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] is not sequence or sa.carrier_state_schema.complete_only is string or sa.carrier_state_schema.complete_only is mapping or sa.carrier_state_schema.complete_only is not sequence)) -%}
{%- if not co.bad -%}{%- for f in sa.carrier_state_schema.complete_only -%}
{%- if cm.fields[f].source != cm.sources.context or f in gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] + gi.root_input.cold_only + gi.root_input.override_keys + [gi.root_input.override_state.key] -%}{%- set co.bad = true -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
{%- if pst.bad or gb.bad or cl.bad or co.bad
     or gi.stage in pst.s or gi.stage == sr.stage or sr.stage not in pst.s or ev.publication.stage not in pst.s
     or gi.stage not in bs.genesis.builder.authoring.initializer
     or gi.playbook_rel not in cd.record_free_launches
     or l.stages[gi.stage].playbook_rel != gi.playbook_rel or l.stages[gi.stage].extra_vars | length != 0
     or (gi.root_input.cold_forms.keys() | list | sort) != (gi.root_input.cold_only | sort)
     or gi.root_input.cold_only | select('in', gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] + gi.root_input.override_keys + bi.record_keys) | list | length != 0
     or gi.root_input.override_state.key in gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] + gi.root_input.cold_only + gi.root_input.override_keys + bi.record_keys
     or fr.slots | reject('in', cd.path_params) | list | length != 0
     or cd.launch.inventory_kind not in l.stages[gi.stage].inventory
     or cd.launch.flow not in sel.flows
     or 'receipt' in kd
     or fr.bad
     or fr.slots | reject('in', cd.params) | list | length != 0
     or gi.root_input.source not in l.input_sources.values() | list
     or gi.root_input.source == sr.anchor.source
     or (c.keys() | list | sort) != (cd.statuses.keys() | list | sort)
     or c.values() | select('in', bs.refusals.keys() | list) | list | length != 0
     or cd.statuses.values() | select('in', bs.refusals.values() | list) | list | length != 0
     or gi.root_input[sa.carrier_state_schema.root_input_nodes.carried] | reject('in', bi.record_keys) | list | length != 0
     or gi.root_input.phase != sa.resolve_phases.callers[gi.playbook_rel]
     or gi.root_input.override_keys | select('in', cd.params) | list | length != 0
     or (cd.param_roles.values() | list) | reject('in', cd.params) | list | length != 0
     or cd.path_params | reject('in', cd.params) | list | length != 0 -%}
