{#- testing/remote_harness/templates/private_group_program.j2 -- renders, for playbook consumers, the SAME owner-private-
    group text the seed embeds (macros/controller_seed.j2; path_admission.ancestry.owner_private_group):
      rh_pg_part == 'program' : the decision program (macro private_group_program), run by tasks/decide_private_group.yml
                                on the controller and by the synthetic fixtures (tests/private_group_fixtures.yml)
      rh_pg_part == 'facts'   : the fact-gathering sh text (macro private_group_facts) for the directory named by the
                                shell variable _pgdir, prefixed by `_uid=$(<os_tools.id> -u)`; target_bootstrap.yml sends it
                                over the initial-contact raw channel (declared tools only, read-only)
    Inputs: rh_pg_bs = the resolved remote_harness.controller.bootstrap map; rh_pg_part. -#}
{%- import 'macros/controller_seed.j2' as m -%}
{%- if rh_pg_part == 'program' -%}
{{ m.private_group_program(rh_pg_bs) }}
{%- elif rh_pg_part == 'facts' -%}
_uid=$({{ m.x(rh_pg_bs, 'id') }} -u)
{{ m.private_group_facts(rh_pg_bs, '_pgdir') }}
{%- else -%}
{{ undefined_rh_pg_part_must_be_program_or_facts }}
{%- endif -%}
