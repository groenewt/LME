# GreptimeDB v1.1.3: candidate starting configuration for a 1 GiB cgroup.
# Runtime capacity acceptance is still required.
user_provider = "static_user_provider:file:/run/secrets/greptime-users"
enable_telemetry = false
init_regions_parallelism = 2
max_concurrent_queries = 4
max_in_flight_write_bytes = "16MiB"
write_bytes_exhausted_policy = "fail"

[runtime]
global_rt_size = 2
compact_rt_size = 1

[http]
addr = "0.0.0.0:4000"
timeout = "15s"
body_limit = "4MiB"
enable_cors = false

[grpc]
bind_addr = "127.0.0.1:4001"
runtime_size = 2

[mysql]
enable = false

[postgres]
enable = false

[opentsdb]
enable = false

[influxdb]
enable = false

[jaeger]
enable = false

[otlp]
enable = true

[wal]
provider = "raft_engine"
dir = "/var/lib/greptime/wal"
sync_write = true
file_size = "64MiB"
purge_threshold = "256MiB"
recovery_parallelism = 1

[storage]
type = "File"
data_home = "/var/lib/greptime"

[query]
parallelism = 2
memory_pool_size = "64MiB"

[flow]
num_workers = 1

[[region_engine]]
[region_engine.mito]
num_workers = 2
max_background_flushes = 1
max_background_compactions = 1
max_background_purges = 1
global_write_buffer_size = "64MiB"
global_write_buffer_reject_size = "96MiB"
sst_meta_cache_size = "8MiB"
vector_cache_size = "16MiB"
page_cache_size = "16MiB"
selector_result_cache_size = "8MiB"
range_result_cache_size = "8MiB"
prefilter_result_cache_size = "4MiB"
manifest_cache_size = "16MiB"
scan_memory_limit = "64MiB"
experimental_compaction_memory_limit = "32MiB"
max_concurrent_scan_files = 8

[region_engine.mito.index]
metadata_cache_size = "4MiB"
content_cache_size = "8MiB"
result_cache_size = "8MiB"

[region_engine.mito.inverted_index]
mem_threshold_on_create = "16MiB"

[region_engine.mito.fulltext_index]
mem_threshold_on_create = "16MiB"

[region_engine.mito.bloom_filter_index]
mem_threshold_on_create = "16MiB"

[[region_engine]]
[region_engine.file]

[[region_engine]]
[region_engine.metric]
sparse_primary_key_encoding = true

[logging]
dir = "/var/lib/greptime/logs"
level = "info"
append_stdout = true
log_format = "json"
max_log_files = 24

[memory]
enable_heap_profiling = false
