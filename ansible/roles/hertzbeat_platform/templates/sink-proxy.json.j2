{
  "mode": "hertzbeat",
  "listen_host": "127.0.0.1",
  "listen_port": 1457,
  "backend_host": "127.0.0.1",
  "backend_port": 1157,
  "metrics_backend_port": 4000,
  "metrics_tables": {{ hertzbeat_platform.sink_gateway.metrics_tables | to_json }},
  "policy_file": {{ hertzbeat_platform.sink_gateway.policy_file | to_json }},
  "max_body_bytes": 1048576,
  "max_response_bytes": 1048576,
  "max_connections": 2,
  "timeout_seconds": 10
}
