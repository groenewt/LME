[Unit]
Description=LME HertzBeat source-scoped ingestion and query gateway
After=hertzbeat.service
Requires=hertzbeat.service

[Service]
Type=simple
WorkingDirectory={{ hertzbeat_platform.data_home }}/hertzbeat/sink-proxy
ExecStartPre=/usr/bin/python3 -m lme_sink_proxy check-config --config {{ hertzbeat_platform.data_home }}/hertzbeat/config/sink-proxy.json
ExecStart=/usr/bin/python3 -m lme_sink_proxy run --config {{ hertzbeat_platform.data_home }}/hertzbeat/config/sink-proxy.json
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2
MemoryMax={{ hertzbeat_platform.sink_gateway.memory_mib }}M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
