[Unit]
Description=LME GreptimeDB 1.1.3 native HertzBeat history

[Container]
LogDriver=journald
Image={{ hertzbeat_platform.greptime.image }}
ContainerName=lme-greptime
Pod=hertzbeat.pod
User={{ hertzbeat_platform.uid }}
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/config/greptime.toml:/etc/greptime/standalone.toml:ro
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/greptime:/var/lib/greptime:rw
Volume={{ hertzbeat_platform.secret_directory }}/greptime-users:/run/secrets/greptime-users:ro
Exec=--log-dir=/var/lib/greptime/logs standalone start -c /etc/greptime/standalone.toml --user-provider=static_user_provider:file:/run/secrets/greptime-users
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=128m

[Service]
Restart=on-failure
TimeoutStartSec=120
MemoryMax=1G

[Install]
WantedBy=default.target
