spring:
  config:
    import: configtree:/run/secrets/hertzbeat/
  datasource:
    driver-class-name: org.postgresql.Driver
    hikari:
      connection-init-sql: "SET synchronous_commit TO on"
    url: {{ hertzbeat_platform.schema_database.url | to_json }}
    username: {{ hertzbeat_platform.schema_database.username | to_json }}
    password: "${password}"
  jpa:
    database: postgresql
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    baseline-on-migrate: true
    baseline-version: 1
    clean-disabled: true
    locations: [classpath:db/migration/postgresql]
