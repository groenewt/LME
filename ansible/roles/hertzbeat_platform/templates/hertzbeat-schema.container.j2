[Unit]
Description=LME HertzBeat one-shot Hibernate then Flyway initialization
After=network-online.target
Conflicts=hertzbeat.service

[Container]
LogDriver=journald
Image={{ hertzbeat_platform.image }}
ContainerName=lme-hertzbeat-schema
WorkingDir=/opt/hertzbeat
UserNS=keep-id
Network=lme-{{ hertzbeat_platform.user }}.network
User={{ hertzbeat_platform.uid }}
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/config:/opt/hertzbeat/config:ro
Volume={{ hertzbeat_platform.schema_database.secret_directory }}:/run/secrets/hertzbeat:ro
Volume={{ hertzbeat_platform.truststore_file }}:/opt/hertzbeat/config/truststore.p12:ro
Environment="JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/opt/hertzbeat/config/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12"
Entrypoint=java
Exec=--add-opens=java.base/java.nio=ALL-UNNAMED -jar /opt/hertzbeat/apache-hertzbeat-1.9.0.jar --schema-only --spring.config.additional-location=file:/opt/hertzbeat/config/schema-application.yml
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=256m
Tmpfs=/opt/hertzbeat/logs:rw,size=32m

[Service]
MemoryMax={{ hertzbeat_platform.memory_mib }}M
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
ExecStartPost=/usr/bin/touch {{ hertzbeat_platform.data_home }}/hertzbeat/schema-{{ hertzbeat_platform.image.split(':')[-1] }}.ready
