[Unit]
Description=LME HertzBeat pinned native monitoring
ConditionPathExists={{ hertzbeat_platform.data_home }}/hertzbeat/schema-{{ hertzbeat_platform.image.split(':')[-1] }}.ready
After=network-online.target greptime.service
Requires=greptime.service
Wants=network-online.target

[Container]
LogDriver=journald
Image={{ hertzbeat_platform.image }}
ContainerName=lme-hertzbeat
WorkingDir=/opt/hertzbeat
Pod=hertzbeat.pod
User={{ hertzbeat_platform.uid }}
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/config:/opt/hertzbeat/config:ro
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/logs:/opt/hertzbeat/logs:rw
Volume={{ hertzbeat_platform.data_home }}/hertzbeat/data:/opt/hertzbeat/data:rw
Volume={{ hertzbeat_platform.native_export.directory }}:/var/lib/hertzbeat/native-metrics:rw
Volume={{ hertzbeat_platform.database.client_secret_directory }}:/run/secrets/hertzbeat-pg:ro
Volume={{ hertzbeat_platform.secret_directory }}/sureness.yml:/opt/hertzbeat/config/sureness.yml:ro
Volume={{ hertzbeat_platform.secret_directory }}:/run/secrets/hertzbeat:ro
{% if hertzbeat_platform.jmx_client_options_file %}
Volume={{ hertzbeat_platform.jmx_client_options_file }}:/run/secrets/hertzbeat/jmx-client.options:ro
{% endif %}
Volume={{ hertzbeat_platform.truststore_file }}:/opt/hertzbeat/config/truststore.p12:ro
Volume={{ hertzbeat_platform.known_hosts_file }}:/opt/hertzbeat/config/known_hosts:ro
Environment="JAVA_TOOL_OPTIONS=-Djava.security.properties=/opt/hertzbeat/config/java.security -Djavax.net.ssl.trustStore=/opt/hertzbeat/config/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Dhertzbeat.ssh.knownHosts=/opt/hertzbeat/config/known_hosts"
Entrypoint=java
Exec={% if hertzbeat_platform.jmx_client_options_file %}@/run/secrets/hertzbeat/jmx-client.options {% endif %}--add-opens=java.base/java.nio=ALL-UNNAMED -jar /opt/hertzbeat/apache-hertzbeat-1.9.0.jar --spring.config.additional-location=file:/opt/hertzbeat/config/application.yml
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=256m

[Service]
Restart=on-failure
TimeoutStartSec=120
MemoryMax={{ hertzbeat_platform.memory_mib }}M

[Install]
WantedBy=default.target
