spring:
  config:
    import: configtree:/run/secrets/hertzbeat/
  datasource:
    driver-class-name: org.postgresql.Driver
    hikari:
      connection-init-sql: "SET synchronous_commit TO on"
    url: {{ hertzbeat_platform.database.url | to_json }}
    username: {{ hertzbeat_platform.database.username | to_json }}
  jpa:
    database: postgresql
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: false
    clean-disabled: true
    baseline-on-migrate: true
    baseline-version: 1
    locations: [classpath:db/migration/postgresql]
common:
  queue:
    metrics-alert-capacity: 32
    metrics-storage-capacity: 32
server:
  address: 0.0.0.0
  port: 1157
hertzbeat:
  native-export:
    run-id: {{ hertzbeat_platform.run_id | to_json }}
    enabled: {{ hertzbeat_platform.native_export.enabled | lower }}
    admission-enabled: {{ hertzbeat_platform.native_export.admission_enabled | lower }}
    directory: /var/lib/hertzbeat/native-metrics
    sinks: elastic
    allowed-labels: {{ hertzbeat_platform.native_export.allowed_labels | default('') | to_json }}
    max-bytes: 268435456
    reserve-bytes: 2147483648
    endpoint: {{ hertzbeat_platform.native_export.endpoint | default('') | to_json }}
    host-id: {{ hertzbeat_platform.native_export.host_id | default('') | to_json }}
    host-name: {{ hertzbeat_platform.native_export.host_name | default('') | to_json }}
    auth-header-file: /run/secrets/hertzbeat/native-export-authorization
    auth-header-map-file: /run/secrets/hertzbeat/native-source-authorization.json
    endpoint-map-file: /run/secrets/hertzbeat/native-source-endpoints.json
lme:
  lifecycle:
    enabled: {{ hertzbeat_platform.lifecycle.enabled | lower }}
    source-node: {{ hertzbeat_platform.lifecycle.source_node | default('') | to_json }}
    admission-url: {{ hertzbeat_platform.lifecycle.admission_url | default('') | to_json }}
    token-file: /run/secrets/hertzbeat/lifecycle-token
    max-bytes: 67108864
    acceptance:
      enabled: {{ hertzbeat_platform.lifecycle.acceptance.enabled | lower }}
      run-id: {{ hertzbeat_platform.lifecycle.acceptance.run_id | to_json }}

# Same-owner rootless pod only. External access terminates at the verified Serve ingress.
warehouse:
  store:
    duckdb:
      enabled: false
    greptime:
      enabled: true
      grpc-endpoints: 127.0.0.1:4001
      http-endpoint: http://127.0.0.1:4000
      database: public
      username: {{ hertzbeat_platform.greptime.username | to_json }}
      password: "${warehouse.store.greptime.runtime-password}"
