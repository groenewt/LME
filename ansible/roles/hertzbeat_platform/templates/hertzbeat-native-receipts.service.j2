[Unit]
Description=LME queried native metric receipts for the HertzBeat owner
After=hertzbeat.service network-online.target
Requires=hertzbeat.service

[Service]
Type=oneshot
WorkingDirectory={{ hertzbeat_platform.data_home }}/hertzbeat/native-receipts
ExecStart=/usr/bin/python3 -m lme_telemetry --config {{ hertzbeat_platform.data_home }}/hertzbeat/config/native-receipts.json verify-native-metrics --outbox-dir {{ hertzbeat_platform.native_export.directory }}
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=120
TimeoutStopSec=5
MemoryMax={{ hertzbeat_platform.native_receipts.memory_mib }}M
CPUQuota=50%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ hertzbeat_platform.native_export.directory }}
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
