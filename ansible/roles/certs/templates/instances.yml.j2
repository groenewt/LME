# certs.san_dns / certs.san_ip), never here.
#
# The instance list is DERIVED, not hand-authored. A service gets a leaf cert iff:
#   (1) it is a cert consumer  -- it mounts either the shared workspace `lme_certs`
#       or its own per-service bundle `cert:<id>`, AND
#   (2) it needs its OWN leaf  -- it terminates TLS: it publishes a port OR its
#       manifest references its own leaf path `<id>/<id>.(crt|key)` (an internal
#       TLS server such as llama-cpp). A manifest may state this with
#       `certs.needs_leaf` explicitly.
# Pure CA-verifying clients (the beats filebeat/heartbeat/metricbeat -- a certs
# block but no published port and no own-leaf reference) are EXCLUDED: their
# published bundle carries only ca/ca.crt, no minted leaf.
#
# init-setup.sh mints one leaf per entry into  certs/<id>/<id>.(crt|key|chain.pem).
{% set es_hosts = groups.get('elasticsearch', []) %}
{% set flags = lme_enable_flags | default({}) %}
{% set absent = lme_child_absent_services | default([]) %}
instances:
{% for id in (lme_services | default({})).keys() | sort %}
{% set svc = lme_services[id] %}
{% set sources = (svc.volumes | default([]) | map(attribute='source') | list) %}
{% set is_cert_consumer = ('lme_certs' in sources) or ((sources | select('match', '^cert:') | list | length) > 0) %}
{% set has_ports = (svc.publish_ports | default([]) | length) > 0 %}
{% set j = svc | to_json %}
{% set refs_own_leaf = ((id ~ '/' ~ id ~ '.key') in j) or ((id ~ '/' ~ id ~ '.crt') in j) %}
{% set needs_leaf = (svc.certs.needs_leaf if (svc.certs is defined and svc.certs.needs_leaf is defined) else (has_ports or refs_own_leaf)) %}
{% set enabled = (svc.enabled_when | default(['always']) | is_enabled(flags)) and (id not in absent) %}
{% if is_cert_consumer and needs_leaf and enabled %}
  - name: "{{ id }}"
    dns:
{% for alias in (svc.network_aliases | default(['lme-' ~ id])) %}
      - "{{ alias }}"
{% endfor %}
      - "localhost"
{% for san in (svc.certs.san_dns | default([]) if svc.certs is defined else []) %}
      - "{{ san }}"
{% endfor %}
{% if id == 'elasticsearch' %}
{% for h in es_hosts %}
      - "{{ h }}"
{% set ah = hostvars[h].get('ansible_host', '') %}
{% if ah and (ah is string) and not (ah is match('^\\d+\\.\\d+\\.\\d+\\.\\d+$')) %}
      - "{{ ah }}"
{% endif %}
{% endfor %}
{% endif %}
    ip:
      - "127.0.0.1"
{% for san in (svc.certs.san_ip | default([]) if svc.certs is defined else []) %}
      - "{{ san }}"
{% endfor %}
{% if id == 'elasticsearch' %}
{% for h in es_hosts %}
{% set ip = hostvars[h].get('es_cluster_ip', hostvars[h].get('ansible_host', '')) %}
{% if ip and (ip is string) and (ip is match('^\\d+\\.\\d+\\.\\d+\\.\\d+$')) %}
      - "{{ ip }}"
{% endif %}
{% endfor %}
{% endif %}
