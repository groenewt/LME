[Unit]
Description=LME tailnet identity capability proxy
After=network.target
Before=lme-identity-serve.service

[Service]
Type=simple
User={{ identity_proxy_user }}
Group={{ identity_proxy_group }}
WorkingDirectory={{ identity_proxy_working_directory }}
RuntimeDirectory=lme-identity
RuntimeDirectoryMode=0750
UMask=0117
LoadCredential=webui-api-key:{{ identity_proxy_backend_api_key_source_file }}
Environment=LME_BACKEND_API_KEY_FILE={{ identity_proxy_backend_api_key_file }}
Environment=LME_DASHBOARD_BACKEND_URL={{ identity_proxy_backend_url }}
Environment=LME_BACKEND_CA_FILE={{ identity_proxy_backend_ca_file }}
Environment=LME_OPERATOR_LOGIN_FILE={{ identity_proxy_operator_login_file }}
Environment=LME_REQUIRED_CAPABILITY={{ identity_proxy_required_capability }}
{% if identity_proxy_public_origin | length > 0 %}
Environment=LME_PUBLIC_ORIGIN={{ identity_proxy_public_origin }}
{% endif %}
ExecStart={{ identity_proxy_python }} -m uvicorn lme_identity.proxy:app --uds {{ identity_proxy_socket }} --no-proxy-headers
Restart=on-failure
MemoryHigh=192M
MemoryMax=224M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths={{ identity_proxy_operator_login_file }} {{ identity_proxy_backend_api_key_file }} {{ identity_proxy_backend_ca_file }}

[Install]
WantedBy=multi-user.target
