[Unit]
Description=Tailscale Serve ingress for the LME identity proxy
After=tailscaled.service lme-identity-proxy.service
Requires=tailscaled.service lme-identity-proxy.service

[Service]
Type=oneshot
RemainAfterExit=true
MemoryHigh=24M
MemoryMax=32M
ExecStart=/usr/bin/tailscale serve --yes --bg --https={{ identity_proxy_serve_port }} --accept-app-caps={{ identity_proxy_required_capability }} unix:{{ identity_proxy_socket }}
ExecStop=/usr/bin/tailscale serve --yes --https={{ identity_proxy_serve_port }} off

[Install]
WantedBy=multi-user.target
