{#
  logical.pgpass -- libpq passfile the subscriber uses for logical replication
  (user 'lme_replicator') to each origin's pg-<origin>-rw endpoint. SECRET-BEARING
  (no_log render). Rendered only for dual-owned-ha (imports non-empty). Password
  is the ORIGIN domain's lme_replicator secret (lme_lab.credentials:443,
  subscription_sql passfile at platform.py:419/provision.py:82).
#}
{%- set domain = cm_domain -%}
{% for imp in credential_material_domain_imports[domain] %}
pg-{{ imp.origin }}-rw:5432:{{ imp.db }}:lme_replicator:{{ lookup('file', _cm_staging_root ~ '/secrets/pg-' ~ imp.origin ~ '-lme_replicator') | trim }}
{% endfor %}
