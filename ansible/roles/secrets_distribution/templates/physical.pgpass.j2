{#
  physical.pgpass -- libpq passfile for physical streaming replication
  (user 'replicator'). SECRET-BEARING (no_log render). Mounted only for the
  rejoin operation container (rejoin.py:171). Line format
  hostname:port:database:username:password, one per member (lme_lab.credentials:442).
#}
{%- set domain = cm_domain -%}
{%- set port = credential_material_domain_port[domain] -%}
{%- set replpw = lookup('file', _cm_staging_root ~ '/secrets/pg-' ~ domain ~ '-replicator') | trim -%}
{#- One line per DECLARED member of THIS domain (canonical
    lme_resolved.database.domains[domain].members), NOT the cross-domain union
    _cm_member_nodes -- a non-member host must never receive a replication line here.
    Order follows the declared member list (deterministic for reapply identity). The
    base64url password alphabet contains no ':' or '\', so no pgpass escaping is needed. -#}
{%- set members = lme_resolved.database.domains[domain].members -%}
{% for n in members %}
{{ lme_runtime_inventory.hosts[n].fqdn }}:{{ port }}:replication:replicator:{{ replpw }}
{% endfor %}
