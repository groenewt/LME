{#
  physical.pgpass -- libpq passfile for physical streaming replication
  (user 'replicator'). SECRET-BEARING (no_log render). Mounted only for the
  rejoin operation container (rejoin.py:171). Line format
  hostname:port:database:username:password, one per member (lme_lab.credentials:442).
#}
{%- set domain = cm_domain -%}
{%- set port = credential_material_domain_port[domain] -%}
{%- set replpw = lookup('file', credential_materializer_staging_dir ~ '/secrets/pg-' ~ domain ~ '-replicator') | trim -%}
{% for n in _cm_nodes %}
{{ lme_runtime_inventory.hosts[n].fqdn }}:{{ port }}:replication:replicator:{{ replpw }}
{% endfor %}
