{#
  patroni.env -- EnvironmentFile for the Patroni container (platform.py:353).
  SECRET-BEARING (no_log render); rejoin.py:39 strips PATRONI_* from the child
  environment as secret material, so treat this whole file as a secret. This
  TEMPLATE holds only variable NAMES + file() lookups, never a literal secret.
  Values mirror lme_lab.credentials:444.
#}
{%- set domain = cm_domain -%}
PATRONI_SUPERUSER_PASSWORD={{ lookup('file', credential_materializer_staging_dir ~ '/secrets/pg-' ~ domain ~ '-postgres') | trim }}
PATRONI_REPLICATION_PASSWORD={{ lookup('file', credential_materializer_staging_dir ~ '/secrets/pg-' ~ domain ~ '-replicator') | trim }}
