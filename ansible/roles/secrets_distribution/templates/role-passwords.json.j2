{#
  role-passwords.json -- maps each database role to the mounted file that holds
  its password. NON-SECRET: contains PATHS only, never a password value.
  Consumed by provision.initialize_passwords (provision.py:21-34), which requires
  every path's parent to be exactly /run/secrets/roles. The role set must satisfy
  provision's required <= keys <= allowed contract for this domain.
#}
{%- set domain = cm_domain -%}
{{ dict(_cm_domain_roles[domain] | zip(
        _cm_domain_roles[domain] | map('regex_replace', '^', '/run/secrets/roles/') | map('regex_replace', '$', '.password')))
   | to_nice_json }}
