{#
  admin.pgpass -- libpq passfile for the superuser (postgres) admin service.
  SECRET-BEARING: the password field is filled from the staged role-password file
  at render time; the render task carries no_log:true. This TEMPLATE holds only
  the structure + a file() lookup, never a literal secret.
  Line format: hostname:port:database:username:password (mirrors
  lme_lab.credentials:412-413).
#}
{%- set domain = cm_domain -%}
{#- Primary rw endpoint = first declared alias (single source of truth; the full
    list is the cert-SAN set). Preserves lme_lab.credentials:408. -#}
{%- set alias = credential_material_domain_rw_alias[domain] | first -%}
{%- set port = credential_material_domain_port[domain] -%}
{%- set own_dbs = credential_material_domain_databases[domain] -%}
{%- set imported = credential_material_domain_imports[domain] | map(attribute='db') | map('regex_replace', '$', '_replica') | list -%}
{%- set superpw = lookup('file', _cm_staging_root ~ '/secrets/pg-' ~ domain ~ '-postgres') | trim -%}
{#- Per-member superuser lines cover THIS domain's DECLARED members only (canonical
    lme_resolved.database.domains[domain].members), NOT the cross-domain union. Order
    follows the declared member list (deterministic for reapply identity). The base64url
    password alphabet (openssl rand -base64 | tr "+/" "-_") contains no ':' or '\', so no
    pgpass field escaping is required. -#}
{%- set members = lme_resolved.database.domains[domain].members -%}
{% for db in ['postgres'] + own_dbs + imported %}
{{ alias }}:5432:{{ db }}:postgres:{{ superpw }}
{% endfor %}
{% for n in members %}
{{ lme_runtime_inventory.hosts[n].fqdn }}:{{ port }}:postgres:postgres:{{ superpw }}
{% endfor %}
