{
  "mode": "malcolm",
  "listen_host": "{{ malcolm_platform_config.sink_gateway.listen_host }}",
  "listen_port": {{ malcolm_platform_config.sink_gateway.listen_port }},
  "backend_host": "{{ malcolm_platform_config.sink_gateway.backend_host }}",
  "backend_port": {{ malcolm_platform_config.sink_gateway.backend_port }},
  "backend_tls_server_name": "{{ malcolm_platform_config.sink_gateway.backend_tls_server_name }}",
  "backend_ca_file": "{{ malcolm_platform_config.sink_gateway.backend_ca_file }}",
  "policy_file": "{{ malcolm_platform_config.sink_gateway.policy_file }}",
  "max_body_bytes": 1048576,
  "max_response_bytes": 1048576,
  "max_connections": 2,
  "timeout_seconds": 10
}
