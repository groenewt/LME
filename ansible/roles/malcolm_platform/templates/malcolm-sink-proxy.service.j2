[Unit]
Description=LME Malcolm source-scoped receipt gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/lmemalcolm/malcolm/sink-proxy
ExecStartPre=/usr/bin/python3 -m lme_sink_proxy check-config --config /data/lmemalcolm/config/malcolm/sink-proxy.json
ExecStart=/usr/bin/python3 -m lme_sink_proxy run --config /data/lmemalcolm/config/malcolm/sink-proxy.json
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2
MemoryMax={{ malcolm_platform_config.sink_gateway.memory_mib }}M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
