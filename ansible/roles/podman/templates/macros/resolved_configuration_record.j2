{%- macro walk(facts, descriptor, declaration) -%}
{%- set f = declaration.atoms.descriptor -%}
{%- set n = namespace(value=declaration.atoms.absent, available=declaration.atoms.false) -%}
{%- if descriptor[f.fact] in facts -%}
  {%- set n.value = facts[descriptor[f.fact]] -%}
  {%- set n.available = declaration.atoms.true -%}
  {%- for part in descriptor[f.path] -%}
    {%- if n.available and n.value is mapping and part in n.value -%}
      {%- set n.value = n.value[part] -%}
    {%- else -%}
      {%- set n.available = declaration.atoms.false -%}
      {%- set n.value = declaration.atoms.absent -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{{- {f.available: n.available, f.value: n.value} | to_json -}}
{%- endmacro -%}

{%- macro record(facts, contract, declaration) -%}
{%- set f = contract.fields -%}
{%- set df = declaration.atoms.descriptor -%}
{%- set n = namespace(value={f.schema_version: contract.schema_version, f.producer: declaration.producer}) -%}
{%- for role, descriptor in contract.sources.items() -%}
  {%- set result = walk(facts, descriptor, declaration) | from_json -%}
  {%- set n.value = n.value | combine({f[role]: result[df.value]}) -%}
{%- endfor -%}
{%- for role, descriptor in contract.producer_binding.items() -%}
  {%- set result = walk(facts, descriptor, declaration) | from_json -%}
  {%- set n.value = n.value | combine({f[role]: result[df.value]}) -%}
{%- endfor -%}
{{- n.value | to_nice_yaml(indent=declaration.render.indent, width=declaration.render.width, sort_keys=declaration.render.sort_keys) -}}
{%- endmacro -%}
