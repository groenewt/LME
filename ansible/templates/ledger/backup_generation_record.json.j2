{#- ansible/templates/ledger/backup_generation_record.json.j2

    B-owned genuine reusable Jinja macro: renders ONE canonical backup-generation
    ledger record as JSON from declared fields. Value-pure -- it holds STRUCTURE only
    (the field names declared in manifests/ledger/backup-generation.contract.yaml +
    .schema.yaml); every VALUE is injected by the caller (the reusable task include
    ansible/tasks/ledger/backup_generation_ledger.yml, or D's producer). This is the
    "JSON generated by a Jinja macro" form, NOT a hand-authored JSON document and NOT a
    runtime engine.

    Import + call:
      {% raw %}{% from 'ledger/backup_generation_record.json.j2' import gen_record %}
      {{ gen_record(host=..., op_id=..., bundle_dir=..., status='open', opened_at=...,
                    ledger_path=..., volume_set=[...], revision=None,
                    revision_source='unresolved_at_backup_path') | from_json }}{% endraw %}

    Nulls are explicit (an absent optional renders JSON null), so the record round-trips
    through the schema's committed/open branches unambiguously.
-#}
{% macro gen_record(host, op_id, bundle_dir, status, opened_at, ledger_path,
                    volume_set=[], backup_timestamp=none, committed_at=none,
                    revision=none, revision_source=none, bundle_sha256=none,
                    note=none, schema=1) -%}
{#- Every declared field is emitted; an absent optional is an EXPLICIT JSON null (never
    dropped), so the schema's null branches (revision/committed_at/bundle_sha256) and the
    "null revision requires revision_source" rule are unambiguous. -#}
{{ {
     'schema': schema,
     'host': host,
     'op_id': op_id,
     'bundle_dir': bundle_dir,
     'backup_timestamp': backup_timestamp,
     'status': status,
     'opened_at': opened_at,
     'committed_at': committed_at,
     'revision': revision,
     'revision_source': revision_source,
     'bundle_sha256': bundle_sha256,
     'volume_set': volume_set,
     'ledger_path': ledger_path,
     'note': note,
   } | to_nice_json }}
{%- endmacro %}
