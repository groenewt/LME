{# ansible/templates/units/network.j2 -- generic quadlet .network renderer.
   Pure renderer; every [Network] value comes from lme_global.network. #}
# {{ service.name }}.network
[Unit]
{% if service.dependencies is defined %}
{% if service.dependencies.partof is defined %}
PartOf={{ service.dependencies.partof | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.after is defined %}
After={{ service.dependencies.after | unit_refs(kinds) }}
{% endif %}
{% endif %}

[Service]

[Network]
Driver={{ lme_global.network.driver }}
Gateway={{ lme_global.network.gateway }}
IPAMDriver={{ lme_global.network.ipam_driver }}
NetworkName={{ lme_global.network.name }}
Subnet={{ lme_global.network.subnet }}
