{# ansible/templates/units/path_service.j2 -- renders ONE of the pair.
   Called twice per path_service manifest: render_part='path' -> the .path unit,
   render_part='service' -> the paired oneshot .service unit. Pure renderer. #}
{% if render_part == 'path' %}
[Unit]
{% if service.path.description is defined %}
Description={{ service.path.description }}
{% endif %}

[Path]
{% if service.path.path_modified is defined %}
PathModified={{ service.path.path_modified }}
{% endif %}
{% if service.path.path_exists is defined %}
PathExists={{ service.path.path_exists }}
{% endif %}

[Install]
{% if service.path.wanted_by is defined %}
WantedBy={{ service.path.wanted_by | wanted_by(kinds) }}
{% endif %}
{% else %}
[Unit]
{% if service.service.description is defined %}
Description={{ service.service.description }}
{% endif %}
{% if service.service.after is defined %}
After={{ service.service.after | unit_refs(kinds) }}
{% endif %}

[Service]
{% if service.service.type is defined %}
Type={{ service.service.type }}
{% endif %}
{% if service.service.exec_start is defined %}
ExecStart={{ service.service.exec_start }}
{% endif %}
{% for k, v in (service.service.environment | default({})).items() if v is not none %}
Environment={{ k }}={{ v }}
{% endfor %}
{% endif %}
