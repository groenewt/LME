{# ===========================================================================
   ansible/templates/units/container.j2 -- generic quadlet .container renderer.

   PURE RENDERER: contains ZERO deployment literals. Every value comes from the
   service manifest (`service`) or `lme_global`; every derivation goes through a
   filter in filter_plugins/lme_manifests.py. Environment is iterated as a MAP
   (one Environment= per line) which structurally prevents the whitespace-split
   trap. Rendered with trim_blocks + lstrip_blocks (ansible defaults).

   Context: service, lme_global, kinds (logical->kind map), flags (enable flags).
   =========================================================================== #}
# {{ service.name }}.container
[Unit]
{% if service.description is defined %}
Description={{ service.description }}
{% endif %}
{% if service.dependencies is defined %}
{% if service.dependencies.requires is defined %}
Requires={{ service.dependencies.requires | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.after is defined %}
After={{ service.dependencies.after | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.wants is defined %}
Wants={{ service.dependencies.wants | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.partof is defined %}
PartOf={{ service.dependencies.partof | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.binds_to is defined %}
BindsTo={{ service.dependencies.binds_to | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.condition_path_exists is defined %}
{% for p in service.dependencies.condition_path_exists %}
ConditionPathExists={{ p }}
{% endfor %}
{% endif %}
{% endif %}
{% if service.behavior is defined and service.behavior.start_limit_interval is defined %}
StartLimitIntervalSec={{ service.behavior.start_limit_interval }}
{% endif %}
{% if service.behavior is defined and service.behavior.start_limit_burst is defined %}
StartLimitBurst={{ service.behavior.start_limit_burst }}
{% endif %}
{% for line in service.unit_extra | default([]) %}
{{ line }}
{% endfor %}

[Service]
{% if service.behavior is defined %}
{% if service.behavior.type is defined %}
Type={{ service.behavior.type }}
{% endif %}
{% if service.behavior.restart is defined %}
Restart={{ service.behavior.restart }}
{% endif %}
{% if service.behavior.restart_sec is defined %}
RestartSec={{ service.behavior.restart_sec }}
{% endif %}
{% if service.behavior.limit_nofile is defined %}
LimitNOFILE={{ service.behavior.limit_nofile }}
{% endif %}
{% endif %}
{% for k, v in (service.service_environment | default({})).items() if v is not none %}
Environment={{ k }}={{ v }}
{% endfor %}
{% if service.behavior is defined and service.behavior.timeout_start_sec is defined %}
TimeoutStartSec={{ service.behavior.timeout_start_sec }}
{% endif %}
{% if service.behavior is defined and service.behavior.timeout_stop_sec is defined %}
TimeoutStopSec={{ service.behavior.timeout_stop_sec }}
{% endif %}
{% if service.behavior is defined and service.behavior.remain_after_exit is defined %}
RemainAfterExit={{ 'yes' if service.behavior.remain_after_exit else 'no' }}
{% endif %}
{# cgroup memory caps. Two declaration forms (both literal-free here):
     * JVM service (resources.heap set): MemoryHigh/MemoryMax DERIVE from the heap
       via mem_derive (elasticsearch -- heap is the single knob).
     * non-JVM service (no heap): resources.memory_high / resources.memory_max are
       declared directly in the manifest (SF-8 co-residency caps). #}
{% if service.resources is defined %}
{% if service.resources.heap is defined %}
MemoryHigh={{ service.resources.heap | mem_derive(service.resources.memory_high_factor | default(1.5)) }}
MemoryMax={{ service.resources.heap | mem_derive(service.resources.memory_max_factor | default(2)) }}
{% else %}
{% if service.resources.memory_high is defined %}
MemoryHigh={{ service.resources.memory_high }}
{% endif %}
{% if service.resources.memory_max is defined %}
MemoryMax={{ service.resources.memory_max }}
{% endif %}
{% endif %}
{% endif %}
{% for line in service.service_extra | default([]) %}
{{ line }}
{% endfor %}

[Install]
{% if service.install is defined and service.install.wanted_by is defined %}
WantedBy={{ service.install.wanted_by | wanted_by(kinds) }}
{% endif %}

[Container]
ContainerName={{ service.container_name | default(service.name) }}
{# a null env value drops the key entirely: lets a profile "delete" an inherited
   env key through recursive combine, which cannot remove keys on its own. #}
{# offline override: service.environment_offline is merged OVER environment ONLY
   when the offline_mode enable flag is set (install.sh parity -- it sed-swapped
   kibana's NODE_EXTRA_CA_CERTS to the local-only CA in air-gap). Literals live in
   the manifest; the template merely gates. #}
{% set _env = service.environment | default({}) %}
{% if (flags.offline_mode | default(false)) and service.environment_offline is defined %}
{% set _env = _env | combine(service.environment_offline) %}
{% endif %}
{% for k, v in _env.items() if v is not none %}
Environment={{ k }}={{ v }}
{% endfor %}
{% if service.resources is defined and service.resources.jvm_env is defined %}
Environment={{ service.resources.jvm_env }}={{ service.resources | jvm_opts }}
{% endif %}
{% for s in service.secrets | default([]) %}
Secret={{ s.name }},type={{ s.type }},target={{ s.target }}
{% endfor %}
{% for f in service.environment_files | default([]) %}
EnvironmentFile={{ f }}
{% endfor %}
Image={{ lme_global.images[service.image].local }}
{# offline render equivalent of install.sh's `sed '/^Image=/a Pull=never'`: in
   air-gap every image is pre-loaded from a tar, so never reach for a registry.
   Gated on the offline_mode enable flag; emitted right after Image= to match. #}
{% if flags.offline_mode | default(false) %}
Pull=never
{% endif %}
{% if service.hostname is defined %}
HostName={{ service.hostname }}
{% endif %}
Network={{ lme_global.network.name }}
{% if service.network_aliases is defined or service.podman_args is defined %}
PodmanArgs={{ service.network_aliases | default([]) | podman_args(service.podman_args | default([])) }}
{% endif %}
{% for p in service.publish_ports | default([]) %}
PublishPort={{ p | render_port }}
{% endfor %}
{% for k, v in (service.ulimits | default({})).items() %}
Ulimit={{ k }}={{ v }}
{% endfor %}
{# a volume may carry an optional enabled_when: [<flag>] gate (same is_enabled
   semantics as service-level enabled_when). Absent -> ['always'] -> always
   rendered. Used for the offline-only Wazuh CVE-DB mount. #}
{% for v in service.volumes | default([]) if (v.enabled_when | default(['always']) | is_enabled(flags | default({}))) %}
Volume={{ v | render_volume(lme_global) }}
{% endfor %}
{% if service.health is defined %}
{% if service.health.notify is defined %}
Notify={{ service.health.notify }}
{% endif %}
{% if service.health.cmd is defined %}
HealthCmd={{ service.health.cmd }}
{% endif %}
{% if service.health.interval is defined %}
HealthInterval={{ service.health.interval }}
{% endif %}
{% if service.health.timeout is defined %}
HealthTimeout={{ service.health.timeout }}
{% endif %}
{% if service.health.retries is defined %}
HealthRetries={{ service.health.retries }}
{% endif %}
{% if service.health.start_period is defined %}
HealthStartPeriod={{ service.health.start_period }}
{% endif %}
{% endif %}
{% if service.exec is defined %}
Exec={{ service.exec }}
{% endif %}
{% if service.run_as is defined and service.run_as.user is defined %}
User={{ service.run_as.user }}
{% endif %}
{% if service.run_as is defined and service.run_as.group is defined %}
Group={{ service.run_as.group }}
{% endif %}
{% if service.userns is defined %}
UserNS={{ service.userns | render_userns(lme_global) }}
{% endif %}
{% for line in service.container_extra | default([]) %}
{{ line }}
{% endfor %}
