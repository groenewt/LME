{# ansible/templates/units/target.j2 -- the umbrella orchestrator (.service).
   Pure renderer. Section order Unit/Install/Service mirrors the current unit. #}
[Unit]
{% if service.description is defined %}
Description={{ service.description }}
{% endif %}
{% if service.dependencies is defined %}
{% if service.dependencies.requires is defined %}
Requires={{ service.dependencies.requires | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.after is defined %}
After={{ service.dependencies.after | unit_refs(kinds) }}
{% endif %}
{% endif %}

[Install]
{% if service.install is defined and service.install.wanted_by is defined %}
WantedBy={{ service.install.wanted_by | wanted_by(kinds) }}
{% endif %}

[Service]
{% if service.service.type is defined %}
Type={{ service.service.type }}
{% endif %}
{% if service.service.exec_start is defined %}
ExecStart={{ service.service.exec_start }}
{% endif %}
{% if service.service.remain_after_exit is defined %}
RemainAfterExit={{ 'yes' if service.service.remain_after_exit else 'no' }}
{% endif %}
