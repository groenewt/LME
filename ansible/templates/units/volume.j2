{# ansible/templates/units/volume.j2 -- generic quadlet .volume renderer.
   Pure renderer. Optional `owner` ({slot?, in_container_uid}) derives the
   User=/Group= via the cert_owner filter (subuid_base + slot base + in-container
   uid); esdata01 has no owner and omits them. #}
[Unit]
{% if service.dependencies is defined %}
{% if service.dependencies.partof is defined %}
PartOf={{ service.dependencies.partof | unit_refs(kinds) }}
{% endif %}
{% if service.dependencies.after is defined %}
After={{ service.dependencies.after | unit_refs(kinds) }}
{% endif %}
{% endif %}
{% for line in service.unit_extra | default([]) %}
{{ line }}
{% endfor %}

[Service]

[Volume]
VolumeName={{ service.volume_name }}
{% if service.owner is defined %}
User={{ service.owner | cert_owner(lme_global) }}
Group={{ service.owner | cert_owner(lme_global) }}
{% endif %}
{% if service.driver is defined %}
Driver={{ service.driver }}
{% endif %}
{% for line in service.volume_extra | default([]) %}
{{ line }}
{% endfor %}
