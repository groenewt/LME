# lme-metricbeat.container
[Unit]
Description=Elastic Metricbeat Container Service
Requires=lme-elasticsearch.service lme-setup-certs.service
After=lme-elasticsearch.service lme-setup-certs.service lme-kibana.service
PartOf=lme.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh

[Container]
ContainerName=lme-metricbeat
Image=localhost/metricbeat:LME_LATEST
Network=lme
PodmanArgs=--network-alias lme-metricbeat
Volume=lme_certs:/certs:ro
Volume=/opt/lme/config/metricbeat.yml:/usr/share/metricbeat/metricbeat.yml:ro
Volume=/proc:/hostfs/proc:ro
Volume=/sys/fs/cgroup:/hostfs/sys/fs/cgroup:ro
Volume=/:/hostfs:ro
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD
# REQUIRED PRIVILEGE (do not drop): the Metricbeat system module collects host
# CPU/memory/disk/filesystem/process metrics. It needs the read-only /hostfs
# mounts above (system.hostfs) plus User=root to read other users' /proc entries
# and traverse all filesystems. All host mounts are :ro, so this is read-only
# host observation. Trust assumption: the host operator trusts this optional
# monitoring pack with read access to host system metrics.
User=root
HealthCmd=curl -fs http://localhost:5066/ -o /dev/null
