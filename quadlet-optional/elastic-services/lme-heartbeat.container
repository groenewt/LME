# lme-heartbeat.container
[Unit]
Description=Elastic Heartbeat Container Service
Requires=lme-elasticsearch.service lme-setup-certs.service
After=lme-elasticsearch.service lme-setup-certs.service lme-kibana.service
PartOf=lme.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh

[Container]
ContainerName=lme-heartbeat
Image=localhost/heartbeat:LME_LATEST
Network=lme
# NET_RAW is intentionally NOT granted: heartbeat.yml defines only http and
# tcp monitors. NET_RAW would only be required for ICMP (ping) monitors, which
# this deployment does not use. Add --cap-add=NET_RAW here only if an
# `- type: icmp` monitor is introduced in config/heartbeat.yml.
PodmanArgs=--network-alias lme-heartbeat
Volume=lme_certs:/certs:ro
Volume=/opt/lme/config/heartbeat.yml:/usr/share/heartbeat/heartbeat.yml:ro
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD
HealthCmd=curl -fs http://localhost:5066/ -o /dev/null
