# lme-logstash.container
[Unit]
Description=Elastic Logstash Container Service
Requires=lme-elasticsearch.service lme-setup-certs.service
After=lme-elasticsearch.service lme-setup-certs.service
PartOf=lme.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh

[Container]
ContainerName=lme-logstash
Image=localhost/logstash:LME_LATEST
Network=lme
PodmanArgs=--network-alias lme-logstash
# Bind the raw beats/http ports to loopback only: they are not exposed on the
# tailnet/LAN. The host-facing beats port is fronted by the opt-in tailscale
# ingress (tailscale_ingress.yml); container->logstash traffic still uses the
# `lme` podman network alias, which is unaffected by the host publish binding.
PublishPort=127.0.0.1:5044:5044
PublishPort=127.0.0.1:8085:8085
# Set BOTH Xms and Xmx: the logstash image's in-image jvm.options defaults to
# -Xms1g -Xmx1g, and LS_JAVA_OPTS is APPENDED, so setting only -Xmx512m leaves
# Xms=1g > Xmx=512m -> "Initial heap size set to a larger value than the maximum
# heap size" -> JVM aborts and the unit crash-loops. Pin both to 512m.
# QUOTE the value: systemd/quadlet `Environment=` splits on whitespace, so the
# unquoted form is parsed as LS_JAVA_OPTS=-Xms512m + a stray `-Xmx512m` token
# (dropped) -> only -Xmx512m survives as the appended override -> the exact
# Xms(1g) > Xmx(512m) trap again. Verified on the Debian-13 e2e: quoted form
# emits a single `--env "LS_JAVA_OPTS=-Xms512m -Xmx512m"` and the JVM boots.
Environment="LS_JAVA_OPTS=-Xms512m -Xmx512m"
# `,idmap` per the cert-volume (B2) fix; keys are 0640/166536. Logstash runs
# as container-root (User=root below) and reads the key via CAP_DAC_OVERRIDE.
Volume=lme_certs:/certs:ro,idmap
Volume=/opt/lme/config/logstash/logstash.yml:/usr/share/logstash/config/logstash.yml:ro
Volume=/opt/lme/config/logstash/pipeline:/usr/share/logstash/pipeline:ro
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD
# Required so logstash can read the 166536-owned cert key now that the beats
# input is TLS-enabled. This is the same pattern filebeat/metricbeat use to
# read the cert volume; the logstash image otherwise runs as uid 1000, which
# cannot open the key.
User=root
HealthCmd=curl -fs http://localhost:9600/ -o /dev/null
