# lme-filebeat.container
[Unit]
Description=Elastic Filebeat Container Service
Requires=lme-elasticsearch.service lme-setup-certs.service lme-filebeatdata-volume.service
After=lme-elasticsearch.service lme-setup-certs.service lme-kibana.service lme-filebeatdata-volume.service
PartOf=lme.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh

[Container]
ContainerName=lme-filebeat
Image=localhost/filebeat:LME_LATEST
Network=lme
PodmanArgs=--network-alias lme-filebeat
Volume=lme_certs:/certs:ro
Volume=/opt/lme/config/filebeat.yml:/usr/share/filebeat/filebeat.yml:ro
Volume=/var/log/journal:/var/log/journal:ro
Volume=/run/log/journal:/run/log/journal:ro
Volume=lme_filebeatdata:/usr/share/filebeat/data
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD
User=root
