# lme-apm-server.container
[Unit]
Description=Elastic APM Server Container Service
Requires=lme-elasticsearch.service lme-setup-certs.service
After=lme-elasticsearch.service lme-setup-certs.service
PartOf=lme.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=default.target lme.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/lme/pass.sh

[Container]
ContainerName=lme-apm-server
Image=localhost/apm-server:LME_LATEST
Network=lme
PodmanArgs=--network-alias lme-apm-server
PublishPort=8200:8200
Volume=lme_certs:/certs:ro,idmap
Volume=/opt/lme/config/apm-server.yml:/usr/share/apm-server/apm-server.yml:ro
Secret=elastic,type=env,target=ELASTICSEARCH_PASSWORD
# apm-server's image runs as a non-root uid that does NOT map to the cert key's
# owner (166536) under idmap, so it cannot open the 0640
# /certs/apm-server/apm-server.key ("permission denied" -> crash-loop, verified
# on the Debian-13 e2e). Run as container-root to read the key via
# CAP_DAC_OVERRIDE -- the same pattern filebeat/metricbeat/logstash already use
# for the tightened (B2) cert volume.
User=root
HealthCmd=CMD-SHELL bash -c 'exec 3<>/dev/tcp/127.0.0.1/8200'
