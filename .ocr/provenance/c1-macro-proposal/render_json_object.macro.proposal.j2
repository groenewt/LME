{# PROPOSAL -- for C1 to place in templates/macros. NOT active. NOT loaded by any render harness. #}
{# audit_ref: codex-manager-current-source-audits-20260923-0315 (F_representation_audit item 5) #}
{# target: .devcontainer/python_development/devcontainer.json (strict JSON, key order preserved) #}
{# tested: true -- render-parity vs a3352b2 (633B); see PROPOSAL-index.yaml render_parity_evidence #}
{#
   params -> declared schema keys (emitted-structural-literals-schema.yaml):
     data         -> devcontainer manifest values (the object to serialize)
     indent       -> json_render.devcontainer.indent
     sort_keys    -> json_render.devcontainer.sort_keys
     separators   -> json_render.separators
     ensure_ascii -> json_render.ensure_ascii
   No parameter has a default; no string/number literal appears in the body.
   Terminal newline is OWNED by this macro: the {%- -%} trims leave NO trailing newline,
   matching terminal_newline.devcontainer=false. The render layer must add nothing.
#}
{% macro render_json_object(data, indent, sort_keys, separators, ensure_ascii) -%}
{{ data | to_json(indent=indent, sort_keys=sort_keys, separators=separators, ensure_ascii=ensure_ascii) }}
{%- endmacro %}
