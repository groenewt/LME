{# PROPOSAL -- for C1 to place in templates/macros. NOT active. NOT loaded by any render harness. #}
{# audit_ref: codex-manager-current-source-audits-20260923-0315 (F_representation_audit item 5) #}
{# target: .gitignore (comments-as-data, grouped patterns) #}
{# tested: false (C1 wires + byte-parity verifies) #}
{#
   params -> declared schema keys (emitted-structural-literals-schema.yaml):
     groups          -> gitignore manifest values (list of {leading_blank, comment, patterns})
                        NOTE: in the reformed manifest each comment is stored MARKER-FREE; the
                        one-off spacing anomalies (#created... vs # AI...) are normalized into
                        comment text so comment_prefix stays uniform (data-normalization: OPEN).
     group_separator -> gitignore_layout.group_separator
     comment_prefix  -> gitignore_layout.comment_prefix
     line_terminator -> gitignore_layout.line_terminator
   No parameter has a default; no string/number literal appears in the body.
   Terminal newline is OWNED by this macro: line_terminator is emitted after the last
   pattern, so the file ends with a newline (terminal_newline.gitignore=true). The render
   layer must add nothing (a render-layer newline would double it).
#}
{% macro render_grouped_line_list(groups, group_separator, comment_prefix, line_terminator) -%}
{% for g in groups -%}
{% if g.leading_blank %}{{ group_separator }}{% endif -%}
{% if g.comment is not none %}{{ comment_prefix }}{{ g.comment }}{{ line_terminator }}{% endif -%}
{% for p in g.patterns %}{{ p }}{{ line_terminator }}{% endfor -%}
{% endfor -%}
{%- endmacro %}
