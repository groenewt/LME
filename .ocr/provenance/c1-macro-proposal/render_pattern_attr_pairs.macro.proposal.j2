{# PROPOSAL -- for C1 to place in templates/macros. NOT active. NOT loaded by any render harness. #}
{# audit_ref: codex-manager-current-source-audits-20260923-0315 (F_representation_audit item 5) #}
{# target: .gitattributes (pattern/attr pairs) #}
{# tested: true -- render-parity vs a3352b2 (22B); see PROPOSAL-index.yaml render_parity_evidence #}
{#
   params -> declared schema keys (emitted-structural-literals-schema.yaml):
     entries         -> gitattributes manifest values (list of {pattern, attrs})
     field_separator -> gitattributes_layout.field_separator
     line_terminator -> gitattributes_layout.line_terminator
   No parameter has a default; no string/number literal appears in the body.
   Terminal newline is OWNED by this macro: line_terminator is emitted after the last
   entry (terminal_newline.gitattributes=true). The render layer must add nothing.
#}
{% macro render_pattern_attr_pairs(entries, field_separator, line_terminator) -%}
{% for e in entries %}{{ e.pattern }}{{ field_separator }}{{ e.attrs }}{{ line_terminator }}{% endfor -%}
{%- endmacro %}
