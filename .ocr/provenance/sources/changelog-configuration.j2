{ 
  "categories": [
{% for c in changelog.categories %}
    {
      "title": "{{ c.title }}",
      "labels": {{ c.labels | to_json }},
    },
{% endfor %}
  ],
  "template": "#{{ '{{' }}{{ changelog.template_token }}{{ '}}' }}",
  "pr_template": "* #{{ '{{' }}{{ changelog.pr_template_tokens.title }}{{ '}}' }} by @#{{ '{{' }}{{ changelog.pr_template_tokens.author }}{{ '}}' }} in ##{{ '{{' }}{{ changelog.pr_template_tokens.number }}{{ '}}' }}" 
}
