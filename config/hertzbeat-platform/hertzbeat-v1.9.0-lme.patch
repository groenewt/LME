+package org.apache.hertzbeat.alert.lifecycle;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.apache.hertzbeat.alert.notice.AlertStoreHandler;
+import org.apache.hertzbeat.common.entity.alerter.GroupAlert;
+import org.apache.hertzbeat.common.entity.alerter.SingleAlert;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Suppression changes notification routing, while alert state remains durable. */
+@Service
+public class LifecycleDecisions {
+    private final AlertStoreHandler store;
+    private final LifecycleOutbox outbox;
+
+    public LifecycleDecisions(AlertStoreHandler store, LifecycleOutbox outbox) {
+        this.store = store;
+        this.outbox = outbox;
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void suppressed(GroupAlert group, LifecycleOutbox.Decision decision) {
+        GroupAlert saved = store.store(group);
+        for (SingleAlert alert : saved.getAlerts()) {
+            outbox.record("single", alert.getId(), alert.getStatus(), alert.getStatus(), decision);
+        }
+        outbox.record("group", saved.getId(), saved.getStatus(), saved.getStatus(), decision);
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void inhibited(GroupAlert group, SingleAlert alert) {
+        GroupAlert projected = GroupAlert.builder().groupKey(group.getGroupKey())
+                .groupLabels(group.getGroupLabels()).commonLabels(group.getCommonLabels())
+                .commonAnnotations(group.getCommonAnnotations()).status(alert.getStatus())
+                .alerts(new ArrayList<>(List.of(alert))).build();
+        suppressed(projected, LifecycleOutbox.Decision.SUPPRESSED_INHIBIT);
+    }
+}
