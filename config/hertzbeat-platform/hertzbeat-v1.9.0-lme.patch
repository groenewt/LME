+
+public class VerifiedJmxProbe {
+    static int port() throws Exception {
+        try (ServerSocket socket = new ServerSocket(0)) { return socket.getLocalPort(); }
+    }
+    static void check(Path directory, String registryCert, String stubCert, boolean goodPassword) throws Exception {
+        int registryPort = port();
+        SslRMIClientSocketFactory client = new SslRMIClientSocketFactory();
+        Registry registry = LocateRegistry.createRegistry(registryPort, client,
+                new SslRMIServerSocketFactory(VerifiedTlsProbe.serverContext(directory.resolve(registryCert + ".p12")), null, null, false));
+        Map<String, Object> serverEnvironment = new HashMap<>();
+        serverEnvironment.put(RMIConnectorServer.RMI_CLIENT_SOCKET_FACTORY_ATTRIBUTE, stubCert.equals("plaintext") ? null : client);
+        serverEnvironment.put(RMIConnectorServer.RMI_SERVER_SOCKET_FACTORY_ATTRIBUTE,
+                stubCert.equals("plaintext") ? null : new SslRMIServerSocketFactory(VerifiedTlsProbe.serverContext(directory.resolve(stubCert + ".p12")), null, null, false));
+        serverEnvironment.put(JMXConnectorServer.AUTHENTICATOR, (JMXAuthenticator) credentials -> {
+            if (!(credentials instanceof String[] pair) || pair.length != 2
+                    || !pair[0].equals("synthetic-reader") || !pair[1].equals("synthetic-only")) {
+                throw new SecurityException("Invalid synthetic credentials");
+            }
+            return new Subject();
+        });
+        // Bind directly through the in-process registry reference so invalid-registry fixtures
+        // do not fail during server startup before the tested client connects.
+        var implementation = new javax.management.remote.rmi.RMIJRMPServerImpl(0, stubCert.equals("plaintext") ? null : client,
+                (SslRMIServerSocketFactory) serverEnvironment.get(RMIConnectorServer.RMI_SERVER_SOCKET_FACTORY_ATTRIBUTE), serverEnvironment);
+        JMXServiceURL serverUrl = new JMXServiceURL("service:jmx:rmi://localhost");
+        var server = new RMIConnectorServer(serverUrl, serverEnvironment, implementation, ManagementFactory.getPlatformMBeanServer());
+        try {
+            server.start();
+            registry.rebind("jmxrmi", implementation.toStub());
+            boolean accepted = false;
+            boolean expectedRejection = false;
+            Map<String, Object> environment = new HashMap<>();
+            environment.put("com.sun.jndi.rmi.factory.socket", client);
+            environment.put(JMXConnector.CREDENTIALS,
+                    new String[]{"synthetic-reader", goodPassword ? "synthetic-only" : "wrong-synthetic"});
+            try (JMXConnector connection = VerifiedJmxConnector.connect(new JMXServiceURL(
+                    "service:jmx:rmi:///jndi/rmi://localhost:" + registryPort + "/jmxrmi"), environment)) {
+                Object uptime = connection.getMBeanServerConnection().getAttribute(new ObjectName("java.lang:type=Runtime"), "Uptime");
+                accepted = uptime instanceof Long;
+            } catch (Exception error) {
+                for (Throwable cause = error; cause != null; cause = cause.getCause()) {
+                    expectedRejection |= cause instanceof SSLException || (!goodPassword && cause instanceof SecurityException)
+                            || (stubCert.equals("plaintext") && "Secured JMX refused a plaintext RMI stub".equals(cause.getMessage()));
+                }
+                if (!expectedRejection) { throw error; }
+            }
+            boolean expected = registryCert.equals("valid") && stubCert.equals("valid") && goodPassword;
+            if (accepted != expected || (!expected && !expectedRejection)) {
+                throw new AssertionError("JMX registry=" + registryCert + " stub=" + stubCert + " accepted=" + accepted);
+            }
+            System.out.println("PASS JMX registry=" + registryCert + " stub=" + stubCert + " credentials=" + goodPassword);
+        } finally {
+            server.stop();
+            UnicastRemoteObject.unexportObject(registry, true);
+        }
+    }
+    public static void main(String[] args) throws Exception {
+        if (args.length == 2 && args[1].equals("missing-provider")) {
+            try {
+                VerifiedJmxConnector.connect(new JMXServiceURL("service:jmx:rmi:///jndi/rmi://localhost:9/jmxrmi"), Map.of());
+                throw new AssertionError("Missing TLS provider accepted");
+            } catch (java.io.IOException expected) {
+                if (!expected.getMessage().equals("Secured JMX requires the VerifiedSslSocketFactory JVM security provider")) { throw expected; }
+            }
+            System.out.println("PASS JMX missing-provider rejected before connection");
+            return;
+        }
+        if (!(SSLSocketFactory.getDefault() instanceof VerifiedSslSocketFactory)) {
+            throw new AssertionError("Verified socket provider was not loaded");
+        }
+        System.setProperty("java.rmi.server.hostname", "localhost");
+        Path directory = Path.of(args[0]);
+        check(directory, "valid", "valid", true);
+        check(directory, "valid", "valid", false);
+        check(directory, "wrong-san", "valid", true);
+        check(directory, "untrusted", "valid", true);
+        check(directory, "valid", "wrong-san", true);
+        check(directory, "valid", "untrusted", true);
+        check(directory, "valid", "plaintext", true);
+    }
+}
