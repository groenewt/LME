+package org.apache.hertzbeat.alert.lifecycle;
+
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Transaction participant: callers own commit/rollback. Never acknowledges a destination. */
+public final class JdbcLifecycleQueue {
+    private final long maxBytes;
+
+    public JdbcLifecycleQueue(long maxBytes) {
+        if (maxBytes <= 0 || maxBytes > 67108864L) {
+            throw new IllegalArgumentException("Lifecycle queue must be bounded to 1..67108864 bytes");
+        }
+        this.maxBytes = maxBytes;
+    }
+
+    public void append(Connection db, String id, String payload, long createdAt) throws SQLException {
+        long used = lockQuota(db);
+        long bytes = payload.getBytes(StandardCharsets.UTF_8).length;
+        if (bytes == 0 || bytes > 8192 || used > maxBytes - bytes) {
+            throw new IllegalStateException("Lifecycle outbox full or invalid event; transaction must roll back");
+        }
+        try (var insert = db.prepareStatement("insert into hzb_lifecycle_outbox(event_id,payload,payload_bytes,created_at) values(?,?,?,?)")) {
+            insert.setString(1, id);
+            insert.setString(2, payload);
+            insert.setLong(3, bytes);
+            insert.setLong(4, createdAt);
+            insert.executeUpdate();
+        }
+        updateQuota(db, used + bytes);
+    }
+
+    public List<Entry> pending(Connection db, int limit) throws SQLException {
+        if (limit < 1 || limit > 64) {
+            throw new IllegalArgumentException("Lifecycle batch limit must be 1..64");
+        }
+        lockQuota(db);
+        try (var select = db.prepareStatement("select event_id,payload,payload_bytes from hzb_lifecycle_outbox order by created_at,event_id")) {
+            select.setMaxRows(limit);
+            try (var rows = select.executeQuery()) {
+                List<Entry> events = new ArrayList<>();
+                while (rows.next()) {
+                    events.add(new Entry(rows.getString(1), rows.getString(2), rows.getLong(3)));
+                }
+                return events;
+            }
+        }
+    }
+
+    public void acknowledge(Connection db, List<String> ids) throws SQLException {
+        long used = lockQuota(db);
+        for (String id : ids) {
+            try (var select = db.prepareStatement("select payload_bytes from hzb_lifecycle_outbox where event_id=?")) {
+                select.setString(1, id);
+                try (var row = select.executeQuery()) {
+                    if (!row.next()) {
+                        continue;
+                    }
+                    used -= row.getLong(1);
+                }
+            }
+            try (var delete = db.prepareStatement("delete from hzb_lifecycle_outbox where event_id=?")) {
+                delete.setString(1, id);
+                delete.executeUpdate();
+            }
+        }
+        updateQuota(db, used);
+    }
+
+    public long lockQuota(Connection db) throws SQLException {
+        if (db.getAutoCommit()) {
+            throw new IllegalStateException("Lifecycle state and outbox require an explicit transaction");
+        }
+        try (var query = db.createStatement();
+             var row = query.executeQuery("select used_bytes from hzb_lifecycle_quota where id=1 for update")) {
+            if (!row.next()) {
+                throw new IllegalStateException("Lifecycle quota is missing; run schema-only initialization");
+            }
+            return row.getLong(1);
+        }
+    }
+
+    private void updateQuota(Connection db, long used) throws SQLException {
+        if (used < 0) {
+            throw new IllegalStateException("Lifecycle quota invariant failed");
+        }
+        try (var update = db.prepareStatement("update hzb_lifecycle_quota set used_bytes=? where id=1")) {
+            update.setLong(1, used);
+            update.executeUpdate();
+        }
+    }
+
+    /** Immutable event retained until the next durable owner confirms admission. */
+    public record Entry(String id, String payload, long bytes) { }
+}
