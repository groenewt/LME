+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/* Synthetic local fixture; no external endpoints or real credentials. */
+import java.io.InputStream;
+import java.net.InetSocketAddress;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.KeyStore;
+import javax.net.ssl.*;
+import com.sun.net.httpserver.HttpsServer;
+import com.sun.net.httpserver.HttpsConfigurator;
+import org.apache.hertzbeat.collector.collect.common.http.CommonHttpClient;
+import org.apache.http.client.methods.HttpGet;
+
+public class VerifiedTlsProbe {
+    static final char[] PASSWORD = "synthetic-only".toCharArray();
+    static SSLContext serverContext(Path storePath) throws Exception {
+        KeyStore store = KeyStore.getInstance("PKCS12");
+        try (InputStream in = Files.newInputStream(storePath)) { store.load(in, PASSWORD); }
+        KeyManagerFactory keys = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+        keys.init(store, PASSWORD);
+        SSLContext context = SSLContext.getInstance("TLS");
+        context.init(keys.getKeyManagers(), null, null);
+        return context;
+    }
+    public static void main(String[] args) throws Exception {
+        Path directory = Path.of(args[0]);
+        try {
+            for (String fixture : new String[]{"valid", "wrong-san", "untrusted"}) {
+                HttpsServer server = HttpsServer.create(new InetSocketAddress("localhost", 0), 0);
+                server.setHttpsConfigurator(new HttpsConfigurator(serverContext(directory.resolve(fixture + ".p12"))));
+                server.createContext("/", exchange -> {
+                    exchange.sendResponseHeaders(200, 0);
+                    exchange.getResponseBody().close();
+                });
+                server.start();
+                boolean accepted = false;
+                try (var response = CommonHttpClient.getHttpClient().execute(
+                        new HttpGet("https://localhost:" + server.getAddress().getPort() + "/"))) {
+                    accepted = response.getStatusLine().getStatusCode() == 200;
+                } catch (javax.net.ssl.SSLException expected) {
+                    // Certificate identity or trust rejection is the expected negative result.
+                } finally { server.stop(0); }
+                if (accepted != fixture.equals("valid")) {
+                    throw new AssertionError("HTTPS " + fixture + " accepted=" + accepted);
+                }
+                System.out.println("PASS HTTPS " + fixture);
+            }
+        } finally { CommonHttpClient.close(); }
+    }
+}
