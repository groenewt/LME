+package org.apache.hertzbeat.alert.lifecycle;
+
+import com.sun.net.httpserver.HttpServer;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DataSourceTransactionManager;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/** Run with cached Spring/Jackson/H2 jars; exercises real HTTP and Spring transaction enlistment. */
+public final class LifecycleProjectionContractTest {
+    @org.junit.jupiter.api.Test
+    void contract() throws Exception {
+        main(new String[0]);
+    }
+
+    public static void main(String[] args) throws Exception {
+        var source = new DriverManagerDataSource("jdbc:h2:mem:projection;DB_CLOSE_DELAY=-1", "sa", "");
+        var jdbc = new JdbcTemplate(source);
+        jdbc.execute("create table hzb_lifecycle_quota(id integer primary key,used_bytes bigint not null)");
+        jdbc.execute("insert into hzb_lifecycle_quota values(1,0)");
+        jdbc.execute("create table hzb_lifecycle_outbox(event_id varchar(36) primary key,payload varchar(8192),payload_bytes bigint,created_at bigint)");
+        var manager = new DataSourceTransactionManager(source);
+        var transaction = new TransactionTemplate(manager);
+        var outbox = new LifecycleOutbox(source, true, "guest:trixie", 8192);
+        outbox.validate();
+        transaction.executeWithoutResult(status -> {
+            outbox.record("single", 42L, "sentinel-password=DO-NOT-EXPORT", "firing", LifecycleOutbox.Decision.STATE_CHANGED);
+            status.setRollbackOnly();
+        });
+        check(jdbc.queryForObject("select count(*) from hzb_lifecycle_outbox", Integer.class) == 0, "Spring rollback lost atomicity");
+        transaction.executeWithoutResult(status -> outbox.record("single", 42L, "sentinel-password=DO-NOT-EXPORT", "firing",
+                LifecycleOutbox.Decision.STATE_CHANGED));
+        String payload = jdbc.queryForObject("select payload from hzb_lifecycle_outbox", String.class);
+        check(payload.contains("guest:trixie"), "canonical source identity lost");
+        check(!payload.contains("sentinel") && !payload.contains("DO-NOT-EXPORT"), "raw status leaked");
+        check(payload.contains("subject_id") && payload.contains("hertzbeat.alert.lifecycle.v1"), "typed opaque identity missing");
+        var token = Files.createTempFile("lifecycle-synthetic-", ".token");
+        Files.setPosixFilePermissions(token, PosixFilePermissions.fromString("rw-------"));
+        Files.writeString(token, "synthetic-test-token-12345");
+        AtomicInteger status = new AtomicInteger(200);
+        AtomicReference<String> receipt = new AtomicReference<>("{\"ack\":\"local_fsync\",\"inserted\":1,\"replayed\":0}");
+        AtomicReference<String> admitted = new AtomicReference<>();
+        var server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/v1/logs", request -> {
+            admitted.set(new String(request.getRequestBody().readAllBytes(), StandardCharsets.UTF_8));
+            byte[] body = receipt.get().getBytes(StandardCharsets.UTF_8);
+            request.sendResponseHeaders(status.get(), body.length);
+            request.getResponseBody().write(body);
+            request.close();
+        });
+        server.start();
+        String url = "http://127.0.0.1:" + server.getAddress().getPort() + "/v1/logs";
+        try {
+            var sender = new LifecycleDelivery(source, manager, url, token.toString(), 8192);
+            sender.deliver();
+            check(sender.isDegraded(), "HTTP 200 wrongly accepted as fsync");
+            check(jdbc.queryForObject("select count(*) from hzb_lifecycle_outbox", Integer.class) == 1, "bad receipt lost event");
+            status.set(202);
+            receipt.set("{\"ack\":\"local_fsync\",\"inserted\":0,\"replayed\":0}");
+            sender = new LifecycleDelivery(source, manager, url, token.toString(), 8192);
+            sender.deliver();
+            check(sender.isDegraded(), "incomplete receipt accepted");
+            receipt.set("{\"ack\":\"local_fsync\",\"inserted\":0,\"replayed\":1}");
+            sender = new LifecycleDelivery(source, manager, url, token.toString(), 8192);
+            sender.deliver();
+            check(!sender.isDegraded(), "valid replay fsync rejected");
+            check(jdbc.queryForObject("select count(*) from hzb_lifecycle_outbox", Integer.class) == 0, "fsync handoff not committed");
+            check(admitted.get().equals("{\"records\":[" + payload + "]}"), "replay changed immutable event");
+        } finally {
+            server.stop(0);
+            Files.delete(token);
+        }
+        System.out.println("Lifecycle sanitized projection, Spring rollback, HTTP false ACK and immutable replay contracts passed");
+    }
+
+    private static void check(boolean condition, String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+}
