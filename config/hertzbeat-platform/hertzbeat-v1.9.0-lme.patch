+
+package org.apache.hertzbeat.otel.nativeexport;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.node.ArrayNode;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import jakarta.annotation.PostConstruct;
+import jakarta.annotation.PreDestroy;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.hertzbeat.common.entity.message.CollectRep;
+import org.apache.hertzbeat.warehouse.store.NativeMetricCapture;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.stereotype.Component;
+
+/** Native collector path only. OTLP receivers and history query paths never call this exporter. */
+@Slf4j
+@Component
+@ConditionalOnProperty(name = "hertzbeat.native-export.enabled", havingValue = "true")
+public final class NativeMetricExporter implements NativeMetricCapture {
+    private final NativeMetricOutbox outbox;
+    private final Path readbacks;
+    private final String endpoint;
+    private final List<String> sinks;
+    private final String hostId;
+    private final String hostName;
+    private final Set<String> allowedLabels;
+    private final String authHeaderFile;
+    private final String authHeaderMapFile;
+    private final String endpointMapFile;
+    private final ObjectMapper mapper;
+    private final HttpClient client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5))
+            .followRedirects(HttpClient.Redirect.NEVER).build();
+    private final ScheduledExecutorService executor = Executors.newSingleThreadScheduledExecutor(runnable -> {
+        Thread thread = new Thread(runnable, "native-metric-outbox");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private final AtomicLong admissionFailures = new AtomicLong();
+    private final AtomicLong transportFailures = new AtomicLong();
+    private final AtomicLong readbackFailures = new AtomicLong();
+    private String readbackCursor = "";
+
+    @Autowired
+    public NativeMetricExporter(@Value("${hertzbeat.native-export.directory}") String directory,
+                                @Value("${hertzbeat.native-export.endpoint}") String endpoint,
+                                @Value("${hertzbeat.native-export.sinks:elastic}") String sinks,
+                                @Value("${hertzbeat.native-export.host-id}") String hostId,
+                                @Value("${hertzbeat.native-export.host-name}") String hostName,
+                                @Value("${hertzbeat.native-export.allowed-labels:}") String allowedLabels,
+                                @Value("${hertzbeat.native-export.auth-header-file:}") String authHeaderFile,
+                                @Value("${hertzbeat.native-export.auth-header-map-file:}") String authHeaderMapFile,
+                                @Value("${hertzbeat.native-export.endpoint-map-file:}") String endpointMapFile,
+                                @Value("${hertzbeat.native-export.max-bytes:268435456}") long maxBytes,
+                                @Value("${hertzbeat.native-export.reserve-bytes:2147483648}") long reserveBytes) throws IOException {
+        // Boot 4 supplies Jackson 3; this module's OTLP codecs deliberately own their Jackson 2 mapper.
+        this(directory, endpoint, sinks, hostId, hostName, allowedLabels, authHeaderFile,
+                authHeaderMapFile, endpointMapFile, maxBytes, reserveBytes, new ObjectMapper());
+    }
+
+    public NativeMetricExporter(String directory, String endpoint, String sinks, String hostId, String hostName,
+                                String allowedLabels, String authHeaderFile, long maxBytes, long reserveBytes,
+                                ObjectMapper mapper) throws IOException {
+        this(directory, endpoint, sinks, hostId, hostName, allowedLabels, authHeaderFile, "", "", maxBytes, reserveBytes, mapper);
+    }
+
+    public NativeMetricExporter(String directory, String endpoint, String sinks, String hostId, String hostName,
+                                String allowedLabels, String authHeaderFile, String authHeaderMapFile, String endpointMapFile,
+                                long maxBytes, long reserveBytes, ObjectMapper mapper) throws IOException {
+        validateEndpoint(endpoint);
+        this.sinks = Arrays.stream(sinks.split(",", -1)).map(String::trim).toList();
+        if (!List.of(List.of("elastic"), List.of("elastic", "hertzbeat")).contains(this.sinks)
+                || hostId.isBlank() || hostName.isBlank() || maxBytes > 268435456L || reserveBytes < 2147483648L) {
+            throw new IllegalArgumentException("Invalid native metric export identity, sinks or capacity");
+        }
+        this.endpoint = endpoint;
+        this.hostId = hostId;
+        this.hostName = hostName;
+        this.allowedLabels = Arrays.stream(allowedLabels.split(",")).map(String::trim)
+                .filter(value -> !value.isEmpty()).collect(Collectors.toUnmodifiableSet());
+        this.authHeaderFile = authHeaderFile;
+        if (authHeaderMapFile.isBlank() != endpointMapFile.isBlank()) {
+            throw new IllegalArgumentException("Native metric source endpoint and authorization maps must be configured together");
+        }
+        this.authHeaderMapFile = authHeaderMapFile;
+        this.endpointMapFile = endpointMapFile;
+        this.mapper = mapper.copy().enable(DeserializationFeature.FAIL_ON_READING_DUP_TREE_KEY);
+        this.readbacks = Path.of(directory).resolve("readbacks");
+        Files.createDirectories(readbacks);
+        this.outbox = new NativeMetricOutbox(Path.of(directory), maxBytes, reserveBytes);
+    }
+
+    static URI validateEndpoint(String endpoint) {
+        URI uri = URI.create(endpoint);
+        if (!"https".equals(uri.getScheme()) || uri.getHost() == null || uri.getUserInfo() != null
+                || uri.getQuery() != null || uri.getFragment() != null || !uri.getPath().endsWith("/v1/metrics")) {
+            throw new IllegalArgumentException("Native metric endpoint must be an authenticated fixed HTTPS OTLP route");
+        }
+        return uri;
+    }
+
+    String sourceHost(byte[] payload) throws IOException {
+        JsonNode resources = mapper.readTree(payload).path("resourceMetrics");
+        if (!resources.isArray() || resources.isEmpty()) {
+            throw new IOException("Native metric payload has no source resource");
+        }
+        String source = null;
+        for (JsonNode resource : resources) {
+            JsonNode attributes = resource.path("resource").path("attributes");
+            String current = null;
+            for (JsonNode attribute : attributes) {
+                if ("host.name".equals(attribute.path("key").asText())) {
+                    JsonNode value = attribute.path("value").path("stringValue");
+                    if (current != null || !value.isTextual() || value.asText().isBlank()) {
+                        throw new IOException("Native metric payload has ambiguous source identity");
+                    }
+                    current = value.asText();
+                }
+            }
+            if (current == null || source != null && !source.equals(current)) {
+                throw new IOException("Native metric payload has missing or conflicting source identity");
+            }
+            source = current;
+        }
+        return source;
+    }
+
+    /** Admission-time routing references; credentials remain exclusively in separately mounted files. */
+    record SourceRoute(String endpoint, String authorizationFile) { }
+
+    SourceRoute sourceRoute(byte[] payload) throws IOException {
+        String source = sourceHost(payload);
+        if (!endpointMapFile.isBlank()) {
+            String target = mappedValue(endpointMapFile, source);
+            String authorization = mappedValue(authHeaderMapFile, source);
+            validateEndpoint(target);
+            if (!Path.of(authorization).isAbsolute()) {
+                throw new IOException("Native metric authorization reference must be absolute");
+            }
+            return new SourceRoute(target, authorization);
+        }
+        if (!hostName.equals(source) || authHeaderFile.isBlank() || !Path.of(authHeaderFile).isAbsolute()) {
+            throw new IOException("Native metric source has no authorized route");
+        }
+        return new SourceRoute(endpoint, authHeaderFile);
+    }
+
+    private String mappedValue(String filename, String source) throws IOException {
+        if (!Path.of(filename).isAbsolute()) {
+            throw new IOException("Native metric source map path must be absolute");
+        }
+        JsonNode map = mapper.readTree(readBounded(Path.of(filename), 65536));
+        if (map == null || !map.isObject() || !map.path(source).isTextual() || map.path(source).asText().isBlank()) {
+            throw new IOException("Native metric source is absent from routing map");
+        }
+        return map.path(source).asText();
+    }
+
+    String authorization(NativeMetricOutbox.Entry entry) throws IOException {
+        String filename = entry.authorizationFile();
+        if (filename.isBlank()) {
+            // Legacy version-1 records did not snapshot a reference. Only their original single source may use fallback.
+            if (!hostName.equals(sourceHost(entry.payload())) || authHeaderFile.isBlank()) {
+                throw new IOException("Legacy native metric source has no authorized credential");
+            }
+            filename = authHeaderFile;
+        }
+        if (!Path.of(filename).isAbsolute()) {
+            throw new IOException("Native metric authorization reference must be absolute");
+        }
+        String value = new String(readBounded(Path.of(filename), 8192), java.nio.charset.StandardCharsets.UTF_8).strip();
+        if (value.isBlank() || value.contains("\n") || value.contains("\r")) {
+            throw new IOException("Invalid native export authorization file");
+        }
+        return value;
+    }
+
+    private byte[] readBounded(Path path, int limit) throws IOException {
+        try (InputStream input = Files.newInputStream(path)) {
+            byte[] bytes = input.readNBytes(limit + 1);
+            if (bytes.length > limit) {
+                throw new IOException("Native metric routing file exceeds size limit");
+            }
+            return bytes;
+        }
+    }
+
+    @Override
+    public void capture(CollectRep.MetricsData metricsData) {
+        try {
+            NativeMetricSnapshot snapshot = NativeMetricSnapshot.capture(metricsData, allowedLabels);
+            if (!snapshot.points().isEmpty()) {
+                byte[] payload = snapshot.toOtlpJson(hostId, hostName);
+                SourceRoute route = sourceRoute(payload);
+                outbox.admit(route.endpoint(), route.authorizationFile(), sinks, payload);
+            }
+        } catch (Exception failure) {
+            admissionFailures.incrementAndGet();
+            throw new IllegalStateException("Native metric admission failed; collection gap", failure);
+        }
+    }
+
+    @PostConstruct
+    public void start() {
+        executor.scheduleWithFixedDelay(this::flush, 1, 5, TimeUnit.SECONDS);
+    }
+
+    void flush() {
+        try {
+            consumeReadbacks();
+            for (NativeMetricOutbox.Entry entry : outbox.pending(32)) {
+                try {
+                    HttpRequest.Builder request = HttpRequest.newBuilder(validateEndpoint(entry.endpoint()))
+                            .timeout(Duration.ofSeconds(10)).header("Content-Type", "application/json")
+                            .header("X-LME-Origin", "hertzbeat-native")
+                            .header("X-LME-Delivery-Id", entry.id().toString());
+                    request.header("Authorization", authorization(entry));
+                    HttpResponse<InputStream> response = client.send(request.POST(HttpRequest.BodyPublishers.ofByteArray(entry.payload())).build(),
+                            HttpResponse.BodyHandlers.ofInputStream());
+                    try (InputStream body = response.body()) {
+                        byte[] bounded = body.readNBytes(65537);
+                        if (bounded.length > 65536 || response.statusCode() != 200
+                                || !fullyAccepted(new String(bounded, java.nio.charset.StandardCharsets.UTF_8))) {
+                            throw new IOException("OTLP transport did not fully accept native metric batch");
+                        }
+                    }
+                    outbox.transportAccepted(entry.id());
+                } catch (InterruptedException interrupted) {
+                    Thread.currentThread().interrupt();
+                    return;
+                } catch (Exception failed) {
+                    transportFailures.incrementAndGet();
+                    // No exception message: HTTP libraries can embed URLs, response bodies or credentials.
+                    log.warn("Native metric transport failed; retained for retry");
+                }
+            }
+        } catch (IOException failed) {
+            transportFailures.incrementAndGet();
+            log.error("Native metric outbox read failed; retained for operator repair");
+        }
+    }
+
+    boolean fullyAccepted(String body) throws IOException {
+        JsonNode root = mapper.readTree(body);
+        if (root == null || !root.isObject()) {
+            return false;
+        }
+        JsonNode partial = root.get("partialSuccess");
+        return partial == null || (partial.isObject()
+                && (!partial.has("rejectedDataPoints") || partial.path("rejectedDataPoints").asLong(-1) == 0)
+                && partial.path("errorMessage").asText("").isEmpty());
+    }
+
+    /** Integration boundary for a destination query adapter, deliberately distinct from HTTP acceptance. */
+    public void verifyReadback(UUID id, String sink, byte[] retrievedCanonicalOtlp) throws IOException {
+        byte[] admitted = outbox.read(id).payload();
+        if (!normalize(mapper.readTree(admitted)).equals(normalize(mapper.readTree(retrievedCanonicalOtlp)))) {
+            throw new IOException("Queried native metric content differs from admitted samples");
+        }
+        outbox.verifyReadback(id, sink, admitted);
+    }
+
+    /** Readback producer has only read access to accepted records and write access to this receipt directory. */
+    void consumeReadbacks() throws IOException {
+        try (Stream<Path> paths = Files.list(readbacks)) {
+            List<Path> sorted = paths.filter(item -> item.getFileName().toString().endsWith(".json")).sorted().toList();
+            List<Path> ordered = new ArrayList<>();
+            sorted.stream().filter(p -> p.getFileName().toString().compareTo(readbackCursor) > 0).forEach(ordered::add);
+            sorted.stream().filter(p -> p.getFileName().toString().compareTo(readbackCursor) <= 0).forEach(ordered::add);
+            for (Path path : ordered.stream().limit(32).toList()) {
+                readbackCursor = path.getFileName().toString();
+                try {
+                    if (Files.isSymbolicLink(path) || Files.size(path) > 1024 * 1024L + 4096) {
+                        throw new IOException("Invalid native metric readback receipt");
+                    }
+                    JsonNode receipt = mapper.readTree(Files.readAllBytes(path));
+                    UUID id = UUID.fromString(receipt.path("id").asText());
+                    String sink = receipt.path("sink").asText();
+                    if (!path.getFileName().toString().equals(id + "." + sink + ".json") || !receipt.path("payload").isObject()) {
+                        throw new IOException("Native metric receipt identity mismatch");
+                    }
+                    if (!Files.exists(readbacks.getParent().resolve(id + ".accepted"))
+                            && !Files.exists(readbacks.getParent().resolve(id + ".pending"))) {
+                        // A crash can leave the final readback receipt after fully verified record retirement.
+                        // An unknown receipt cannot establish any new obligation or a verified result.
+                        Files.delete(path);
+                        continue;
+                    }
+                    verifyReadback(id, sink, mapper.writeValueAsBytes(receipt.get("payload")));
+                    Files.delete(path);
+                } catch (Exception failure) {
+                    readbackFailures.incrementAndGet();
+                    log.warn("Native metric readback mismatch; obligation and receipt retained");
+                }
+            }
+        }
+    }
+
+    // OTLP gauges are unordered sets of resources/scopes/metrics/points/attributes. Preserve multiplicity and scalar types.
+    private JsonNode normalize(JsonNode node) throws IOException {
+        if (node == null) {
+            throw new IOException("Missing native metric readback content");
+        }
+        if (node.isObject()) {
+            ObjectNode result = mapper.createObjectNode();
+            List<String> names = new ArrayList<>();
+            node.fieldNames().forEachRemaining(names::add);
+            names.sort(String::compareTo);
+            for (String name : names) {
+                result.set(name, normalize(node.get(name)));
+            }
+            return result;
+        }
+        if (node.isArray()) {
+            List<JsonNode> values = new ArrayList<>();
+            for (JsonNode value : node) {
+                values.add(normalize(value));
+            }
+            values.sort(Comparator.comparing(JsonNode::toString));
+            ArrayNode result = mapper.createArrayNode();
+            values.forEach(result::add);
+            return result;
+        }
+        return node;
+    }
+
+    public long getAdmissionFailures() {
+        return admissionFailures.get();
+    }
+
+    public long getTransportFailures() {
+        return transportFailures.get();
+    }
+
+    public long getReadbackFailures() {
+        return readbackFailures.get();
+    }
+
+    public long getUnreadableRecords() {
+        return outbox.getUnreadableRecords();
+    }
+
+    public long getRetainedBytes() throws IOException {
+        return outbox.retainedBytes();
+    }
+
+    @PreDestroy
+    public void close() throws IOException {
+        executor.shutdownNow();
+        try {
+            if (!executor.awaitTermination(15, TimeUnit.SECONDS)) {
+                throw new IOException("Native export worker did not stop; outbox lock retained");
+            }
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Interrupted stopping native metric export", interrupted);
+        }
+        outbox.close();
+    }
+}
