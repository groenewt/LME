+package org.apache.hertzbeat.alert.lifecycle;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import jakarta.annotation.PostConstruct;
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import javax.sql.DataSource;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.jdbc.datasource.DataSourceUtils;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+
+/** Sanitized event projection. Labels, fingerprints, content and receiver addresses never enter it. */
+@Service
+public class LifecycleOutbox {
+    private final DataSource dataSource;
+    private final ObjectMapper mapper;
+    private final boolean enabled;
+    private final String sourceNode;
+    private final JdbcLifecycleQueue queue;
+    private static final Set<String> STATUSES = Set.of("firing", "resolved", "acknowledged", "pending", "unresolved");
+
+    /** Closed vocabulary of lifecycle and notification routing decisions. */
+    public enum Decision {
+        STATE_CHANGED, MANUAL_STATE_CHANGED, DELETED, SUPPRESSED_SILENCE, SUPPRESSED_INHIBIT,
+        SUPPRESSED_REPEAT, NOTIFICATION_SELECTED, NOTIFICATION_NO_MATCH, NOTIFICATION_INVALID_RECEIVER,
+        NOTIFICATION_QUEUED, NOTIFICATION_REJECTED, NOTIFICATION_HANDLER_COMPLETED, NOTIFICATION_FAILED
+    }
+
+    public LifecycleOutbox(DataSource dataSource,
+                           @Value("${lme.lifecycle.enabled:false}") boolean enabled,
+                           @Value("${lme.lifecycle.source-node:}") String sourceNode,
+                           @Value("${lme.lifecycle.max-bytes:67108864}") long maxBytes) {
+        this.dataSource = dataSource;
+        this.mapper = new ObjectMapper();
+        this.enabled = enabled;
+        this.sourceNode = sourceNode;
+        this.queue = new JdbcLifecycleQueue(maxBytes);
+    }
+
+    @PostConstruct
+    public void validate() {
+        if (enabled && !sourceNode.matches("[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}")) {
+            throw new IllegalArgumentException("Lifecycle source-node must be a configured opaque node identifier");
+        }
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void lock() {
+        if (!enabled) {
+            return;
+        }
+        Connection connection = DataSourceUtils.getConnection(dataSource);
+        try {
+            queue.lockQuota(connection);
+        } catch (SQLException failure) {
+            throw new IllegalStateException("Lifecycle quota lock failed");
+        } finally {
+            DataSourceUtils.releaseConnection(connection, dataSource);
+        }
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void record(String subjectType, Long subjectId, String previous, String current, Decision decision) {
+        if (!enabled) {
+            return;
+        }
+        if (!TransactionSynchronizationManager.isActualTransactionActive()) {
+            throw new IllegalStateException("Lifecycle outbox requires a state transaction");
+        }
+        if (!Set.of("single", "group").contains(subjectType) || subjectId == null) {
+            throw new IllegalArgumentException("Persist an alert before projecting its lifecycle");
+        }
+        String id = UUID.randomUUID().toString();
+        Instant now = Instant.now();
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("event_type", "hertzbeat.alert.lifecycle.v1");
+        body.put("subject_type", subjectType);
+        body.put("subject_id", UUID.nameUUIDFromBytes((sourceNode + ":" + subjectType + ":" + subjectId)
+                .getBytes(StandardCharsets.UTF_8)).toString());
+        body.put("decision", decision.name());
+        body.put("previous_status", status(previous));
+        body.put("status", status(current));
+        Map<String, Object> event = new LinkedHashMap<>();
+        event.put("schema_version", 1);
+        event.put("event_id", id);
+        event.put("source_node", sourceNode);
+        event.put("observed_at", now.toString());
+        event.put("kind", "lifecycle");
+        event.put("severity", "INFO");
+        event.put("dataset", "hertzbeat.alert.lifecycle");
+        event.put("body", body);
+        event.put("attributes", Map.of("service.name", "hertzbeat", "event.type", "alert.lifecycle"));
+        Connection connection = DataSourceUtils.getConnection(dataSource);
+        try {
+            queue.append(connection, id, mapper.writeValueAsString(event), now.toEpochMilli());
+        } catch (SQLException | JsonProcessingException failure) {
+            throw new IllegalStateException("Lifecycle admission failed; alert transaction rolled back");
+        } finally {
+            DataSourceUtils.releaseConnection(connection, dataSource);
+        }
+    }
+
+    @Transactional(propagation = Propagation.REQUIRES_NEW, rollbackFor = Exception.class)
+    public void notification(Long groupId, String status, Decision decision) {
+        record("group", groupId, status, status, decision);
+    }
+
+    private String status(String value) {
+        return value == null ? "absent" : STATUSES.contains(value) ? value : "other";
+    }
+}
