+package org.apache.hertzbeat.collector.collect.common.jmx;
+
+import java.io.IOException;
+import java.io.ObjectOutputStream;
+import java.io.OutputStream;
+import java.lang.reflect.Proxy;
+import java.net.URI;
+import java.rmi.Remote;
+import java.rmi.registry.LocateRegistry;
+import java.rmi.server.RMIClientSocketFactory;
+import java.rmi.server.RemoteObject;
+import java.rmi.server.RemoteObjectInvocationHandler;
+import java.util.Map;
+import javax.management.remote.JMXConnector;
+import javax.management.remote.JMXServiceURL;
+import javax.management.remote.rmi.RMIConnection;
+import javax.management.remote.rmi.RMIConnector;
+import javax.management.remote.rmi.RMIServer;
+import javax.net.ssl.SSLSocketFactory;
+import javax.rmi.ssl.SslRMIClientSocketFactory;
+import org.apache.hertzbeat.collector.collect.common.http.VerifiedSslSocketFactory;
+
+/** Verified TLS for the registry, RMIServer and RMIConnection, including downgrade rejection. */
+public final class VerifiedJmxConnector {
+    private VerifiedJmxConnector() {
+    }
+
+    public static JMXConnector connect(JMXServiceURL url, Map<String, ?> environment) throws IOException {
+        if (!(SSLSocketFactory.getDefault() instanceof VerifiedSslSocketFactory)) {
+            throw new IOException("Secured JMX requires the VerifiedSslSocketFactory JVM security provider");
+        }
+        if (!"rmi".equals(url.getProtocol()) || !url.getURLPath().startsWith("/jndi/rmi://")) {
+            throw new IOException("Secured JMX requires an RMI registry URL");
+        }
+        URI registry;
+        try {
+            registry = URI.create(url.getURLPath().substring("/jndi/".length()));
+        } catch (IllegalArgumentException exception) {
+            throw new IOException("Invalid secured JMX registry URL", exception);
+        }
+        if (registry.getHost() == null || registry.getPort() < 1 || registry.getPort() > 65535
+                || registry.getUserInfo() != null || registry.getQuery() != null || registry.getFragment() != null
+                || registry.getPath() == null || registry.getPath().length() < 2) {
+            throw new IOException("Invalid secured JMX registry endpoint");
+        }
+        Remote remote;
+        try {
+            remote = LocateRegistry.getRegistry(registry.getHost(), registry.getPort(), new SslRMIClientSocketFactory())
+                    .lookup(registry.getPath().substring(1));
+        } catch (java.rmi.NotBoundException exception) {
+            throw new IOException("Secured JMX registry name is not bound", exception);
+        }
+        if (!(remote instanceof RMIServer server)) {
+            throw new IOException("Registry did not return an RMIServer");
+        }
+        requireTlsStub(server);
+        // Validate the connection stub too: it is a separate remote endpoint returned after authentication.
+        RMIServer verifiedServer = new RMIServer() {
+            @Override
+            public String getVersion() throws java.rmi.RemoteException {
+                return server.getVersion();
+            }
+
+            @Override
+            public RMIConnection newClient(Object credentials) throws IOException {
+                RMIConnection connection = server.newClient(credentials);
+                requireTlsStub(connection);
+                return connection;
+            }
+        };
+        RMIConnector connector = new RMIConnector(verifiedServer, environment);
+        try {
+            connector.connect(environment);
+            return connector;
+        } catch (IOException | RuntimeException exception) {
+            try {
+                connector.close();
+            } catch (IOException closeFailure) {
+                exception.addSuppressed(closeFailure);
+            }
+            throw exception;
+        }
+    }
+
+    private static void requireTlsStub(Remote remote) throws IOException {
+        RemoteObject object;
+        if (remote instanceof RemoteObject remoteObject) {
+            object = remoteObject;
+        } else if (Proxy.isProxyClass(remote.getClass())
+                && Proxy.getInvocationHandler(remote) instanceof RemoteObjectInvocationHandler handler) {
+            object = handler;
+        } else {
+            throw new IOException("Secured JMX requires a standard RMI stub");
+        }
+        // Plain UnicastRef has no client socket factory and would silently downgrade to TCP.
+        if (!"sun.rmi.server.UnicastRef2".equals(object.getRef().getClass().getName())) {
+            throw new IOException("Secured JMX refused a plaintext RMI stub");
+        }
+        try (FactoryVerifier verifier = new FactoryVerifier()) {
+            // Externalization exposes the factory without reflection into encapsulated JDK classes
+            // and without deserializing a second, potentially executable object graph.
+            object.getRef().writeExternal(verifier);
+            if (!verifier.verified) {
+                throw new IOException("Secured JMX RMI stub has no verified SSL client socket factory");
+            }
+        }
+    }
+
+    private static final class FactoryVerifier extends ObjectOutputStream {
+        private boolean verified;
+
+        private FactoryVerifier() throws IOException {
+            super(OutputStream.nullOutputStream());
+            enableReplaceObject(true);
+        }
+
+        @Override
+        protected Object replaceObject(Object object) throws IOException {
+            if (object instanceof RMIClientSocketFactory) {
+                if (object.getClass() != SslRMIClientSocketFactory.class) {
+                    throw new IOException("Secured JMX refused an unsupported RMI socket factory");
+                }
+                verified = true;
+            }
+            return object;
+        }
+    }
+}
