+package org.apache.hertzbeat.otel.nativeexport;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.util.Map;
+import java.util.Set;
+import org.apache.hertzbeat.common.constants.CommonConstants;
+import org.apache.hertzbeat.common.entity.message.CollectRep;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class NativeMetricSnapshotTest {
+    @Test
+    void detachedSnapshotSurvivesArrowReleaseAndPreservesTimeUnitAndDimensions() throws Exception {
+        NativeMetricSnapshot snapshot;
+        try (CollectRep.MetricsData data = sample("42.25", 1700000000123L)) {
+            snapshot = NativeMetricSnapshot.capture(data, Set.of("region"));
+        }
+        assertEquals(42.25, snapshot.points().getFirst().value());
+        assertEquals(Map.of("hertzbeat.field.device", "sda", "hertzbeat.label.region", "lab"), snapshot.points().getFirst().attributes());
+        assertThrows(UnsupportedOperationException.class, () -> snapshot.points().clear());
+        assertThrows(UnsupportedOperationException.class, () -> snapshot.points().getFirst().attributes().clear());
+        JsonNode root = new ObjectMapper().readTree(snapshot.toOtlpJson("collector-id", "collector"));
+        JsonNode metric = root.at("/resourceMetrics/0/scopeMetrics/0/metrics/0");
+        assertEquals("hertzbeat.linux.disk.used", metric.path("name").asText());
+        assertEquals("By", metric.path("unit").asText());
+        assertEquals("1700000000123000000", metric.at("/gauge/dataPoints/0/timeUnixNano").asText());
+        assertEquals(42.25, metric.at("/gauge/dataPoints/0/asDouble").asDouble());
+        assertFalse(root.toString().contains("synthetic-secret"));
+        assertFalse(root.toString().contains("delivery_id"));
+        assertTrue(root.toString().contains("monitored-host"));
+    }
+
+    @Test
+    void invalidNumbersAndMissingOriginalTimestampAreRejected() {
+        try (CollectRep.MetricsData data = sample("NaN", 1700000000123L)) {
+            assertThrows(IllegalArgumentException.class, () -> NativeMetricSnapshot.capture(data, Set.of()));
+        }
+        try (CollectRep.MetricsData data = sample("1", 0)) {
+            assertThrows(IllegalArgumentException.class, () -> NativeMetricSnapshot.capture(data, Set.of()));
+        }
+    }
+
+    private CollectRep.MetricsData sample(String value, long timestamp) {
+        return CollectRep.MetricsData.newBuilder().setId(17).setApp("linux").setMetrics("disk")
+                .setTime(timestamp).setCode(CollectRep.Code.SUCCESS)
+                .setLabels(Map.of("region", "lab", "password", "synthetic-secret", "host.name", "monitored-host"))
+                .addField(CollectRep.Field.newBuilder().setName("device").setType(CommonConstants.TYPE_STRING).setLabel(true).build())
+                .addField(CollectRep.Field.newBuilder().setName("used").setType(CommonConstants.TYPE_NUMBER).setUnit("By").build())
+                .addValueRow(CollectRep.ValueRow.newBuilder().addColumn("sda").addColumn(value).build()).build();
+    }
+}
