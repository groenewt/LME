+
+/* Synthetic loopback SSH fixture exercising the actual shared collector client. */
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.time.Duration;
+import java.util.List;
+import org.apache.sshd.common.config.keys.PublicKeyEntry;
+import org.apache.sshd.server.SshServer;
+import org.apache.hertzbeat.collector.collect.common.ssh.CommonSshClient;
+
+public class VerifiedSshProbe {
+    public static void main(String[] args) throws Exception {
+        Path knownHosts = Path.of(args[0], "known_hosts");
+        System.setProperty("hertzbeat.ssh.knownHosts", knownHosts.toString());
+        KeyPair trusted = KeyPairGenerator.getInstance("RSA").generateKeyPair();
+        KeyPair wrong = KeyPairGenerator.getInstance("RSA").generateKeyPair();
+        try (SshServer server = SshServer.setUpDefaultServer()) {
+            server.setHost("127.0.0.1");
+            server.setPort(0);
+            server.setKeyPairProvider(session -> List.of(trusted));
+            server.setPasswordAuthenticator((user, password, session) ->
+                    user.equals("synthetic-reader") && password.equals("synthetic-only"));
+            server.start();
+            var client = CommonSshClient.getSshClient();
+            try {
+                for (String fixture : new String[]{"valid", "changed", "unknown", "missing"}) {
+                    if (fixture.equals("missing")) {
+                        Files.deleteIfExists(knownHosts);
+                    } else {
+                        String host = fixture.equals("unknown") ? "other.invalid" : "[127.0.0.1]:" + server.getPort();
+                        Files.writeString(knownHosts, host + " " + PublicKeyEntry.toString(
+                                fixture.equals("changed") ? wrong.getPublic() : trusted.getPublic()) + "\n");
+                        // Force a distinct file timestamp even on coarse filesystems.
+                        Files.setLastModifiedTime(knownHosts, java.nio.file.attribute.FileTime.fromMillis(
+                                System.currentTimeMillis() + 5000L * fixture.length()));
+                    }
+                    boolean accepted = false;
+                    try (var session = client.connect("synthetic-reader", "127.0.0.1", server.getPort())
+                            .verify(Duration.ofSeconds(5)).getSession()) {
+                        session.addPasswordIdentity("synthetic-only");
+                        session.auth().verify(Duration.ofSeconds(5));
+                        accepted = session.isAuthenticated();
+                    } catch (org.apache.sshd.common.SshException expected) {
+                        // Identity rejection is expected for unknown, changed and missing keys.
+                        if (!expected.toString().contains("Server key did not validate")) { throw expected; }
+                    }
+                    if (accepted != fixture.equals("valid")) { throw new AssertionError("SSH " + fixture + " accepted=" + accepted); }
+                    System.out.println("PASS SSH " + fixture);
+                }
+            } finally { client.stop(); }
+        }
+    }
+}
