@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Run local transport probes using cached jars; fixtures are synthetic and temporary."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+CACHE = Path(os.environ.get("MAVEN_REPO", str(Path.home() / ".m2/repository")))
+ARTIFACTS = {
+    "org/apache/httpcomponents/httpclient": "4.5.14",
+    "org/apache/httpcomponents/httpcore": "4.4.16",
+    "commons-logging/commons-logging": "1.2",
+    "commons-codec/commons-codec": "1.17.0",
+    "org/slf4j/slf4j-api": "2.0.17",
+    "com/google/guava/guava": None,
+    "org/projectlombok/lombok": None,
+    "org/apache/sshd/sshd-core": "2.13.1",
+    "org/apache/sshd/sshd-common": "2.13.1",
+}
+
+def run(*args):
+    subprocess.run(args, check=True)
+
+with tempfile.TemporaryDirectory(prefix="hertzbeat-transport-") as temp:
+    directory = Path(temp)
+    for name, san in [("valid", "localhost"), ("wrong-san", "wrong.invalid"), ("untrusted", "localhost")]:
+        run("keytool", "-genkeypair", "-alias", name, "-keyalg", "RSA", "-keysize", "2048",
+            "-dname", "CN=" + san, "-ext", "SAN=dns:" + san, "-validity", "2", "-storetype", "PKCS12",
+            "-keystore", str(directory / (name + ".p12")), "-storepass", "synthetic-only", "-noprompt")
+        if name != "untrusted":
+            run("keytool", "-exportcert", "-alias", name, "-keystore", str(directory / (name + ".p12")),
+                "-storepass", "synthetic-only", "-file", str(directory / (name + ".cer")))
+            run("keytool", "-importcert", "-alias", name, "-keystore", str(directory / "trust.p12"),
+                "-storepass", "synthetic-only", "-file", str(directory / (name + ".cer")), "-noprompt")
+    jars = []
+    for artifact, version in ARTIFACTS.items():
+        found = sorted((CACHE / artifact).glob((version or "*") + "/*.jar"))
+        found = [p for p in found if not p.name.endswith(("-sources.jar", "-javadoc.jar"))]
+        if not found:
+            found = sorted((Path("/tmp/lme-hertzbeat-m2") / artifact).glob((version or "*") + "/*.jar"))
+            found = [p for p in found if not p.name.endswith(("-sources.jar", "-javadoc.jar"))]
+        if not found:
+            raise SystemExit("Missing cached test dependency: " + artifact)
+        jars.append(str(found[-1]))
+    classpath = os.pathsep.join(jars)
+    source = ROOT / "hertzbeat-collector-common/src/main/java/org/apache/hertzbeat/collector/collect/common/http/CommonHttpClient.java"
+    run("javac", "-proc:full", "-cp", classpath, "-d", temp, str(source),
+        str(source.with_name("VerifiedSslSocketFactory.java")),
+        str(source.parent.parent / "jmx/VerifiedJmxConnector.java"),
+        str(source.parent.parent / "ssh/CommonSshClient.java"),
+        str(ROOT / "security-tests/VerifiedSshProbe.java"),
+        str(ROOT / "security-tests/VerifiedTlsProbe.java"), str(ROOT / "security-tests/VerifiedJmxProbe.java"))
+    run("java", "-Djavax.net.ssl.trustStore=" + str(directory / "trust.p12"),
+        "-Djavax.net.ssl.trustStorePassword=synthetic-only", "-cp", temp + os.pathsep + classpath,
+        "VerifiedTlsProbe", temp)
+    run("java", "-cp", temp + os.pathsep + classpath, "VerifiedJmxProbe", temp, "missing-provider")
+    (directory / "verified.security").write_text(
+        "ssl.SocketFactory.provider=org.apache.hertzbeat.collector.collect.common.http.VerifiedSslSocketFactory\n")
+    run("java", "-Djavax.net.ssl.trustStore=" + str(directory / "trust.p12"),
+        "-Djavax.net.ssl.trustStorePassword=synthetic-only",
+        "-Djava.security.properties=" + str(directory / "verified.security"),
+        "-cp", temp + os.pathsep + classpath, "VerifiedJmxProbe", temp)
+    run("java", "-cp", temp + os.pathsep + classpath, "VerifiedSshProbe", temp)
diff --git a/hertzbeat-collector/security-tests/test_narrow_templates.py b/hertzbeat-collector/security-tests/test_narrow_templates.py
new file mode 100644
index 000000000..2f35d2fb3
--- /dev/null
+++ b/hertzbeat-collector/security-tests/test_narrow_templates.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Validate the narrow LME templates and their selected response-field contracts."""
+import copy
+from pathlib import Path
+import re
+import unittest
+import uuid
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+DEFINITIONS = ROOT / "hertzbeat-manager/src/main/resources/define"
+APPS = ("lme-service-ssh", "lme-elasticsearch-rest", "lme-elasticsearch-jmx")
+
+
+def load(app):
+    return yaml.safe_load((DEFINITIONS / ("app-" + app + ".yml")).read_text())
+
+
+def validate(document):
+    app = document["app"]
+    assert app in APPS
+    params = {p["field"]: p for p in document["params"]}
+    assert len(params) == len(document["params"])
+    expected_params = {"host", "port", "username"}
+    expected_params |= {"privateKey", "serviceToken"} if app == APPS[0] else {"password"}
+    assert set(params) == expected_params
+    assert all(p["required"] is True for p in params.values())
+    assert params["port"]["range"] == "[1,65535]"
+    metrics = document["metrics"]
+    assert len({m["name"] for m in metrics}) == len(metrics)
+    references = set(re.findall(r"\^_\^([A-Za-z0-9_]+)\^_\^", yaml.safe_dump(metrics)))
+    assert references == expected_params
+    fields = [[f["field"] for f in m["fields"]] for m in metrics]
+    if app == APPS[0]:
+        assert fields == [["active"]]
+        assert metrics[0]["fields"][0]["type"] == 0
+        assert metrics[0]["protocol"] == "ssh"
+        ssh = metrics[0]["ssh"]
+        assert ssh["script"] == "lme-service ^_^serviceToken^_^"
+        assert ssh["parseType"] == "oneRow"
+        assert ssh["useProxy"] == "false"
+        assert "password" not in ssh
+        assert params["port"]["defaultValue"] == 22
+    elif app == APPS[1]:
+        assert fields == [["status", "number_of_nodes", "number_of_data_nodes"]]
+        assert metrics[0]["protocol"] == "http"
+        http = metrics[0]["http"]
+        assert http["url"] == "/_cluster/health"
+        assert http["method"] == "GET"
+        assert http["ssl"] == "true"
+        assert http["parseType"] == "jsonPath" and http["parseScript"] == "$"
+        assert http["authorization"] == {
+            "type": "Basic Auth", "basicAuthUsername": "^_^username^_^", "basicAuthPassword": "^_^password^_^"
+        }
+    else:
+        assert fields == [["ThreadCount", "PeakThreadCount"], ["Name", "CollectionCount", "CollectionTime"]]
+        assert [m["jmx"]["objectName"] for m in metrics] == [
+            "java.lang:type=Threading", "java.lang:type=GarbageCollector,name=*"
+        ]
+        assert all(m["protocol"] == "jmx" and m["jmx"]["ssl"] == "true" for m in metrics)
+        assert metrics[1]["fields"][0]["label"] is True
+        assert metrics[1]["fields"][0]["type"] == 1
+        assert all(f["type"] == 0 for m in metrics for f in m["fields"] if f["field"] != "Name")
+        assert metrics[1]["fields"][2]["unit"] == "ms"
+
+
+class NarrowTemplateTest(unittest.TestCase):
+    def test_all_templates_parse_with_complete_parameter_wiring(self):
+        for app in APPS:
+            with self.subTest(app=app):
+                validate(load(app))
+
+    def test_ssh_single_field_matches_forced_command_output(self):
+        template = load(APPS[0])
+        protocol = template["metrics"][0]["ssh"]
+        token = str(uuid.UUID("3d807c58-a8d3-452b-bcca-98981a8b7aa0"))
+        self.assertEqual(protocol["script"].replace("^_^serviceToken^_^", token).split(), ["lme-service", token])
+        for stdout, expected in [("1\n", 1), ("0\n", 0)]:
+            self.assertEqual(len(stdout.splitlines()), len(template["metrics"][0]["fields"]))
+            self.assertEqual(int(stdout.strip()), expected)
+
+    def test_rest_projection_excludes_unowned_resource_fields(self):
+        # JSONPath "$" returns this root object; field names select only the owned columns.
+        response = {"status": "green", "number_of_nodes": 3, "number_of_data_nodes": 2,
+                    "active_shards": 42, "cpu": 99, "memory": 1024}
+        fields = load(APPS[1])["metrics"][0]["fields"]
+        self.assertEqual([response[field["field"]] for field in fields], ["green", 3, 2])
+
+    def test_gc_label_distinguishes_multiple_collectors(self):
+        beans = [{"Name": "G1 Young Generation", "CollectionCount": 12, "CollectionTime": 87},
+                 {"Name": "G1 Old Generation", "CollectionCount": 3, "CollectionTime": 20}]
+        fields = load(APPS[2])["metrics"][1]["fields"]
+        self.assertEqual([[bean[f["field"]] for f in fields] for bean in beans],
+                         [["G1 Young Generation", 12, 87], ["G1 Old Generation", 3, 20]])
+
+    def test_security_and_scope_drift_is_rejected(self):
+        mutations = []
+        for app, protocol in [(APPS[1], "http"), (APPS[2], "jmx")]:
+            document = load(app)
+            document["metrics"][0][protocol]["ssl"] = "false"
+            mutations.append(document)
+        document = load(APPS[0])
+        document["metrics"][0]["ssh"]["script"] += "; uname -a"
+        mutations.append(document)
+        document = load(APPS[1])
+        document["metrics"][0]["fields"].append({"field": "cpu", "type": 0})
+        mutations.append(document)
+        document = load(APPS[2])
+        document["metrics"][1]["fields"][0]["label"] = False
+        mutations.append(document)
+        document = load(APPS[0])
+        document["metrics"][0]["ssh"]["privateKey"] = "^_^undeclared^_^"
+        mutations.append(document)
+        for document in mutations:
+            with self.subTest(app=document["app"]):
+                with self.assertRaises(AssertionError):
+                    validate(document)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
