+package org.apache.hertzbeat.startup;
+
+import java.sql.DriverManager;
+import java.util.Arrays;
+import org.junit.jupiter.api.Test;
+import org.springframework.core.env.SimpleCommandLinePropertySource;
+import org.springframework.boot.SpringApplication;
+import org.springframework.boot.WebApplicationType;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+class SchemaOnlyApplicationTest {
+    @Test
+    void normalApplicationCannotEnableSchemaWrites() {
+        var source = new SimpleCommandLinePropertySource(SchemaOnlyApplication.normalArguments(
+                new String[] {"--spring.jpa.hibernate.ddl-auto=create", "--spring.flyway.enabled=true"}));
+        // Duplicate CLI options are joined by Spring; avoid duplicates rather than relying on order.
+        assertEquals("validate", source.getProperty("spring.jpa.hibernate.ddl-auto"));
+        assertEquals("false", source.getProperty("spring.flyway.enabled"));
+    }
+
+    @Test
+    void schemaOnlyCreatesNativeTablesAndQuotaBeforeNormalValidation() throws Exception {
+        String url = "jdbc:h2:mem:lme_schema_only;MODE=MYSQL;DB_CLOSE_DELAY=-1";
+        String[] databaseArgs = new String[] { "--spring.datasource.url=" + url,
+            "--spring.datasource.username=sa", "--spring.datasource.password=",
+            "--spring.jpa.database=h2", "--spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect",
+            "--spring.flyway.locations=classpath:db/migration/h2"};
+        var beans = SchemaOnlyApplication.initialize(databaseArgs);
+        assertFalse(beans.contains("dataStorageDispatch"));
+        assertFalse(beans.contains("periodicAlertRuleScheduler"));
+        assertFalse(beans.contains("nettyRemotingServer"));
+        var validation = new SpringApplication(SchemaOnlyApplication.SchemaConfiguration.class);
+        validation.setWebApplicationType(WebApplicationType.NONE);
+        validation.setAdditionalProfiles("schema-only");
+        try (var context = validation.run(SchemaOnlyApplication.normalArguments(databaseArgs))) {
+            assertFalse(context.containsBean("delayedFlywayInitializer"));
+        }
+        try (var connection = DriverManager.getConnection(url, "sa", "");
+                var statement = connection.createStatement()) {
+            for (String table : Arrays.asList("hzb_monitor", "hzb_collector", "hzb_lifecycle_outbox")) {
+                try (var rows = statement.executeQuery("SELECT count(*) FROM " + table)) {
+                    rows.next();
+                    assertEquals(0, rows.getLong(1));
+                }
+            }
+            try (var rows = statement.executeQuery("SELECT used_bytes FROM hzb_lifecycle_quota WHERE id=1")) {
+                rows.next();
+                assertEquals(0, rows.getLong(1));
+            }
+        }
+    }
+}
