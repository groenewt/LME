+import org.springframework.context.annotation.Import;
+import org.springframework.context.annotation.Profile;
+import org.springframework.jdbc.core.JdbcTemplate;
+
+/** One-shot schema initialization. Deliberately has no component/repository scan or scheduling. */
+public final class SchemaOnlyApplication {
+    private SchemaOnlyApplication() {
+    }
+
+    static String[] normalArguments(String[] args) {
+        String[] filtered = Arrays.stream(args).filter(arg -> !arg.startsWith("--spring.jpa.hibernate.ddl-auto=")
+                && !arg.startsWith("--spring.flyway.enabled=")).toArray(String[]::new);
+        String[] validated = Arrays.copyOf(filtered, filtered.length + 2);
+        validated[filtered.length] = "--spring.jpa.hibernate.ddl-auto=validate";
+        validated[filtered.length + 1] = "--spring.flyway.enabled=false";
+        return validated;
+    }
+
+    static Set<String> initialize(String[] args) {
+        SpringApplication application = new SpringApplication(SchemaConfiguration.class);
+        application.setWebApplicationType(WebApplicationType.NONE);
+        application.setAdditionalProfiles("schema-only");
+        application.setDefaultProperties(Map.of("spring.main.banner-mode", "off"));
+        // Command-line properties have higher precedence than application.yml. Never permit the
+        // one-shot command to accidentally validate an empty schema or launch a web application.
+        String[] filtered = Arrays.stream(args).filter(arg -> !arg.equals("--schema-only")
+                && !arg.startsWith("--spring.jpa.hibernate.ddl-auto=")
+                && !arg.startsWith("--spring.flyway.enabled=")
+                && !arg.startsWith("--spring.main.web-application-type=")
+                && !arg.startsWith("--spring.flyway.clean-disabled="))
+                .toArray(String[]::new);
+        String[] forced = Arrays.copyOf(filtered, filtered.length + 4);
+        forced[filtered.length] = "--spring.jpa.hibernate.ddl-auto=update";
+        forced[filtered.length + 1] = "--spring.flyway.enabled=true";
+        forced[filtered.length + 2] = "--spring.main.web-application-type=none";
+        forced[filtered.length + 3] = "--spring.flyway.clean-disabled=true";
+        try (ConfigurableApplicationContext context = application.run(forced)) {
+            // FlywayConfiguration depends on entityManagerFactory: Hibernate runs before Flyway.
+            context.getBean("delayedFlywayInitializer");
+            JdbcTemplate jdbc = new JdbcTemplate(context.getBean(DataSource.class));
+            jdbc.update("INSERT INTO hzb_lifecycle_quota(id,used_bytes) "
+                    + "SELECT 1,0 WHERE NOT EXISTS (SELECT 1 FROM hzb_lifecycle_quota WHERE id=1)");
+            return Set.of(context.getBeanDefinitionNames());
+        }
+    }
+
+    @Profile("schema-only")
+    @Configuration(proxyBeanMethods = false)
+    @ImportAutoConfiguration({DataSourceAutoConfiguration.class, HibernateJpaAutoConfiguration.class})
+    @EnableConfigurationProperties(FlywayProperties.class)
+    @EntityScan(basePackages = "org.apache.hertzbeat")
+    @Import(FlywayConfiguration.class)
+    static class SchemaConfiguration {
+        @Bean
+        Flyway flyway(DataSource dataSource, FlywayProperties properties) throws SQLException {
+            String vendor;
+            try (var connection = dataSource.getConnection()) {
+                vendor = connection.getMetaData().getDatabaseProductName().toLowerCase(Locale.ROOT);
+            }
+            final String databaseVendor = vendor;
+            String[] locations = properties.getLocations().stream()
+                    .map(location -> location.replace("{vendor}", databaseVendor)).toArray(String[]::new);
+            return Flyway.configure().dataSource(dataSource).locations(locations)
+                    .baselineOnMigrate(properties.isBaselineOnMigrate())
+                    .baselineVersion(properties.getBaselineVersion()).cleanDisabled(true).load();
+        }
+    }
+}
