+package org.apache.hertzbeat.otel.nativeexport;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.channels.OverlappingFileLockException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class NativeMetricOutboxTest {
+    @TempDir
+    Path directory;
+
+    @Test
+    void restartPreservesOpaqueIdBytesAndAdmissionTimeRoute() throws Exception {
+        byte[] payload = "original immutable samples".getBytes(StandardCharsets.UTF_8);
+        UUID id;
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            id = outbox.admit("https://old-route/v1/metrics", "/private/source.authorization", List.of("elastic", "hertzbeat"), payload);
+            assertNotEquals(id, outbox.admit("https://new-route/v1/metrics", List.of("elastic"), payload));
+            payload[0] = 'X';
+        }
+        try (NativeMetricOutbox restarted = new NativeMetricOutbox(directory, 4096, 0)) {
+            NativeMetricOutbox.Entry entry = restarted.read(id);
+            assertEquals("https://old-route/v1/metrics", entry.endpoint());
+            assertEquals("/private/source.authorization", entry.authorizationFile());
+            assertEquals(List.of("elastic", "hertzbeat"), entry.sinks());
+            assertEquals('o', entry.payload()[0]);
+            byte[] copy = entry.payload();
+            copy[0] = 'Y';
+            assertEquals('o', entry.payload()[0]);
+            assertFalse(entry.accepted());
+        }
+    }
+
+    @Test
+    void legacyVersionOneRemainsReadableWithoutInventingCredentialReference() throws Exception {
+        UUID id = UUID.randomUUID();
+        try (java.io.DataOutputStream output = new java.io.DataOutputStream(Files.newOutputStream(directory.resolve(id + ".pending")))) {
+            output.writeInt(1);
+            output.writeUTF("https://legacy.invalid/v1/metrics");
+            output.writeInt(1);
+            output.writeUTF("elastic");
+            output.writeInt(2);
+            output.write(new byte[] {'{', '}'});
+        }
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            NativeMetricOutbox.Entry entry = outbox.read(id);
+            assertEquals("", entry.authorizationFile());
+            assertEquals("https://legacy.invalid/v1/metrics", entry.endpoint());
+        }
+    }
+
+    @Test
+    void transportAcceptanceNeverDeletesAndAllSinksMustVerifyContent() throws Exception {
+        byte[] payload = "canonical content".getBytes(StandardCharsets.UTF_8);
+        UUID id;
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            id = outbox.admit("https://route/v1/metrics", List.of("elastic", "hertzbeat"), payload);
+            assertThrows(IOException.class, () -> outbox.verifyReadback(id, "elastic", payload));
+            outbox.transportAccepted(id);
+            assertTrue(outbox.pending(32).isEmpty());
+            assertTrue(outbox.retainedBytes() > 0);
+            assertThrows(IOException.class, () -> outbox.verifyReadback(id, "elastic", "copied hash".getBytes(StandardCharsets.UTF_8)));
+            assertThrows(IOException.class, () -> outbox.verifyReadback(id, "malcolm", payload));
+            outbox.verifyReadback(id, "elastic", payload);
+        }
+        try (NativeMetricOutbox restarted = new NativeMetricOutbox(directory, 4096, 0)) {
+            assertTrue(restarted.read(id).accepted());
+            assertArrayEquals(payload, restarted.read(id).payload());
+            restarted.verifyReadback(id, "hertzbeat", payload);
+            assertThrows(IOException.class, () -> restarted.read(id));
+            assertEquals(0, restarted.retainedBytes());
+        }
+    }
+
+    @Test
+    void capAndDiskReserveRejectWithoutDeletingUnverifiedRecords() throws Exception {
+        byte[] payload = new byte[200];
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 400, 0)) {
+            UUID id = outbox.admit("https://route/v1/metrics", List.of("elastic"), payload);
+            outbox.transportAccepted(id);
+            assertThrows(IOException.class, () -> outbox.admit("https://route/v1/metrics", List.of("elastic"), payload));
+            assertArrayEquals(payload, outbox.read(id).payload());
+        }
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, Long.MAX_VALUE)) {
+            assertThrows(IOException.class, () -> outbox.admit("https://route/v1/metrics", List.of("elastic"), payload));
+        }
+    }
+
+    @Test
+    void lockAndMalformedRecordsFailClosed() throws Exception {
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            assertThrows(OverlappingFileLockException.class, () -> new NativeMetricOutbox(directory, 4096, 0));
+            UUID id = outbox.admit("https://route/v1/metrics", List.of("elastic"), new byte[10]);
+            Files.write(directory.resolve(id + ".pending"), new byte[] {1, 2});
+            assertThrows(IOException.class, () -> outbox.read(id));
+            assertTrue(Files.exists(directory.resolve(id + ".pending")));
+            UUID healthy = outbox.admit("https://route/v1/metrics", List.of("elastic"), new byte[10]);
+            assertEquals(healthy, outbox.pending(32).getFirst().id());
+            assertTrue(outbox.getUnreadableRecords() > 0);
+            assertThrows(IllegalArgumentException.class,
+                    () -> outbox.admit("https://route/v1/metrics", List.of("elastic", "elastic"), new byte[10]));
+        }
+    }
+
+    @Test
+    void transportFailuresDoNotStarveOtherBatches() throws Exception {
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            for (int i = 0; i < 4; i++) {
+                outbox.admit("https://route/v1/metrics", List.of("elastic"), new byte[10]);
+            }
+            List<UUID> first = outbox.pending(2).stream().map(NativeMetricOutbox.Entry::id).toList();
+            List<UUID> second = outbox.pending(2).stream().map(NativeMetricOutbox.Entry::id).toList();
+            assertTrue(first.stream().noneMatch(second::contains));
+            assertEquals(first, outbox.pending(2).stream().map(NativeMetricOutbox.Entry::id).toList());
+        }
+    }
+}
