+
+package org.apache.hertzbeat.alert.lifecycle;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.nio.ByteBuffer;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.Flow;
+import java.util.concurrent.TimeUnit;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermission;
+import java.sql.Connection;
+import java.time.Duration;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+import javax.sql.DataSource;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.jdbc.datasource.DataSourceUtils;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/** A local-fsync receipt transfers custody to the delivery spool, never asserts sink delivery. */
+@Component
+@ConditionalOnProperty(name = "lme.lifecycle.enabled", havingValue = "true")
+public class LifecycleDelivery {
+    private final DataSource dataSource;
+    private final ObjectMapper mapper;
+    private final TransactionTemplate transaction;
+    private final JdbcLifecycleQueue queue;
+    private final URI endpoint;
+    private final Path tokenFile;
+    private final HttpClient client;
+    private long nextAttempt;
+    private long backoffMillis = 1000;
+    private volatile boolean degraded;
+
+    public LifecycleDelivery(DataSource dataSource, PlatformTransactionManager transactionManager,
+                             @Value("${lme.lifecycle.admission-url}") String endpoint,
+                             @Value("${lme.lifecycle.token-file}") String tokenFile,
+                             @Value("${lme.lifecycle.max-bytes:67108864}") long maxBytes) {
+        this.dataSource = dataSource;
+        this.mapper = new ObjectMapper();
+        this.transaction = new TransactionTemplate(transactionManager);
+        this.transaction.setTimeout(15);
+        this.queue = new JdbcLifecycleQueue(maxBytes);
+        this.endpoint = URI.create(endpoint);
+        this.tokenFile = Path.of(tokenFile);
+        boolean local = Set.of("127.0.0.1", "localhost", "[::1]").contains(this.endpoint.getHost());
+        if (!("https".equals(this.endpoint.getScheme()) || local && "http".equals(this.endpoint.getScheme()))
+                || this.endpoint.getUserInfo() != null || this.endpoint.getFragment() != null
+                || !"/v1/logs".equals(this.endpoint.getPath())) {
+            throw new IllegalArgumentException("Lifecycle admission requires HTTPS or isolated loopback /v1/logs");
+        }
+        this.client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(3))
+                .followRedirects(HttpClient.Redirect.NEVER).build();
+    }
+
+    @Scheduled(fixedDelay = 1000, initialDelay = 5000)
+    public synchronized void deliver() {
+        if (System.currentTimeMillis() < nextAttempt) {
+            return;
+        }
+        try {
+            transaction.executeWithoutResult(status -> deliverTransaction());
+            degraded = false;
+            backoffMillis = 1000;
+            nextAttempt = 0;
+        } catch (RuntimeException failure) {
+            // Do not log credentials, endpoint query strings, exception messages or returned payloads.
+            degraded = true;
+            nextAttempt = System.currentTimeMillis() + backoffMillis;
+            backoffMillis = Math.min(60000, backoffMillis * 2);
+        }
+    }
+
+    public boolean isDegraded() {
+        return degraded;
+    }
+
+    private void deliverTransaction() {
+        Connection connection = DataSourceUtils.getConnection(dataSource);
+        try {
+            List<JdbcLifecycleQueue.Entry> entries = queue.pending(connection, 64);
+            if (entries.isEmpty()) {
+                return;
+            }
+            String payload = "{\"records\":[" + entries.stream().map(JdbcLifecycleQueue.Entry::payload)
+                    .collect(Collectors.joining(",")) + "]}";
+            HttpRequest request = HttpRequest.newBuilder(endpoint).timeout(Duration.ofSeconds(5))
+                    .header("Content-Type", "application/json").header("Authorization", "Bearer " + token())
+                    .POST(HttpRequest.BodyPublishers.ofString(payload)).build();
+            var exchange = client.sendAsync(request, info -> new BoundedReceipt());
+            HttpResponse<byte[]> response;
+            try {
+                response = exchange.get(5, TimeUnit.SECONDS);
+            } finally {
+                if (!exchange.isDone()) {
+                    exchange.cancel(true);
+                }
+            }
+            {
+                byte[] bytes = response.body();
+                if (response.statusCode() != 202) {
+                    throw new IllegalStateException("Lifecycle spool did not confirm local fsync");
+                }
+                JsonNode ack = mapper.readTree(bytes);
+                if (!"local_fsync".equals(ack.path("ack").asText())
+                        || !ack.path("inserted").isIntegralNumber() || !ack.path("replayed").isIntegralNumber()
+                        || ack.path("inserted").asLong() < 0 || ack.path("replayed").asLong() < 0
+                        || ack.path("inserted").asLong() + ack.path("replayed").asLong() != entries.size()) {
+                    throw new IllegalStateException("Lifecycle spool receipt does not cover the batch");
+                }
+            }
+            queue.acknowledge(connection, entries.stream().map(JdbcLifecycleQueue.Entry::id).toList());
+        } catch (InterruptedException failure) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("Lifecycle handoff interrupted");
+        } catch (Exception failure) {
+            throw new IllegalStateException("Lifecycle handoff failed; immutable events retained");
+        } finally {
+            DataSourceUtils.releaseConnection(connection, dataSource);
+        }
+    }
+
+    private static final class BoundedReceipt implements HttpResponse.BodySubscriber<byte[]> {
+        private final HttpResponse.BodySubscriber<byte[]> delegate = HttpResponse.BodySubscribers.ofByteArray();
+        private Flow.Subscription subscription;
+        private int received;
+
+        @Override
+        public CompletionStage<byte[]> getBody() {
+            return delegate.getBody();
+        }
+
+        @Override
+        public void onSubscribe(Flow.Subscription subscription) {
+            this.subscription = subscription;
+            delegate.onSubscribe(subscription);
+        }
+
+        @Override
+        public void onNext(List<ByteBuffer> buffers) {
+            for (ByteBuffer buffer : buffers) {
+                if (buffer.remaining() > 4096 - received) {
+                    subscription.cancel();
+                    delegate.onError(new IllegalStateException("Lifecycle receipt exceeds bound"));
+                    return;
+                }
+                received += buffer.remaining();
+            }
+            delegate.onNext(buffers);
+        }
+
+        @Override
+        public void onError(Throwable failure) {
+            delegate.onError(failure);
+        }
+
+        @Override
+        public void onComplete() {
+            delegate.onComplete();
+        }
+    }
+
+    private String token() throws Exception {
+        if (!Files.isRegularFile(tokenFile, LinkOption.NOFOLLOW_LINKS) || Files.size(tokenFile) > 4096) {
+            throw new IllegalArgumentException("Lifecycle token must be a bounded private regular file");
+        }
+        Set<PosixFilePermission> permissions = Files.getPosixFilePermissions(tokenFile, LinkOption.NOFOLLOW_LINKS);
+        if (permissions.stream().anyMatch(p -> p.name().startsWith("GROUP_") || p.name().startsWith("OTHERS_"))) {
+            throw new IllegalArgumentException("Lifecycle token file must be owner-only");
+        }
+        String token = Files.readString(tokenFile).strip();
+        if (!token.matches("[!-~]{16,4096}")) {
+            throw new IllegalArgumentException("Invalid lifecycle token");
+        }
+        return token;
+    }
+}
