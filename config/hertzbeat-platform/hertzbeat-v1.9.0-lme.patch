+package org.apache.hertzbeat.otel.nativeexport;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.apache.hertzbeat.common.constants.CommonConstants;
+import org.apache.hertzbeat.common.entity.arrow.RowWrapper;
+import org.apache.hertzbeat.common.entity.message.CollectRep;
+import org.apache.hertzbeat.common.util.JsonUtil;
+
+/** Detached, immutable metric values. No Arrow references or label-derived occurrence IDs. */
+public record NativeMetricSnapshot(long monitorId, String app, long sourceMillis, List<Point> points,
+                                   Map<String, String> identity) {
+    public NativeMetricSnapshot {
+        points = List.copyOf(points);
+        identity = Map.copyOf(identity);
+    }
+
+    /** One numeric observation with the dimensions needed to distinguish its time series. */
+    public record Point(String name, String unit, double value, Map<String, String> attributes) {
+        public Point {
+            attributes = Map.copyOf(attributes);
+        }
+    }
+
+    public static NativeMetricSnapshot capture(CollectRep.MetricsData data, Set<String> allowedLabels) {
+        List<Point> points = new ArrayList<>();
+        Map<String, String> identity = new LinkedHashMap<>();
+        Map<String, String> custom = data.getLabels();
+        if (custom != null) {
+            for (String key : List.of("host.id", "host.name")) {
+                if (custom.get(key) != null && !custom.get(key).isBlank()) {
+                    identity.put(key, custom.get(key));
+                }
+            }
+        }
+        if (data.getCode() == CollectRep.Code.SUCCESS) {
+            if (data.getTime() <= 0) {
+                throw new IllegalArgumentException("Native sample requires original source timestamp");
+            }
+            List<CollectRep.Field> fields = data.getFields();
+            RowWrapper row = data.readRow();
+            while (row.hasNextRow()) {
+                row = row.nextRow();
+                List<String> cells = row.cellStream().map(cell -> cell.getValue()).toList();
+                Map<String, String> labels = new LinkedHashMap<>();
+                if (custom != null) {
+                    custom.forEach((key, value) -> {
+                        if (allowedLabels.contains(key) && value != null) {
+                            labels.put("hertzbeat.label." + key, value);
+                        }
+                    });
+                }
+                for (int i = 0; i < fields.size(); i++) {
+                    CollectRep.Field field = fields.get(i);
+                    // Native schema labels distinguish rows; dropping one can collapse distinct series.
+                    if (field.getLabel() && cells.get(i) != null) {
+                        labels.put("hertzbeat.field." + field.getName(), cells.get(i));
+                    }
+                }
+                for (int i = 0; i < fields.size(); i++) {
+                    CollectRep.Field field = fields.get(i);
+                    String value = cells.get(i);
+                    if (field.getLabel() || field.getType() != CommonConstants.TYPE_NUMBER
+                            || value == null || CommonConstants.NULL_VALUE.equals(value)) {
+                        continue;
+                    }
+                    double number = Double.parseDouble(value);
+                    if (!Double.isFinite(number)) {
+                        throw new IllegalArgumentException("Native sample contains non-finite number");
+                    }
+                    points.add(new Point("hertzbeat." + data.getApp() + "." + data.getMetrics() + "." + field.getName(),
+                            field.getUnit(), number, labels));
+                }
+            }
+        }
+        return new NativeMetricSnapshot(data.getId(), data.getApp(), data.getTime(), points, identity);
+    }
+
+    public byte[] toOtlpJson(String hostId, String hostName) {
+        List<Map<String, Object>> metrics = new ArrayList<>();
+        String timestamp = Long.toString(Math.multiplyExact(sourceMillis, 1_000_000L));
+        for (Point point : points) {
+            Map<String, String> exportedAttributes = new LinkedHashMap<>(point.attributes());
+            // The pinned ES ECS exporter omits these OTLP envelope fields; retain them for content readback.
+            exportedAttributes.put("lme.metric.unit", point.unit());
+            exportedAttributes.put("lme.metric.type", "gauge");
+            exportedAttributes.put("lme.scope.name", "org.apache.hertzbeat.native");
+            metrics.add(Map.of("name", point.name(), "unit", point.unit(), "gauge", Map.of("dataPoints", List.of(
+                    Map.of("asDouble", point.value(), "timeUnixNano", timestamp, "attributes", attributes(exportedAttributes))))));
+        }
+        Map<String, String> resource = Map.of("host.id", identity.getOrDefault("host.id", hostId),
+                "host.name", identity.getOrDefault("host.name", hostName),
+                "service.name", "hertzbeat-native", "service.instance.id", Long.toString(monitorId),
+                "hertzbeat.app", app, "lme.origin", "hertzbeat-native");
+        // CollectRep has no counter temporality/type metadata: represent its numeric observations as gauges.
+        return JsonUtil.toJson(Map.of("resourceMetrics", List.of(Map.of("resource", Map.of("attributes", attributes(resource)),
+                "scopeMetrics", List.of(Map.of("scope", Map.of("name", "org.apache.hertzbeat.native"), "metrics", metrics))))))
+                .getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static List<Map<String, Object>> attributes(Map<String, String> values) {
+        List<Map<String, Object>> result = new ArrayList<>();
+        values.forEach((key, value) -> result.add(Map.of("key", key, "value", Map.of("stringValue", value))));
+        return result;
+    }
+}
