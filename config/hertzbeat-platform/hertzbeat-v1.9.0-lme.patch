+package org.apache.hertzbeat.otel.nativeexport;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.nio.file.Path;
+import java.nio.file.Files;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+import org.springframework.core.env.MapPropertySource;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class NativeMetricExporterTest {
+    @TempDir
+    Path directory;
+
+    @Test
+    void sourceMapsSelectSeparateCredentialsAndSnapshotRoutingReferences() throws Exception {
+        Path graph = directory.resolve("graph.authorization");
+        Path trixie = directory.resolve("trixie.authorization");
+        Files.writeString(graph, "Bearer synthetic-graph");
+        Files.writeString(trixie, "Bearer synthetic-trixie");
+        Path authMap = directory.resolve("authorization.json");
+        Path endpointMap = directory.resolve("endpoints.json");
+        ObjectMapper mapper = new ObjectMapper();
+        Files.write(authMap, mapper.writeValueAsBytes(Map.of("physical:graph", graph.toString(), "guest:trixie", trixie.toString())));
+        Files.write(endpointMap, mapper.writeValueAsBytes(Map.of("physical:graph", "https://graph.invalid:14418/v1/metrics",
+                "guest:trixie", "https://trixie.invalid:14418/v1/metrics")));
+        NativeMetricExporter exporter = new NativeMetricExporter(directory.resolve("exporter").toString(),
+                "https://fallback.invalid/v1/metrics", "elastic", "host-id", "guest:trixie", "", trixie.toString(),
+                authMap.toString(), endpointMap.toString(), 268435456L, 2147483648L, mapper);
+        try {
+            byte[] graphPayload = sourcePayload("physical:graph");
+            NativeMetricExporter.SourceRoute graphRoute = exporter.sourceRoute(graphPayload);
+            assertEquals("https://graph.invalid:14418/v1/metrics", graphRoute.endpoint());
+            assertEquals(trixie.toString(), exporter.sourceRoute(sourcePayload("guest:trixie")).authorizationFile());
+            assertThrows(java.io.IOException.class, () -> exporter.sourceRoute(sourcePayload("physical:silmaril")));
+            NativeMetricOutbox.Entry entry;
+            try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory.resolve("queue"), 4096, 0)) {
+                UUID id = outbox.admit(graphRoute.endpoint(), graphRoute.authorizationFile(), List.of("elastic"), graphPayload);
+                entry = outbox.read(id);
+                outbox.transportAccepted(id);
+                assertTrue(outbox.read(id).accepted());
+            }
+            Files.write(authMap, mapper.writeValueAsBytes(Map.of("physical:graph", trixie.toString())));
+            Files.write(endpointMap, mapper.writeValueAsBytes(Map.of("physical:graph", "https://changed.invalid/v1/metrics")));
+            assertEquals("https://graph.invalid:14418/v1/metrics", entry.endpoint());
+            assertEquals("Bearer synthetic-graph", exporter.authorization(entry));
+            Files.writeString(graph, "Bearer synthetic-graph-rotated");
+            assertEquals("Bearer synthetic-graph-rotated", exporter.authorization(entry));
+            Files.delete(graph);
+            assertThrows(java.io.IOException.class, () -> exporter.authorization(entry));
+        } finally {
+            exporter.close();
+        }
+    }
+
+    @Test
+    void singleCredentialFallbackCannotAuthorizeOtherSources() throws Exception {
+        Path authorization = directory.resolve("authorization");
+        Files.writeString(authorization, "Bearer synthetic-trixie");
+        NativeMetricExporter exporter = new NativeMetricExporter(directory.resolve("queue").toString(),
+                "https://gateway.invalid/v1/metrics", "elastic", "host-id", "guest:trixie", "", authorization.toString(),
+                268435456L, 2147483648L, new ObjectMapper());
+        try {
+            assertEquals(authorization.toString(), exporter.sourceRoute(sourcePayload("guest:trixie")).authorizationFile());
+            assertThrows(java.io.IOException.class, () -> exporter.sourceRoute(sourcePayload("physical:graph")));
+            NativeMetricOutbox.Entry legacy = new NativeMetricOutbox.Entry(UUID.randomUUID(), "https://gateway.invalid/v1/metrics",
+                    "", List.of("elastic"), sourcePayload("physical:graph"), false);
+            assertThrows(java.io.IOException.class, () -> exporter.authorization(legacy));
+        } finally {
+            exporter.close();
+        }
+    }
+
+    @Test
+    void queuedSourceIdentityMustBeUnambiguous() throws Exception {
+        NativeMetricExporter exporter = new NativeMetricExporter(directory.toString(), "https://gateway.invalid/v1/metrics", "elastic",
+                "host-id", "guest:trixie", "", "", 268435456L, 2147483648L, new ObjectMapper());
+        try {
+            assertEquals("physical:graph", exporter.sourceHost(sourcePayload("physical:graph")));
+            assertThrows(java.io.IOException.class, () -> exporter.sourceHost(sourcePayload()));
+            assertThrows(java.io.IOException.class, () -> exporter.sourceHost(sourcePayload("physical:graph", "guest:trixie")));
+            assertThrows(java.io.IOException.class, () -> exporter.sourceHost(sourcePayload("")));
+        } finally {
+            exporter.close();
+        }
+    }
+
+    private byte[] sourcePayload(String... names) throws Exception {
+        List<Map<String, Object>> resources = new java.util.ArrayList<>();
+        for (String name : names) {
+            resources.add(Map.of("resource", Map.of("attributes", List.of(
+                    Map.of("key", "host.name", "value", Map.of("stringValue", name))))));
+        }
+        return new ObjectMapper().writeValueAsBytes(Map.of("resourceMetrics", resources));
+    }
+
+    @Test
+    void springCreatesEnabledExporterWithoutJacksonTwoMapperBean() {
+        try (AnnotationConfigApplicationContext context = new AnnotationConfigApplicationContext()) {
+            context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("native-test", Map.of(
+                    "hertzbeat.native-export.enabled", "true",
+                    "hertzbeat.native-export.directory", directory.toString(),
+                    "hertzbeat.native-export.endpoint", "https://gateway.invalid/v1/metrics",
+                    "hertzbeat.native-export.host-id", "fixture-host-id",
+                    "hertzbeat.native-export.host-name", "fixture-host")));
+            context.register(NativeMetricExporter.class);
+            context.refresh();
+            assertTrue(context.getBeansOfType(ObjectMapper.class).isEmpty());
+            assertNotNull(context.getBean(NativeMetricExporter.class));
+        }
+    }
+
+    @Test
+    void consumedReceiptsCompareActualContentAndRetireOnlyAfterEverySink() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        byte[] payload = "{\"resourceMetrics\":[{\"attributes\":[{\"key\":\"b\",\"value\":2},{\"key\":\"a\",\"value\":1}]}]}"
+                .getBytes(StandardCharsets.UTF_8);
+        UUID id;
+        try (NativeMetricOutbox outbox = new NativeMetricOutbox(directory, 4096, 0)) {
+            id = outbox.admit("https://gateway/v1/metrics", List.of("elastic", "hertzbeat"), payload);
+            outbox.transportAccepted(id);
+        }
+        NativeMetricExporter exporter = new NativeMetricExporter(directory.toString(), "https://gateway/v1/metrics", "elastic",
+                "host-id", "host-name", "", "", 268435456L, 2147483648L, mapper);
+        try {
+            Path first = directory.resolve("readbacks").resolve(id + ".elastic.json");
+            Files.write(first, mapper.writeValueAsBytes(Map.of("id", id.toString(), "sink", "elastic", "payload", Map.of("wrong", "content"))));
+            exporter.consumeReadbacks();
+            assertTrue(Files.exists(first));
+            assertTrue(Files.exists(directory.resolve(id + ".accepted")));
+            assertTrue(exporter.getReadbackFailures() > 0);
+            String reordered = "{\"resourceMetrics\":[{\"attributes\":[{\"value\":1,\"key\":\"a\"},{\"value\":2,\"key\":\"b\"}]}]}";
+            Files.write(first, mapper.writeValueAsBytes(Map.of("id", id.toString(), "sink", "elastic", "payload", mapper.readTree(reordered))));
+            exporter.consumeReadbacks();
+            assertFalse(Files.exists(first));
+            assertTrue(Files.exists(directory.resolve(id + ".accepted")));
+            Path second = directory.resolve("readbacks").resolve(id + ".hertzbeat.json");
+            Files.write(second, mapper.writeValueAsBytes(Map.of("id", id.toString(), "sink", "hertzbeat", "payload", mapper.readTree(reordered))));
+            exporter.consumeReadbacks();
+            assertFalse(Files.exists(second));
+            assertFalse(Files.exists(directory.resolve(id + ".accepted")));
+        } finally {
+            exporter.close();
+        }
+    }
+
+    @Test
+    void rejectsPartialAcceptanceAndInsecureEndpoints() throws Exception {
+        try (var ignored = java.nio.file.Files.list(directory)) {
+            NativeMetricExporter exporter = new NativeMetricExporter(directory.toString(), "https://gateway/v1/metrics", "elastic",
+                    "host-id", "host-name", "", "", 268435456L, 2147483648L, new ObjectMapper());
+            try {
+                assertTrue(exporter.fullyAccepted("{}"));
+                assertTrue(exporter.fullyAccepted("{\"partialSuccess\":{}}"));
+                assertTrue(exporter.fullyAccepted("{\"partialSuccess\":{\"rejectedDataPoints\":\"0\"}}"));
+                assertFalse(exporter.fullyAccepted("{\"partialSuccess\":{\"rejectedDataPoints\":\"1\"}}"));
+                assertFalse(exporter.fullyAccepted("{\"partialSuccess\":{\"errorMessage\":\"rejected\"}}"));
+                assertFalse(exporter.fullyAccepted("null"));
+            } finally {
+                exporter.close();
+            }
+        }
+        assertThrows(IllegalArgumentException.class, () -> NativeMetricExporter.validateEndpoint("http://gateway/v1/metrics"));
+        assertThrows(IllegalArgumentException.class, () -> NativeMetricExporter.validateEndpoint("https://user:secret@gateway/v1/metrics"));
+        assertThrows(IllegalArgumentException.class, () -> NativeMetricExporter.validateEndpoint("https://gateway/v1/metrics?secret=x"));
+    }
+}
