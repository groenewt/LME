+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.apache.hertzbeat.alert.lifecycle;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.util.List;
+
+/** Executable contract test using a real transactional database, no running services. */
+public final class LifecycleOutboxContractTest {
+    @org.junit.jupiter.api.Test
+    void contract() throws Exception {
+        main(new String[0]);
+    }
+
+    public static void main(String[] args) throws Exception {
+        try (Connection db = DriverManager.getConnection("jdbc:h2:mem:lifecycle;DB_CLOSE_DELAY=-1")) {
+            db.createStatement().execute("create table hzb_lifecycle_quota(id integer primary key,used_bytes bigint not null)");
+            db.createStatement().execute("insert into hzb_lifecycle_quota values(1,0)");
+            db.createStatement().execute("create table hzb_lifecycle_outbox(event_id varchar(36) primary key,payload varchar(8192),payload_bytes bigint,created_at bigint)");
+            db.createStatement().execute("create table alert_state(id integer primary key,status varchar(32))");
+            db.createStatement().execute("insert into alert_state values(1,'firing')");
+            JdbcLifecycleQueue queue = new JdbcLifecycleQueue(32);
+            expectFailure(() -> queue.append(db, "one", "payload", 1));
+            db.setAutoCommit(false);
+            db.createStatement().execute("update alert_state set status='resolved' where id=1");
+            queue.append(db, "one", "payload", 1);
+            db.rollback();
+            check(queue.pending(db, 64).isEmpty(), "rollback retained event");
+            var result = db.createStatement().executeQuery("select status from alert_state where id=1");
+            result.next();
+            check("firing".equals(result.getString(1)), "state and event did not rollback together");
+            queue.append(db, "one", "payload", 1);
+            db.commit();
+            try (Connection restarted = DriverManager.getConnection("jdbc:h2:mem:lifecycle")) {
+                restarted.setAutoCommit(false);
+                check(queue.pending(restarted, 64).equals(List.of(new JdbcLifecycleQueue.Entry("one", "payload", 7))),
+                        "committed event lost on reconnect");
+                expectFailure(() -> queue.append(restarted, "overflow", "x".repeat(40), 2));
+                restarted.rollback();
+                check(queue.pending(restarted, 64).size() == 1, "quota failure deleted pending event");
+                queue.acknowledge(restarted, List.of("one"));
+                restarted.rollback();
+                check(queue.pending(restarted, 64).size() == 1, "failed handoff lost event");
+                queue.acknowledge(restarted, List.of("one"));
+                restarted.commit();
+                check(queue.pending(restarted, 64).isEmpty(), "handoff not removed");
+                queue.append(restarted, "two", "z".repeat(32), 3);
+                restarted.commit();
+                expectFailure(() -> queue.append(restarted, "three", "z", 4));
+                restarted.rollback();
+            }
+        }
+        System.out.println("Lifecycle transaction, rollback, restart, quota and handoff contracts passed");
+    }
+
+    private static void check(boolean value, String message) {
+        if (!value) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static void expectFailure(Checked operation) throws Exception {
+        try {
+            operation.run();
+        } catch (IllegalStateException expected) {
+            return;
+        }
+        throw new AssertionError("Expected closed admission");
+    }
+
+    private interface Checked {
+        void run() throws Exception;
+    }
+}
