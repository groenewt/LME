+package org.apache.hertzbeat.otel.nativeexport;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.stream.Stream;
+
+/** Linux filesystem outbox. Fsync admission, bounded bytes, and no deletion of unverified samples. */
+public final class NativeMetricOutbox implements AutoCloseable {
+    private static final int FORMAT = 2;
+    private static final int MAX_PAYLOAD = 1024 * 1024;
+    private final Path directory;
+    private final long maxBytes;
+    private final long reserveBytes;
+    private final FileChannel lockChannel;
+    private final FileLock lock;
+    private String pendingCursor = "";
+    private long unreadableRecords;
+
+    /** Immutable admission, including its fixed route and selected sink obligations. */
+    public record Entry(UUID id, String endpoint, String authorizationFile, List<String> sinks, byte[] payload, boolean accepted) {
+        public Entry {
+            sinks = List.copyOf(sinks);
+            payload = payload.clone();
+        }
+
+        @Override
+        public byte[] payload() {
+            return payload.clone();
+        }
+    }
+
+    public NativeMetricOutbox(Path directory, long maxBytes, long reserveBytes) throws IOException {
+        if (maxBytes < 1 || reserveBytes < 0) {
+            throw new IllegalArgumentException("Invalid native metric outbox limits");
+        }
+        this.directory = directory;
+        this.maxBytes = maxBytes;
+        this.reserveBytes = reserveBytes;
+        Files.createDirectories(directory);
+        lockChannel = FileChannel.open(directory.resolve(".lock"), StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+        FileLock acquired;
+        try {
+            acquired = lockChannel.tryLock();
+        } catch (RuntimeException | IOException error) {
+            lockChannel.close();
+            throw error;
+        }
+        if (acquired == null) {
+            lockChannel.close();
+            throw new IOException("Native metric outbox already owned");
+        }
+        lock = acquired;
+        // A crash before rename did not acknowledge admission. Incomplete temporary files can be removed.
+        try (Stream<Path> paths = Files.list(directory)) {
+            for (Path path : paths.filter(p -> p.getFileName().toString().endsWith(".tmp")).toList()) {
+                Files.delete(path);
+            }
+        }
+    }
+
+    public synchronized UUID admit(String endpoint, List<String> sinks, byte[] payload) throws IOException {
+        return admit(endpoint, "", sinks, payload);
+    }
+
+    public synchronized UUID admit(String endpoint, String authorizationFile, List<String> sinks, byte[] payload) throws IOException {
+        if (payload.length == 0 || payload.length > MAX_PAYLOAD || sinks.isEmpty()
+                || !Set.of("elastic", "hertzbeat").containsAll(sinks) || Set.copyOf(sinks).size() != sinks.size()) {
+            throw new IllegalArgumentException("Invalid native metric admission");
+        }
+        UUID id = UUID.randomUUID();
+        byte[] encoded;
+        try (ByteArrayOutputStream bytes = new ByteArrayOutputStream(); DataOutputStream out = new DataOutputStream(bytes)) {
+            out.writeInt(FORMAT);
+            out.writeUTF(endpoint);
+            out.writeUTF(authorizationFile);
+            out.writeInt(sinks.size());
+            for (String sink : sinks) {
+                out.writeUTF(sink);
+            }
+            out.writeInt(payload.length);
+            out.write(payload);
+            out.flush();
+            encoded = bytes.toByteArray();
+        }
+        if (encoded.length > maxBytes - retainedBytes()
+                || Files.getFileStore(directory).getUsableSpace() - encoded.length < reserveBytes) {
+            throw new IOException("Native metric outbox capacity or filesystem reserve reached");
+        }
+        Path temporary = directory.resolve(id + ".tmp");
+        try {
+            try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE)) {
+                ByteBuffer buffer = ByteBuffer.wrap(encoded);
+                while (buffer.hasRemaining()) {
+                    channel.write(buffer);
+                }
+                channel.force(true);
+            }
+            Files.move(temporary, directory.resolve(id + ".pending"), StandardCopyOption.ATOMIC_MOVE);
+            syncDirectory();
+        } finally {
+            Files.deleteIfExists(temporary);
+        }
+        return id;
+    }
+
+    public synchronized List<Entry> pending(int limit) throws IOException {
+        if (limit < 1 || limit > 1000) {
+            throw new IllegalArgumentException("Invalid native metric read batch limit");
+        }
+        List<Entry> entries = new ArrayList<>();
+        try (Stream<Path> paths = Files.list(directory)) {
+            List<Path> sorted = paths.filter(p -> p.getFileName().toString().endsWith(".pending")).sorted().toList();
+            List<Path> ordered = new ArrayList<>();
+            sorted.stream().filter(p -> p.getFileName().toString().compareTo(pendingCursor) > 0).forEach(ordered::add);
+            sorted.stream().filter(p -> p.getFileName().toString().compareTo(pendingCursor) <= 0).forEach(ordered::add);
+            for (Path path : ordered) {
+                String filename = path.getFileName().toString();
+                pendingCursor = filename;
+                try {
+                    entries.add(read(UUID.fromString(filename.substring(0, filename.indexOf('.')))));
+                } catch (IOException | IllegalArgumentException invalid) {
+                    // Preserve poison records while allowing independent valid records to progress.
+                    unreadableRecords++;
+                }
+                if (entries.size() == limit) {
+                    break;
+                }
+            }
+        }
+        return List.copyOf(entries);
+    }
+
+    public synchronized Entry read(UUID id) throws IOException {
+        Path pending = directory.resolve(id + ".pending");
+        boolean accepted = !Files.exists(pending);
+        Path path = accepted ? directory.resolve(id + ".accepted") : pending;
+        if (Files.size(path) > MAX_PAYLOAD + 131072L) {
+            throw new IOException("Invalid native metric outbox record size");
+        }
+        try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(Files.readAllBytes(path)))) {
+            int version = input.readInt();
+            if (version != 1 && version != FORMAT) {
+                throw new IOException("Unsupported native metric outbox format");
+            }
+            String endpoint = input.readUTF();
+            String authorizationFile = version >= 2 ? input.readUTF() : "";
+            int count = input.readInt();
+            if (count < 1 || count > 2) {
+                throw new IOException("Invalid native metric sink count");
+            }
+            List<String> sinks = new ArrayList<>();
+            for (int i = 0; i < count; i++) {
+                sinks.add(input.readUTF());
+            }
+            int length = input.readInt();
+            if (length < 1 || length > MAX_PAYLOAD) {
+                throw new IOException("Invalid native metric payload size");
+            }
+            byte[] payload = input.readNBytes(length);
+            if (payload.length != length || input.read() != -1) {
+                throw new IOException("Truncated or corrupt native metric outbox record");
+            }
+            return new Entry(id, endpoint, authorizationFile, sinks, payload, accepted);
+        }
+    }
+
+    public synchronized void transportAccepted(UUID id) throws IOException {
+        Files.move(directory.resolve(id + ".pending"), directory.resolve(id + ".accepted"), StandardCopyOption.ATOMIC_MOVE);
+        syncDirectory();
+    }
+
+    /** Called only with canonical OTLP reconstructed from queried destination content, never a copied hash. */
+    public synchronized void verifyReadback(UUID id, String sink, byte[] retrievedCanonicalPayload) throws IOException {
+        Entry entry = read(id);
+        if (!entry.accepted() || !entry.sinks().contains(sink) || !Arrays.equals(entry.payload(), retrievedCanonicalPayload)) {
+            throw new IOException("Native metric readback does not match admitted obligation");
+        }
+        Path receipt = directory.resolve(id + ".verified-" + sink);
+        try (FileChannel channel = FileChannel.open(receipt, StandardOpenOption.CREATE, StandardOpenOption.WRITE)) {
+            channel.force(true);
+        }
+        syncDirectory();
+        if (entry.sinks().stream().allMatch(target -> Files.exists(directory.resolve(id + ".verified-" + target)))) {
+            Files.delete(directory.resolve(id + ".accepted"));
+            syncDirectory();
+            for (String target : entry.sinks()) {
+                Files.deleteIfExists(directory.resolve(id + ".verified-" + target));
+            }
+            syncDirectory();
+        }
+    }
+
+    public synchronized long retainedBytes() throws IOException {
+        long bytes = 0;
+        try (Stream<Path> paths = Files.walk(directory, 2)) {
+            for (Path path : paths.filter(Files::isRegularFile).toList()) {
+                bytes = Math.addExact(bytes, Files.size(path));
+            }
+        }
+        return bytes;
+    }
+
+    public synchronized long getUnreadableRecords() {
+        return unreadableRecords;
+    }
+
+    private void syncDirectory() throws IOException {
+        try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ)) {
+            channel.force(true);
+        }
+    }
+
+    @Override
+    public synchronized void close() throws IOException {
+        lock.release();
+        lockChannel.close();
+    }
+}
