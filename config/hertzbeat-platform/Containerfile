# Build only with a resolved JDK25 OCI reference containing @sha256:<digest>.
ARG JAVA_IMAGE
FROM ${JAVA_IMAGE}
WORKDIR /opt/hertzbeat
COPY distribution/ /opt/hertzbeat/
# The caller supplies the inventory UID through rootless keep-id. No SSH daemon or root helper.
ENTRYPOINT ["java"]
CMD ["--add-opens=java.base/java.nio=ALL-UNNAMED", "-jar", "/opt/hertzbeat/apache-hertzbeat-1.9.0.jar"]
