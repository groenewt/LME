# BASE_IMAGE must be a qualified Debian13 digest supplied by the artifact builder.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install --no-install-recommends -y build-essential bison flex bzip2 libssl-dev ca-certificates python3 python3-venv pgbackrest && rm -rf /var/lib/apt/lists/*
COPY postgresql-17.11.tar.bz2 pgvector-0.8.1.tar.gz /tmp/sources/
RUN echo 'dd27f2b3c59e73ed14aa3324901242bf69a032a6347805f274e6260322d42979  /tmp/sources/postgresql-17.11.tar.bz2' | sha256sum -c - && echo 'a9094dfb85ccdde3cbb295f1086d4c71a20db1d26bf1d6c39f07a7d164033eb4  /tmp/sources/pgvector-0.8.1.tar.gz' | sha256sum -c - && tar -xjf /tmp/sources/postgresql-17.11.tar.bz2 -C /tmp && tar -xzf /tmp/sources/pgvector-0.8.1.tar.gz -C /tmp
WORKDIR /tmp/postgresql-17.11
RUN ./configure --prefix=/opt/postgresql --without-icu --without-readline --without-zlib --with-ssl=openssl && make -j4 && make install
WORKDIR /tmp/pgvector-0.8.1
RUN make PG_CONFIG=/opt/postgresql/bin/pg_config OPTFLAGS='' -j4 && make PG_CONFIG=/opt/postgresql/bin/pg_config OPTFLAGS='' install
RUN python3 -m venv /opt/patroni && /opt/patroni/bin/pip install --no-cache-dir 'patroni[etcd3]==4.1.3' 'psycopg[binary]==3.2.9' && /opt/patroni/bin/pip freeze > /opt/patroni/qualified-python-packages.txt
COPY scripts/postgresql_platform /opt/lme/scripts/postgresql_platform
RUN touch /opt/lme/scripts/__init__.py && if getent group postgres >/dev/null; then groupmod --gid 999 postgres; else groupadd --gid 999 postgres; fi
RUN if getent passwd postgres >/dev/null; then usermod --uid 999 --gid 999 postgres; else useradd --uid 999 --gid 999 --create-home postgres; fi
RUN install -d -o postgres -g postgres /var/lib/postgresql/data && dpkg-query -W > /opt/lme/qualified-debian-packages.txt
ENV PATH=/opt/patroni/bin:/opt/postgresql/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV PYTHONPATH=/opt/lme
WORKDIR /opt/lme
USER postgres
CMD ["patroni", "/etc/lme/postgresql/patroni.json"]
