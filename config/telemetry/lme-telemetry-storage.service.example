# MAIN renders absolute installed package/config paths and exact storage parent.
[Unit]
Description=Restore and verify the owned telemetry filesystem
After=local-fs.target
Before=lme-telemetry-admission.service lme-telemetry-worker.service lme-source-collector.service hertzbeat-native-receipts.service
RequiresMountsFor=/data/lme-telemetry

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/lme
ExecStart=/usr/bin/python3 -m lme_telemetry.storage --config /etc/lme/telemetry-storage.json remount
TimeoutStartSec=90
# The mount must appear in the host namespace; no PrivateMounts/ProtectSystem mount namespace.
PrivateMounts=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
UMask=0077

[Install]
WantedBy=multi-user.target
