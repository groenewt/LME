{
  "index_patterns": [
    "lme-native-metrics"
  ],
  "priority": 250,
  "composed_of": [
    "metrics@mappings"
  ],
  "template": {
    "mappings": {
      "dynamic_templates": [
        {
          "lme_metric_dimensions": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 4096
            }
          }
        },
        {
          "long_metrics": {
            "match_mapping_type": "long",
            "mapping": {
              "type": "long",
              "index": false
            }
          }
        },
        {
          "float_metrics": {
            "match_mapping_type": "double",
            "mapping": {
              "type": "float",
              "index": false
            }
          }
        },
        {
          "double_metrics": {
            "mapping": {
              "type": "double",
              "index": false
            }
          }
        },
        {
          "histogram_metrics": {
            "mapping": {
              "type": "histogram"
            }
          }
        },
        {
          "summary_metrics": {
            "mapping": {
              "type": "aggregate_metric_double",
              "metrics": [
                "sum",
                "value_count"
              ],
              "default_metric": "value_count"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date_nanos"
        }
      }
    }
  }
}
