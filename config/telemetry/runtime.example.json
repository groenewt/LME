{
  "spool_path": "/var/lib/lme-telemetry/spool.db",
  "source_node": "graph",
  "destinations": [
    "elastic",
    "hertzbeat",
    "malcolm"
  ],
  "ingress": {
    "bind": "127.0.0.1",
    "port": 9469,
    "token_file": "/run/secrets/telemetry-admission-token"
  },
  "quotas": {
    "pending_bytes": 4294967296,
    "archive_bytes": 8589934592,
    "reserve_bytes": 2147483648,
    "retention_seconds": 86400
  },
  "sinks": {
    "elastic": {
      "origin": "https://graph.example.ts.net:9200",
      "ca_file": "/etc/lme/pki/ca.pem",
      "auth_file": "/run/secrets/telemetry-elastic-write-authorization",
      "read_auth_file": "/run/secrets/telemetry-elastic-read-authorization",
      "index": "lme-typed-logs"
    },
    "hertzbeat": {
      "origin": "https://trixie.example.ts.net",
      "ca_file": "/etc/lme/pki/ca.pem",
      "auth_file": "/run/secrets/telemetry-hertzbeat-write-authorization",
      "read_auth_file": "/run/secrets/telemetry-hertzbeat-read-authorization"
    },
    "malcolm": {
      "origin": "https://silmaril.example.ts.net",
      "tcp_host": "silmaril.example.ts.net",
      "tcp_port": 5045,
      "ca_file": "/etc/lme/pki/ca.pem",
      "client_cert_file": "/etc/lme/pki/telemetry-client.pem",
      "client_key_file": "/run/secrets/telemetry-client-key.pem",
      "auth_file": "/run/secrets/telemetry-malcolm-write-authorization",
      "read_auth_file": "/run/secrets/telemetry-malcolm-read-authorization"
    }
  },
  "native_metrics": {
    "elastic": {
      "origin": "https://graph.example.ts.net:9200",
      "ca_file": "/etc/lme/pki/ca.pem",
      "auth_file": "/run/secrets/telemetry-elastic-write-authorization",
      "read_auth_file": "/run/secrets/telemetry-elastic-read-authorization",
      "index": "lme-native-metrics"
    }
  }
}
