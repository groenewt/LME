{
  "index_patterns": ["lme-typed-logs"],
  "priority": 250,
  "template": {
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {"type": "date"},
        "event": {"properties": {"id": {"type": "keyword"}, "kind": {"type": "keyword"}, "dataset": {"type": "keyword"}}},
        "host": {"properties": {"name": {"type": "keyword"}}},
        "log": {"properties": {"level": {"type": "keyword"}}},
        "lme": {"type": "object", "enabled": false}
      }
    }
  }
}
