{% import 'query.macros.j2' as q %}
{% set syntax = hook_syntax %}
{% set ser = hook_serializers %}
{% set prefixes = query.prefixes %}
{% set graphs = query.named_graphs %}
{% set names = query.variable_names %}
{{ q.emit_prefixes(prefixes, syntax, ser) }}
{{ q.emit_select_list(query.columns, syntax) }}{{ syntax.newline }}
{{ q.emit_from_named(graphs, syntax, ser) }}
{{ syntax.where }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ q.emit_population(graphs, syntax, ser, names) }}{{ syntax.newline }}
{{ q.emit_control_union(query.positive_control, query.negative_control, graphs, syntax, ser, names) }}{{ syntax.newline }}
{{ q.emit_tuple_binds(query.tuple, syntax, ser) }}
{% if query.geometry is defined and query.geometry.enabled %}
{{ q.emit_geometry(query.geometry, syntax, ser, names) }}{{ syntax.newline }}
{% endif %}
{% if query.typed_bindings is defined and (query.typed_bindings | length) > 0 %}
{{ syntax.values }}{{ syntax.space }}{{ q.emit_values_row(query.binding_names, query.typed_bindings, ser, syntax) }}{{ syntax.newline }}
{% endif %}
{{ syntax.rbrace }}{{ syntax.newline }}
{{ q.emit_order_by(query.order_by_columns, syntax) }}{{ syntax.newline }}
{{ q.emit_limit(query.limits.max_rows, syntax) }}{{ syntax.newline }}
