{# Reusable query rendering. Tokens, wraps, and forbidden atoms come from YAML. #}
{% macro iri(value, ser) -%}
{{ ser.iri.wrap_left }}{{ value }}{{ ser.iri.wrap_right }}
{%- endmacro %}

{% macro string_literal(value, ser, syntax) -%}
{%- set ns = namespace(escaped=value) -%}
{%- for pair in ser.string.escape_pairs -%}
{%- set ns.escaped = ns.escaped | replace(pair.from, pair.to) -%}
{%- endfor -%}
{{ ser.string.wrap }}{{ ns.escaped }}{{ ser.string.wrap }}
{%- endmacro %}

{% macro integer_literal(value, ser) -%}
{{ value }}{{ ser.integer.datatype_suffix }}
{%- endmacro %}

{% macro term(binding, ser, syntax) -%}
{%- if binding.term_type == 'iri' -%}
{{ iri(binding.value, ser) }}
{%- elif binding.term_type == 'string' -%}
{{ string_literal(binding.value, ser, syntax) }}
{%- elif binding.term_type == 'integer' -%}
{{ integer_literal(binding.value, ser) }}
{%- endif -%}
{%- endmacro %}

{% macro prefix_line(item, syntax, ser) -%}
{{ syntax.prefix }}{{ syntax.space }}{{ item.name }}:{{ syntax.space }}{{ iri(item.iri, ser) }}
{%- endmacro %}

{% macro emit_prefixes(prefixes, syntax, ser) -%}
{%- for item in prefixes -%}
{{ prefix_line(item, syntax, ser) }}{{ syntax.newline }}
{%- endfor -%}
{%- endmacro %}

{% macro emit_from_named(graphs, syntax, ser) -%}
{%- for graph in graphs -%}
{{ syntax.from_named }}{{ syntax.space }}{{ iri(graph, ser) }}{{ syntax.newline }}
{%- endfor -%}
{%- endmacro %}

{% macro emit_select_list(columns, syntax) -%}
{{ syntax.select }}{{ syntax.space }}{% for col in columns %}?{{ col }}{% if not loop.last %}{{ syntax.space }}{% endif %}{% endfor %}
{%- endmacro %}

{% macro emit_values_row(names, bindings, ser, syntax) -%}
{{ syntax.lparen }}{% for name in names %}?{{ name }}{% if not loop.last %}{{ syntax.space }}{% endif %}{% endfor %}{{ syntax.rparen }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.lparen }}{% for name in names %}{{ term(bindings[name], ser, syntax) }}{% if not loop.last %}{{ syntax.space }}{% endif %}{% endfor %}{{ syntax.rparen }}{{ syntax.newline }}
{{ syntax.rbrace }}
{%- endmacro %}

{% macro emit_control_union(positive, negative, graphs, syntax, ser, names) -%}
{{ syntax.union }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.values }}{{ syntax.space }}{{ syntax.lparen }}?{{ names.row_kind }}{{ syntax.space }}?{{ names.control }}{{ syntax.rparen }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.space }}{{ syntax.lparen }}{{ string_literal(syntax.control_present_row, ser, syntax) }}{{ syntax.space }}{{ iri(positive.iri, ser) }}{{ syntax.rparen }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.space }}{{ syntax.lparen }}{{ string_literal(syntax.control_absent_row, ser, syntax) }}{{ syntax.space }}{{ iri(negative.iri, ser) }}{{ syntax.rparen }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.rbrace }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.bind }}{{ syntax.lparen }}{{ syntax.if }}{{ syntax.lparen }}{{ syntax.exists }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.space }}{{ syntax.graph }}{{ syntax.space }}{{ iri(graphs[0], ser) }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.space }}?{{ names.control }}{{ syntax.space }}{{ syntax.type_token }}{{ syntax.space }}{{ iri(positive.type_iri, ser) }}{{ syntax.space }}{{ syntax.rbrace }}{{ syntax.space }}{{ syntax.rbrace }}{{ syntax.comma }}{{ syntax.space }}{{ string_literal(syntax.present_token, ser, syntax) }}{{ syntax.comma }}{{ syntax.space }}{{ string_literal(syntax.absent_token, ser, syntax) }}{{ syntax.rparen }}{{ syntax.space }}{{ syntax.as }}{{ syntax.space }}?{{ names.state }}{{ syntax.rparen }}{{ syntax.newline }}
{{ syntax.rbrace }}
{%- endmacro %}

{% macro emit_population(graphs, syntax, ser, names) -%}
{{ syntax.lbrace }}{{ syntax.newline }}
{%- for graph in graphs -%}
{{ syntax.space }}{{ syntax.graph }}{{ syntax.space }}{{ iri(graph, ser) }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}?{{ names.predicate }}{{ syntax.space }}?{{ names.object }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.space }}{{ syntax.rbrace }}{{ syntax.newline }}
{%- endfor -%}
{{ syntax.space }}{{ syntax.bind }}{{ syntax.lparen }}{{ string_literal(syntax.population_row, ser, syntax) }}{{ syntax.space }}{{ syntax.as }}{{ syntax.space }}?{{ names.row_kind }}{{ syntax.rparen }}{{ syntax.newline }}
{{ syntax.rbrace }}
{%- endmacro %}

{% macro emit_tuple_binds(tuple, syntax, ser) -%}
{%- for key, value in tuple.items() -%}
{{ syntax.bind }}{{ syntax.lparen }}{{ string_literal(value, ser, syntax) }}{{ syntax.space }}{{ syntax.as }}{{ syntax.space }}?{{ key }}{{ syntax.rparen }}{{ syntax.newline }}
{%- endfor -%}
{%- endmacro %}

{% macro emit_order_by(columns, syntax) -%}
{{ syntax.order_by }}{{ syntax.space }}{% for col in columns %}?{{ col }}{% if not loop.last %}{{ syntax.space }}{% endif %}{% endfor %}
{%- endmacro %}

{% macro emit_geometry(geo, syntax, ser, names) -%}
{{ syntax.graph }}{{ syntax.space }}{{ iri(geo.graph, ser) }}{{ syntax.space }}{{ syntax.lbrace }}{{ syntax.newline }}
{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}{{ iri(geo.geometry_predicate, ser) }}{{ syntax.space }}?{{ names.geometry }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}{{ iri(geo.frame_predicate, ser) }}{{ syntax.space }}{{ string_literal(geo.frame_kind, ser, syntax) }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}{{ iri(geo.crs_predicate, ser) }}{{ syntax.space }}{{ string_literal(geo.coordinate_reference_system, ser, syntax) }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}{{ iri(geo.axis_digest_predicate, ser) }}{{ syntax.space }}{{ string_literal(geo.axis_digest, ser, syntax) }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.space }}?{{ names.subject }}{{ syntax.space }}{{ iri(geo.rejoin_predicate, ser) }}{{ syntax.space }}{{ string_literal(geo.omitted_axis_rejoin, ser, syntax) }}{{ syntax.space }}{{ syntax.dot }}{{ syntax.newline }}
{{ syntax.rbrace }}
{%- endmacro %}

{% macro emit_limit(max_rows, syntax) -%}
{{ syntax.limit }}{{ syntax.space }}{{ max_rows }}
{%- endmacro %}
