{{ [{R.observation_keys.failed: R.booleans.false_value, R.observation_keys.skipped: R.booleans.false_value, R.observation_keys.item: item, R.observation_keys.stat: {R.observation_keys.exists: [exists] | map(R.filters.bool) | first, R.observation_keys.isdir: [proven] | map(R.filters.bool) | first, R.observation_keys.islnk: R.booleans.false_value, R.observation_keys.executable: [proven] | map(R.filters.bool) | first}}] | map(R.filters.to_json) | first }}
