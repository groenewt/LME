{# controls/route-declared-span.j2
   Reusable source-projection macros. This file does not evaluate combination
   cells, unique(), or dead/retain. Ansible evaluates the extracted candidate
   or predecessor task expressions. rh_span_action selects the projection.
   Structural atoms come from rh_span_schema (route-component-values.yaml render).
#}
{%- set R = rh_span_schema -%}
{%- macro task_hits(source_text, task_name, R) -%}
{%- set ns = namespace(hits=[]) -%}
{%- set delim = R.task_split.delimiter -%}
{%- set prefix = R.task_split.leading_prefix -%}
{%- set name_end = R.task_split.name_end -%}
{%- set nl = R.task_split.document_newline -%}
{%- set parts = [source_text] | map(R.filters.split, delim) | first -%}
{%- for part in parts -%}
{%- if loop.first and part.startswith(prefix) -%}
{%- set body = part[(prefix | length):] -%}
{%- set nm = body.split(name_end, R.task_split.maxsplit)[0] -%}
{%- if nm == task_name -%}{%- set ns.hits = ns.hits + [part ~ (nl if (not part.endswith(nl)) else R.strings.empty)] -%}{%- endif -%}
{%- elif not loop.first -%}
{%- set nm = part.split(name_end, R.task_split.maxsplit)[0] -%}
{%- if nm == task_name -%}{%- set ns.hits = ns.hits + [prefix ~ part ~ (nl if (not part.endswith(nl)) else R.strings.empty)] -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{- [ns.hits] | map(R.filters.to_json) | first -}}
{%- endmacro -%}
{%- macro listing_result(kind, leaf_text, R, texts) -%}
{%- set spec = R.listing_kinds[kind] -%}
{%- set SK = R.schema_only_keys -%}
{%- set OK = R.observation_keys -%}
{%- if SK.stdout_mode in spec and spec[SK.stdout_mode] == R.listing_stdout_modes.leaf_plus_separator -%}
{%- set stdout = leaf_text ~ R.record_separators[R.record_separator_name] -%}
{%- elif SK.stdout_mode in spec and spec[SK.stdout_mode] == R.listing_stdout_modes.unknown_text -%}
{%- set stdout = texts.unknown_listing_record ~ R.record_separators[R.record_separator_name] -%}
{%- else -%}
{%- set stdout = spec[OK.stdout] -%}
{%- endif -%}
{%- set row = R.mappings.empty -%}
{%- if R.observation_keys.rc in spec -%}
{%- set row = [row] | map(R.filters.combine, {R.observation_keys.rc: spec[R.observation_keys.rc]}) | first -%}
{%- endif -%}
{%- if R.observation_keys.skipped in spec -%}
{%- set row = [row] | map(R.filters.combine, {R.observation_keys.skipped: spec[R.observation_keys.skipped]}) | first -%}
{%- endif -%}
{%- set row = [row] | map(R.filters.combine, {R.observation_keys.stdout: stdout}) | first -%}
{{ [row] | map(R.filters.to_json) | first }}
{%- endmacro -%}
{%- macro anc_type(ok, item, type_stdout, R) -%}
{{ [{R.observation_keys.rc: (R.integers.zero if ok else R.integers.one), R.observation_keys.stdout: (type_stdout if ok else R.strings.empty), R.observation_keys.skipped: R.booleans.false_value, R.observation_keys.item: item}] | map(R.filters.to_json) | first }}
{%- endmacro -%}
