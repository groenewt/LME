{%- import model.format.macros_template as macros -%}
{%- set format = model.format -%}
{%- set labels = format.labels -%}
{%- set headings = format.section_headings -%}
{%- set separators = format.separators -%}
{%- set empty = format.tokens.empty -%}
{%- set optional_keys = format.optional_keys -%}
{%- set sources = model.sources -%}
{{ macros.emit(format.document_heading) }}
{% for section in format.section_order %}
{{ macros.emit(headings[section]) }}
{% if section == format.section_ids.identity %}
{{ macros.render_identity(model.identity, labels, separators) }}
{% elif section == format.section_ids.ontology %}
{{ macros.kv(labels.status, model.identity.ontology_integration.status, separators) }}
{{ macros.kv(labels.kind, model.identity.ontology_integration.reason, separators) }}
{% elif section == format.section_ids.sources %}
{% for file in model.sources.files %}
{{ macros.render_source_file(file, sources, labels, separators, empty, format) }}
{% endfor %}
{% elif section == format.section_ids.entities %}
{% for entity in model.entities %}
{{ macros.render_entity(entity, labels, sources, separators, empty, optional_keys, format) }}
{% endfor %}
{% elif section == format.section_ids.relations %}
{% for relation in model.relations %}
{{ macros.render_relation(relation, labels, sources, separators, empty, optional_keys, format) }}
{% endfor %}
{% elif section == format.section_ids.operations %}
{% for operation in model.operations %}
{{ macros.render_operation(operation, labels, separators, sources, empty, optional_keys, format) }}
{% if optional_keys.inputs in operation %}
{% for field in operation.inputs %}
{{ macros.render_field(field, labels, separators, optional_keys) }}
{% endfor %}
{% endif %}
{% if optional_keys.outputs in operation %}
{% for field in operation.outputs %}
{{ macros.render_field(field, labels, separators, optional_keys) }}
{% endfor %}
{% endif %}
{% endfor %}
{% elif section == format.section_ids.helpers %}
{% for helper in model.helpers %}
{{ macros.render_helper(helper, labels, separators, optional_keys) }}
{% endfor %}
{% elif section == format.section_ids.fields %}
{% for field in model.field_url_map.pairs %}
{{ macros.kv(labels.path, field.regex, separators) }}
{{ macros.kv(labels.name, macros.join_list(field.urls, separators.list_join), separators) }}
{% endfor %}
{% elif section == format.section_ids.auth %}
{% for gate in model.auth.gates %}
{{ macros.render_auth_gate(gate, labels, separators, optional_keys) }}
{% endfor %}
{% elif section == format.section_ids.errors %}
{% for error in model.errors %}
{{ macros.render_error(error, labels, separators, optional_keys) }}
{% endfor %}
{% elif section == format.section_ids.response_contracts %}
{% for contract in model.response_contracts.records %}
{{ macros.render_response_contract(contract, labels, sources, separators, empty, optional_keys, format) }}
{% endfor %}
{% elif section == format.section_ids.dependencies %}
{% for dependency in model.dependencies %}
{{ macros.render_dependency(dependency, labels, separators) }}
{% endfor %}
{% elif section == format.section_ids.datasets %}
{% for dataset in model.datasets %}
{{ macros.render_dataset(dataset, labels, sources, separators, empty, optional_keys, format) }}
{% endfor %}
{% elif section == format.section_ids.lifecycle %}
{% for item in model.lifecycle %}
{{ macros.render_lifecycle(item, labels, separators) }}
{% endfor %}
{% elif section == format.section_ids.documentation %}
{% for item in model.documentation.index_listed %}
{{ macros.kv(labels.id, item.operation, separators) }}
{{ macros.kv(labels.path, item.doc, separators) }}
{% endfor %}
{% elif section == format.section_ids.releases %}
{% for item in model.releases %}
{{ macros.kv(labels.id, item.id, separators) }}
{% endfor %}
{% elif section == format.section_ids.gaps %}
{% for gap in model.gaps %}
{{ macros.render_gap(gap, labels, separators, optional_keys) }}
{% endfor %}
{% endif %}
{% endfor %}
{{ macros.render_ack_delivery(deep.acknowledge_versus_delivery, labels, separators, format) }}
{% for observation in deep.control_static %}
{{ macros.render_observation(observation, labels, separators) }}
{% endfor %}
{% for observation in deep.dataflow_static %}
{{ macros.render_observation(observation, labels, separators) }}
{% endfor %}
{% for limitation in deep.limitations %}
{{ macros.render_gap(limitation, labels, separators, optional_keys) }}
{% endfor %}
{% for fixture in fixtures.positive %}
{{ macros.render_fixture(fixture, labels, separators, optional_keys, format) }}
{% endfor %}
{% for fixture in fixtures.negative %}
{{ macros.render_fixture(fixture, labels, separators, optional_keys, format) }}
{% endfor %}
{% for row in coverage.rows %}
{{ macros.render_coverage_row(row, labels, separators) }}
{% endfor %}
