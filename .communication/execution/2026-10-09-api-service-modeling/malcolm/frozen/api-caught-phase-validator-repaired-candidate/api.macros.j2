{% if (bytejoined | length) == lookup.required_match_count and join.sha256_key in file and join.bytes_key in file and file[join.sha256_key] == bytejoined[lookup.first_index][join.sha256_key] and file[join.bytes_key] == bytejoined[lookup.first_index][join.bytes_key] %}
