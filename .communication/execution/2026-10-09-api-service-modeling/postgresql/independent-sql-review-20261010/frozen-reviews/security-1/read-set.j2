{% import 'review-output/security-1/macros.j2' as m %}
{% set g = yaml_grammar %}
{% set ex = examination %}
{% set L = ex.report_labels %}
{% set cls = ex.vocabulary.examination_classes %}
{% set comp = ex.vocabulary.completeness %}
{% set indep = ex.vocabulary.independent_sha256 %}
{{ m.document_start(g) }}{{ m.keyed(L.schema_version, ex.schema_version, g) }}{{ m.nl(g) }}
{{ m.keyed_bare(L.actor, '', g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.id, task.actor.id, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.phase, task.actor.phase, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.focus, task.actor.focus, g) }}{{ m.nl(g) }}
{{ m.keyed(L.model, task.model, g) }}{{ m.nl(g) }}
{{ m.keyed(L.approved_source_manifest_sha256, task.approved_source_manifest_sha256, g) }}{{ m.nl(g) }}
{{ m.keyed(L.source_manifest_sha256_from_input_manifest, input_manifest.source_manifest_sha256, g) }}{{ m.nl(g) }}
{{ m.keyed(L.frozen_map_manifest_sha256, task.frozen_map_manifest_sha256, g) }}{{ m.nl(g) }}
{{ m.keyed(L.maps_treated_as, ex.maps_treated_as, g) }}{{ m.nl(g) }}
{{ m.keyed(L.peer_reviews_read, ex.peer_reviews_read, g) }}{{ m.nl(g) }}
{{ m.keyed(L.candidate_patched, ex.candidate_patched, g) }}{{ m.nl(g) }}
{{ m.keyed(L.historical_paths_followed, ex.historical_paths_followed, g) }}{{ m.nl(g) }}
{{ m.keyed(L.findings_live_in, ex.findings_live_in, g) }}{{ m.nl(g) }}
{{ m.keyed(L.findings_not_repeated_here, declared_values.typed_bool.true_value, g) }}{{ m.nl(g) }}
{{ m.keyed(L.byte_span_indexing, emission_schema.notes.byte_span_indexing, g) }}{{ m.nl(g) }}
{{ m.keyed(L.line_indexing, emission_schema.notes.line_indexing, g) }}{{ m.nl(g) }}
{{ m.keyed(L.hash_note, ex.hash_note, g) }}{{ m.nl(g) }}
{{ m.keyed_bare(L.python3_byte_slice_checker, '', g) }}{{ m.nl(g) }}
{{ m.yaml_map_optional(ex.python3_byte_slice_checker, ex.field_keys.check, g, 1) }}
{{ m.keyed_bare(L.content_read, '', g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.count, ex.independent_counts.content_read, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed_bare(L.members, '', g) }}{{ m.nl(g) }}
{%- for member in input_manifest.members -%}
{%- for cr in ex.content_read.members -%}
{%- if cr.path == member.path -%}
{{ m.yaml_list_map(cr, ex.field_keys.content_read_member, g, 1) }}
{{ m.keyed_if_defined(cr, L.note, g, 2) }}
{%- if cr.spans is defined -%}
{{ m.indent(g, 2) }}{{ m.keyed_bare(L.spans, '', g) }}{{ m.nl(g) }}
{%- for span in cr.spans -%}
{{ m.yaml_list_map_optional(span, ex.field_keys.span_optional, g, 2) }}
{%- endfor -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{{ m.keyed_bare(L.pattern_line_seen, '', g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.count, ex.independent_counts.pattern_line_seen, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.independent_sha256, indep.not_computed, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed_bare(L.members, '', g) }}{{ m.nl(g) }}
{%- for member in input_manifest.members -%}
{%- if member.path in ex.pattern_line_seen.paths -%}
{{ m.indent(g, 1) }}{{ m.list_prefix(g) }}{{ m.keyed(L.path, member.path, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.manifest_sha256, member.sha256, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.manifest_bytes, member.bytes, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.completeness, comp.pattern_line_seen, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.independent_sha256, indep.not_computed, g) }}{{ m.nl(g) }}
{%- endif -%}
{%- endfor -%}
{{ m.keyed_bare(L.unexamined, '', g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.count, ex.independent_counts.unexamined, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed(L.independent_sha256, indep.not_computed, g) }}{{ m.nl(g) }}
{{ m.indent(g, 1) }}{{ m.keyed_bare(L.members, '', g) }}{{ m.nl(g) }}
{%- for member in input_manifest.members -%}
{%- set seen = namespace(v=false) -%}
{%- for cr in ex.content_read.members -%}
{%- if cr.path == member.path -%}
{%- set seen.v = true -%}
{%- endif -%}
{%- endfor -%}
{%- if member.path in ex.pattern_line_seen.paths -%}
{%- set seen.v = true -%}
{%- endif -%}
{%- if seen.v is sameas false -%}
{{ m.indent(g, 1) }}{{ m.list_prefix(g) }}{{ m.keyed(L.path, member.path, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.manifest_sha256, member.sha256, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.manifest_bytes, member.bytes, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.completeness, comp.unexamined, g) }}{{ m.nl(g) }}
{{ m.indent(g, 2) }}{{ m.keyed(L.independent_sha256, indep.not_computed, g) }}{{ m.nl(g) }}
{%- endif -%}
{%- endfor -%}
