{#
  Reusable YAML emission grammar for this review actor.
  Every marker, separator, indent, quote and boolean token is taken from
  yaml_grammar in the caller context. This file does not invent punctuation.
#}

{% macro indent(g, level) -%}
{%- for _ in range(level) -%}{{ g.indent }}{%- endfor -%}
{%- endmacro %}

{% macro nl(g) -%}{{ g.newline }}{%- endmacro %}

{% macro yaml_scalar(value, g) -%}
{%- if value is sameas true -%}{{ g.true_token }}
{%- elif value is sameas false -%}{{ g.false_token }}
{%- elif value is none -%}{{ g.null_token }}
{%- elif value is number -%}{{ value }}
{%- else -%}
{%- set ns = namespace(s=value) -%}
{%- for esc in g.scalar_escapes -%}
{%- set ns.s = ns.s | replace(esc.find, esc.replace) -%}
{%- endfor -%}
{{ g.quote }}{{ ns.s }}{{ g.quote }}
{%- endif -%}
{%- endmacro %}

{% macro keyed(key, value, g) -%}
{{ key }}{{ g.colon }}{{ g.space }}{{ yaml_scalar(value, g) }}
{%- endmacro %}

{% macro keyed_bare(key, value, g) -%}
{{ key }}{{ g.colon }}{{ g.space }}{{ value }}
{%- endmacro %}

{% macro list_prefix(g) -%}
{{ g.list_marker }}{{ g.space }}
{%- endmacro %}

{% macro document_start(g) -%}
{{ g.document_start }}{{ g.newline }}
{%- endmacro %}

{% macro yaml_list_map(item, key_order, g, level) -%}
{{ indent(g, level) }}{{ list_prefix(g) }}{{ keyed(key_order[0], item[key_order[0]], g) }}{{ nl(g) }}
{%- for k in key_order[1:] -%}
{{ indent(g, level + 1) }}{{ keyed(k, item[k], g) }}{{ nl(g) }}
{%- endfor -%}
{%- endmacro %}

{% macro block_list_scalars(items, g, level) -%}
{%- if items | length == 0 -%}
{{ indent(g, level) }}{{ g.flow_list_open }}{{ g.flow_list_close }}{{ nl(g) }}
{%- else -%}
{%- for x in items -%}
{{ indent(g, level) }}{{ list_prefix(g) }}{{ yaml_scalar(x, g) }}{{ nl(g) }}
{%- endfor -%}
{%- endif -%}
{%- endmacro %}

{% macro yaml_list_map_optional(item, key_order, g, level) -%}
{%- set first = namespace(done=false) -%}
{%- for k in key_order -%}
{%- if item[k] is defined -%}
{%- if first.done is sameas false -%}
{{ indent(g, level) }}{{ list_prefix(g) }}{{ keyed(k, item[k], g) }}{{ nl(g) }}
{%- set first.done = true -%}
{%- else -%}
{{ indent(g, level + 1) }}{{ keyed(k, item[k], g) }}{{ nl(g) }}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endmacro %}

{% macro keyed_if_defined(item, key, g, level) -%}
{%- if item[key] is defined -%}
{{ indent(g, level) }}{{ keyed(key, item[key], g) }}{{ nl(g) }}
{%- endif -%}
{%- endmacro %}

{% macro yaml_map_optional(item, key_order, g, level) -%}
{%- for k in key_order -%}
{%- if item[k] is defined -%}
{{ indent(g, level) }}{{ keyed(k, item[k], g) }}{{ nl(g) }}
{%- endif -%}
{%- endfor -%}
{%- endmacro %}
