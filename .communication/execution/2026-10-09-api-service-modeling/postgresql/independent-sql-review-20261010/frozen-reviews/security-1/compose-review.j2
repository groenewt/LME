{%- for part in parts -%}
{%- set ns = namespace(inc=part.path) -%}
{%- if compose.path_skip_first -%}
{%- set ns.inc = part.path.split(compose.path_sep)[1:] | join(compose.path_sep) -%}
{%- endif -%}
{%- if part.context_key == compose.root_merge_key -%}
{% include ns.inc %}
{%- else -%}
{{ part.context_key }}{{ compose.colon }}{{ compose.newline }}{% filter indent(compose.nest_indent_width, compose.indent_first) %}{% include ns.inc %}{% endfilter %}{{ compose.newline }}
{%- endif -%}
{%- endfor -%}
