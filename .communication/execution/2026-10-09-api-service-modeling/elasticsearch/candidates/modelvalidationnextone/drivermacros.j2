{%- from 'macros.j2' import abort, project_model, require_mapping with context -%}

{%- macro py_quote(text, L) -%}
{%- set s = text | string -%}
{%- set s = s | replace(L.backslash, L.backslash ~ L.backslash) -%}
{%- set s = s | replace(L.py_squote, L.backslash ~ L.py_squote) -%}
{%- set s = s | replace(L.newline, L.backslash ~ L.n_char) -%}
{%- set s = s | replace(L.cr_char, L.backslash ~ L.r_char) -%}
{%- set s = s | replace(L.tab_char, L.backslash ~ L.t_char) -%}
{{ L.py_squote }}{{ s }}{{ L.py_squote }}
{%- endmacro -%}

{%- macro py_literal(value, L) -%}
{%- if value is none -%}
{{ L.py_none }}
{%- elif value is sameas true -%}
{{ L.py_true }}
{%- elif value is sameas false -%}
{{ L.py_false }}
{%- elif value is string -%}
{{ py_quote(value, L) }}
{%- elif value is mapping -%}
{{ L.py_lbrace }}
{%- set first = namespace(done=false) -%}
{%- for key in value -%}
{%- if first.done -%}{{ L.py_comma }}{{ L.space }}{%- endif -%}
{{ py_quote(key, L) }}{{ L.py_colon }}{{ L.space }}{{ py_literal(value[key], L) }}
{%- set first.done = true -%}
{%- endfor -%}
{{ L.py_rbrace }}
{%- elif value is sequence -%}
{{ L.py_lbracket }}
{%- set first = namespace(done=false) -%}
{%- for item in value -%}
{%- if first.done -%}{{ L.py_comma }}{{ L.space }}{%- endif -%}
{{ py_literal(item, L) }}
{%- set first.done = true -%}
{%- endfor -%}
{{ L.py_rbracket }}
{%- else -%}
{{ py_quote(value, L) }}
{%- endif -%}
{%- endmacro -%}

{%- macro compile_contract(driver, L) -%}
{{ require_mapping(driver, L) }}
{%- if driver[L.driver_entry] != L.driver_entry_value -%}
{{ abort(L) }}
{%- endif -%}
{%- if driver[L.driver_model_entry] != L.model_entry_value -%}
{{ abort(L) }}
{%- endif -%}
{{ L.phase_compile }}{{ L.colon_space }}{{ L.status_declared }}{{ L.newline }}
{%- endmacro -%}

{%- macro project_carrier(model, literals, packets, index, typed, history, phase) -%}
{{ project_model(model, literals, packets, index, typed, history, phase) }}
{%- endmacro -%}

{%- macro drive(driver, literals, model, packets, index, typed, history) -%}
{{ require_mapping(literals, L=literals) }}
{{ require_mapping(driver, L=literals) }}
{%- set phase = driver[literals.driver_phase] -%}
{%- if phase == literals.phase_compile -%}
{{ compile_contract(driver, literals) }}
{%- elif phase == literals.phase_fixture -%}
{{ project_carrier(model, literals, packets, index, typed, history, driver[literals.fixture_run_phase]) }}
{%- elif phase == literals.phase_draft or phase == literals.phase_source or phase == literals.phase_project or phase == literals.phase_render -%}
{{ project_carrier(model, literals, packets, index, typed, history, phase) }}
{%- else -%}
{{ abort(literals) }}
{%- endif -%}
{%- endmacro -%}
