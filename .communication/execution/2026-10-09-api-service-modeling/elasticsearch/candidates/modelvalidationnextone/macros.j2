{%- set st.state = L.state_in_lower -%}
{%- elif ch in L.upper -%}
{%- set st.state = L.state_in_pascal -%}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- elif st.state == L.state_in_lower -%}
{%- if ch in L.lower -%}
{%- elif ch == L.colon -%}
{%- set st.state = L.state_after_colon -%}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- elif st.state == L.state_in_pascal -%}
{%- if ch in L.lower -%}
{%- elif ch == L.colon -%}
{%- set st.state = L.state_after_colon -%}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- endif -%}
{%- set st.i = st.i + 1 -%}
{%- endfor -%}
{%- if st.state == L.state_need_seg or st.state == L.state_after_colon -%}
{{ abort(L) }}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro require_reference(value, L) -%}
{%- if value is not string -%}
{{ abort(L) }}
{%- elif starts_with(value, L.profile_prefix, L) == L.true_word -%}
{{ require_registered_profile(value, L) }}
{%- else -%}
{{ require_alphabetic_urn(value, L) }}
{%- endif -%}
