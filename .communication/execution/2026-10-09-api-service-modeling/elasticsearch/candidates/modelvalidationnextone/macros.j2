{{ abort(L) }}
{%- endif -%}
{%- set marker = L.slash ~ node[L.key_identity] ~ L.slash -%}
{%- if marker in seen.blob -%}
{{ abort(L) }}
{%- endif -%}
{%- set seen.blob = seen.blob ~ marker -%}
{%- endif -%}
{%- endmacro -%}

{%- macro walk_node(node, depth, L, seen, parent) -%}
{{ require_mapping(node, L) }}
{%- if node[L.key_identity] is defined and node[L.key_kind] is not defined -%}
{{ abort(L) }}
{%- endif -%}
{{- record_identity(node, L, seen) -}}
{%- for key in L.emit_order -%}
{%- if node[key] is defined -%}
{{ require_closed_key(key, L) }}
{%- if node[key] is mapping -%}
{{ pad(depth, L) }}{{ key }}{{ L.colon_space }}{{ L.newline }}
{{ walk_node(node[key], depth + 1, L, seen, key) }}
{%- elif node[key] is string -%}
{{ emit_scalar(key, node[key], depth, L, parent) }}
{%- elif node[key] is sequence -%}
{{ abort(L) }}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- for key in node -%}
{%- set extra = namespace(known=false) -%}
{%- for name in L.emit_order -%}
{%- if name == key -%}
{%- set extra.known = true -%}
{%- endif -%}
{%- endfor -%}
{%- if extra.known is sameas false -%}
{{ abort(L) }}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro packet_source_digest(packet, L) -%}
{%- if packet is not mapping -%}
{{ abort(L) }}
{%- elif packet[L.spec_source] is not mapping -%}
{{ abort(L) }}
{%- elif packet[L.spec_source][L.spec_sha256] is not defined -%}
{{ abort(L) }}
{%- else -%}
{{- packet[L.spec_source][L.spec_sha256] -}}
{%- endif -%}
{%- endmacro -%}

{%- macro require_packet_join(packets, rec, L) -%}
{{ require_mapping(packets, L) }}
{{ require_mapping(rec, L) }}
{%- set path = rec[L.join_file] -%}
{%- if path is not defined -%}
{{ abort(L) }}
{%- endif -%}
{%- if path not in packets -%}
{{ abort(L) }}
{%- endif -%}
{%- set packet = packets[path] -%}
{%- if packet is not mapping -%}
{{ abort(L) }}
{%- endif -%}
{%- set digest = packet_source_digest(packet, L) -%}
{%- if digest != rec[L.join_source_sha256] -%}
{{ abort(L) }}
{%- endif -%}
{%- endmacro -%}

{%- macro require_index_identities_and_packets(packets, index, L) -%}
{{ require_mapping(packets, L) }}
{{ require_mapping(index, L) }}
{%- if index[L.index_iterator] is not sequence -%}
{{ abort(L) }}
{%- endif -%}
{%- if index[L.index_iterator] | length != L.family_total -%}
{{ abort(L) }}
{%- endif -%}
{%- set acc = namespace(seen='', head=0, prior=0) -%}
{%- for rec in index[L.index_iterator] -%}
{{ require_mapping(rec, L) }}
{%- if rec[L.join_tag] is not string or rec[L.join_api] is not string or rec[L.join_file] is not string or rec[L.join_source_sha256] is not string -%}
{{ abort(L) }}
{%- endif -%}
{%- set expected = L.packet_root ~ L.slash ~ rec[L.join_tag] ~ L.slash ~ rec[L.join_api] ~ L.packet_suffix -%}
{%- if rec[L.join_file] != expected -%}
{{ abort(L) }}
{%- endif -%}
{%- set tagapi = L.record_sep ~ L.mark_api ~ L.field_sep ~ rec[L.join_tag] ~ L.field_sep ~ rec[L.join_api] ~ L.record_sep -%}
{%- set tagfile = L.record_sep ~ L.mark_file ~ L.field_sep ~ rec[L.join_tag] ~ L.field_sep ~ rec[L.join_file] ~ L.record_sep -%}
{%- set composite = L.record_sep ~ L.mark_composite ~ L.field_sep ~ rec[L.join_tag] ~ L.field_sep ~ rec[L.join_api] ~ L.field_sep ~ rec[L.join_file] ~ L.field_sep ~ rec[L.join_source_sha256] ~ L.record_sep -%}
{%- if tagapi in acc.seen or tagfile in acc.seen or composite in acc.seen -%}
{{ abort(L) }}
{%- endif -%}
{%- set acc.seen = acc.seen ~ tagapi ~ tagfile ~ composite -%}
{%- if rec[L.join_tag] == L.tag_head -%}
{%- set acc.head = acc.head + 1 -%}
{%- elif rec[L.join_tag] == L.tag_prior -%}
{%- set acc.prior = acc.prior + 1 -%}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{{ require_packet_join(packets, rec, L) }}
{%- endfor -%}
{%- if acc.head != L.family_count_per_tag or acc.prior != L.family_count_per_tag -%}
{{ abort(L) }}
{%- endif -%}
{%- endmacro -%}

{%- macro require_typed_shape(typed, L) -%}
{{ require_mapping(typed, L) }}
{%- set nonempty = namespace(n=0) -%}
{%- for key in typed -%}
{%- set nonempty.n = nonempty.n + 1 -%}
{%- endfor -%}
{%- if nonempty.n > 0 -%}
{%- if typed[L.typed_shape_key] is not mapping -%}
{{ abort(L) }}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro require_history_shape(history, L) -%}
{{ require_mapping(history, L) }}
{%- set nonempty = namespace(n=0) -%}
{%- for key in history -%}
{%- set nonempty.n = nonempty.n + 1 -%}
{%- endfor -%}
{%- if nonempty.n > 0 -%}
{%- if history[L.history_shape_key] is not mapping -%}
{{ abort(L) }}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro require_join_contents(overlay, declared, L) -%}
{{ require_mapping(overlay, L) }}
{%- if overlay[L.join_identity_key] != declared[L.join_identity_key] -%}
{{ abort(L) }}
{%- endif -%}
{%- if overlay[L.join_coverage_key] != declared[L.join_coverage_key] -%}
{{ abort(L) }}
{%- endif -%}
{%- if overlay[L.join_evidence_key] != declared[L.join_evidence_key] -%}
{{ abort(L) }}
{%- endif -%}
{%- if overlay[L.join_status_key] != declared[L.join_status_key] -%}
{{ abort(L) }}
{%- endif -%}
