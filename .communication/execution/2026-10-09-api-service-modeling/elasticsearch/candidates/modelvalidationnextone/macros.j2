{%- endif -%}
{%- set st.i = st.i + 1 -%}
{%- endfor -%}
{%- endif -%}
{%- if st.ok is sameas true -%}
{{- L.true_word -}}
{%- else -%}
{{- L.false_word -}}
{%- endif -%}
{%- endmacro -%}

