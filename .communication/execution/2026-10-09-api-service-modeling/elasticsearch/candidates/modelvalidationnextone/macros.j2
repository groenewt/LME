{%- macro require_complete_module(module, shape_key, required_list, L) -%}
{{ require_mapping(module, L) }}
{%- if module[shape_key] is not mapping -%}
{{ abort(L) }}
{%- endif -%}
{%- set acc = namespace(n=0) -%}
{%- for declared in required_list -%}
{%- set ident = declared[L.join_identity_key] -%}
{%- if ident not in module[shape_key] -%}
{{ abort(L) }}
{%- endif -%}
{{ require_join_contents(module[shape_key][ident], declared, L) }}
{%- set acc.n = acc.n + 1 -%}
{%- endfor -%}
{%- set seen = namespace(n=0) -%}
{%- for key in module[shape_key] -%}
{%- set seen.n = seen.n + 1 -%}
{%- set hit = namespace(ok=false) -%}
{%- for declared in required_list -%}
{%- if key == declared[L.join_identity_key] -%}
{%- set hit.ok = true -%}
{%- endif -%}
{%- endfor -%}
{%- if hit.ok is sameas false -%}
{{ abort(L) }}
{%- endif -%}
{%- endfor -%}
{%- if seen.n != acc.n -%}
{{ abort(L) }}
{%- endif -%}
{%- if acc.n == 0 -%}
{{ abort(L) }}
{%- endif -%}
{%- endmacro -%}

