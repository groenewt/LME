{%- macro emit_scalar(key, value, depth, L, parent) -%}
{%- if value is mapping -%}
{{ abort(L) }}
{%- elif value is none -%}
{{ abort(L) }}
{%- elif value is sameas true or value is sameas false -%}
{{ abort(L) }}
{%- elif value is string -%}
{%- if key == L.key_short_description or key == L.key_long_description -%}
{%- if parent == L.key_metadata -%}
{{ emit_quoted(key, value, depth, L) }}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- else -%}
{{- require_reference(value, L) -}}
{{ pad(depth, L) }}{{ key }}{{ L.colon_space }}{{ value }}{{ L.newline }}
{%- endif -%}
{%- elif value is sequence -%}
{{ abort(L) }}
{%- else -%}
{{ abort(L) }}
{%- endif -%}
{%- endmacro -%}

{%- macro require_mapping(obj, L) -%}
{%- if obj is not mapping -%}
{{ abort(L) }}
{%- endif -%}
{%- endmacro -%}

{%- macro require_closed_key(key, L) -%}
{%- set found = namespace(ok=false) -%}
{%- for name in L.closed_keys -%}
{%- if name == key -%}
