{% macro jinja_encode_natural(v, text) -%}
{%- set ns = namespace(out=v.empty) -%}
{%- if text is not none -%}
{%- for ch in (text | string) -%}
{%- if ch in v.identity_grammar.digit_to_letter -%}
{%- set ns.out = ns.out ~ v.identity_grammar.digit_to_letter[ch] -%}
{%- elif ch in v.urn.grammar.segment_lower -%}
{%- set ns.out = ns.out ~ ch -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ ns.out }}
{%- endmacro %}
{% macro jinja_append_ident_segments(v, text, acc) -%}
{%- set ns = namespace(current=v.empty, has_lower=false) -%}
{%- if text is not none -%}
{%- for ch in (text | string) -%}
{%- if ch in v.identity_grammar.split_chars -%}
{%- if ns.current -%}
{%- set encoded = jinja_encode_natural(v, ns.current | lower) -%}
{%- if encoded -%}{%- set acc.parts = acc.parts + [encoded] -%}{%- endif -%}
{%- set ns.current = v.empty -%}
{%- set ns.has_lower = false -%}
{%- endif -%}
{%- elif ch in v.urn.grammar.segment_upper -%}
{%- if ns.current and ns.has_lower -%}
{%- set encoded = jinja_encode_natural(v, ns.current | lower) -%}
{%- if encoded -%}{%- set acc.parts = acc.parts + [encoded] -%}{%- endif -%}
{%- set ns.current = ch -%}
{%- set ns.has_lower = false -%}
{%- else -%}
{%- set ns.current = ns.current ~ ch -%}
{%- endif -%}
{%- else -%}
{%- set ns.current = ns.current ~ ch -%}
{%- if ch in v.urn.grammar.segment_lower -%}
{%- set ns.has_lower = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if ns.current -%}
{%- set encoded = jinja_encode_natural(v, ns.current | lower) -%}
{%- if encoded -%}{%- set acc.parts = acc.parts + [encoded] -%}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endmacro %}
{% macro jinja_ident_segments(v, text) -%}
{%- set acc = namespace(parts=[]) -%}
{{- jinja_append_ident_segments(v, text, acc) -}}
{%- for segment in acc.parts -%}{{ segment }}{% if not loop.last %}{{ v.identity_grammar.urn_colon }}{% endif %}{%- endfor -%}
{%- endmacro %}
