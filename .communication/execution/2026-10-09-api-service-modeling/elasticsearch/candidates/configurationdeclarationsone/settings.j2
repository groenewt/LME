{%- from "settingsmacros.j2" import emit_python_projector, emit_model_document, emit_declaration_document, emit_citation_document, emit_behavior_document with context -%}
{%- set mode = projection_mode if projection_mode is defined else values.projection.default_mode -%}
{%- if mode == values.projection.program_mode -%}
{{ emit_python_projector(values) }}
{%- elif record is defined and record -%}
{{ emit_declaration_document(values, record) }}
{%- elif join is defined and join -%}
{{ emit_citation_document(values, join) }}
{%- elif behavior_topic is defined and behavior_citation is defined -%}
{{ emit_behavior_document(values, behavior_topic, behavior_citation) }}
{%- else -%}
{{ emit_model_document(values) }}
{%- endif -%}
