{%- elif item_kind == values.item_kinds.openapi_operation -%}
{{- emit_openapi_operation(item, values) -}}
{%- elif item_kind == values.item_kinds.openapi_schema -%}
{{- emit_openapi_schema(item, values) -}}
{%- elif item_kind == values.item_kinds.openapi_parameter -%}
{{- emit_openapi_parameter(item, values) -}}
{%- elif item_kind == values.item_kinds.openapi_request_body -%}
{{- emit_openapi_request_body(item, values) -}}
{%- elif item_kind == values.item_kinds.openapi_response -%}
{{- emit_openapi_response(item, values) -}}
{%- elif item_kind == values.item_kinds.api_index -%}
