{%- set parameter = item[values.openapi_item_keys.parameter] if values.openapi_item_keys.parameter in item else item -%}
{%- set identity = values.urn.parameter ~ values.punct.colon ~ values.identity_slots.open ~ values.punct.colon ~ encode_identity(name, values) -%}
{%- set short = name | string -%}
{%- set long_ns = namespace(text=short) -%}
{%- if values.description_key in parameter and parameter[values.description_key] -%}
{%- set long_ns.text = parameter[values.description_key] | string -%}
{%- endif -%}
{%- set slot = parameter[values.in_key] if values.in_key in parameter else values.path_key -%}
{{- emit_spine(identity, values.kinds.parameter, values.kinds.parameter, status_for_required(parameter[values.required_key] if values.required_key in parameter else values.bools.false, values), values.urn.catalog, values.urn.ontology_common, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].UNITS, values.parameter_in[slot] if slot in values.parameter_in else values.parameter_in.query, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].FLAGS, flag_for_required(parameter[values.required_key] if values.required_key in parameter else values.bools.false, values), values) -}}
{%- if values.deprecated_key in parameter and parameter[values.deprecated_key] -%}
{{- line(values.numbers.zero, values[values.keys_key].STATE, values.statuses.deprecated, values) -}}
{%- endif -%}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.openapi.identity, values) -}}
{{- emit_metadata(identity, short, long_ns.text, values) -}}
{%- endmacro -%}
{%- macro emit_openapi_request_body(item, values) -%}
{%- set name = item[values.name_key] -%}
{%- set body = item[values.openapi_item_keys.body] if values.openapi_item_keys.body in item else item -%}
{%- set identity = values.urn.body ~ values.punct.colon ~ values.identity_slots.open ~ values.punct.colon ~ encode_identity(name, values) -%}
{%- set short = name | string -%}
{{- emit_spine(identity, values.kinds.body, values.kinds.body, values.statuses.observed, values.urn.catalog, values.urn.ontology_common, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].AXES, values.axes.request, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.openapi.identity, values) -}}
{%- if values.content_key in body -%}
{%- set content = body[values.content_key] -%}
{%- if content is mapping -%}
{%- set first = first_mapping_key(content, values) -%}
{{- line(values.numbers.zero, values[values.keys_key].UNITS, media_urn(first, values), values) -}}
{%- endif -%}
{%- endif -%}
{{- emit_metadata(identity, short, short, values) -}}
{%- endmacro -%}
{%- macro emit_openapi_response(item, values) -%}
{%- set name = item[values.name_key] -%}
{%- set response = item[values.openapi_item_keys.response] if values.openapi_item_keys.response in item else item -%}
{%- set identity = values.urn.schema ~ values.punct.colon ~ values.identity_slots.response ~ values.punct.colon ~ encode_identity(name, values) -%}
{%- set short = name | string -%}
{%- set long_ns = namespace(text=short) -%}
{%- if values.description_key in response and response[values.description_key] -%}
{%- set long_ns.text = response[values.description_key] | string -%}
{%- endif -%}
{{- emit_spine(identity, values.kinds.response, values.kinds.response, values.statuses.observed, values.urn.catalog, values.urn.ontology_common, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].AXES, values.axes.response, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.openapi.identity, values) -}}
{%- if values.content_key in response and response[values.content_key] is mapping -%}
{%- set first = first_mapping_key(response[values.content_key], values) -%}
{{- line(values.numbers.zero, values[values.keys_key].UNITS, media_urn(first, values), values) -}}
{%- endif -%}
{{- emit_metadata(identity, short, long_ns.text, values) -}}
{%- endmacro -%}
{%- macro emit_api_index(item, values) -%}
{%- set api = item[values.api_key] -%}
{%- set tag = item[values.tag_key] -%}
{%- set identity = values.urn.join ~ values.punct.colon ~ values.identity_slots.index ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) -%}
{%- set short = (tag | string) ~ values.punct.space ~ (api | string) -%}
{%- set long_text = (item[values.file_key] | string) ~ values.punct.space ~ (item[values.sha256_key] | string) ~ values.punct.space ~ (item[values.source_sha256_key] | string) -%}
{{- emit_spine(identity, values.kinds.join, values.kinds.join, values.statuses.joined if api != values.common_api_name else values.statuses.unmatched, values.urn.catalog, values.urn.ontology_process, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{%- if api == values.common_api_name -%}
{{- line(values.numbers.zero, values[values.keys_key].GAP, values.gap.unmatched, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].STATUS, values.statuses.unmatched, values) -}}
{%- else -%}
{{- line(values.numbers.zero, values[values.keys_key].FORWARD, endpoint_urn(api, values), values) -}}
{%- endif -%}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.apiindex.identity, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].CITATION, values.provenance_specimens.apiindex.identity, values) -}}
{%- if values.rest_bodies.materialized == values.bools.true -%}
{{- line(values.numbers.zero, values[values.keys_key].CHILD, values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values), values) -}}
{%- else -%}
{{- line(values.numbers.zero, values[values.keys_key].GAP, values.gap.no_api_bodies, values) -}}
{%- endif -%}
{{- line(values.numbers.zero, values[values.keys_key].VERSION, values.version_tokens.tag_unproven, values) -}}
{{- emit_metadata(identity, short, long_text, values) -}}
{%- endmacro -%}
{%- macro emit_rest_body(item, values) -%}
{%- set api = item[values.api_key] -%}
{%- set tag = item[values.tag_key] -%}
{%- set identity = values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) -%}
{%- set short = (tag | string) ~ values.punct.space ~ (api | string) -%}
{%- set long_text = (item[values.file_key] | string) ~ values.punct.space ~ (item[values.sha256_key] | string) ~ values.punct.space ~ (item[values.source_sha256_key] | string) -%}
{{- emit_spine(identity, values.kinds.rest, values.kinds.rest, values.statuses.observed, values.urn.catalog, values.urn.ontology_process, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].PARENT, values.urn.join ~ values.punct.colon ~ values.identity_slots.index ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values), values) -}}
{%- if api != values.common_api_name -%}
{{- line(values.numbers.zero, values[values.keys_key].FORWARD, endpoint_urn(api, values), values) -}}
{%- else -%}
{{- line(values.numbers.zero, values[values.keys_key].GAP, values.gap.unmatched, values) -}}
{%- endif -%}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.apiindex.identity, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].VERSION, values.version_tokens.tag_unproven, values) -}}
{{- emit_metadata(identity, values.prose.rest_short, long_text, values) -}}
{%- endmacro -%}
{%- macro emit_rest_param(item, values) -%}
{%- set api = item[values.api_key] if values.api_key in item else values.words.unnamed -%}
{%- set tag = item[values.tag_key] if values.tag_key in item else values.words.unnamed -%}
{%- set slot = item[values.slot_key] if values.slot_key in item else values.identity_slots.params -%}
{%- set name = item[values.name_key] if values.name_key in item else values.words.unnamed -%}
{%- set identity = values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) ~ values.punct.colon ~ encode_identity(slot, values) ~ values.punct.colon ~ encode_identity(name, values) -%}
{%- set parent_urn = values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) -%}
{%- set short = (slot | string) ~ values.punct.dot ~ (name | string) -%}
{{- emit_spine(identity, values.kinds.parameter, values.kinds.rest, values.statuses.observed, parent_urn, values.urn.ontology_process, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].MEMBER, parent_urn, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].UNITS, values.parameter_in[slot] if slot in values.parameter_in else values.parameter_in.query, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.apiindex.identity, values) -}}
{{- emit_metadata(identity, short, short, values) -}}
{%- endmacro -%}
{%- macro emit_rest_path(item, values) -%}
{%- set api = item[values.api_key] if values.api_key in item else values.words.unnamed -%}
{%- set tag = item[values.tag_key] if values.tag_key in item else values.words.unnamed -%}
{%- set path = item[values.path_key] if values.path_key in item else values.words.unnamed -%}
{%- set identity = values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) ~ values.punct.colon ~ encode_identity(path, values) -%}
{%- set parent_urn = values.urn.rest ~ values.punct.colon ~ encode_identity(tag, values) ~ values.punct.colon ~ encode_identity(api, values) -%}
{%- set short = path | string -%}
{{- emit_spine(identity, values.kinds.url, values.kinds.rest, values.statuses.observed, parent_urn, values.urn.ontology_process, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].MEMBER, parent_urn, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.apiindex.identity, values) -}}
{{- emit_metadata(identity, short, short, values) -}}
{%- endmacro -%}
{%- macro emit_dangling(item, values) -%}
{%- set raw = item[values.original_key] if values.original_key in item else item | string -%}
{%- set name = raw | replace(values.dangling_error_prefix, values.punct.empty) | replace(values.punct.quote, values.punct.empty) -%}
{%- set identity = values.urn.dangling ~ values.punct.colon ~ encode_identity(name, values) -%}
{{- emit_spine(identity, values.kinds.dangling, values.kinds.dangling, values.statuses.dangling, values.urn.catalog, values.urn.ontology_common, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].GAP, values.gap.dangling, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].DEVIATION, values.deviation.dangling, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.validation_errors.identity, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].CITATION, values.provenance_specimens.validation_errors.identity, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].DIGEST, values.hash_tokens.validation, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].TOPIC, values.topics.coverage, values) -}}
{{- emit_metadata(identity, raw | string, raw | string, values) -}}
{%- endmacro -%}
{%- macro emit_unmatched(item, values) -%}
{%- set original = item[values.original_key] if values.original_key in item else values.words.unknown -%}
{%- set identity = values.urn.unmatched ~ values.punct.colon ~ encode_identity(item[values.join_item_keys.surface] if values.join_item_keys.surface in item else values.words.unnamed, values) ~ values.punct.colon ~ encode_identity(original, values) -%}
{%- set short = original | string -%}
{%- set long_text = (item[values.join_item_keys.reason] if values.join_item_keys.reason in item else values.prose.unmatched_short) | string -%}
{{- emit_spine(identity, values.kinds.unmatched, values.kinds.unmatched, values.statuses.unmatched, values.urn.catalog, values.urn.ontology_basic, values) -}}
{{- emit_distinctions(values, values.words.source, values.gap.unmatched) -}}
{{- line(values.numbers.zero, values[values.keys_key].GAP, values.gap.unmatched, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].CONFLICT, values.conflict.branch_versus_tag, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].RESOLUTION, values.resolution.keep_visible, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].TOPIC, values.topics.coverage, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.typeschema.identity, values) -}}
