{%- set long_text = (item[values.spec_location_key] | string) ~ values.punct.space ~ short -%}
{{- emit_spine(identity, values.kinds.error, type_urn(namespace, original, values), values.statuses.observed, values.urn.catalog, values.urn.ontology_common, values) -}}
{{- emit_distinctions(values, values.words.source, values.punct.empty) -}}
{{- line(values.numbers.zero, values[values.keys_key].ERROR, type_urn(namespace, original, values), values) -}}
{{- line(values.numbers.zero, values[values.keys_key].AXES, values.axes.error, values) -}}
{{- line(values.numbers.zero, values[values.keys_key].PROVENANCE, values.provenance_specimens.typeschema.identity, values) -}}
{{- emit_metadata(identity, short, long_text, values) -}}
{%- endmacro -%}
{%- macro emit_join_edge(item, values) -%}
