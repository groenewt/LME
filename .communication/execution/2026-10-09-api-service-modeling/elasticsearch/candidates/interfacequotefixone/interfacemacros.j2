{%- macro dispatch_item(values, item_kind, item) -%}
{%- if item_kind == values.item_kinds.catalog -%}
{{- emit_catalog(values) -}}
{%- elif item_kind == values.item_kinds.endpoint -%}
{{- emit_endpoint(item, values) -}}
{%- elif item_kind == values.item_kinds.type -%}
{{- emit_type(item, values) -}}
{%- elif item_kind == values.item_kinds.field -%}
{{- emit_field(item, values) -}}
{%- elif item_kind == values.item_kinds.parameter -%}
{{- emit_parameter(item, values) -}}
{%- elif item_kind == values.item_kinds.enum_member -%}
{{- emit_enum_member(item, values) -}}
{%- elif item_kind == values.item_kinds.body -%}
{{- emit_body(item, values) -}}
{%- elif item_kind == values.item_kinds.behavior_attachment -%}
{{- emit_behavior(item, values) -}}
{%- elif item_kind == values.item_kinds.generic -%}
