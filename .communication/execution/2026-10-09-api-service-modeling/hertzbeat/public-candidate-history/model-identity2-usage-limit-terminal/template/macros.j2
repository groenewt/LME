{%- macro text(node) -%}{{ node.METADATA.ShortDescription }}{%- endmacro -%}
{%- macro nl(ctx) -%}{{ text(ctx.newline) }}{%- endmacro -%}
{%- macro ind(ctx, depth) -%}{{ text(ctx.indent) * depth }}{%- endmacro -%}
{%- macro quoted(ctx, value) -%}{{ text(ctx.quote) }}{{ value }}{{ text(ctx.quote) }}{%- endmacro -%}
{%- macro pair(ctx, field_name, value, depth) -%}{{ ind(ctx, depth) }}{{ field_name }}{{ text(ctx.colon) }}{{ text(ctx.space) }}{{ value }}{{ nl(ctx) }}{%- endmacro -%}
{%- macro keyline(ctx, field_name, depth) -%}{{ ind(ctx, depth) }}{{ field_name }}{{ text(ctx.colon) }}{{ nl(ctx) }}{%- endmacro -%}
{%- macro scalar(ctx, key, value) -%}
{%- if key == ctx.prose or key == ctx.proselong or (value is string and text(ctx.projection) in value) -%}{{ quoted(ctx, value) }}
{%- else -%}{{ value }}
{%- endif -%}
{%- endmacro -%}
{%- macro emit_node(ctx, node, depth) -%}
{%- for key, value in node.items() -%}
{%- if value is mapping -%}{{ keyline(ctx, key, depth) }}{{ emit_node(ctx, value, depth + ctx.increment) }}
{%- else -%}{{ pair(ctx, key, scalar(ctx, key, value), depth) }}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
