{% macro emit_import(import_kw, space, path) -%}
{{ import_kw }}{{ space }}{{ path }}
{%- endmacro %}

{% macro emit_println_quoted(println_fn, open_paren, quote, text, close_paren) -%}
{{ println_fn }}{{ open_paren }}{{ quote }}{{ text }}{{ quote }}{{ close_paren }}
{%- endmacro %}

{% macro emit_string_item(indent, quote, value, comma, is_last) -%}
{{ indent }}{{ quote }}{{ value }}{{ quote }}{% if not is_last %}{{ comma }}{% endif %}
{%- endmacro %}

{% macro emit_collection(val_kw, space, ident, eq, ctor, open_paren, close_paren, indent, indent2, quote, comma, items) -%}
{{ indent }}{{ val_kw }}{{ space }}{{ ident }}{{ space }}{{ eq }}{{ space }}{{ ctor }}{{ open_paren }}
{% for item in items %}{{ emit_string_item(indent2, quote, item, comma, loop.last) }}
{% endfor %}{{ indent }}{{ close_paren }}
{%- endmacro %}

{% macro emit_filename_helper(indent, def_kw, space, name, open_paren, node_param, colon, ast_type, close_paren, ret_colon, string_type, eq, open_brace, close_brace, val_kw, traversal_val, iterator_ctor, file_acc, name_acc, to_list, if_kw, non_empty, head_fn, else_kw, filename_acc, indent2, dot) -%}
{{ indent }}{{ def_kw }}{{ space }}{{ name }}{{ open_paren }}{{ node_param }}{{ colon }}{{ space }}{{ ast_type }}{{ close_paren }}{{ ret_colon }}{{ space }}{{ string_type }}{{ space }}{{ eq }}{{ space }}{{ open_brace }}
{{ indent2 }}{{ val_kw }}{{ space }}{{ traversal_val }}{{ space }}{{ eq }}{{ space }}{{ iterator_ctor }}{{ open_paren }}{{ node_param }}{{ close_paren }}{{ dot }}{{ file_acc }}{{ dot }}{{ name_acc }}{{ dot }}{{ to_list }}
{{ indent2 }}{{ if_kw }}{{ space }}{{ open_paren }}{{ traversal_val }}{{ dot }}{{ non_empty }}{{ close_paren }}{{ space }}{{ traversal_val }}{{ dot }}{{ head_fn }}
{{ indent2 }}{{ else_kw }}{{ space }}{{ node_param }}{{ dot }}{{ filename_acc }}
{{ indent }}{{ close_brace }}
{%- endmacro %}

{% macro emit_line_helper(indent, def_kw, space, name, open_paren, node_param, colon, ast_type, close_paren, ret_colon, int_type, eq, line_acc, get_or_else, fallback, indent2, dot) -%}
{{ indent }}{{ def_kw }}{{ space }}{{ name }}{{ open_paren }}{{ node_param }}{{ colon }}{{ space }}{{ ast_type }}{{ close_paren }}{{ ret_colon }}{{ space }}{{ int_type }}{{ space }}{{ eq }}
{{ indent2 }}{{ node_param }}{{ dot }}{{ line_acc }}{{ dot }}{{ get_or_else }}{{ open_paren }}{{ fallback }}{{ close_paren }}
{%- endmacro %}

{% macro emit_normalize_helper(indent, def_kw, space, name, open_paren, code_param, colon, string_type, close_paren, eq, replace_all, quote, regex, replacement, indent2, dot, comma) -%}
{{ indent }}{{ def_kw }}{{ space }}{{ name }}{{ open_paren }}{{ code_param }}{{ colon }}{{ space }}{{ string_type }}{{ close_paren }}{{ colon }}{{ space }}{{ string_type }}{{ space }}{{ eq }}
{{ indent2 }}{{ code_param }}{{ dot }}{{ replace_all }}{{ open_paren }}{{ quote }}{{ regex }}{{ quote }}{{ comma }}{{ space }}{{ quote }}{{ replacement }}{{ quote }}{{ close_paren }}
{%- endmacro %}

{% macro emit_gap_foreach(indent, collection, foreach_fn, open_brace, binder, arrow, println_fn, interpolator, quote, gap_marker, tab, kind, close_brace, indent2, open_paren, close_paren, dot, interp_open, interp_close, space) -%}
{{ indent }}{{ collection }}{{ dot }}{{ foreach_fn }}{{ space }}{{ open_brace }}{{ space }}{{ binder }}{{ space }}{{ arrow }}
{{ indent2 }}{{ println_fn }}{{ open_paren }}{{ interpolator }}{{ quote }}{{ gap_marker }}{{ tab }}{{ kind }}{{ tab }}{{ interp_open }}{{ binder }}{{ interp_close }}{{ quote }}{{ close_paren }}
{{ indent }}{{ close_brace }}
{%- endmacro %}
