{%- from 'macros.j2' import nl, pair, keyline, seq_item, emit_quoted, flow_pair with context -%}
{{- pair(syntax, emitted_names.type, envelope.type, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.fields, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for field in envelope.fields -%}
{{- seq_item(syntax, field, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- pair(syntax, emitted_names.success_code, envelope.success_code, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.codes, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for code in envelope.codes -%}
{{- keyline(syntax, code.name, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.value, code.value, indent_depth.two) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.hex, emit_quoted(syntax, code.hex), indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.source, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.path, envelope.source.path, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.lines, flow_pair(syntax, envelope.source.lines[0], envelope.source.lines[1]), indent_depth.one) -}}
{{- nl(syntax) -}}
