{%- from 'macros.j2' import nl, pair, keyline, seq_item, emit_quoted with context -%}
{{- pair(syntax, emitted_names.name, projection_examples.mcp_tool.name, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.class_name, projection_examples.mcp_tool.class_name, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.documented_sort_default, projection_examples.mcp_tool.documented_sort_default, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.executed_sort_default, projection_examples.mcp_tool.executed_sort_default, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.editions, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for edition in projection_examples.mcp_tool.editions -%}
{{- seq_item(syntax, edition, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.http, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.path, mcp.http_path, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.methods, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- for method in mcp.http_methods -%}
{{- seq_item(syntax, method, indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.roles, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- for role in mcp.roles -%}
{{- seq_item(syntax, role, indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- pair(syntax, emitted_names.server_name, mcp.server_name, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.server_version, emit_quoted(syntax, mcp.server_version), indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.protocol, mcp.protocol, indent_depth.one) -}}
{{- nl(syntax) -}}
