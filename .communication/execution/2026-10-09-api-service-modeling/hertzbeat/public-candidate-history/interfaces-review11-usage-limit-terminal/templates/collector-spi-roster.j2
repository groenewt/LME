{%- from 'macros.j2' import nl, pair, keyline, seq_item, seq_map_first, seq_map_cont, emit_quoted with context -%}
{{- pair(syntax, emitted_names.kind, collector_spi.kind, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.not_plugin_spi, collector_spi.not_plugin_spi, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.origin_path, collector_spi.origin_path, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.copy_status, collector_spi.copy_status, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.packet_copy_root, collector_spi.packet_copy_root, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.plugin_java_interface_without_services_file, collector_spi.plugin_java_interface_without_services_file, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.plugin_spi_interfaces, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for iface in collector_spi.plugin_spi_interfaces -%}
{{- seq_item(syntax, iface, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.rows_180, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for row in collector_spi.rows_180 -%}
{{- seq_map_first(syntax, emitted_names.protocol, row.protocol, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- seq_map_cont(syntax, emitted_names.class_name, row.class_name, indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.rows_v190_head, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for row in collector_spi.rows_v190_head -%}
{{- seq_map_first(syntax, emitted_names.protocol, row.protocol, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- seq_map_cont(syntax, emitted_names.class_name, row.class_name, indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.named_distinctions, indent_depth.root) -}}
{{- nl(syntax) -}}
{%- for item in collector_spi.named_distinctions -%}
{{- seq_map_first(syntax, emitted_names.protocol, item.protocol, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- seq_map_cont(syntax, emitted_names.spi, item.spi, indent_depth.two) -}}
{{- nl(syntax) -}}
{{- seq_map_cont(syntax, emitted_names.note, emit_quoted(syntax, item.note), indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
{{- keyline(syntax, emitted_names.empty_registry, indent_depth.root) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.guard_180, factory_empty.guard_180, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.exception, factory_empty.v190_and_head.exception, indent_depth.one) -}}
{{- nl(syntax) -}}
{{- pair(syntax, emitted_names.message, emit_quoted(syntax, factory_empty.v190_and_head.message), indent_depth.one) -}}
{{- nl(syntax) -}}
{{- keyline(syntax, emitted_names.message_fragments, indent_depth.one) -}}
{{- nl(syntax) -}}
{%- for fragment in factory_empty.v190_and_head.message_fragments -%}
{{- seq_item(syntax, emit_quoted(syntax, fragment), indent_depth.two) -}}
{{- nl(syntax) -}}
{%- endfor -%}
