{%- macro nl(syntax) -%}{{ syntax.newline }}{%- endmacro -%}
{%- macro ind(syntax, depth) -%}{{ syntax.indent * depth }}{%- endmacro -%}
{%- macro emit_quoted(syntax, value) -%}{{ syntax.quote }}{{ value }}{{ syntax.quote }}{%- endmacro -%}
{%- macro flow_pair(syntax, left, right) -%}{{ syntax.lbracket }}{{ left }}{{ syntax.comma }}{{ syntax.space }}{{ right }}{{ syntax.rbracket }}{%- endmacro -%}
{%- macro pair(syntax, field_name, value, depth) -%}{{ ind(syntax, depth) }}{{ field_name }}{{ syntax.colon }}{{ syntax.space }}{{ value }}{%- endmacro -%}
{%- macro keyline(syntax, field_name, depth) -%}{{ ind(syntax, depth) }}{{ field_name }}{{ syntax.colon }}{%- endmacro -%}
{%- macro seq_item(syntax, value, depth) -%}{{ ind(syntax, depth) }}{{ syntax.seq_dash }}{{ syntax.space }}{{ value }}{%- endmacro -%}
{%- macro seq_map_first(syntax, field_name, value, depth) -%}{{ ind(syntax, depth) }}{{ syntax.seq_dash }}{{ syntax.space }}{{ field_name }}{{ syntax.colon }}{{ syntax.space }}{{ value }}{%- endmacro -%}
{%- macro seq_map_cont(syntax, field_name, value, depth) -%}{{ ind(syntax, depth) }}{{ field_name }}{{ syntax.colon }}{{ syntax.space }}{{ value }}{%- endmacro -%}
