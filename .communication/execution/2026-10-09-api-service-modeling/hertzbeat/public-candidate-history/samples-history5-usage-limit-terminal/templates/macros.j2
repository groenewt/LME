{# Stock Jinja2 macros. No custom filters. Named preload mappings are arguments or with-context globals. #}
{% macro yaml_kv(key, value) -%}
{{ key }}: {{ value }}
{%- endmacro %}

{% macro source_span(path, start, end, git_blob, sha256, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
path: {{ path }}
lines: [{{ start }}, {{ end }}]
git_blob: {{ git_blob }}
sha256: {{ sha256 }}
{%- endmacro %}

{% macro pin_block(pin, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
id: {{ pin.id }}
ref: {{ pin.ref }}
edition: {{ pin.edition }}
java_files: {{ pin.java_files }}
common_module: {{ pin.common_module }}
java_version: "{{ pin.java_version }}"
spring_boot_parent: "{{ pin.spring_boot_parent }}"
hzb_version: "{{ pin.hzb_version }}"
{%- endmacro %}

{% macro field_type_entry(name, spec, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
{{ name }}:
  value: {{ spec.value }}
  java_type: {{ spec.java_type }}
  line: {{ spec.line }}
{%- endmacro %}

{% macro storage_enable(name, spec, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
{{ name }}:
  prefix: {{ spec.prefix }}
  name: {{ spec.name }}
  havingValue: "{{ spec.havingValue }}"
  application_default: {{ spec.application_default | string | lower }}
{%- endmacro %}

{% macro fixture_expect(case, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
id: {{ case.id }}
expect: {{ case.expect }}
source: {{ case.source }}
{%- endmacro %}

{% macro adapter_class_line(class_name, protocol, prefix, pins=none, pom_tools=none, numeric_arrow=none, history_lifecycle=none, history_adapters=none, codecs=none, fixtures_positive=none, fixtures_negative=none) -%}
{{ "  - class: " }}{{ class_name }}
{{ "    protocol: " }}{{ protocol }}
{{ "    prefix: " }}{{ prefix }}
{%- endmacro %}
