{# Parameterized adapter inventory. Macros imported with context and explicit named-preload arguments. #}
{% from 'macros.j2' import adapter_class_line with context %}
kind: rendered.history-adapters
pin_trees:
{% for pin in pins.pins %}
  - edition: {{ pin.edition }}
    commit: {{ pin.commit }}
    tree: {{ pin.tree }}
{% endfor %}
history:
{% for adapter in history_adapters.history %}
{{ adapter_class_line(adapter.class, adapter.protocol, adapter.prefix, pins, pom_tools, numeric_arrow, history_lifecycle, history_adapters, codecs, fixtures_positive, fixtures_negative) }}
{% endfor %}
query_executors:
{% for ex in history_adapters.query_executors %}
  - class: {{ ex.class }}
    datasource: {{ ex.datasource }}
    language: {{ ex.language }}
{% endfor %}
greptime_sql_warehouse_query_frames: {{ history_adapters.query_executors[0].http_warehouse_query_frames }}
sql_query_executor_query: {{ history_adapters.sql_query_executor_base.query }}
