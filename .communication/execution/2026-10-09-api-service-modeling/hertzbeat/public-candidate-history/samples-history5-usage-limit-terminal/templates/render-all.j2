{# Parameterized native Jinja2 StrictUndefined render. Coordinator preloads values/*.yaml. #}
schema: {{ pins.schema }}
kind: rendered.numeric-arrow-history
arrow_version: "{{ pom_tools.arrow.value }}"
maven_distribution: "{{ pom_tools.maven_wrapper.maven_distribution }}"
wrapperVersion: "{{ pom_tools.maven_wrapper.wrapperVersion }}"
null_value: "{{ numeric_arrow.common_constants_field_types.NULL_VALUE.value }}"
type_number: {{ numeric_arrow.common_constants_field_types.TYPE_NUMBER.value }}
type_string: {{ numeric_arrow.common_constants_field_types.TYPE_STRING.value }}
type_secret: {{ numeric_arrow.common_constants_field_types.TYPE_SECRET.value }}
type_time: {{ numeric_arrow.common_constants_field_types.TYPE_TIME.value }}
fail_code: {{ numeric_arrow.common_constants_field_types.FAIL_CODE.value }}
default_history: "{{ history_lifecycle.http_history.default_history }}"
metric_full_length: {{ history_lifecycle.http_history.METRIC_FULL_LENGTH }}
value_type_class: {{ numeric_arrow.value_type_class }}
warehouse_history_csv_class: {{ history_lifecycle.csv_export.warehouse_history_csv_class }}
graphs_subtree: {{ pins.graphs_subtree }}
pins:
{% for pin in pins.pins %}
  - id: {{ pin.id }}
    ref: {{ pin.ref }}
    edition: {{ pin.edition }}
    java_files: {{ pin.java_files }}
    common_module: {{ pin.common_module }}
    java_version: "{{ pin.java_version }}"
    arrow_test_module: "{{ pom_tools.modules_for_arrow_tests[pin.edition] }}"
{% endfor %}
history_impls:
  "180":
{% for impl in history_lifecycle.history_impls.present_180 %}
    - {{ impl }}
{% endfor %}
  v190_head:
{% for impl in history_lifecycle.history_impls.present_v190_head %}
    - {{ impl }}
{% endfor %}
query_executors:
{% for ex in history_lifecycle.sql_http_query.query_executors if ex.datasource is defined %}
  - class: {{ ex.class }}
    datasource: {{ ex.datasource }}
    language: {{ ex.language }}
{% if ex.editions is defined %}
    editions: [{% for e in ex.editions %}"{{ e }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% endfor %}
enable:
{% for name, spec in history_lifecycle.enable_disable.items() if spec.prefix is defined %}
  {{ name }}:
    prefix: {{ spec.prefix }}
    havingValue: "{{ spec.havingValue }}"
    application_default: {{ spec.application_default | string | lower }}
{% endfor %}
identical_blobs:
  ArrowUtil.git_blob: {{ numeric_arrow.arrow_util.git_blob }}
  ArrowTable.git_blob: {{ numeric_arrow.arrow_table.git_blob }}
  KafkaMetricsDataSerializer.git_blob: {{ codecs.kafka.serializer_blob }}
  CommonConstants.git_blob: {{ numeric_arrow.common_constants_field_types.source.git_blob }}
